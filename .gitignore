# exclude all dot files except .git, appveyor and travis files
.*
!.git*
!.appveyor*
!.editorconfig
!.vscode

# exclude binaries and temporary files
[Bb]in/
[Bb]uild*/
!tools/build/
!tools/build/**

# Local bootstrap tools are downloaded and signature-checked by the build setup.
tools/nuget/
[Tt]est_root/
[Tt]est_root_*/
[Tt]est_install_root/
[Tt]est_patch_apply/
__pycache__/
*.py[cod]

# Local diagnostics are not part of the runtime or source package.
tools/sysinternals/
build_*.log
build_*.pid
[Aa]rtifacts/

# User-specific files
*.user
*.user.props
*.nvuser
*.PVS-Studio.*

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# exclude doxygen output
doc/doxygen/html/*
