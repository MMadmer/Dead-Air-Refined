# exclude all dot files except .git, appveyor and travis files
.*
!.git*
!.appveyor*
!.editorconfig
!.vscode

# exclude binaries and temporary files
[Bb]in/
[Bb]uild*/
!tools/build/
!tools/build/**

# Local bootstrap tools are downloaded and signature-checked by the build setup.
tools/nuget/
[Tt]est_root/
__pycache__/
*.py[cod]

# User-specific files
*.user
*.user.props
*.nvuser
*.PVS-Studio.*

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# exclude doxygen output
doc/doxygen/html/*
