#include "common.h"

struct v2p
{
    float3 lightToPos : TEXCOORD0;
    float3 vPos : TEXCOORD1;
    half fDensity : TEXCOORD2;
};

uniform float4 m_lmap[2];
uniform float4x4 m_shadow;
uniform sampler2D s_noise;

half4 main(v2p I) : COLOR
{
    float4 position = float4(I.vPos, 1.0);
    float4 projected = mul(m_shadow, position);
    projected.x = dot(position, m_lmap[0]);
    projected.y = dot(position, m_lmap[1]);
    const half4 lightmap = tex2Dproj(s_lmap, projected);

    const half radiusSquared = dot(I.lightToPos, I.lightToPos);
    const half attenuation = saturate(1.0 - radiusSquared * Ldynamic_pos.w);

    projected.xy /= projected.w * 3.0;
    const half time = timers.z * 0.1;
    projected.x += time;
    half4 noise = tex2D(s_noise, projected.xy);
    projected.x -= time;
    projected.y -= time * 0.70091;
    noise *= tex2D(s_noise, projected.xy);
    noise = noise * 0.5 + 0.5;

    half3 result = I.fDensity * attenuation;
    result *= lightmap.rgb;
    result *= Ldynamic_color.rgb * noise.rgb;
    return half4(result, 0.0);
}
