// The version resource of an engine library, included by its version.rc after ProductVersion.h,
// DAR_MODULE_NAME and DAR_MODULE_FILE (the library's name and its file name). Every library that
// implements a word of DAR_ENGINE_ABILITIES states the whole list, as xrEngine.exe does: a tool that
// starts the engine takes a word as present only when all of them state it, so a mixed installation
// is not run as one that can.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DAR_VERSION_RESOURCE
 PRODUCTVERSION DAR_VERSION_RESOURCE
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "Dead Air: Refined"
            VALUE "FileDescription", "Dead Air: Refined x64"
            VALUE "FileVersion", DAR_VERSION_STRING
            VALUE "InternalName", DAR_MODULE_NAME
            VALUE "LegalCopyright", "Copyright © 2009 GSC Game World"
            VALUE "OriginalFilename", DAR_MODULE_FILE
            VALUE "ProductName", "Dead Air: Refined"
            VALUE "ProductVersion", DAR_VERSION_STRING
            VALUE "EngineAbilities", DAR_ENGINE_ABILITIES
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
