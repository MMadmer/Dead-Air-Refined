<?xml version="1.0" encoding="windows-1251"?>
<!--
	XMS world rules: the task offers a mode can take out of the game.

	Every dialog that HANDS OUT work gets one more precondition, answered by
	xms_world.script from the mode's [world] rules; with no rules in force the
	answer is always yes, so a stock game sees no difference. Turning in a task
	already taken is never gated. The dialogs ship in a third-party mod, so this
	is a data patch on their ids (gamedata\patch\, the base layer) - a replaced
	file without these ids just logs the misses and stays intact.

	npc_quests   - jobs of squad leaders (the simulation task dialog)
	story_quests - tasks of named characters and the storylines (DoctorX questlines)
-->
<xms-patch target="gameplay\dialogs.xml">
	<append into="dialog[id=dm_sim_ordered_task_dialog]">
		<precondition>xms_world.allow_npc_quests</precondition>
	</append>
	<append into="dialog[id=drx_sl_esc_m_trader_game_start_dialog_1]">
		<precondition>xms_world.allow_story_quests</precondition>
	</append>
	<append into="dialog[id=drx_sl_bar_dolg_general_petrenko_stalker_game_start_dialog_1]">
		<precondition>xms_world.allow_story_quests</precondition>
	</append>
	<append into="dialog[id=drx_sl_mil_smart_terrain_7_7_freedom_leader_stalker_game_start_dialog_1]">
		<precondition>xms_world.allow_story_quests</precondition>
	</append>
	<append into="dialog[id=drx_sl_mar_smart_terrain_base_stalker_leader_marsh_game_start_dialog_1]">
		<precondition>xms_world.allow_story_quests</precondition>
	</append>
