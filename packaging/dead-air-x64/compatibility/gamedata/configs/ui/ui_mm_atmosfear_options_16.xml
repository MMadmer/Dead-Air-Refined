	<option_list>
		<!-- The weather dialog's two pages are lists like the options dialog's (atmosfear_options.script
		     builds them with dead_air_x64_option_list.script): these are their templates - the scroll
		     list, a subsection header, a row with its caption. -->
		<scroll_v x="285" y="64" width="300" height="586" right_ident="0" left_ident="0" top_indent="0" bottom_indent="0" vert_interval="0" always_show_scroll="0"/>
		<templ_header width="295" height="30"/>
		<cap_header x="10" y="8" width="275" height="20" complex_mode="1">
			<text align="l" font="graffiti19" r="175" g="175" b="170"></text>
		</cap_header>
		<templ_item width="295" height="24"/>
		<cap_item x="10" y="3" width="240" height="21">
			<text align="l" font="letterica16" r="95" g="92" b="79"></text>
		</cap_item>
	</option_list>

	<event_page>
		<!-- The events page: a subsection per event, a row per setting - check_enable_<event>,
		     list_<event>_freq, list_<event>_task, each placed in its row. The event_dialog nodes are
		     the stock page's. -->
		<check_enable_blowout x="255" y="1" width="30" height="21">
		</check_enable_blowout>
		<list_blowout_freq x="125" y="1" width="160" height="21" list_length="4" always_show_scroll="0">
			<list_font r="170" g="170" b="170" font="letterica16"/>
			<text_color>
				<e r="170" g="170" b="170"/>
				<d r="70" g="70" b="70"/>
			</text_color>
		</list_blowout_freq>
		<list_blowout_task x="125" y="1" width="160" height="21" list_length="2" always_show_scroll="0">
			<list_font r="170" g="170" b="170" font="letterica16"/>
			<text_color>
