<!-- Dead Air's booster_params.xml with every texture drawn by the xms_ui_shape shader (ui_theme.xml):
     written by tools\ui\item_info_from_da.py; the nodes are where Dead Air put them. -->
<booster_params x="0" y="0" width="260" height="20">
