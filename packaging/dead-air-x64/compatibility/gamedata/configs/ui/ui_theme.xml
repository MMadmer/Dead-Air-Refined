<?xml version="1.0" encoding="utf-8"?>
<!-- The interface theme: named colours and named looks every layout may use. A layout node takes
     a look with shape="name" or <shape style="name" .../> (and may set any attribute over it); any
     colour attribute, of a shape or of a text, may name a colour of the theme as "$name".

     A mod restyles the interface without touching this file: it ships ui_theme_<anything>.xml in
     configs\ui. Those files are read after this one, in name order, and a colour or a style they
     define replaces the one of the same name.

     <color name value="#rrggbb[aa]"/>
     <style name base="another style" kind fill line border radius soft segment gap text>
         <highlight/> <pushed/> <checked/> <disabled/>   - the states of a button, a row, a tab
     </style>
     A style's own attributes are its normal look and every state's that does not set them; a state
     sets only what changes. kind is box (the default) or a pictogram: trefoil, grid, pistol, helmet,
     cutlery, medkit, gem, gear, sort, biohazard, bolt, flame, psi, claw, bullet, impact, burst,
     heart, drop, runner, weight, clock, wrench, crosshair, hand, gauge, shield, cartridge, moon,
     upgrade, pin, keyboard, scales, gasmask (and the stroke glyphs search, check, cross, chevron,
     star). Lengths are
     768-line units; segment and gap cut a box into the segmented bars of Dead Air. -->
<w>
    <!-- The game's windows: Dead Air's warm near-black, the beige of its text, the orange of its highlights.
         Two seeds make them - main, the panels' near-black, and accent, the highlights - and the player may
         choose others (Options -> Game -> Interface). A colour with follow="seed" turns with its seed: its hue
         moves as the seed's moved, its saturation scales with the seed's, its value moves with the seed's
         (mode="shade", the default: surfaces) or stays (mode="tint": text, which keeps its contrast). The
         values written are the theme's own seeds'. Any colour may be named with an alpha of its own:
         "$accent#26". The menus' palette (sys_*, combo*) follows no seed. -->
    <seed name="main" value="#15120F"/>
    <seed name="accent" value="#D4913A"/>

    <color name="panel" value="#15120FFA" follow="main"/>
    <color name="panel_edge" value="#4C443AFF" follow="main"/>
    <color name="card" value="#1D1915F5" follow="main"/>
    <color name="inset" value="#0D0B09E6" follow="main"/>
    <color name="inset_edge" value="#2F2A23FF" follow="main"/>
    <color name="rule" value="#4C443A99" follow="main"/>
    <color name="blocker" value="#0B0908FF" follow="main"/>
    <color name="shade" value="#00000066"/>

    <color name="text" value="#E6D8BFFF" follow="main" mode="tint"/>
    <color name="text_dim" value="#A39886FF" follow="main" mode="tint"/>
    <color name="text_muted" value="#6E665AFF" follow="main" mode="tint"/>
    <color name="text_dark" value="#14110EFF" follow="main"/>

    <color name="accent" value="#D4913AFF" follow="accent"/>
    <color name="accent_dim" value="#A46D2BFF" follow="accent"/>
    <color name="accent_soft" value="#D4913A2E" follow="accent"/>
    <!-- what goes with the item in hand (its ammo, its weapon, its addons): a warmer cousin of the accent -->
    <color name="related" value="#D9A441FF" follow="accent"/>

    <!-- the surfaces of buttons, tools, tabs, key caps, menus and hints -->
    <color name="button_fill" value="#221E19FF" follow="main"/>
    <color name="button_line" value="#5A5145FF" follow="main"/>
    <color name="button_off" value="#1A1714FF" follow="main"/>
    <color name="primary_fill" value="#2A2116FF" follow="main"/>
    <color name="tool_fill" value="#1C1915FF" follow="main"/>
    <color name="tool_line" value="#3F382FFF" follow="main"/>
    <color name="tool_hover" value="#2C261FFF" follow="main"/>
    <color name="chip_fill" value="#2A2520FF" follow="main"/>
    <color name="menu_fill" value="#14110EFA" follow="main"/>
    <color name="tooltip_fill" value="#110E0CF7" follow="main"/>
    <color name="tip_bar" value="#C9BFAEFF" follow="main" mode="tint"/>

    <!-- what a value means does not follow a seed -->
    <color name="good" value="#86B36BFF"/>
    <color name="warn" value="#D9A441FF"/>
    <color name="bad" value="#D8574BFF"/>
    <color name="negative" value="#E07A6CFF"/>
    <color name="health" value="#C8382CFF"/>
    <color name="satiety" value="#7FA05AFF"/>
    <color name="protection" value="#B3AA9BFF" follow="main" mode="tint"/>

    <!-- surfaces -->
    <style name="panel" fill="$panel" line="$panel_edge" border="1" radius="4"/>
    <style name="card" fill="$card" line="$inset_edge" border="1" radius="3"/>
    <style name="inset" fill="$inset" line="$inset_edge" border="1" radius="3"/>
    <style name="slot" fill="$inset" line="$inset_edge" border="1" radius="3"/>
    <style name="rule" fill="$rule"/>
    <style name="shadow" fill="#000000A6" soft="14" radius="8"/>
    <style name="portrait_frame" fill="#00000000" line="$panel_edge" border="1" radius="2"/>
    <style name="blocker" fill="$blocker#D9" line="$inset_edge" border="1" radius="2"/>
    <style name="slot_highlight" fill="$accent_soft" line="$accent" border="1" radius="3"/>
    <!-- the dialog window: see-through like Dead Air's own, the partner stays in sight behind it -->
    <style name="talk_panel" fill="$panel#8C" line="$panel_edge" border="1" radius="4"/>
    <style name="talk_card" fill="$card#4D" line="$inset_edge" border="1" radius="3"/>
    <style name="talk_inset" fill="$inset#40" line="$inset_edge" border="1" radius="3"/>
    <style name="slot_glyph" kind="trefoil" fill="$text#1F"/>

    <!-- buttons: a plain one, the one that does the window's business, a square tool -->
    <style name="button" fill="$button_fill" line="$button_line" border="1" radius="3" text="$text">
        <highlight fill="$accent" line="$accent" text="$text_dark"/>
        <pushed fill="$accent_dim" line="$accent_dim" text="$text_dark"/>
        <checked fill="$accent_soft" line="$accent" text="$accent"/>
        <disabled fill="$button_off" line="$inset_edge" text="$text_muted"/>
    </style>
    <style name="button_primary" base="button" fill="$primary_fill" line="$accent" text="$accent"/>
    <style name="tool_button" base="button" fill="$tool_fill" line="$tool_line">
        <highlight fill="$tool_hover" line="$accent" text="$text"/>
        <pushed fill="$accent_soft" line="$accent" text="$accent"/>
        <checked fill="$accent_soft" line="$accent" text="$accent"/>
    </style>
    <style name="tool_glyph" fill="#FFFFFFFF"/>

    <!-- The game's own windows over the menus - the updates, the bug and crash reports, the content
         repair, the Mods window - are black panels and light lines with a gold accent, apart from
         the in-game palette above: sys_* -->
    <color name="sys_text" value="#ECE9E2FF"/>
    <color name="sys_muted" value="#9A968CFF"/>
    <color name="sys_dim" value="#7C786FFF"/>
    <color name="sys_dark" value="#0B0B0BFF"/>
    <color name="sys_accent" value="#D2BE73FF"/>
    <color name="sys_good" value="#7FB069FF"/>
    <color name="sys_warn" value="#D9A441FF"/>
    <color name="sys_bad" value="#DC645AFF"/>
    <style name="sys_shade" fill="#00000073"/>
    <style name="sys_shadow" fill="#000000B3" soft="18" radius="8"/>
    <style name="sys_panel" fill="#000000F5" line="#E8E6E0CC" border="1" radius="3"/>
    <style name="sys_rule" fill="#E8E6E033"/>
    <style name="sys_inset" fill="#FFFFFF0A" line="#E8E6E040" border="1" radius="2"/>
    <style name="sys_button" fill="#00000000" line="#E8E6E099" border="1" radius="2" text="$sys_text">
        <highlight fill="#E8E6E0FF" line="#E8E6E0FF" text="$sys_dark"/>
        <pushed fill="#BDB9AEFF" line="#BDB9AEFF" text="$sys_dark"/>
        <checked fill="#E8E6E0FF" line="#E8E6E0FF" text="$sys_dark"/>
        <disabled fill="#00000000" line="#E8E6E02E" text="#5E5B55FF"/>
    </style>
    <style name="sys_button_primary" base="sys_button" line="$sys_accent" text="$sys_accent">
        <highlight fill="$sys_accent" line="$sys_accent" text="$sys_dark"/>
        <pushed fill="#B8A45EFF" line="#B8A45EFF" text="$sys_dark"/>
        <checked fill="$sys_accent" line="$sys_accent" text="$sys_dark"/>
    </style>
    <style name="sys_field" fill="#FFFFFF0A" line="#E8E6E066" border="1" radius="2">
        <highlight line="#E8E6E0B3"/>
        <checked line="#E8E6E0FF"/>
        <disabled line="#E8E6E02E"/>
    </style>
    <style name="sys_check" fill="#FFFFFF0A" line="#E8E6E099" border="1" radius="2">
        <highlight line="#E8E6E0FF"/>
        <checked fill="#E8E6E026" line="#E8E6E0FF"/>
        <disabled line="#E8E6E02E"/>
    </style>
    <style name="sys_check_mark" kind="check" fill="$sys_text" border="2"/>
    <style name="sys_bar_track" fill="#E8E6E014" radius="1"/>
    <style name="sys_bar_fill" fill="$sys_accent" radius="1"/>
    <style name="sys_scroll_track" fill="#E8E6E014" radius="1"/>
    <style name="sys_scroll_thumb" fill="#E8E6E080" radius="1">
        <highlight fill="#E8E6E0CC"/>
    </style>

    <!-- A drop-down of the menus (CUIComboBox; a layout may name others): the field in its states, the list
         that opens over everything, a row - under the cursor, the current choice -, the arrow, the list's
         scroll bar. The menus' palette: it does not follow the interface colours of the game. -->
    <style name="combo" fill="#000000B3" line="#E8E6E099" border="1" radius="2" text="$sys_text">
        <highlight line="#E8E6E0FF"/>
        <pushed fill="#000000D9" line="#E8E6E0FF"/>
        <disabled fill="#00000073" line="#E8E6E02E" text="#5E5B55FF"/>
    </style>
    <style name="combo_list" fill="#0A0A0AFF" line="#E8E6E0CC" border="1" radius="2"/>
    <style name="combo_row" fill="#00000000" radius="2" text="$sys_text">
        <highlight fill="#E8E6E033" text="#FFFFFFFF"/>
        <checked fill="#D2BE7314" text="$sys_accent"/>
    </style>
    <style name="combo_arrow" kind="chevron" border="1.5"/>
    <style name="combo_scroll_track" fill="#E8E6E014" radius="1"/>
    <style name="combo_scroll_thumb" fill="#E8E6E080" radius="1"/>

    <!-- a drop-down and a context menu of the game's windows -->
    <style name="menu" fill="$menu_fill" line="$panel_edge" border="1" radius="3" soft="1"/>
    <style name="menu_row" fill="#00000000" radius="2" text="$text_dim">
        <highlight fill="$accent" text="$text_dark"/>
        <pushed fill="$accent_dim" text="$text_dark"/>
        <checked fill="$accent_soft" text="$accent"/>
    </style>
    <!-- a row of a list whose choice is shown by marks of its own (the carcass's parts) -->
    <style name="list_row_marks" fill="#00000000" radius="2" text="$text">
        <highlight fill="#FFFFFF10"/>
    </style>

    <!-- the hint over an item, a button, a sensor -->
    <style name="tooltip" fill="$tooltip_fill" line="$panel_edge" border="1" radius="3"/>
    <style name="tooltip_rule" fill="$rule"/>

    <!-- bars: Dead Air's segments, the track a shade of the fill -->
    <style name="bar_track" fill="#FFFFFF12" segment="3" gap="1"/>
    <style name="bar_fill" fill="#FFFFFFFF" segment="3" gap="1"/>
    <style name="bar_thin_track" fill="#FFFFFF14" segment="2" gap="1"/>
    <style name="bar_thin_fill" fill="#FFFFFFFF" segment="2" gap="1"/>
    <style name="tip_bar_track" fill="#FFFFFF14" segment="3" gap="1"/>
    <style name="tip_bar_fill" fill="$tip_bar" segment="3" gap="1"/>
    <!-- the player's load: the track, the load, a mark at each limit of movement -->
    <style name="load_track" fill="#FFFFFF12" radius="1"/>
    <style name="load_fill" fill="#FFFFFFFF" radius="1"/>
    <style name="load_mark" fill="$text_dim"/>

    <!-- the cells of an item grid -->
    <style name="cell" fill="#FFFFFF06" line="#FFFFFF0C" border="1" radius="2"/>
    <style name="cell_item" fill="#FFFFFF0D" line="#FFFFFF1A" border="1" radius="2"/>
    <style name="cell_selected" fill="$accent#26" line="$accent" border="1" radius="2"/>
    <style name="cell_marked" fill="$good#1F" line="$good#99" border="1" radius="2"/>
    <style name="cell_related" fill="$related#1C" line="$related#80" border="1" radius="2"/>
    <style name="cell_blocked" fill="$bad#26" line="$bad#99" border="1" radius="2"/>
    <style name="cell_drop" fill="$accent#1F" line="$accent" border="1" radius="2"/>
    <style name="badge" fill="$inset#D9" line="$panel_edge#B3" border="1" radius="2"/>
    <!-- over the icons: an item picked for a comparison, and what cannot join it -->
    <style name="cell_picked" fill="$accent#14" line="$accent" border="2" radius="3"/>
    <style name="cell_dim" fill="$blocker#B8" radius="2"/>

    <!-- the comparison: the shade over the menu, a column, the winner's, every other row, the star -->
    <style name="compare_shade" fill="#000000A0"/>
    <style name="compare_column" fill="#FFFFFF07" line="#FFFFFF12" border="1" radius="3"/>
    <style name="compare_column_winner" fill="$accent#1C" line="$accent" border="1" radius="3"/>
    <style name="compare_row" fill="#FFFFFF06" radius="2"/>
    <style name="compare_badge" kind="star" fill="$accent"/>
    <style name="tab" base="button" fill="$tool_fill" line="$tool_line" text="$text_dim">
        <highlight fill="$tool_hover" line="$accent" text="$text"/>
        <pushed fill="$accent_soft" line="$accent" text="$accent"/>
        <checked fill="$accent_soft" line="$accent" text="$accent"/>
    </style>

    <!-- the panel of hotkeys: a key on its key cap -->
    <style name="key_chip" fill="$chip_fill" line="$button_line" border="1" radius="3"/>

    <!-- a thin scroll bar (scroll_bar_shape.xml) -->
    <style name="scroll_track" fill="#FFFFFF0A" radius="1"/>
    <style name="scroll_thumb" fill="$text#66" radius="1">
        <highlight fill="$accent"/>
    </style>
</w>
