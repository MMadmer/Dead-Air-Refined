<?xml version="1.0" encoding="utf-8"?>
<!-- The loading screen: the engine's built-in 4:3 layout, node for node, with a thin bar without the black
     frame. A mod replaces this file with a screen of its own, or patches only its loading_progress; a texture
     here may be a video or a GIF, a static may draw with a shader that reads xms_ui_progress (MODDING.md). -->
<w>
	<background width="1024" height="768">
		<auto_static width="1024" height="768">
			<texture x="0" y="0" width="1024" height="768">ui\ui_actor_loadgame_screen</texture>
		</auto_static>
	</background>
	<loading_logo x="0" y="173" width="1024" height="399"/>
	<loading_progress x="260" y="600" width="506" height="2" horz="1" min="0" max="100" pos="0" under_background="0">
		<progress><shape fill="#E8E6E0D9" radius="1"/></progress>
		<background><shape fill="#E8E6E01F" radius="1"/></background>
	</loading_progress>
	<loading_stage x="260" y="530" width="506" height="20">
		<text align="c" r="170" g="170" b="170" font="letterica18"/>
	</loading_stage>
	<loading_header x="260" y="622" width="506" height="20">
		<text align="c" r="103" g="103" b="103" font="letterica18"/>
	</loading_header>
	<loading_tip_number x="260" y="658" width="506" height="20">
		<text align="c" r="103" g="103" b="103" font="letterica18"/>
	</loading_tip_number>
	<loading_tip x="163" y="676" width="700" height="80" complex_mode="1">
		<text alignment="c" align="c" r="103" g="103" b="103" font="letterica18"/>
	</loading_tip>
</w>
