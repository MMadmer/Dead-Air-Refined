<?xml version="1.0" encoding="utf-8"?>
<!-- The dialog window (CUITalkDialogWnd). Written by tools\ui\talk_layout.py for 4:3 and 16:9 in the look of
     the inventory and the trade: every surface and button is drawn by the xms_ui_shape shader (ui_theme.xml).
     The window is laid out in the middle; the option "Dialog window" (dar_dialog_position) moves all of it
     to the left or the right edge of the screen. -->
<w>
    <main x="0" y="0" width="1024" height="768">
        <auto_static x="226" y="6" width="572" height="760" shape="shadow"/>
        <auto_static x="232" y="10" width="560" height="748" shape="panel"/>
        <auto_static x="244" y="22" width="536" height="100" shape="card"/>
        <auto_static x="673" y="33" width="98" height="66" shape="portrait_frame"/>
    </main>

    <left_character_icon x="244" y="22" width="536" height="100"/>

    <frame_top x="244" y="130" width="536" height="390" shape="inset"/>
    <frame_bottom x="244" y="528" width="536" height="176" shape="inset"/>
    <!-- relative to their frames -->
    <answers_list x="8" y="8" width="520" height="374" always_show_scroll="0" scroll_profile="thin" vert_interval="2"/>
    <questions_list x="8" y="8" width="520" height="160" always_show_scroll="0" scroll_profile="thin" vert_interval="2"/>

    <button x="392" y="714" width="240" height="32">
        <shape style="button_primary"/>
        <text font="graffiti22" align="c" vert_align="c">ui_st_trade</text>
    </button>

    <question_item x="0" y="0" width="510" height="22" min_height="22">
        <num_text x="2" y="2" width="18" height="20">
            <text font="letterica18" color="$text_muted"/>
        </num_text>
        <content_text x="22" y="2" width="484" height="20">
            <text font="letterica18" color="$text" align="l" complex_mode="1"/>
            <text_color>
                <e color="$text"/>
                <t color="$accent"/>
                <h color="$accent"/>
                <d color="$text_muted"/>
            </text_color>
        </content_text>
    </question_item>

    <other_answer_item x="0" y="0" width="510" height="0" min_height="14" bottom_footer="8">
        <name_caption x="0" y="2" width="502" height="18">
            <text font="graffiti22" color="$accent" complex_mode="0"/>
        </name_caption>
        <content_text x="22" y="24" width="480" height="10" complex_mode="1">
            <text font="letterica18" color="$text"/>
        </content_text>
    </other_answer_item>

    <actor_answer_item x="0" y="0" width="510" height="0" min_height="14" bottom_footer="8">
        <name_caption x="0" y="2" width="502" height="18">
            <text font="graffiti22" color="$text_dim" complex_mode="0"/>
        </name_caption>
        <content_text x="22" y="24" width="480" height="10" complex_mode="1">
            <text font="letterica18" color="$text_dim"/>
        </content_text>
    </actor_answer_item>

    <iconed_answer_item x="0" y="0" width="510" height="0" min_height="32" bottom_footer="6">
        <name_caption x="0" y="0" width="0" height="0"/>
        <content_text x="68" y="0" width="434" height="30" complex_mode="1">
            <text font="letterica18" color="$text"/>
        </content_text>
        <msg_icon x="22" y="2" width="41" height="29" stretch="1"/>
    </iconed_answer_item>

    <simple_answer_item x="0" y="0" width="510" height="0" min_height="14" bottom_footer="6">
        <name_caption x="0" y="0" width="0" height="0"/>
        <content_text x="22" y="0" width="480" height="30" complex_mode="1">
            <text font="letterica18" color="$text"/>
        </content_text>
        <msg_icon x="0" y="0" width="0" height="0"/>
    </simple_answer_item>

    <iconed_trade_info x="0" y="0" width="510" height="0" min_height="22" bottom_footer="6">
        <name_caption x="0" y="0" width="0" height="0"/>
        <content_text x="58" y="2" width="444" height="20" complex_mode="1">
            <text font="letterica18" color="$text_dim"/>
        </content_text>
        <msg_icon x="22" y="0" width="28" height="20" stretch="1"/>
    </iconed_trade_info>
</w>
