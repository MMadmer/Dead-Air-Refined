<?xml version="1.0" encoding="utf-8"?>
<!-- The loading screen: the engine's built-in widescreen layout, node for node, with a thin bar low on the screen
     without the black frame. The bar is the screen's one progress: a mod gives it its own place, size and
     form - a texture, a shape, or a shader of its own over the whole bar (<progress whole="1">) - in a
     screen of its own or in an XMS patch of loading_progress. A texture here may be a video or a GIF
     (MODDING.md). -->
<w>
	<background width="1024" height="768">
		<auto_static x="102" y="0" width="819" height="768" stretch="1">
			<texture x="0" y="0" width="1024" height="768">ui\ui_actor_loadgame_screen</texture>
		</auto_static>
		<auto_static x="0" y="0" width="104" height="768" stretch="1">
			<texture x="0" y="0" width="128" height="768">ui\ui_actor_widescreen_sidepanels</texture>
		</auto_static>
		<auto_static x="920" y="0" width="104" height="768" stretch="1">
			<texture x="128" y="0" width="128" height="768">ui\ui_actor_widescreen_sidepanels</texture>
		</auto_static>
	</background>
	<loading_logo x="102" y="173" width="819" height="512" stretch="1"/>
	<loading_progress x="151.5" y="752" width="720" height="2" horz="1" min="0" max="100" pos="0" under_background="0">
		<progress><shape fill="#E8E6E0D9" radius="1"/></progress>
		<background><shape fill="#E8E6E01F" radius="1"/></background>
	</loading_progress>
	<loading_stage x="310" y="530" width="405" height="20" stretch="1">
		<text align="c" r="170" g="170" b="170" font="letterica18"/>
	</loading_stage>
	<loading_header x="310" y="622" width="405" height="20" stretch="1">
		<text align="c" r="103" g="103" b="103" font="letterica18"/>
	</loading_header>
	<loading_tip_number x="310" y="658" width="405" height="20" stretch="1">
		<text align="c" r="103" g="103" b="103" font="letterica18"/>
	</loading_tip_number>
	<loading_tip x="273" y="676" width="480" height="80" complex_mode="1" stretch="1">
		<text alignment="c" align="c" r="103" g="103" b="103" font="letterica18"/>
	</loading_tip>
</w>
