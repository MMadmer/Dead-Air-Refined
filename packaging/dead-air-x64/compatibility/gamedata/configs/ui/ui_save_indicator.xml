<?xml version="1.0" encoding="utf-8"?>
<!-- The save indicator (CUISaveIndicator): an ash-white gas mask on a dark disc at the middle of the screen's right
     edge, drawn per pixel by the xms_ui_shape shader, big and bright enough to be caught from the corner of the eye.
     It slides in, an arc runs round the disc while the game is saved, then the arc closes into a ring: a success sends
     a ping out of it and pops a tick up on the mask; a failure turns ring, mask and disc red, shudders and pops a cross.
     right, y, size and slide are 768-line units: the gap to the screen's right edge, the disc's centre, its diameter,
     how far it slides in. mask is the mask's height as a share of the disc's, arc the running arc's length (radians);
     the times are seconds (hold and hold_failed: how long the outcome stays).
     plate: the disc (fill) and its rim (line, border); ring: the arc's and the ring's colour (fill) and thickness
     (border); mask: the mask's colour; failed: the ring's and the mask's colour (fill) and the disc's (line) on a
     failure. -->
<w>
    <save_indicator right="24" y="384" size="72" slide="32" mask="0.66" arc="2.2"
        enter="0.25" spin="1.1" close="0.25" badge_in="0.3" ping="0.55" shake="0.45" hold="1.6" hold_failed="3" exit="0.4">
        <plate fill="#0c0c0ce0" line="#e2e0da40" border="1.5"/>
        <ring fill="#e2e0da" border="4"/>
        <mask fill="#e2e0da"/>
        <failed fill="#e5483d" line="#3a0e0bf0"/>
    </save_indicator>
</w>
