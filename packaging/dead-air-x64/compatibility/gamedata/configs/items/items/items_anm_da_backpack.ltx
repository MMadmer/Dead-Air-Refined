; [DA_PORT] Анимация возни с рюкзаком при открытии инвентаря.
;
; Движения рук - meshes\anomaly_weapons\hud_hands_animation\zzzz_ea_backpack.omf (FDDA Enhanced
; Animations, Mirrowel), собственные движения сумки (язычок молнии) -
; meshes\dynamics\weapons\wpn_eat\backpack\wpn_backpack_act_hud_anm.omf. Имена сходятся попарно:
; руки open_b_backpack <-> сумка open_b_backpack_itm.
;
; Сами сумки СВОИ (dar_bag_*_hud.ogf рядом с этой анимацией): скелет wpn_body + zipper с той же
; привязкой, ссылка на ту же анимацию, корпус по габаритам прежней сумки, молния ровно по пути
; язычка. Поэтому item_position / item_scale им не нужны: сумка садится туда же, куда садилась
; прежняя, и руки берут её там же.
;
; ВАЖНО: в строке "anm_xxx = руки, предмет" второе имя - цикл САМОЙ сумки. Без него движок возьмёт
; для предмета имя цикла РУК, не найдёт его в модели сумки и отступит к idle: сумка будет висеть
; неподвижно в двигающихся руках.

[da_backpack_hud]
hands_position                           = 0, 0, 0
hands_orientation                        = 0, 0, 0
hands_position_16x9                      = 0, 0, 0
hands_orientation_16x9                   = 0, 0, 0

; Дешёвая болотная сумка из брезента: слот пуст, заперт костюмом (backpack_avaliable = false у СЕВЫ,
; ССП-99 и др.) или в нём не рюкзак - экзоскелет, баллоны, АЗРМ, ремень с подсумками.
item_visual                              = dynamics\weapons\wpn_eat\backpack\dar_bag_default_hud.ogf
item_position                            = 0, 0, 0
item_orientation                         = 0, 0, 0

; Если сумка окажется НЕ в руках - это первая ручка, которую надо трогать.
;
; Корень модели предмета движок по умолчанию подавляет: у бутылок и еды в нём записан проезд по
; мировым координатам, и без подавления они улетают за сотню метров. Но бывает наоборот - у мешка
; после разделки в корне лежала вся расстановка сцены, и подавление её стирало. У сумки корень
; подавлен, как у всех: её держит кость рук.
item_root_lock                           = true

; Звук молнии, записан под эти движения. У каждого раздела может быть свой: достаточно дописать snd
; в секцию рюкзака.
snd                                      = interface\item_usage\backpack_open

anm_ea_show                              = open_b_backpack, open_b_backpack_itm
anm_ea_idle                              = idle_b_backpack, idle_b_backpack_itm
anm_ea_hide                              = close_b_backpack, close_b_backpack_itm


; По разделу на каждый рюкзак: меняется только модель сумки в руках.
;
; Раздел ищется по имени вещи в слоте рюкзака: da_backpack_<секция>_hud. Нет такого - играет общий
; [da_backpack_hud] выше. Апгрейды механиков DAR2 (секции с "1" на конце) наследуют вид своего
; рюкзака.

; охотничий рюкзак: тёмный серо-зелёный брезент, два кожаных ремня с пряжками
[da_backpack_kit_hunt_hud]:da_backpack_hud
item_visual                              = dynamics\weapons\wpn_eat\backpack\dar_bag_kit_hunt_hud.ogf
[da_backpack_kit_hunt1_hud]:da_backpack_kit_hunt_hud

; походный рюкзак: светлый шалфейный рипстоп, шнур-резинка поверх кармана
[da_backpack_backpack_light_hud]:da_backpack_hud
item_visual                              = dynamics\weapons\wpn_eat\backpack\dar_bag_backpack_light_hud.ogf
[da_backpack_backpack_light1_hud]:da_backpack_backpack_light_hud

; тактический рюкзак: почти чёрная зелёная кордура, пятнистый камуфляж, ряды MOLLE
[da_backpack_backpack_heavy_hud]:da_backpack_hud
item_visual                              = dynamics\weapons\wpn_eat\backpack\dar_bag_backpack_heavy_hud.ogf
[da_backpack_backpack_heavy1_hud]:da_backpack_backpack_heavy_hud

; туристический «Ермак»: хаки, нашитый карман под двумя стяжками с пряжками
[da_backpack_backpack_travel_hud]:da_backpack_hud
item_visual                              = dynamics\weapons\wpn_eat\backpack\dar_bag_backpack_travel_hud.ogf
[da_backpack_backpack_travel1_hud]:da_backpack_backpack_travel_hud

; сталкерский рюкзак: выцветший серо-зелёный, большой нашитый карман и нашивка
[da_backpack_backpack_stalker_hud]:da_backpack_hud
item_visual                              = dynamics\weapons\wpn_eat\backpack\dar_bag_backpack_stalker_hud.ogf
[da_backpack_backpack_stalker1_hud]:da_backpack_backpack_stalker_hud
