; Human NPC AI (Grizzly): behaviour profiles by faction, rank band and weapon, and the tuning of perception,
; communication, tactics, morale and search. Merged into system.ltx by the engine (x_ray.cpp) BEFORE the XMS module
; stage, so a module's configs\xms\*.ltx sections and .ltxp directives patch any key here. Every number of the AI
; lives in this file, not in code. Profiles resolve through a chain of sections (see [ai_profile_default]) rather than
; "[a]:b" parents, so a patch of one key reaches every NPC whose chain does not set that key closer to its head. A
; missing key falls back to [ai_profile_default], a missing section to the compiled-in defaults.
;
; Each global section belongs to one part of the AI and sits in its "; [ai:<part>]" block.

; [ai:core] begin ai_config
[ai_config]
rays_per_frame                  = 48        ; new AI rays per frame (hearing occlusion, flash, torch, gestures...)
squad_tick_ms                   = 250       ; per-squad step
squad_refresh_ms                = 1000      ; re-read of an NPC's sim squad and community
; Level of detail: an NPC farther than this from the player's camera ("far"; "calm" = without an enemy) refreshes
; per-target work less often (the lanes' *_far keys). First reactions and identification never change.
lod_near_m                      = 60
; [ai:core] end ai_config

; [ai:core] begin ranks
; Rank name ([game_relations] rating) -> band 1..4; unknown names are band 2.
[ai_rank_bands]
novice                          = 1
trainee                         = 1
experienced                     = 2
professional                    = 2
veteran                         = 3
expert                          = 3
master                          = 4
legend                          = 4

; react_ms and settle_s multiplier per rank name (absent = 1).
[ai_rank_scale]
legend                          = 0.9

; A mod's community -> the community whose profiles it uses, e.g. "renegade = bandit". Dead Air's own communities
; all have profiles; trader and arena_enemy fall back to the default profile on purpose.
[ai_community_alias]

; Specific character id (else character profile id) prefix -> profile section; the longest prefix wins. The section
; heads the NPC's chain; keys it leaves out come from the NPC's community and band as usual. A mod adds its special
; NPCs here by .ltxp.
[ai_profile_by_character]
sim_default_military_3_default_sniper = ai_profile_army_sniper
sim_default_military_3_sniper   = ai_profile_army_sniper
sim_monolith_sniper             = ai_profile_monolith_sniper    ; also the Gauss snipers
sim_monolith_specnaz_rg6        = ai_profile_monolith_rg6
sim_default_ecolog_2            = ai_profile_ecolog             ; scientists, whatever their rank
sim_default_ecolog_3            = ai_profile_ecolog_r3          ; field staff
sim_default_stalker_ecolog_guard = ai_profile_ecolog_guard
sim_default_csky_4              = ai_profile_csky_r4            ; experienced ranks on the best tier (C20)
sim_default_metro_ecolog_2      = ai_profile_ecolog
sim_default_metro_stalker_ecolog_guard = ai_profile_ecolog_guard
sim_default_metro_csky_4        = ai_profile_csky_r4
; [ai:core] end ranks

; [ai:core] begin profile_default
; Profiles. Every key is read from the first section of the NPC's chain that has it:
;   <[ai_profile_by_character] match>_r<band>, <match>, ai_profile_<community>_r<band>, ai_profile_<community>,
;   ai_profile_default_r<band>, ai_profile_default
; (band 1..4 from the rank, community after [ai_community_alias]; missing sections are skipped). Keys that scale by
; band live in the _r<band> sections, the rest in the base one; a faction's base section is its R2 row. An empty
; value is a value (grenade_issue = means no grenades), except peek and aggr_winning, which then follow cover and
; aggr. [ai_rank_scale] multiplies react_ms and settle_s last.
[ai_profile_default]
; perception
react_ms                        = 700, 1000 ; first aimed shot after identification, random range
react_idle_ms                   = 0         ; added when not in danger or combat
settle_s                        = 1.0       ; aim settles from x3 to x1 dispersion
detect_rate                     = 1.0       ; awareness gain multiplier
hear_skill                      = 0.5       ; localisation quality 0..1
hear_gain                       = 1.0       ; received sound power multiplier
aim_head                        = 0.15      ; chance of the head as aim point, else the spine
lead_error                      = 0.4       ; fraction of the velocity lead that is wrong
light_discipline                = 0.5       ; torch use at night: below 0.5 searches with the torch on
; comms
radio_chance                    = 0.2, 0.2, 0.3, 0.4 ; carries a radio, by band R1..R4 (rolled once per NPC life)
radio_leader_bonus              = 0.2       ; added for the squad's AI leader at the roll
hq_relay                        = 0         ; 0 = none, else the minimum band that relays to other squads
hq_delay_s                      = 60, 120
voice                           = auto      ; auto / loud / hushed / none
gestures                        = 3         ; minimum band, 0 = never
pda                             = 0
decide_ms                       = 400, 900
understand_ms                   = 300, 700
callouts                        = 1
; tactics
aggr                            = 0.5
aggr_winning                    =           ; aggression while winning_ratio holds; empty = aggr
winning_ratio                   = 1.5       ; known friendly / enemy strength that counts as winning
cover                           = 0.7
flank                           = 0.3
supp                            = 0.3
supp_window_s                   = 3
gren                            = 0.2
peek                            =           ; look-out discipline; empty = cover
bounding                        = 0
fire_on_order                   = 0
return_fire_m                   = 0         ; seen in the open within this (m): shoot back first; 0 = cover first
flank_fire                      = 0         ; the ordered flanker fires at what it sees on the move (0: at the cover)
roles                           = opportunist, suppressor, flanker, grenadier, rearguard
grenade_issue                   =           ; item, count, chance: count at spawn, plus one more with chance
; morale
courage                         = 0.5
break_cas                       = 0.45      ; own squad casualty share that breaks it
break_ratio                     = 0.5       ; known strength ratio below which it breaks
leader_dead                     = -0.10     ; break threshold change when the leader is known dead
rout_style                      = orderly   ; orderly / scatter / relocate / never
surrender                       = 0
recover_s                       = 30
fanatic                         = 0
stamina                         = 0.6
; search
search_delay_s                  = 8         ; no sighting, sound or report this long (s): search; < 0 = never
search_s                        = 90
search_style                    = single    ; pairs / single / straight / none
investigate                     = single    ; pair / single / none / advance
quiet_search                    = 0
giveup_stagger_s                = 4, 12

; Unknown communities scale by rank band like the known factions: a master of any faction is not dumb. R2 is
; the default row itself; the band values of the plan's default row (detect_rate, supp_window_s) differ there.
