concrete                        = 1.0
stucco                          = 1.0
bricks                          = 1.15      ; rubble
flooring_tile                   = 1.1
tree_trunk                      = 1.0
wood                            = 1.2
wooden_board                    = 1.3
shifer                          = 1.3
metal                           = 1.5
metal_pipe                      = 1.4
metal_plate                     = 1.6
