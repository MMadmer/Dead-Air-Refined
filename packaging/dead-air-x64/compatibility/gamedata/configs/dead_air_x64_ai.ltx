; [ai:search] begin ai_search
; Search after lost contact. Spots are places near the last known position (LKP) that cannot be seen from it:
; cover points and level vertices on rings around it, ordered by the estimated escape direction. A spot is cleared
; only by a searcher's own eyes; the squad's coordinator hands spots out by search_assign messages and learns of
; cleared ones by all_clear messages, so a searcher out of reach keeps its own plan.
[ai_search]
spot_radius                     = 30        ; first ring around the LKP, metres
spot_radius_max                 = 60        ; the search never widens beyond this
widen_mult                      = 1.6       ; radius of the next ring when every spot is cleared
widen_max                       = 2         ; wider rings after the first one
spots_max                       = 10        ; spots per ring
spot_min_gap                    = 6         ; metres between two spots
spot_max_dy                     = 3         ; spots farther above or below the LKP are skipped
hidden_max                      = 0.5       ; level-graph cover value toward the LKP at or below which a place is hidden
ring_samples                    = 12        ; level vertices tried per ring
escape_weight                   = 1.0       ; order: facing away from the escape direction costs this much
distance_weight                 = 0.5       ; order: distance from the LKP (fraction of the ring radius)
travel_weight                   = 0.5       ; assignment: travel from the searcher (fraction of the ring radius)
escape_speed_min                = 0.5       ; m/s; slower last seen motion gives no escape direction
clear_reach                     = 2.5       ; a searcher this close to a spot has cleared it
clear_view                      = 25        ; farthest spot a searcher can clear by looking into it
clear_height                    = 0.9       ; look point above the spot (a crouching man)
clear_rays                      = 2         ; sight rays per searcher update (budgeted)
replan_dist                     = 10        ; new information this far from the plan's LKP makes a new plan
assign_timeout_s                = 25        ; an assignment without all_clear frees the spot again
assign_tries                    = 2         ; a spot nobody cleared after this many assignments is dropped
assign_wait_s                   = 5         ; a coordinated searcher waits this long for its next spot
task_max_s                      = 40        ; a spot not reached in this time is given up
pair_max_gap                    = 30        ; two searchers farther apart are not paired
overwatch_dist                  = 8         ; the covering partner watches the spot from this far
overwatch_max_s                 = 30        ; the covering partner stops waiting for all_clear
takeover_s                      = 4         ; a new coordinator starts its own plan this long after the old one is gone
unselected_drop_s               = 20        ; a target not selected for this long ends the search quietly
sworn_mult                      = 1.3       ; search_s against a sworn enemy
; quiet_search profiles make no search barks, give their orders hushed and sneak up on a spot; the others call to
; each other on the way to every spot
bark_pause_s                    = 8, 15     ; a searcher's search line is not repeated sooner, random range
sneak_dist                      = 8         ; quiet searchers and investigators crouch this close to their spot
torch_check_s                   = 1         ; how often a searcher's torch is looked at for r_torch_on
plan_builds_per_frame           = 1         ; spot plan build steps per frame over all squads; the rest wait an update
; a plan is built in steps: its ring around the LKP in square tiles whose circles are plan_tile_m, then its spots in
; order of preference, at most plan_pops_per_step candidates per step; a step goes on to its next tile or candidate only
; while it has taken less than plan_step_budget_us
plan_tile_m                     = 15
plan_pops_per_step              = 256
plan_step_budget_us             = 120
plan_builders                   = 4         ; plan builds under way at once (at most 4); a plan finding none free waits
plan_build_stale_s              = 2         ; a build its owner stops asking for is dropped
; Investigation of a suspicion (profile investigate): pair - one goes and asks a mate he sees to cover him; single -
; one goes and says so, mates who hear it hold; none - wait in cover and call out; advance - straight at the source.
investigate_same_m              = 10        ; a danger this close to the spot under investigation is the same one
investigate_told_s              = 30        ; a mate who said he goes (or asked for cover) is waited for this long
investigate_max_s               = 45        ; an investigator that has not seen the spot by then gives up

; Sworn enemies search longer (lore): "<community> = <community>, ..." pairs, symmetric. Communities go through
