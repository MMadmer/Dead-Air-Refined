; [ai:sense] begin ai_noise
; Hearing of stalkers. Every heard sound (engine sounds and the noise bus) goes through one function: the profile's
; hear_gain, one static occlusion ray with the materials' sound occlusion, rain as a noise floor, and the NPC's own
; adaptive threshold (recent loud sounds mask quieter ones). The noise bus carries what a human's body and hands do:
; steps and landings (gait x surface x load), weapon reloads, torch clicks and level.ai_noise; the engine's own step,
; reload and torch sound events of humans are then ignored by the AI so nothing is heard twice. A noise of loudness L
; is heard in silence within L x step_range (steps, landings) or L x noise_range (everything else) metres, with an
; inverse-square fall-off inside that radius, so gunfire masking, walls, rain and a poor ear shrink the radius.
[ai_noise]
occlusion_floor                 = 0.25      ; sound bends around corners: walls never let through less than this
occlusion_hits                  = 3         ; faces along the ray that count
occlusion_cache_ms              = 2000      ; one ray per source and hearer in this time
occlusion_cache_far_ms          = 4000      ; the same for a hearer far from the player ([ai_config] lod_near_m)
occlusion_move_m                = 2         ; a source that moved farther gets a new ray...
occlusion_move_k                = 0.08      ; ...plus this share of its distance (a far source barely turns the line)
; A burst is one observation, not one per round: rounds and impacts of one source this soon and near reuse the first.
heard_repeat                    = 250, 2    ; ms, m
heard_repeat_far                = 1000, 6   ; ms, m: the same for a calm NPC far from the player (its first shot counts)
rain_mask                       = 0.08      ; received power lost in full rain (quiet sounds drown, shots do not)
detached_m                      = 6         ; a sound this far from its source object (ricochet, whine) is only a spot
gait                            = 0.12, 0.35, 0.7, 1.0 ; step loudness: crouch, walk, run, sprint
shuffle                         = 0.12      ; a step in place (turning on the spot)
landing                         = 0.9       ; the actor landing from a jump or a fall
step_range                      = 36        ; audible radius in silence per unit of loudness: steps and landings, m
noise_range                     = 40        ; the same for reloads, torch clicks and scripted noises, m
cull_mult                       = 1.25      ; hearers beyond the audible radius x this are not even tested
edge_power                      = 0.08      ; received power at the audible radius (stalkers' sound_threshold)
load                            = 25, 0.015 ; kg carried without extra noise, loudness added per kg above it
reload                          = 0.5       ; a weapon reload
torch_click                     = 0.2       ; a torch switched on or off
inbox_max                       = 16        ; pending stimuli per NPC (one per source and kind)
stimulus_ttl_ms                 = 1500      ; a stimulus the NPC could not process in this time is dropped
stimuli_per_update              = 8         ; stimuli one NPC update takes, oldest first; the rest wait for the next
pre_rays                        = 2         ; new rays of one update's stimuli and lamp look (a due look keeps one)
pre_budget_us                   = 150       ; after its first stimulus an update takes more (and looks) only within this
; Near misses: a bullet crossing a stalker's bounding sphere. Suppression (0..1) rises by near_miss_suppression x
; closeness and decays linearly; fire from a friend does not suppress. Tactics and morale read it.
near_miss_suppression           = 0.25
near_miss_radius                = 1.5, 0.3  ; metres from the eyes where closeness reaches 0; closeness floor
suppression_decay               = 0.3       ; per second
near_miss_estimate_ms           = 500       ; one estimate of the same shooter per this time
near_miss_hit_ms                = 300       ; a near miss this close in time to a hit by the same shooter is that hit
near_miss_queue_max             = 256       ; bullets waiting for the main thread

; Step loudness by the ground material (the last part of its name, "materials\<name>"); unlisted = default.
[ai_noise_surface]
default                         = 1.0
earth                           = 0.9
earth_death                     = 0.9
earth_slide                     = 0.9
dirt                            = 0.9
