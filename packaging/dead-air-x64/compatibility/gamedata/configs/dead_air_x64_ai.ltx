; [ai:know] begin ai_errors
[ai_errors]
; Error model of every estimate an NPC holds (metres; d = distance to the source). err is the radius the NPC itself
; assumes; the realised position is a disk sample of radius err * realise around the truth, snapped to the level
; graph. Estimates age: err grows by age_growth per second since the observation, up to age_cap. The hearing sense
; reads the heard_*, hit_*, near_miss_*, muzzle_flash and flashlight keys too.
extrap_s                        = 0.6       ; a lost target is extrapolated with its last seen velocity
extrap_band                     = 0.8, 1.0, 1.2, 1.4 ; extrap_s multiplier by rank band R1..R4
see_me_unknown                  = 1         ; enemy_sees_me estimate while the enemy is not in own vision
see_me_cone_deg                 = 60        ; half angle of an enemy's facing cone an NPC judges "he sees me" by
see_me_ray_s                    = 0.5       ; the LOS ray of that judgement is reused this long per target
script                          = 25        ; error of a scripted rumour, metres
realise                         = 0.6
age_growth                      = 1.5       ; m/s, a walking-speed prior
age_cap                         = 60
clarity_k                       = 1.5       ; err *= 1 + clarity_k * (1 - clarity) for a poorly seen or heard source
center_height                   = 0.9       ; an estimate on the ground is held at this height (body centre)
heard_shot                      = 3, 0.08   ; e0, k: err = e0 + k * d
heard_step                      = 2, 0.12
heard_other                     = 2, 0.10   ; reload, item, voice
heard_silenced_mult             = 2         ; a suppressed shot localises this much worse
heard_occlusion_mult            = 1         ; err x (1 + this * occlusion)
heard_skill_base                = 1.5       ; err x (base - hear_skill), every heard kind
muzzle_flash                    = 1, 0.02
flashlight                      = 2, 0.05
hit_cone_deg                    = 5, 20     ; shooter unseen: direction +-(a + b * (1 - hear_skill)) degrees
hit_distance_err                = 0.4       ; distance +-40 %
hit_distance_prior              = 30, 60    ; distance when no shot was heard, metres
near_miss_cone_deg              = 25
near_miss_distance_prior        = 20, 80    ; distance prior of an unheard shooter, metres
witness_cone_deg                = 30        ; a friend's aim or facing seen from outside
witness_distance_prior          = 30, 60
; A report describes a spot by sector or landmark: err = sender's err + describe_k * d(sender, spot), quantised to
; the grid: describe_<channel> = describe_k, grid.
describe_voice                  = 0.15, 5
describe_hushed                 = 0.15, 5
describe_radio                  = 0.10, 10
describe_gesture                = 0.20, 5
describe_pda                    = 0.10, 25
describe_hq                     = 0.10, 25
forget_enemy_s                  = 300       ; a belief nobody refreshes is dropped after this age (enemies)
forget_other_s                  = 60        ; the same for everybody else
reacquire_s                     = 1         ; own sight lost longer than this counts as a new sighting (k_seen)
beliefs_max                     = 16        ; beliefs per NPC; the oldest non-enemy goes first
aim_reroll_s                    = 3         ; how long an aim roll (bone, lead error) holds on one target
aim_bone_head                   = bip01_head
aim_bone_body                   = bip01_spine2
kill_wounded_seen_s             = 3         ; the finishing hit through cover needs an own sighting this recent
restore_grace_s                 = 10        ; AIK1: staged beliefs and unresolved restored targets wait this long
vertex_search_m                 = 22        ; an estimate off the graph snaps to the nearest cell this near (else all)
vertex_march_steps              = 16        ; farther: windows back toward the observer, at most this many
enemy_callback_ms               = 1000, 3000 ; the script's enemy callback answer lasts ~this: near, far (a hit: no)
maintain_ms                     = 250, 1000 ; beliefs are aged (dropped, relations re-read) this often: near, far
relation_refresh_ms             = 1000      ; the enemy flag of an unobserved belief is re-read this often
sight_hold_ms                   = 750       ; a live creature stays "in sight" at most this long after own vision saw it
; [ai:know] end ai_errors

; [ai:sense] begin ai_awareness
; Visual awareness of stalkers (mutants keep the stock vision). While the vision rays reach an object, awareness rises
; per second by intensity / visibility_threshold x rate_<state> x detect_rate (profile) x band_rate x peripheral
; x stance x close x concealment, where intensity is the stock visibility value (or the script hook
; visual_memory_manager.get_visible_value) of one time quantum; unseen it decays. identify = seen (the engine's
; visible flag), suspicious = a danger at a rough spot. Calibration targets (plan 7.5 B1: danger state, daylight, in
; the open, frontal, <= 80 m): R1 1.0-1.8 s, R2 0.7-1.2 s, R3 0.45-0.8 s, R4 0.3-0.6 s; calm state x2.5.
[ai_awareness]
identify                        = 1.0
suspicious                      = 0.35
crouch_mult                     = 0.6       ; the target crouches
rate_danger                     = 4.0       ; danger vision (visibility_threshold 5)
rate_free                       = 32.0      ; calm vision (visibility_threshold 100): x2.5 slower than danger
band_rate                       = 1.0, 1.2, 1.55, 1.9 ; R1..R4, on top of the profile's detect_rate
peripheral_mult                 = 0.35      ; rate at the edge of the field of view (1 on the view axis)
close                           = 10, 4     ; metres, gain: rate x (1 + gain x (1 - d / metres)) when closer
decay                           = 0.15, 0.3 ; per second while unseen: danger, calm
reacquire                       = 0.7, 8    ; floor, seconds: a target identified that recently decays no lower
