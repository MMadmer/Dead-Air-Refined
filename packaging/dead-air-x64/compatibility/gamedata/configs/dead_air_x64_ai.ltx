; [ai:morale] begin ai_morale
; Morale: each NPC weighs what it knows - friends it believes alive, enemies it has seen (attributes only from its own
; sightings), losses it perceived or was told about, its leader, its wounds, ammo and fear - into a confidence level
; (panicked < worried < steady < confident < heroic). A break sends it out of the fight by its profile's rout_style.
[ai_morale]
update_ms                       = 250       ; evaluation period per NPC
quiet_update_ms                 = 1000      ; the same while calm (no enemy, threat, break or wound); events wake it
; confidence = conf_base + ratio_k*log2(ratio) + courage_k*(courage-0.5) - health_k*(1-health) - ammo_k*low_ammo
;              - fear_k*fear - loss_k*losses/squad + kill_k*enemy deaths seen (<= kill_max) + leader_conf (leader near)
levels                          = 0.15, 0.35, 0.65, 0.85 ; thresholds worried, steady, confident, heroic
hysteresis                      = 0.04
conf_base                       = 0.5
ratio_k                         = 0.15      ; per doubling of the known strength ratio
ratio_max                       = 4         ; the ratio is clamped to 1/ratio_max .. ratio_max
courage_k                       = 0.4
health_k                        = 0.3
ammo_k                          = 0.1       ; less than one magazine left
fear_k                          = 0.5
loss_k                          = 0.4
kill_k                          = 0.05
kill_max                        = 0.15
leader_conf                     = 0.05
; strength of a fighter = armour x weapon x wounds (x band for mates: their rank is known, an enemy's is not)
unknown_enemy_strength          = 1.0       ; an enemy known only by report or sound
