; [ai:search] end ai_search

; [ai:script] begin ai_script
; The Lua side: dead_air_x64_ai.script and the overlay copies of base scripts it owns.
[ai_script]
; Report kinds whose target is the sender's enemy. A non-hostile NPC told about the actor this way by a member of its
; own community turns on him (goodwill -1000), as DA's first-contact broadcast did for everyone within 100 m.
hostility_kinds = contact, update, lost, taking_fire, reloading, flanking, cover_me, attack, help, search_assign
attacked_squad_window_s         = 120       ; told this soon after the actor hit its squad, a mate drops combat_ignore
weapon_choice_ms                = 2000      ; doctrine weapon choice period per NPC (DA's own timer)
melee_m                         = 4.5       ; below this known distance DA's own hand-to-hand weapon choice runs
weapon_primary                  = smg, shotgun, rifle_old, rifle, mg, dmr ; long guns, chosen first when the range fits
weapon_heavy                    = launcher  ; chosen after the long guns when the range fits
weapon_sidearm                  = pistol    ; chosen last, and when nothing else fits a close enemy
torch_period_ms                 = 2000, 2100 ; torch rule period per NPC, random range (DA's sr_light timer)
torch_discipline                = 0.5       ; light_discipline from here up: torch dark in combat, danger and search
vision_denominator_floor_m      = 1         ; visual_memory_manager: least denominator of DA's distance ratio (fog)
surrender_animation             = hand_up_0 ; played while the engine reports a surrender (DA's hands_up state)
surrender_check_ms              = 250       ; surrender check period per NPC
item_use_loudness               = 0.25      ; eating, a medkit, a bandage: level.ai_noise "item" (heard within ~10 m)
hear_danger_fresh_ms            = 1000      ; xr_danger's hearing reaction: own perception of the source this recent
; A level vertex DA's stalker binder remembered when the NPC went offline is used when it comes back online only on
; the level it was taken on and within this distance of where ALife brings the NPC online.
offline_vertex_max_m            = 150
; [ai:script] end ai_script
