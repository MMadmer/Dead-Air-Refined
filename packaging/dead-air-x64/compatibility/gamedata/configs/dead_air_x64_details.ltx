; Dead Air x64: grass swing override.
;
; The base system.ltx is sealed inside the game archives, and its authored fast-set was tuned
; against an engine that silently ignored the amplitudes (they were computed and discarded for a
; hardcoded wind_velocity line). With the amplitudes live again those numbers are wrong twice over:
; swing_fast_speed 20 is a 3.2 Hz phase racing at 185 km/h, and swing_fast_rot1 1 spins the wind
; direction full circle every second. This file is read by CDetailManager::Load after [details]
; and overrides only the keys present here.
;
; Values: the fast (storm) set started from IX-Ray's field-tested numbers (0.35/0.20) and was
; then raised after an in-game storm still read as near-calm - the swing amplitude multiplies
; with the wind-service variability and the spatial gust field, and the average of that product
; must land at "storm", not at "storm on paper". Speed stays near the physically-plausible value
; for a 12 m/s gust (~4.7, see docs/dead-air/ixray-graphics-audit.md); the whip factor of the
; wind service raises it further inside a gust. rot periods are wander periods now (the
; direction itself comes from the weather wind).

[details]
swing_normal_amp1  = 0.12
swing_normal_amp2  = 0.06
swing_normal_rot1  = 30.0
swing_normal_rot2  = 1.0
swing_normal_speed = 2.0

swing_fast_amp1    = 0.50
swing_fast_amp2    = 0.28
swing_fast_rot1    = 8.0
swing_fast_rot2    = 0.75
swing_fast_speed   = 4.5

; Details by season (r__season, docs/dead-air/SEASONS.md):
;   <season folder> = <grass density>, <grass height>, <shrub density>, <shrub height>
; Every value is a share of what the graphics preset (density) and the player (r__detail_height)
; set, so a season only takes away. Winter in the Zone is snow over grass that lies flat: no grass,
; the shrubs stand. Early spring is the matted remains of last year with the first short shoots; the
; grass grows back through spring.
[season_grass]
autumn       = 1.0,  1.0,  1.0, 1.0
winter       = 0.0,  1.0,  1.0, 1.0
spring_early = 0.35, 0.45, 1.0, 1.0
spring_mid   = 0.65, 0.7,  1.0, 1.0
spring_late  = 0.9,  0.9,  1.0, 1.0
summer       = 1.0,  1.0,  1.0, 1.0

