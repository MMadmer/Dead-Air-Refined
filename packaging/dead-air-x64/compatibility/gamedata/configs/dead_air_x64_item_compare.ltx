; The comparison of items in the actor menu (pick items with the middle button or C + click, then
; the scales button or V). Only items of one kind are compared; the winner is the best weighted
; score, not the one that wins the most rows.
;
; How the score is made: every row puts each item against the best of the row on the scale of the
; row's biggest value (a ratio for positive values, sound for signed ones such as an artefact's
; radiation), 0..1; the score is the weighted mean of those, 0..100.
;
; The weights (0..5) follow what players of shooters and survival games say they choose by -
; STALKER Anomaly/GAMMA, Dead Air, STALKER 2, Escape from Tarkov, Battlefield, Valorant, Fallout,
; The Elder Scrolls: for a gun the damage first, then accuracy, reliability and recoil, then the
; rate of fire; for armour the bullet protection, then the carry bonus and the artefact slots; for
; an artefact its radiation; for selling the price and the price per kilogram.
;
; A mod changes them without touching this file: it ships configs\item_compare_<anything>.ltx with
; the same sections. Those files are read after this one, in name order; a line replaces the line
; of that name, "= remove" takes the row out.
;
; [item_compare_<kind>]: firearm, melee, outfit, helmet, backpack, artefact, ammo, grenade, addon,
; detector, food, medicine, misc
;   rows = the order of the rows; lines it does not name come after them
;   <row> = <weight to keep>, <weight to sell> [| <source> | <better: high or low> | <caption> | <format> | <scale>]
; The row's name is its source unless a source is given:
;   condition, weight, price (a trader's in a trade, else the base price the condition leaves),
;   price_per_kg, uses (portions left), upgrades
;   a weapon's: damage (hit power with its first ammunition), damage_heavy (a knife's second
;   strike), rpm, accuracy (base dispersion), recoil, handling (inertia), aim_time, mag_size,
;   bullet_speed (how flat it shoots), endurance (shots per tenth of the condition), misfire (the
;   chance now), fouled, deformed, broken (faults, weighed by part: [item_compare_faults]),
;   addons (attached), mounts (that can be attached), ammo_cost (a round of its ammunition)
;   a suit's or a helmet's: armor (against bullets), prot_burn, prot_shock, prot_chemical,
;   prot_radiation, prot_psi, prot_strike, prot_wound, prot_explosion, artefact_slots, carry,
;   power_loss, night_vision, restore_health, restore_power, restore_bleeding, restore_satiety,
;   restore_radiation
;   an artefact's: restore_*, imm_burn, imm_shock, imm_chemical, imm_radiation, imm_psi,
;   imm_strike, imm_wound, imm_explosion, imm_fire_wound, carry
;   ammunition's: rounds, round_cost
;   key:<line> - a number in the item's section; script:<module>.<function> - called with the item's
;   game object, returns a number
; The caption is st_cmp_p_<row> unless given; the format is one of num, int, pct, kg, money, sec,
; mps, deg, yes, faults.

[item_compare]
max_items = 8

[item_compare_firearm]
