; Dead Air: Refined x64 - the shader fire.
;
; A campfire's flame is not a sprite flipbook any more: the effect names listed in [shader_fire]
; are drawn as a flame volume marched in a pixel shader (da_fire.ps) with a smoke plume that the
; engine simulates and the wind service drives (CDaFireEffect). The flame leans downwind by the
; AGA correlation, shortens in wind (Thomas), puffs at 1.5/sqrt(D) Hz and tears off tongues in
; gusts; the smoke rises as a bent-over buoyant plume (Briggs' two-thirds law), takes the wind of
; its own height and spreads with distance.
;
; Value = a preset section [shader_fire_<name>] below, or "off" for an effect that should draw
; nothing (the glow sprites the shader flame makes redundant). Every other effect keeps its
; sprites; the sparks, the heat haze and the air drawn into the fire stay as they are.

[shader_fire]
explosions\effects\campfire_flame               = campfire
explosions\effects\campfire_glow                = off
explosions\effects\campfire_big_flame           = campfire_big
explosions\effects\campfire_glow_04             = off
explosions\effects\campfire_06_flame            = campfire
explosions\effects\campfire_06_glow             = off
explosions\effects\campfire_flame_bed_fireplace = fireplace

; base_height  metres above the effect origin where the flame starts (the fuel bed)
; radius       fuel bed radius, m
; height       calm mean flame height, m
; intensity    emission gain
; lean         wind tilt gain, 1 = the AGA correlation
; smoke        1 = a plume, 0 = none
; smoke_rate   puffs per second
; smoke_life   seconds a puff lives, +-25%
; smoke_alpha  opacity of a fresh puff
; smoke_size   radius of a fresh puff, m
; smoke_grey   0 = light grey (a well-burning fire), 1 = dark resinous soot
; heat_kw      convective heat release, drives the plume rise
;
; Within r__fire_fluid_dist of the camera and on the two top presets the nearest such fire is
; simulated instead: a combusting fluid on a 64x96x64 grid whose fuel comes off the surfaces
; the fire actually stands on, so the flame's base follows the wood, the ground or a rooftop
; cell by cell, and the wind blows through the volume itself. These keys tune it; lengths are
; metres, rates per second.
;
; fluid_base        the fuel disc's centre above the effect origin
; fluid_bed         how far above and below it a surface still counts as fuel
; fluid_radius      the disc's radius; 0 = radius * 1.15
; fluid_cell        one cell, m (0.035 = a 2.24 x 3.36 x 2.24 m box)
; fluid_ignition    the temperature a cell needs before it burns
; fluid_burn        burn per degree over the ignition point, 1/s
; fluid_t_per_burn  degrees the reaction gives per unit burned
; fluid_smoke_per_burn  soot the reaction gives per unit burned
; fluid_cooling     radiative cooling, 1/s - this is what sets the flame's height
; fluid_fuel        how much fuel a burning surface holds
; fluid_couple      how fast it hands that fuel to the gas above, 1/s
; fluid_expansion   the volume the reaction makes; fullness and puffing
; fluid_buoyancy    m/s2 on gas at the core temperature
; fluid_inject      m/s of gas off a burning surface, along its normal
; fluid_wind_relax  how fast a parcel takes the wind up, 1/s
; fluid_vorticity   vorticity confinement; keeps the tongues from smearing
; fluid_iterations  pressure iterations
; fluid_emission    how hard the hot soot radiates
; fluid_absorb      how much the plume swallows
; fluid_ember       the glow the hot gas leaves on the wood under it
; fluid_core_t      the temperature that reads as a white core

[shader_fire_campfire]
base_height = 0.45
radius      = 0.32
height      = 0.8
intensity   = 1.0
lean        = 1.0
smoke       = 1
smoke_rate  = 10
smoke_life  = 12
smoke_alpha = 0.3
smoke_size  = 0.18
smoke_grey  = 0.3
heat_kw     = 100

fluid_base      = 0.12
fluid_radius    = 0.42
fluid_cooling   = 2.9
fluid_burn      = 4.5
fluid_t_per_burn = 2.5
fluid_fuel      = 1.1
fluid_buoyancy  = 24
fluid_vorticity = 0.2
fluid_expansion = 0.3
fluid_couple    = 8
fluid_bed       = 0.35
fluid_cell      = 0.035
fluid_emission  = 140
fluid_absorb    = 2.0
fluid_ember     = 1.1
fluid_core_t    = 2.4

