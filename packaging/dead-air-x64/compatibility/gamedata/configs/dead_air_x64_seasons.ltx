; Dead Air: Refined 1.6.0 season data (docs/dead-air/SEASON_DATA.md has every field).
; Generated by tools/seasons/gen_season_data.py from tools/seasons/data; edit those and regenerate.
;
; Day D: 0 = 1 January 00:00 of a 365-day year, a month key is its 15th at noon (14.5, 45.5, ... 348.5).
; Key lists: field = day:value, day:value, ... (any days, at most 32 keys), read through the periodic
; monotone cubic DaSeasonCurve (src/xrEngine/da_season.h): no overshoot, runs of equal keys stay exactly flat.
; Colours: day:#RRGGBB, sRGB of dry albedo; convert to linear and build one curve per channel.

; Season choice (r__season): glide = seconds a menu change takes to reach the new day.
[season]
glide   = 2.0
default = calendar

; Texture overlay category by texture name prefix (names relative to textures\, either slash, case-insensitive);
; the longest prefix wins, a name without a match is "default".
[season_categories]
terrain\      = default
build_details = default
level_lods    = trees
trees\        = trees
map\          = trees
ui\           = trees
grnd\         = ground
detail\       = ground
roof\         = ground
decal\        = decal
vine\         = vine

; Overlay folder per category: day:folder from that day (0-based, 00:00) to the next entry, wrapping; "-" = base.
; Latched at safe points. Ground sets are never winter; trees/decals wear winter only under full snow cover.
[season_folders]
default = 99:spring_mid, 120:spring_late, 151:summer, 262:autumn, 304:spring_early
trees   = 46:spring_early, 99:spring_mid, 120:spring_late, 151:summer, 262:autumn, 304:spring_early, 348:winter
ground  = 0:-
decal   = 46:-, 348:winter
vine    = 99:-, 304:winter

; Snow of the season per surface class: open ground, under tree canopy, roads, drifts and neglected spots.
; cover_* = covered share of the class, depth_* = game metres where it lies (mean of the covered part; drift =
; P90 of the covered drift cells), cap applied. The other lists describe the state of the snow. Extra keys:
; 304 (1 Nov 00:00) no snow yet; open cover is exactly 0.9 at 334 (1 Dec 00:00) and 58.5 (28 Feb noon) and
