; Season tint of the ground beyond the blades: strength near and far, fade from start * r__detail_radius to
; end * r__detail_radius + end_margin (m), reference day of each latched terrain folder (the brightness ratio).
; The canopy colour of each community is mixed by the engine from its species' season colours.
[ground_tint]
near             = 0.45
far              = 0.75
start            = 0.7
end              = 1
end_margin       = 20
ref_autumn       = 287.5
ref_spring_early = 73.5
ref_spring_mid   = 109.5
ref_spring_late  = 134.5
ref_summer       = 195.5

; Thresholds of the 1 m level bake (brief 3.3, followup_4 2): lengths in metres, heights above the hole-filled
; ground, angles in degrees, materials by GMLib name. Axes: +x east, +z north.
[snow_bake]
texel           = 1
receiver_ny     = 0.5
ground_dy       = 1
slope           = 0.35, 0.4
crown_h         = 2
tree_disc       = 0.8, 0.7
canopy_blur     = 3
canopy_class    = 0.5
canopy_lee      = 0.3
canopy_shield   = 0.45
tree_well       = 0.2, 0.6, 0.4
forest_area     = 300
obstacle_h      = 0.8
obstacle_cap    = 2.5
obstacle_area   = 4
wall_ny         = 0.3
wind_from       = 270, 247.5, 292.5
wind_weight     = 1, 0.7, 0.7
lee_reach       = 15
lee_flat        = 6
lee_end         = 12
toe_reach       = 1.5
toe_weight      = 0.45
