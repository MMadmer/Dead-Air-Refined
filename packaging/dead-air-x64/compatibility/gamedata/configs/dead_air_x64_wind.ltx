; Dead Air x64: per-weather wind strength profiles.
;
; DA weather cycles do not author wind_velocity (1028 of ~1100 entries are zero), so the
; engine's wind service maps the CYCLE NAME to a base strength here. Matching: an exact
; cycle-name key wins, otherwise the LONGEST substring key found in the name wins (so
; "veryfoggy" beats "foggy", "af3_day_storm" can be overridden exactly). Values are the
; weather's nominal wind in 0..1 (1 = full gale); the service layers its own minute-scale
; trends, waves, discrete gusts and the travelling gust field on top, and an authored
; wind_velocity or rain still raises the ceiling if it says more.
;
; Substring defaults below cover the whole AF3 set (af3_<light>_<sky>) plus the default_*
; and special cycles. Add exact names to fine-tune a single cycle.

; Service tunables.
;   z0 - surface roughness length in metres, the one number behind the vertical profile:
;        0.03 is open grassland, 0.1 farmland with hedges, 0.3-0.5 forest and village. The
;        Zone is mostly the middle case. It sets how much faster the wind is at a treetop
;        than at the grass, and how fast the cloud deck moves relative to the ground.
[wind_service]
z0 = 0.12

; The cloud deck: base altitude above the level's ground and thickness, metres. Cumulus over
; the Zone bases at 1-1.5 km and towers about as high again; the aloft wind (the log profile
; at this altitude, see z0) is what moves it and its shadow.
[clouds]
altitude  = 1300
thickness = 1200

; Which particle effects drift in the wind, and how much of it they take (0..1). Keys are
; effect-name substrings (case-insensitive): an exact effect name wins outright, otherwise the
; LONGEST key found in the name decides, and an effect no key matches takes no wind at all.
; Smoke, dust, steam and fog lean downwind; a flame sprite, a muzzle flash, a blood hit, a ring
; on water, an anomaly or a vortex stay where their author put them - the drift replaces the
; horizontal velocity, so a long-lived sprite given the wind would sail away from its source.
[particle_wind]
smoke     = 1.0
dym       = 1.0
dust      = 0.8
steam     = 0.9
fog       = 0.6
mist      = 0.6
gas       = 0.6
snow      = 0.7
leaves    = 0.7
spark     = 0.35
zone_smoke = 0.3
; keep still whatever the name says elsewhere
psi_storm = 0.0
anomaly   = 0.0
anomal    = 0.0
zone      = 0.0
artefact  = 0.0
vortex    = 0.0
weapons   = 0.0
distort   = 0.0
flame     = 0.0
fire      = 0.0
flash     = 0.0
glow      = 0.0
blood     = 0.0
water     = 0.0
trail     = 0.0
shells    = 0.0
teleport  = 0.0
gravi     = 0.0
electra   = 0.0
studen    = 0.0
zharka    = 0.0
psi       = 0.0

[wind_profiles]
storm        = 0.95
thunder      = 0.85
rain         = 0.65
veryfoggy    = 0.12
foggy        = 0.20
cloudy       = 0.48
partly       = 0.30
clear        = 0.14
night        = 0.10
indoor       = 0.05
stancia      = 0.55
map          = 0.00
