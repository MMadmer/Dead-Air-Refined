; Dead Air x64: per-weather wind strength profiles.
;
; DA weather cycles barely author wind_velocity (1028 of ~1100 entries are zero), so the
; engine's wind service maps the CYCLE NAME to a base strength here. Matching: an exact
; cycle-name key wins, otherwise the LONGEST substring key found in the name wins (so
; "veryfoggy" beats "foggy", "af3_day_storm" can be overridden exactly).
;
; These values are the MAGNITUDE, not a floor. Where a key matches, the authored wind_velocity
; curve only shapes the day around this number (+-30 per cent) instead of replacing it - the
; handful of entries that do author a value are not calibrated against each other at all
; (af3_day_clear says 350 at noon, af3_day_storm says 400), and taken literally a clear day
; blew nine tenths as hard as a gale. A cycle no key matches - a weather effect - keeps its
; authored value literally. Rain still raises the ceiling under both.
;
; Substring defaults below cover the whole AF3 set (af3_<light>_<sky>) plus the default_*
; and special cycles. Add exact names to fine-tune a single cycle.

; Service tunables.
;   z0 - surface roughness length in metres, the one number behind the vertical profile:
;        0.03 is open grassland, 0.1 farmland with hedges, 0.3-0.5 forest and village. The
;        Zone is mostly the middle case. It sets how much faster the wind is at a treetop
;        than at the grass, and how fast the cloud deck moves relative to the ground.
[wind_service]
z0 = 0.12

; The cloud deck: base altitude above the level's ground and thickness, metres. Cumulus over
; the Zone bases at 1-1.5 km and towers about as high again; the aloft wind (the log profile
; at this altitude, see z0) is what moves it and its shadow.
[clouds]
altitude  = 1300
thickness = 1200

; Which particle effects drift in the wind, and how much of it they take (0..1). Keys are
; effect-name substrings (case-insensitive): an exact effect name wins outright, otherwise the
; LONGEST key found in the name decides, and an effect no key matches takes no wind at all.
; Smoke, dust, steam and fog lean downwind; a flame sprite, a muzzle flash, a blood hit, a ring
; on water, an anomaly or a vortex stay where their author put them - the drift replaces the
; horizontal velocity, so a long-lived sprite given the wind would sail away from its source.
[particle_wind]
smoke     = 1.0
dym       = 1.0
dust      = 0.8
steam     = 0.9
fog       = 0.6
mist      = 0.6
gas       = 0.6
snow      = 0.7
leaves    = 0.7
spark     = 0.35
zone_smoke = 0.3
; keep still whatever the name says elsewhere
psi_storm = 0.0
anomaly   = 0.0
anomal    = 0.0
zone      = 0.0
artefact  = 0.0
vortex    = 0.0
weapons   = 0.0
distort   = 0.0
flame     = 0.0
fire      = 0.0
flash     = 0.0
glow      = 0.0
blood     = 0.0
water     = 0.0
trail     = 0.0
shells    = 0.0
teleport  = 0.0
gravi     = 0.0
electra   = 0.0
studen    = 0.0
zharka    = 0.0
psi       = 0.0

;
; The ladder below is Beaufort. Roughly, m/s at 10 m over open ground = value * 11, times the
; service's own variability (0.55..1.4 around it), so the mean and the gust range are both
; given. What each step is supposed to LOOK like is the whole point of the calibration:
;
;   0.02  ~0.1 m/s   B0  nothing moves
;   0.05  ~0.3 m/s   B0-1  smoke rises almost straight; leaf tips only
;   0.10  ~0.7 m/s   B1  leaves barely stir, twigs still
;   0.28  ~2.0 m/s   B2  leaves rustle, wind felt on the face
;   0.45  ~3.6 m/s   B3  leaves and small twigs in constant motion
;   0.62  ~5.4 m/s   B4  small branches move, dust lifts
;   0.85  ~8.2 m/s   B5  small trees in leaf begin to sway
;   1.00  ~10 m/s, gusting 14  B5-6  large branches in motion
[wind_profiles]
storm        = 1.00
thunder      = 0.85
rain         = 0.62
cloudy       = 0.45
partly       = 0.28
foggy        = 0.12
clear        = 0.10
night        = 0.08
; Dense fog forms in near-still air - it does not survive a breeze.
veryfoggy    = 0.05
indoor       = 0.02
stancia      = 0.45
map          = 0.00
