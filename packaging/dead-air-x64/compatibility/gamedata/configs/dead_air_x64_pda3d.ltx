; 3D PDA feature data (engine: da_pda3d.cpp, player_hud.cpp; docs/dead-air/pda-1to1-plan.md).
; Mechanism in code, bindings here: no section names, level names or mod script names in C++.

[pda3d]
; the presenter item raised into hands instead of the fullscreen dialog
animator_section        = pda_show_animator
; hands model for the PDA episode: the Gunslinger hand set is authored against its own rig
; whose REST POSE differs from the DA rigs per hand (the l/r wrist deltas diverge by ~116
; degrees - measured, see tools/animation/retarget_omf.py) - a direct retarget cannot keep
; a rigid two-handed device in both palms. So the episode swaps to the native rig, with
; its texture recolored to the DA look (no camo gloves).
hands_section           = pda3d_actor_hud
; Fallback boot length in seconds, used only when the show motion has no timings
; (savegame restore). Normally the two marks below drive the sequence.
boot_time               = 1.4
; m_affects.x pushed here when the battery reports empty (the shader blacks out past 0.41)
blackout_level          = 0.55
; pda.get_power() at or below this = dead battery
power_low_threshold     = 0.05
; screen brightness multiplier (m_affects.z)
brightness              = 1.0
; Boot marks along the show motion, as fractions of its length (pda_draw is 1.15 s):
;   screen_on_mark - the screen lights up and the loading sequence starts. Kept just off
;     zero so the device leaves the pocket dark for a beat.
;   boot_done_mark - the loading ends and the live UI takes over. This is Gunslinger's
;     mark_anm_show 0.85: "the display is active", i.e. the END of the boot, not the
;     power-on. The loader therefore plays WHILE the device is being raised (~0.9 s here)
;     and the screen is live exactly as it settles in front of the eyes.
screen_on_mark          = 0.06
boot_done_mark          = 0.85
; interference approach speed, normalized units per second - the screen degrades and
; recovers as a wave, never as a switch flip (Gunslinger electronics-counter ramp)
interference_ramp       = 0.15
; joystick quantizer: refresh period (ms) and cursor deadzone (canvas px per period)
joystick_update_period  = 100
joystick_deadzone       = 2

; Base interference per level, 0..1 (the shader ladder: 0.09 tear / 0.15 wave / 0.27 feed
; lost / 0.38 shift / 0.41 blackout). Unknown level names are silently skipped; the script
; side (surge / psi storm / jammed levels) combines with these by maximum.
[pda3d_interference_levels]
; l10_red_forest      = 0.20
; l13_generators      = 0.30

; Script-side interference sources (dead_air_x64_pda3d.get_interference). Curves are
; "progress:level" breakpoints over the event's phase 0..1 - the level holds from its
; breakpoint until the next one. Values tuned to walk the shader ladder as the event
; escalates: light tear -> travelling wave -> feed lost -> blackout at the peak.
[pda3d_interference]
surge_curve             = 0.0:0.12, 0.35:0.20, 0.65:0.30, 0.85:0.45
psi_storm_curve         = 0.0:0.20, 0.50:0.32, 0.80:0.50
; constant level on jammed levels (axr_battery.is_jammed - Red Forest, Generators)
jammed_level            = 0.20

; Extra hand-animation omfs appended to EVERY player hands model on load
; (engine: SkeletonAnimated.cpp + player_hud.cpp; a missing file only logs).
[player_hud_extra_omf]
pda_hands               = dynamics\weapons\hud_hands_animation\pda_hands_animation.omf
