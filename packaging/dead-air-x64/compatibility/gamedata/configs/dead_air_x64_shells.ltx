; Spent cartridge cases (src/xrGame/da_shells.cpp). A case of the shot's calibre leaves the ejection port,
; bounces off the level and the objects in it, and lies where it lands until the quality preset's count of
; cases (r__shells) makes room for a new one - the resting case farthest from the camera goes first. The
; models and the atlas are made by tools/shells, the bounce sounds too.

[shells]
enabled                 = true
render_distance         = 25        ; m: farther a case is under a pixel and is not drawn
spawn_distance          = 40        ; m: an NPC's shot farther than this throws no case
sound_distance          = 20        ; m: bounces heard this far
own_ignore_s            = 0.4       ; the shooter's own body does not stop its cases for this long
gravity                 = 9.81
drag                    = 0.1       ; of the speed per second in the air
kick_radius             = 0.3       ; m: feet this close push a lying case
kick_speed              = 0.8       ; m/s of the case per m/s of the feet, for a case of kick_mass
kick_max                = 1.8       ; m/s: a kicked case never flies off
kick_mass               = 0.01      ; kg: heavier cases go less far, lighter further (square root)
sound_volume            = 0.6
shadow_distance         = 6         ; m: lights and sun cascades get only the cases this close to the camera
shadow_max              = 48        ; and no more of them than this per pass
eject_dir               = 1, 0.55, -0.15 ; right, up and forward of the weapon: out of the port, up and back

; Weapons that throw their cases elsewhere (section prefix = right, up, forward).
[shells_eject]
wpn_p90                 = 0, -1, 0.15
wpn_m249                = 0.25, -1, 0
wpn_fn2000              = 0.7, 0.35, 0.6

; The calibre: the ammo of the shot first (longest section prefix), else the weapon's shell_particles.
