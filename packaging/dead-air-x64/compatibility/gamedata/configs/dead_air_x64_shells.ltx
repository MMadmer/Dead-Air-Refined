; Bounce sounds by the size of the case: <prefix><hard|soft|metal>_<n>.ogg, n from 1.
[shell_sounds]
pistol                  = dead_air_x64\shells\pistol_
rifle                   = dead_air_x64\shells\rifle_
large                   = dead_air_x64\shells\large_
shotgun                 = dead_air_x64\shells\shotgun_

; One case per calibre: model, half its diameter and length (m), mass (kg), the throw (m/s and rad/s).
[shell_base]
eject_speed             = 2.0, 3.2
eject_up                = 0.8, 1.6
eject_back              = -0.4, 0.2
spin                    = 15, 40

