; 3D PDA presenter item (docs/dead-air/pda-3d-port-plan.md, pda-1to1-plan.md). Merged on
; top of system.ltx by the engine (x_ray.cpp InitSettings) through the XMS overlay path -
; no DA file is overridden. Inherits DA's own shipped [anm_base]/[anm_base_hud]
; (misc\items\items_animations.ltx): class WP_PDA3D in the animation slot, hidden from the
; inventory grid. Hud offsets, fov factors and the anm_* map come from the Gunslinger
; original [pda_show_animator_hud]; every key below is verified against what OUR engine
; actually reads (inert keys are a defect, see the plan).

[pda_show_animator]:anm_base
$spawn                      = "weapons\pda_show_animator"
class                       = WP_PDA3D
description                 = st_pda_name
inv_name                    = st_pda_name
inv_name_short              = st_pda_name
hud                         = pda_show_animator_hud
visual                      = dynamics\devices\dev_pda\dev_pda.ogf
zoom_enabled                = true
scope_status                = 0
scope_zoom_factor           = 1.05
zoom_rotate_time            = 0.25
snd_draw                    = items\pda\pda_draw
snd_holster                 = detectorshud\detector_draw
; the PDA is not a weapon: sprint stays available (anm_idle_sprint exists), and no-weapon
; zones / ladders do not block or holster it (engine: CInventory::IsSlotBlocked)
sprint_allowed              = true
ignore_slots_blocked        = true

; The PDA episode swaps to the animation set's native rig (rest poses differ per hand from
; the DA rigs, a rigid two-handed grip cannot survive a retarget); its texture is recolored
; to the DA look.
[pda3d_actor_hud]
visual                      = dynamics\weapons\wpn_hand\wpn_hand_pda3d

[pda_show_animator_hud]:anm_base_hud
item_visual                 = dynamics\devices\dev_pda\dev_pda_hud.ogf
attach_place_idx            = 0
item_position               = 0,0,0
item_orientation            = 0,0,0

hands_position              = -0.015,-0.018,0.17
hands_orientation           = 0,0,0
hands_position_16x9         = -0.015,-0.018,0.15
hands_orientation_16x9      = 0,0,0

aim_hud_offset_pos          = 0.0282,0.041,0.15
aim_hud_offset_rot          = 0.0,0.0,0.0
aim_hud_offset_pos_16x9     = 0.02,0.041,0.15
aim_hud_offset_rot_16x9     = 0.0,0.0,0.0

; per-item hud fov: hip 0.9 -> aimed 0.29, ~3.1x linear magnification at the face - this
; is what makes the screen text readable (engine: CWeapon::GetHudFov)
hud_fov_factor              = 0.9
hud_fov_zoom_factor         = 0.29

; hud sway, straight from the Gunslinger original
inertion_origin_offset      = 0.03
inertion_origin_aim_offset  = 0
inertion_tendto_speed       = 10
inertion_tendto_aim_speed   = 10

; ---- hand motions (pda_hands_animation.omf, verified list) ----
anm_show                    = pda_draw
anm_hide                    = pda_hide
; holstering straight out of the raised-to-face pose (engine: CPdaAnimatorItem::PlayAnimHide)
anm_hide_from_aim           = pda_aim_hide
anm_idle                    = pda_idle
anm_bore                    = pda_vibros_end
anm_idle_moving             = pda_walk
anm_idle_moving_crouch      = pda_walk_slow
anm_idle_sprint             = pda_walk

; raised-to-face stage: entry / loop / exit (engine: the aim edge latch in PlayAnimIdle)
anm_idle_aim_start          = pda_aim_start
anm_idle_aim                = pda_aim_idle
anm_idle_aim_end            = pda_aim_end
anm_idle_aim_moving         = pda_aim_idle

; the thumb on the joystick: cursor direction quantized 8-way + click, appended to
; anm_idle_aim (engine: da_pda3d joystick + CPdaAnimatorItem::play_composed_idle)
anm_idle_aim_up             = pda_aim_idle_up
anm_idle_aim_up_right       = pda_aim_idle_right_up
anm_idle_aim_right          = pda_aim_idle_right
anm_idle_aim_down_right     = pda_aim_idle_right_down
anm_idle_aim_down           = pda_aim_idle_down
anm_idle_aim_down_left      = pda_aim_idle_left_down
anm_idle_aim_left           = pda_aim_idle_left
anm_idle_aim_up_left        = pda_aim_idle_left_up
anm_idle_aim_click          = pda_aim_click

; headlamp / night-vision acknowledgement while the device is held (engine: torch watch
; in CPdaAnimatorItem::UpdateCL; the light itself is NOT gated on the motion)
anm_headlamp                = pda_headflash
anm_headlamp_aim            = pda_aim_headflash
