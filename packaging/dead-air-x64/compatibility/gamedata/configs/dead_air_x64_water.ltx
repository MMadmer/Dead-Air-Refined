; Water impact response of the procedural puddles (engine: Environment::water_hit,
; Level_bullet_manager_firetrace.cpp, Explosive.cpp). Data here, mechanism in code:
; the material name routes the hit into the game's own bullet-x-water pair (sound,
; particles, no bullet-hole decal), the particle names are the game's own hit_fx set.

[water_impact]
; whose material pair a bullet hit in a puddle should play
material                = materials\water
; puddle mask threshold (0..1) for "this landed in water"
mask_threshold          = 0.22
; bullet ring ripple radius, metres
ring_radius_bullet      = 1.4

; explosion response
ring_radius_scale       = 0.9   ; ring reach as a share of blast_r
drain_radius_scale      = 0.55  ; dried-out spot as a share of blast_r
drain_radius_min        = 1.5
drain_radius_max        = 4.0
; depth = mask * wetness at the epicentre decides how much water there IS to throw:
; a deep puddle gives the full fountain, a shallow film only the big splash
deep_threshold          = 0.45
mid_threshold           = 0.20
ps_fountain             = amik\hit_fx\hit_water_splash_00
ps_hit_big              = hit_fx\effects\hit_water_hit_big
ps_distort_big          = hit_fx\effects\hit_water_hit_distort_big
ps_hit                  = hit_fx\effects\hit_water_hit
; Flat sprites the stock hit set lays ON the water: the white ring texture of hit_water_hit
; (pfx_water_wave, grows to metres) and the distortion discs. Each is an expanding ring with a
; lifetime - exactly what the ripple field is now - so they are skipped wherever they would
; play (a bullet's material pair, a step, a blast). The sprays around them are not listed and
; play as before. Comma-separated effect names; the skip itself is the engine's.
suppress_effects        = hit_fx\effects\hit_water_hit_distort, hit_fx\effects\hit_water_hit_distort_big, amik\hit_fx\hit_water_hit_distort, hit_fx\effects\hit_water_hit, hit_fx\effects\hit_water_hit_big

; rings from feet and bodies (step_manager.cpp, physics_game.cpp). A liquid material (open
; water: a lake, a river) counts as water for every response in this section, as does a
; puddle; only the drain is puddle-only - a lake does not dry out.
ring_radius_step        = 1.6   ; a footstep's ring, metres (the front runs ~0.9 m/s)
ring_radius_object_min  = 0.7   ; a body's ring at the threshold impact...
ring_radius_object_max  = 2.4   ; ...and at ring_object_velocity
ring_object_threshold   = 1.5   ; impact measure (speed x sqrt(mass)) below which a body makes no ring
ring_object_velocity    = 12.0  ; impact measure of the largest ring
ring_distance           = 45    ; metres from the camera past which feet and bodies skip the ring

; ============================================================================================
; Optical profiles of the water itself (engine: CEnvironment's water solver, shader:
; da_water_common.h). These are inherent optical properties, not a tint: the shader runs
; Beer-Lambert over the path the light actually crossed, so the colour SHIFTS with depth
; instead of just darkening, and the same profile reads clear in the shallows and opaque in
; the middle of the pond without anyone authoring either.
;
;   sigma_t - beam extinction per metre, linear sRGB. Red goes first in every natural water;
;             what separates a lake from a bog is how fast green and blue follow it.
;   body_r  - irradiance reflectance of the water column: what the body glows back with when
;             the sky lights it. This is the colour people think of as "the water's colour".
;   scum    - floating film coverage 0..1: duckweed, algae, peat foam. Damps the capillary
;             ripple the way an oil slick does (Cox & Munk's own "slick" fit), so a scummed
;             pool loses its glitter and goes matte.
;   fetch_max - how much open water the wind really gets to work over, metres (5..500). The
;             engine measures the fetch off the water body's footprint, and a marsh's footprint
;             is a lattice of reed islands: half a kilometre by the box, tens of metres by the
;             water. The fetch is most of what sets the wave length, so this is the key that
;             takes the slow swell off standing water.
;   wave_damp - 0..1, a factor on the slope variance of everything the wind raises: waves,
;             the detail ripple and the glitter alike. Vegetation and a dead backwater take
;             the energy out of a sea the fetch would still allow.
;
; The numbers are pure water plus CDOM at S = 0.017, tripton and particle scattering. Retune
; them freely - nothing in the engine hardcodes a profile name, the mapping below is the only
; place names are bound.
; ============================================================================================

; A mountain lake or a running stream: red is gone by a couple of metres, green and blue carry.
[water_profile_clear]
sigma_t = 0.35, 0.09, 0.15
body_r  = 0.004, 0.013, 0.012
scum    = 0.00
fetch_max = 500
wave_damp = 1.00

; The default Zone pond: mildly turbid standing water, blue already dying at a metre.
[water_profile_pond]
sigma_t = 0.30, 0.24, 0.87
body_r  = 0.018, 0.029, 0.012
scum    = 0.05
fetch_max = 300
wave_damp = 0.85

; Peat-stained marsh. CDOM eats blue outright, which is exactly why bog water reads brown.
[water_profile_swamp]
sigma_t = 0.44, 1.05, 5.24
body_r  = 0.014, 0.010, 0.003
scum    = 0.35
fetch_max = 40
wave_damp = 0.35

; A black pool: nothing comes back out of it, and the surface is all you ever see.
[water_profile_bog]
sigma_t = 0.81, 2.81, 15.3
body_r  = 0.005, 0.002, 0.001
scum    = 0.55
fetch_max = 20
wave_damp = 0.20

; Silt-laden flood water. High extinction AND high reflectance - it is bright and opaque at
; once, the way a churned-up puddle is.
[water_profile_muddy]
sigma_t = 0.53, 0.77, 2.31
body_r  = 0.065, 0.059, 0.024
scum    = 0.10
fetch_max = 300
wave_damp = 0.90

; Green standing pool: the algae both absorb outside their band and scatter back inside it.
[water_profile_algae]
sigma_t = 0.37, 0.44, 1.55
body_r  = 0.036, 0.041, 0.015
scum    = 0.50
fetch_max = 60
wave_damp = 0.45

; ============================================================================================
; Which profile each level's water reads. A level may carry two water materials at once (the
; engine keeps two profile slots and the surface's own .s script picks the slot at compile
; time), so every entry is a PAIR:
;
;   <level name> = <slot A profile>, <slot B profile>
;
; Slot A is what effects\water reads - the level's main body of water, the one that moves or at
; least drains. Slot B is what effects\waterstuden and effects\waterryaska read, and both of
; those materials mean the same thing in the level data: water that just sits there, with a lid
; of duckweed on it ("ryaska" IS duckweed). So slot B should always be the stiller, greener,
; deader of the pair - it is never the clearer one. Names are the suffix of the sections above,
; so "swamp" means [water_profile_swamp]. An unlisted level falls back to "default" below.
;
; Binding is data, not code: the engine never looks for a level by name, it only reads this
; table. An entry for a level with no liquid collision is simply never used - the water body
; is measured from the level's own geometry first - so adding levels here is free.
; ============================================================================================

[water_levels]
default                = pond, algae               ; the safe middle, and what the engine falls back to on its own

k00_marsh              = swamp, bog                ; the Great Swamp is peat water end to end, and its deep pools go black
l01_escape             = pond, algae               ; Cordon's stream; the flooded pit by the ATP has been still for years
l02_garbage            = muddy, algae              ; rain sitting in silt between the scrap heaps
l03_agroprom           = swamp, algae              ; the reed-choked river along the south edge
k01_darkscape          = pond, algae               ; the ford across the stream, and the roadside hollows behind it
l04_darkvalley         = muddy, bog                ; flooded concrete pits at the factory, no outflow from any of them
l05_bar                = muddy, algae              ; standing rainwater in the yards
l06_rostok             = muddy, bog                ; Wild Territory: whatever collects between the workshops
new_military           = pond, swamp               ; Army Warehouses: the stream by the farmstead, boggy hollows behind it
l08_yantar             = algae, swamp              ; the Yantar lake is a duckweed lid over dead water - that IS the level
l09_deadcity           = muddy, algae              ; flooded streets and cellars
l10_limansk            = pond, algae               ; the river under the bridge still runs; its backwaters do not
l10_radar              = pond, algae               ; only what the burnt ground manages to hold
l10_red_forest         = clear, swamp              ; the stream comes off the hills clean; the flats below it stagnate
l11_hospital           = muddy, bog                ; flooded basements, no daylight in them
l11_pripyat            = muddy, algae              ; city flooding, everything in it churned up
l12_stancia            = pond, algae               ; the cooling channels
l12_stancia_2          = pond, algae               ; same water, other side of the plant
l13_generators         = pond, swamp               ; hard standing with a marsh at its edge
zaton                  = swamp, algae              ; a backwater is what is left of a river: shallow, still, green
jupiter                = swamp, algae              ; the marshes west of the plant
pripyat                = muddy, algae              ; flooded pits and basements
k02_trucks_cemetery    = muddy, algae              ; rain collecting between the trucks

; The undergrounds: stagnant, lightless, nothing living in it and nothing coming back out.
l03u_agr_underground   = bog, muddy                ; the flooded tunnels
l04u_labx18            = bog, muddy
l08u_brainlab          = bog, muddy
l10u_bunker            = bog, muddy
l12u_sarcofag          = bog, muddy
l12u_control_monolith  = bog, muddy
l13u_warlab            = bog, muddy
jupiter_underground    = bog, muddy
labx8                  = bog, muddy

; fake_start is the new-game stub and carries no water; it needs no entry.

; ============================================================================================
; The actor in water (engine: PHMovementControl, Actor_Movement.cpp, step_manager.cpp,
; ActorCondition.cpp, physics_game.cpp; DESIGN2 section 4). Depths are metres of water
; standing over the FEET, read off the baked water field - so they are real depths, not
; guesses from a material flag. A level with no baked field reports no depth and everything
; here quietly falls back to the behaviour before the rework.
;
; Deliberately absent: swimming and drowning. Deep water in this game is level-design
; geometry - a barrier - and making it swimmable would let the player walk through what the
; map means as a wall. Wading is the whole of it.
; ============================================================================================

[water_actor]
; --- wading ---
ankle                   = 0.12  ; the wade state, the step splash and the dose all start here
wade_full               = 1.30  ; depth at which the slow-down bottoms out
wade_speed_min          = 0.40  ; movement scale at wade_full and past it
sprint_depth            = 0.45  ; no sprinting deeper than this
jump_depth              = 0.80  ; no jumping deeper than this

; --- the continuous disturbance under a moving foot (fed into the ripple field) ---
wake_radius             = 0.5
wake_strength           = 1.0
wake_speed_ref          = 2.5   ; speed (m/s) at which the wake reaches full strength

; --- the discrete splash a footstep throws, where the material pair cannot throw one itself ---
step_splash_depth       = 0.05
ps_step                 = hit_fx\hit_water_00

; --- breaking the surface: a jump into a pond, a body dropped into one ---
entry_speed_min         = 2.5   ; downward speed (m/s) below which nothing is spawned
entry_speed_max         = 11.0  ; downward speed of the largest entry
entry_radius_min        = 1.0
entry_radius_max        = 3.2
ps_entry                = hit_fx\effects\hit_water_splash_01
ps_entry_big            = hit_fx\effects\hit_water_splash_02

; --- landing damage: water this deep takes the whole fall, from the ankle to it it tapers ---
fall_safe_depth         = 0.55

; --- the dose an injurious liquid delivers: a depth and a motion, not a binary tick ---
rad_depth_ref           = 1.0   ; depth at which the material's own rate is reached
rad_depth_floor         = 0.20  ; share of that rate when barely in it
rad_move_bonus          = 0.50  ; extra share at rad_move_speed - stirring it up costs more
rad_move_speed          = 3.0

; --- screen droplets once the head comes back out (r2_lenswater_val -> visor_drops) ---
drops_rise              = 2.5   ; per second while the head is under
drops_fall              = 0.25  ; per second once it is out
drops_step              = 0.05  ; how far the value must move before the console is touched
