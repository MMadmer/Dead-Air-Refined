; NQ kind catalog v5 - Dead Air Refined. Encoding: cp1251 (like every other game config).
; A ';' starts a comment, so it must never appear inside a value - one in a desc
; truncates it silently and the editor shows half the text. Use a dash instead.
; Read by the game runtime (xms_nq_kinds via ini_file) and by XFined Editor (NqCatalog).
; One section per kind: [nq.<kind>]. Keys:
;   group   - group name in the editor dropdown
;   title   - what the author sees (rus)
;   desc    - one-line description (rus), also returned by MCP quest_catalog for AI
;   use     - comma list of: trigger, main, extra, cond
;   params  - ordered comma list of parameter names; each name has its own key:
;   <name>  = <type>[, required][, default=<v>][, min=<v>][, max=<v>][, enum=a|b|c]
;   pins    - main/trigger: comma list of output pins; "cases" = pins come from params.cases
;   wait    - main: waiting kind (true) or instant (false)
;   once    - main: default of node.once
;   event   - cond: true for edge-triggered event conditions (event.*)
;   impl    - core | <module id> (who registers the Lua implementation in xms.registry "nq.kinds")
;   since   - catalog version the kind appeared in
; Extensions: modules add gamedata\configs\nq\kinds\<mod>.ltx with more [nq.*] sections and
; register implementations from scripts\register.script.

[nq.catalog]
version = 9
api     = 1

; ============================================================ triggers
[nq.trigger.start]
group  = triggers
title  = Quest start
desc   = Fires once when the quest activates.
use    = trigger
params =
pins   = next
wait   = false
once   = true
impl   = core
since  = 1

[nq.trigger.when]
group  = triggers
title  = When conditions hold
desc   = Fires on the rising edge of the node conditions. repeat re-arms after they turn false, cooldown limits the rate, check_every sets the poll period. The off pin fires once per trigger when the conditions stop holding.
use    = trigger
params   = repeat, cooldown, check_every
repeat   = bool, default=false
cooldown = duration
check_every = float, default=0.25, min=0
pins   = next, off
wait   = false
once   = false
impl   = core
since  = 1

; ============================================================ main: dialog
[nq.dialog.topic]
group  = dialog
title  = Dialog: topic
desc   = Adds a talk topic to the NPC while the node token and conditions hold. next: phrases, done: a leaf phrase was said.
use    = main
params    = npc, text, initiator
npc       = npc_ref, required
text      = text, required
initiator = enum, default=actor, enum=actor|npc
pins   = next, done
wait   = true
once   = true
impl   = core
since  = 1

[nq.dialog.npc_phrase]
group  = dialog
title  = Dialog: NPC phrase
desc   = NPC line. Node conditions gate visibility, the first matching phrase is spoken.
use    = main
params = text
text   = text, required
pins   = next
wait   = false
once   = false
impl   = core
since  = 1

[nq.dialog.actor_phrase]
group  = dialog
title  = Dialog: player phrase
desc   = Player reply option. Node conditions gate visibility.
use    = main
params = text
text   = text, required
pins   = next
wait   = false
once   = false
impl   = core
since  = 1

; ============================================================ main: objectives
[nq.objective.kill]
group  = objective
title  = Kill target
desc   = Waits for the target to die: an NPC by story id, a saved ref, or a squad from spawn (created on entry, saved under ref). spot_task points the bound task marker (spot_objective: its objective) at the target. spot_done completes the bound task or objective when the node closes.
use    = main
params    = target, by_actor, spot_task, spot_objective, spot_done
target    = kill_target, required
by_actor  = bool, default=false
spot_task      = task_id
spot_objective = objective_id
spot_done      = bool, default=true
pins   = done
wait   = true
once   = false
impl   = core
since  = 1

[nq.objective.kill_count]
group  = objective
title  = Kill N targets
desc   = Counts kills from node entry until count is reached, survives saves. by_actor counts only player kills. Optional single filter: community, squad, or section.
use    = main
params    = count, by_actor, community, squad, section
count     = int, default=1, min=1
by_actor  = bool, default=true
community = community
squad     = object_ref
section   = string
pins   = done
wait   = true
once   = false
impl   = core
since  = 2

[nq.objective.fetch]
group  = objective
title  = Fetch items
desc   = Waits until the player holds the items. items rows: a section with a count, or one concrete object (ref or story id), mixed freely. section+count is the one-row shorthand. from credits only items taken from that container. spawn creates the loot on entry and credits only those instances. spot_task (spot_objective: its objective) points the bound marker at the nearest pending source. spot_done completes the bound task or objective on close. count is in items (ammo: boxes).
use    = main
params    = section, count, items, from, spawn, spot_task, spot_objective, spot_done
section   = item_section
count     = int, default=1, min=1
items     = item_list
from      = object_ref
spawn     = loot_spawn
spot_task      = task_id
spot_objective = objective_id
spot_done      = bool, default=true
pins   = done
wait   = true
once   = false
impl   = core
since  = 1

[nq.objective.reach]
group  = objective
title  = Reach location
desc   = Waits until the player is inside the place: a point with radius, a restrictor, a smart, or a ref created by this quest. spot_task (spot_objective: its objective) points the bound marker. spot_done completes it on close.
use    = main
params    = place, spot_task, spot_objective, spot_done
place     = place, required
spot_task      = task_id
spot_objective = objective_id
spot_done      = bool, default=true
pins   = done
wait   = true
once   = false
impl   = core
since  = 1

