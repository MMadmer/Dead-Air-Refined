-- Menu cursor speed as a multiplier of the desktop pointer, which is what the engine moves it
-- at. Offered as steps rather than a slider because the options list only builds check boxes
-- and combo boxes; the value itself lives in the ui_cursor_sens console variable, so there is
-- one source of truth and it persists in user.ltx like every other sensitivity.
local CURSOR_SENS_STEPS = { "0.50", "0.75", "1.00", "1.25", "1.50", "2.00" }

-- Where the dialog window stands (dar_dialog_position: 0 left, 1 as the layout has it - the middle -, 2 right). The
-- combo box shows the captions; its item ids are the values.
local DIALOG_POSITIONS = { "ui_mm_dialog_position_left", "ui_mm_dialog_position_center", "ui_mm_dialog_position_right" }

local function nearest_cursor_step(value)
	local best, best_diff = "1.00", nil
	for _, step in ipairs(CURSOR_SENS_STEPS) do
		local diff = math.abs(tonumber(step) - value)
		if (not best_diff) or (diff < best_diff) then
			best, best_diff = step, diff
		end
	end
	return best
end

local function on_init(menu)
	menu.gameplay_options["infinite_bolts"] = {typ="check"}
	menu.gameplay_options["pause_in_background"] = {typ="check"}
	menu.gameplay_options["crosshair_dot"] = {typ="check"}
	-- The same switch the major-release notice offers. It covers ONLY that notice: updates
	-- inside the installed major line are always checked. Caption: ui_mm_major_update_notice.
	menu.gameplay_options["major_update_notice"] = {typ="check"}
	-- Show the inventory the moment the key is pressed instead of when the backpack scene has
	-- finished. The scene still plays behind the window. Caption: ui_mm_instant_inventory.
	menu.gameplay_options["instant_inventory"] = {typ="check"}
	-- The community icons of the main menu and the pause menu (dar_community_links). Caption:
	-- ui_mm_community_links.
	menu.gameplay_options["community_links"] = {typ="check"}
	-- Where a hit came from, round the crosshair (dar_damage_indicator). Caption: ui_mm_damage_indicator.
	menu.gameplay_options["damage_indicator"] = {typ="check"}
	-- The debug menu (dar_debug_menu): its key (Options -> Controls) opens it in the game. Caption: ui_mm_debug_menu.
	menu.gameplay_options["debug_menu"] = {typ="check"}
	-- The main and the accent colour of the game's windows: a window of its own (dar_ui_colors). Caption:
	-- ui_mm_interface_colors.
	menu.gameplay_options["interface_colors"] = {typ="button", button="st_da_colors_open",
		on_click=function() get_console():execute("dar_ui_colors") end}
	menu.gameplay_options["cursor_sens"] = {typ="list", list=CURSOR_SENS_STEPS}
	local positions = {}
	for i, id in ipairs(DIALOG_POSITIONS) do
		positions[i] = game.translate_string(id)
	end
	menu.gameplay_options["dialog_position"] = {typ="list", list=positions}
end

local function on_set_values(menu, opt_manager)
	local console = get_console()
	local infinite_bolts = menu.gameplay_options["infinite_bolts"]
	if (infinite_bolts and infinite_bolts.ctrl) then
		infinite_bolts.ctrl:SetCheck(console:get_bool("g_infinite_bolts"))
	end

	local pause_in_background = menu.gameplay_options["pause_in_background"]
	if (pause_in_background and pause_in_background.ctrl) then
		pause_in_background.ctrl:SetCheck(console:get_bool("g_pause_in_background"))
	end

	local crosshair_dot = menu.gameplay_options["crosshair_dot"]
	if (crosshair_dot and crosshair_dot.ctrl) then
		crosshair_dot.ctrl:SetCheck(console:get_bool("hud_crosshair_dot"))
	end

	local major_update_notice = menu.gameplay_options["major_update_notice"]
	if (major_update_notice and major_update_notice.ctrl) then
		major_update_notice.ctrl:SetCheck(console:get_bool("dar_major_update_notice"))
	end

	local instant_inventory = menu.gameplay_options["instant_inventory"]
	if (instant_inventory and instant_inventory.ctrl) then
		instant_inventory.ctrl:SetCheck(console:get_bool("dar_instant_inventory"))
	end

	local community_links = menu.gameplay_options["community_links"]
	if (community_links and community_links.ctrl) then
		community_links.ctrl:SetCheck(console:get_bool("dar_community_links"))
	end

	local damage_indicator = menu.gameplay_options["damage_indicator"]
	if (damage_indicator and damage_indicator.ctrl) then
		damage_indicator.ctrl:SetCheck(console:get_bool("dar_damage_indicator"))
	end

	local debug_menu = menu.gameplay_options["debug_menu"]
	if (debug_menu and debug_menu.ctrl) then
		debug_menu.ctrl:SetCheck(console:get_bool("dar_debug_menu"))
	end

	local cursor_sens = menu.gameplay_options["cursor_sens"]
	if (cursor_sens and cursor_sens.ctrl) then
		cursor_sens.ctrl:SetText(nearest_cursor_step(console:get_float("ui_cursor_sens")))
	end

	local dialog_position = menu.gameplay_options["dialog_position"]
	if (dialog_position and dialog_position.ctrl) then
		local id = DIALOG_POSITIONS[console:get_integer("dar_dialog_position") + 1] or DIALOG_POSITIONS[2]
		dialog_position.ctrl:SetText(game.translate_string(id))
	end
end

local function on_accept(menu, opt_manager, console)
	local infinite_bolts = menu.gameplay_options["infinite_bolts"]
	if (infinite_bolts and infinite_bolts.ctrl) then
		console:execute("g_infinite_bolts " .. (infinite_bolts.ctrl:GetCheck() and "1" or "0"))
	end

	local pause_in_background = menu.gameplay_options["pause_in_background"]
	if (pause_in_background and pause_in_background.ctrl) then
		console:execute("g_pause_in_background " .. (pause_in_background.ctrl:GetCheck() and "1" or "0"))
	end

	local crosshair_dot = menu.gameplay_options["crosshair_dot"]
	if (crosshair_dot and crosshair_dot.ctrl) then
		console:execute("hud_crosshair_dot " .. (crosshair_dot.ctrl:GetCheck() and "1" or "0"))
	end

	local major_update_notice = menu.gameplay_options["major_update_notice"]
	if (major_update_notice and major_update_notice.ctrl) then
		console:execute("dar_major_update_notice " .. (major_update_notice.ctrl:GetCheck() and "1" or "0"))
	end

	local instant_inventory = menu.gameplay_options["instant_inventory"]
	if (instant_inventory and instant_inventory.ctrl) then
		console:execute("dar_instant_inventory " .. (instant_inventory.ctrl:GetCheck() and "1" or "0"))
	end

	local community_links = menu.gameplay_options["community_links"]
	if (community_links and community_links.ctrl) then
		console:execute("dar_community_links " .. (community_links.ctrl:GetCheck() and "1" or "0"))
	end

	local damage_indicator = menu.gameplay_options["damage_indicator"]
	if (damage_indicator and damage_indicator.ctrl) then
		console:execute("dar_damage_indicator " .. (damage_indicator.ctrl:GetCheck() and "1" or "0"))
	end

	local debug_menu = menu.gameplay_options["debug_menu"]
	if (debug_menu and debug_menu.ctrl) then
		console:execute("dar_debug_menu " .. (debug_menu.ctrl:GetCheck() and "1" or "0"))
	end

	local cursor_sens = menu.gameplay_options["cursor_sens"]
	if (cursor_sens and cursor_sens.ctrl) then
		console:execute("ui_cursor_sens " .. cursor_sens.ctrl:GetText())
	end

	local dialog_position = menu.gameplay_options["dialog_position"]
	if (dialog_position and dialog_position.ctrl) then
		local text = dialog_position.ctrl:GetText()
		for i, id in ipairs(DIALOG_POSITIONS) do
			if (game.translate_string(id) == text) then
				console:execute("dar_dialog_position " .. tostring(i - 1))
			end
		end
	end
end

RegisterScriptCallback("opt_menu_on_init", on_init)
RegisterScriptCallback("opt_menu_on_set_values", on_set_values)
RegisterScriptCallback("opt_menu_on_accept", on_accept)
