class "opt_video" (CUIWindow)

function opt_video:__init() super()
end

function opt_video:__finalize()

end

local function set_static_argb(control, color)
	local alpha = math.floor(color / 0x1000000) % 0x100
	local red = math.floor(color / 0x10000) % 0x100
	local green = math.floor(color / 0x100) % 0x100
	local blue = color % 0x100
	control:SetTextColor(alpha, red, green, blue)
end

function opt_video:InitControls(x, y, xml, handler)

	self:SetWndPos(vector2():set(x,y))
	self:SetWndSize(vector2():set(738,416))
	self:SetAutoDelete(true)

--	self.bk = xml:InitFrame			("frame", self)

	xml:InitStatic					("tab_video:cap_window_mode",		self)
	xml:InitComboBox				("tab_video:list_window_mode",		self)
	handler.level_texture_unload_caption = xml:InitStatic(
		"tab_video:cap_level_texture_unload", self)
	handler.level_texture_unload_check = xml:InitCheck(
		"tab_video:check_level_texture_unload", self)
	handler.level_texture_unload_caption_color =
		handler.level_texture_unload_caption:GetTextColor()

	xml:InitStatic					("tab_video:cap_brightness",		self)
	xml:InitTrackBar				("tab_video:track_brightness",		self)

	xml:InitStatic					("tab_video:cap_contrast",			self)
	xml:InitTrackBar				("tab_video:track_contrast",		self)

	xml:InitStatic("tab_video:cap_fov",self)
	self.fov_value = xml:InitStatic("tab_video:cap_fov_value",self)
	self.fov_track = xml:InitTrackBar("tab_video:track_fov",self)
	
	xml:InitStatic("tab_video:cap_hud_fov",self)
	self.hud_fov_value = xml:InitStatic("tab_video:cap_hud_fov_value",self)
	self.hud_fov_track = xml:InitTrackBar("tab_video:track_hud_fov",self)
	
	xml:InitStatic("tab_video:cap_color_correction",self)
	
	xml:InitStatic("tab_video:cap_color_r",self)
	self.color_r_val = xml:InitStatic("tab_video:cap_color_r_val",self)
	self.color_r_track = xml:InitTrackBar("tab_video:track_color_r",self)
	
	xml:InitStatic("tab_video:cap_color_g",self)
	self.color_g_val = xml:InitStatic("tab_video:cap_color_g_val",self)
	self.color_g_track = xml:InitTrackBar("tab_video:track_color_g",self)
	
	xml:InitStatic("tab_video:cap_color_b",self)
	self.color_b_val = xml:InitStatic("tab_video:cap_color_b_val",self)
	self.color_b_track = xml:InitTrackBar("tab_video:track_color_b",self)
	
	xml:InitStatic("tab_video:cap_vibrance", self)
	self.vibrance_val = xml:InitStatic("tab_video:cap_vibrance_val",self)
	self.vibrance_track = xml:InitTrackBar("tab_video:track_vibrance_val", self)
	
	xml:InitStatic					("tab_video:cap_gamma",				self)
	xml:InitTrackBar				("tab_video:track_gamma",			self)

	xml:InitStatic					("tab_video:cap_resolution",		self)
	xml:InitComboBox				("tab_video:list_resolution",		self)

	xml:InitStatic					("tab_video:cap_fps_limit",			self)
	xml:InitComboBox				("tab_video:list_fps_limit",		self)

	xml:InitStatic					("tab_video:cap_vsync",				self)
	xml:InitCheck					("tab_video:check_vsync",			self)

	xml:InitStatic					("tab_video:cap_preset",			self)
	handler.combo_preset			= xml:InitComboBox("tab_video:list_presets",	self)
	handler:Register				(handler.combo_preset,				"combo_preset")

	xml:InitStatic					("tab_video:cap_renderer",			self)
	handler.combo_renderer			= xml:InitComboBox("tab_video:list_renderer",		self)
	handler:Register				(handler.combo_renderer, "combo_renderer")

	btn		= xml:Init3tButton		("tab_video:btn_advanced",	self)
	handler:Register				(btn, "btn_advanced_graphic")

	function handler:UpdateLevelTextureUnloadState()
		-- Renderer IDs 2-5 are D3D11 profiles; ID 6 is the OpenGL backend.
		local level_unload_supported = self.combo_renderer:CurrentID() ~= 6
			and level_texture_unload_supported ~= nil
			and level_texture_unload_supported()

		-- A pending renderer selection takes precedence over the active backend.
		if self.combo_renderer:CurrentID() >= 2
			and self.combo_renderer:CurrentID() <= 5 then
			level_unload_supported = true
		end

		self.level_texture_unload_check:Enable(level_unload_supported)
		if level_unload_supported then
			set_static_argb(
				self.level_texture_unload_caption,
				self.level_texture_unload_caption_color)
		else
			self.level_texture_unload_caption:SetTextColor(255, 70, 70, 70)
		end
	end

	local update_depend_controls = handler.UpdateDependControls
	function handler:UpdateDependControls()
		update_depend_controls(self)
		self:UpdateLevelTextureUnloadState()
	end

	handler:UpdateLevelTextureUnloadState()
end
