--
-- What the debug menu lists and does (docs/dead-air/DEBUG_MENU.md). The window (UIDebugMenuWnd.cpp) asks:
--   tabs()                                  -> { { id, caption }, ... }
--   build(tab)                              -> { all = bool, categories = { caption, ... }, entries = { { key, name, sec,
--                                               badge, note, cat }, ... } }
--   describe(tab, key)                      -> { title, sub, body, icon = <item section>, choice = { a, b },
--                                               choice_default, count = { min, max, default }, primary, second, third }
--   act(tab, key, button, count, choice)    -> { msg, rebuild, close } or the message alone
-- Captions are string ids (st_dbg_*) or text in the UI code page. A mod adds a tab with add_tab(id, caption, provider)
-- where provider has build, describe and act of its own.

local ini = system_ini()
local providers = {}
local order = {}

function add_tab(id, caption, provider)
	if not providers[id] then
		order[#order + 1] = id
	end
	providers[id] = provider
	provider.caption = caption
end

local function tr(id)
	local text = game.translate_string(id)
	return text ~= "" and text or id
end

local function fmt(id, ...)
	return string.format(tr(id), ...)
end

local function r_string(sec, key)
	if ini:line_exist(sec, key) then
		return ini:r_string(sec, key) or ""
	end
	return ""
end

local function r_float(sec, key, def)
	if ini:line_exist(sec, key) then
		return tonumber(ini:r_string(sec, key)) or def
	end
	return def
end

-- the point a step or two in front of the actor on the ground, with its level and game vertices
local function in_front(distance)
	local dir = vector():set(device().cam_dir)
	dir.y = 0
	if dir:magnitude() < 0.01 then
		dir = vector():set(0, 0, 1)
	end
	dir:normalize()
	local lvid = level.vertex_in_direction(db.actor:level_vertex_id(), dir, distance)
	local pos = level.vertex_position(lvid)
	if lvid == db.actor:level_vertex_id() then
		pos = vector():set(db.actor:position()):add(vector():set(dir):mul(distance))
	end
	return pos, lvid, db.actor:game_vertex_id()
end

-- ---- items -----------------------------------------------------------------------------------------------------------
local item_cats = { "st_dbg_cat_weapons", "st_dbg_cat_ammo", "st_dbg_cat_outfits", "st_dbg_cat_helmets",
	"st_dbg_cat_artefacts", "st_dbg_cat_medicine", "st_dbg_cat_food", "st_dbg_cat_devices", "st_dbg_cat_quest",
	"st_dbg_cat_other" }

local function item_category(sec, class)
	if ini:line_exist(sec, "quest_item") and ini:r_bool(sec, "quest_item") then return 9 end
	if string.find(class, "^AMMO") or string.find(class, "^S_AMMO") or class == "S_OG7B" or class == "S_VOG25" or class == "S_M209" then return 2 end
	if string.find(class, "^WP_") or string.find(class, "^G_") or class == "W_BINOC" or class == "II_BOLT" then return 1 end
	if class == "E_HLMET" or class == "EQ_HLMET" or class == "E_HELMET" then return 4 end
	if string.find(class, "STLK") or class == "E_STLK" or class == "EQU_STLK" then return 3 end
	if string.find(class, "^ART") or class == "SCRPTART" or string.find(class, "ARTEF") then return 5 end
	if class == "II_MEDKI" or class == "II_BANDG" or class == "II_ANTIR" or class == "S_MEDKI" or class == "S_BANDG" or class == "S_ANTIR" then return 6 end
	if class == "II_FOOD" or class == "S_FOOD" or class == "II_BOTTL" or class == "S_BOTTL" then return 7 end
	if string.find(class, "^DET") or string.find(class, "^D_") or class == "TORCH_S" or class == "TORCH" or class == "II_DOC" then return 8 end
	return 10
end

local items
local function build_items()
	if items then return items end
	items = { entries = {}, by_key = {} }
	ini:section_for_each(function(sec)
		local class = r_string(sec, "class")
		local inv_name = r_string(sec, "inv_name")
		if class ~= "" and inv_name ~= "" and inv_name ~= "default" and ini:line_exist(sec, "visual")
			and r_float(sec, "inv_grid_width", 0) > 0 and r_float(sec, "inv_grid_height", 0) > 0
			and not string.find(sec, "^mp_") and not string.find(sec, "_hud$") then
			local cost = r_float(sec, "cost", 0)
			local e = { key = sec, name = tr(inv_name), sec = sec, cat = item_category(sec, class),
				note = cost > 0 and fmt("st_dbg_note_cost", cost) or "" }
			items.entries[#items.entries + 1] = e
			items.by_key[sec] = e
		end
	end)
	table.sort(items.entries, function(a, b)
		if a.cat ~= b.cat then return a.cat < b.cat end
		return a.name < b.name
	end)
	return items
end

add_tab("items", "st_dbg_tab_items", {
	build = function()
		return { categories = item_cats, entries = build_items().entries }
	end,
	describe = function(key)
		local e = build_items().by_key[key]
		local body = {}
		local desc = r_string(key, "description")
		if desc ~= "" then body[#body + 1] = tr(desc) end
		local params = {}
		params[#params + 1] = fmt("st_dbg_param_weight", r_float(key, "inv_weight", 0))
		params[#params + 1] = fmt("st_dbg_param_cost", r_float(key, "cost", 0))
		if e and e.cat == 2 then params[#params + 1] = fmt("st_dbg_param_box", r_float(key, "box_size", 1)) end
		if e and e.cat == 1 and ini:line_exist(key, "ammo_class") then
			params[#params + 1] = tr("st_dbg_param_ammo") .. " " .. r_string(key, "ammo_class")
		end
		body[#body + 1] = table.concat(params, "\\n")
		return { title = e and e.name or key, sub = key, body = table.concat(body, "\\n \\n"), icon = key,
			choice = { "st_dbg_into_inventory", "st_dbg_in_front" }, count = { min = 1, max = 500, default = 1 },
			primary = "st_dbg_spawn" }
	end,
	act = function(key, button, count, choice)
		local e = build_items().by_key[key]
		local ammo = e and e.cat == 2
		local made = 0
		if choice == 1 then
			if ammo then
				-- whole boxes: create_ammo splits a count over boxes of box_size
				local box = math.max(math.floor(r_float(key, "box_size", 1)), 1)
				for _ = 1, count do
					alife():create_ammo(key, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id(), box)
					made = made + 1
				end
			else
				for _ = 1, count do
					if alife():create(key, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id()) then
						made = made + 1
					end
				end
			end
		else
			local pos, lvid, gvid = in_front(1.6)
			pos.y = pos.y + 0.4
			for i = 1, count do
				local p = vector():set(pos.x + math.random() * 0.4 - 0.2, pos.y + 0.05 * i, pos.z + math.random() * 0.4 - 0.2)
				local ok
				if ammo then
					ok = alife():create_ammo(key, p, lvid, gvid, 65535, math.max(math.floor(r_float(key, "box_size", 1)), 1))
				else
					ok = alife():create(key, p, lvid, gvid)
				end
				if ok then made = made + 1 end
			end
		end
		return fmt("st_dbg_spawned_fmt", made)
	end,
})

-- ---- characters ------------------------------------------------------------------------------------------------------
local npcs
local function faction_name(f)
	local id = "st_faction_" .. f
	local text = game.translate_string(id)
	if text ~= id and text ~= "" then return text end
	return tr(f)
end

local function build_npcs()
	if npcs then return npcs end
	npcs = { entries = {}, by_key = {}, cats = {}, cat_of = {} }
	local function cat_of(f)
		if not npcs.cat_of[f] then
			npcs.cats[#npcs.cats + 1] = string.find(f, "^monster") and "st_dbg_cat_mutants" or faction_name(f)
			npcs.cat_of[f] = #npcs.cats
		end
		return npcs.cat_of[f]
	end
	-- the mutants share one category
	local function key_faction(f)
		return string.find(f, "^monster") and "monster" or f
	end
	ini:section_for_each(function(sec)
		if sec ~= "online_offline_group" and ini:line_exist(sec, "faction")
			and (ini:line_exist(sec, "npc_random") or ini:line_exist(sec, "npc")) then
			local f = r_string(sec, "faction")
			local members = r_string(sec, "npc_in_squad")
			local list = r_string(sec, "npc_random") ~= "" and r_string(sec, "npc_random") or r_string(sec, "npc")
			local first = string.match(list, "^%s*([^,%s]+)") or ""
			local name
			if string.find(f, "^monster") then
				local inv = r_string(first, "inv_name")
				local kind = string.match(sec, "^simulation_(.+)$") or first
				name = inv ~= "" and tr(inv) or tr("st_dbg_squad_of") .. " " .. string.gsub(kind, "_", " ")
			else
				name = faction_name(f)
				for _, rank in ipairs({ "novice", "advanced", "experienced", "veteran", "expert", "master", "elite" }) do
					if string.find(sec, rank, 1, true) then
						name = name .. ", " .. tr("st_dbg_rank_" .. rank)
						break
					end
				end
			end
			local sim = string.find(sec, "sim_squad", 1, true) or string.find(sec, "^simulation_")
			local e = { key = sec, name = name, sec = sec, cat = cat_of(key_faction(f)), sim = sim and 0 or 1,
				note = members ~= "" and fmt("st_dbg_note_members", string.gsub(members, "%s", "")) or "",
				first = first, faction = f }
			npcs.entries[#npcs.entries + 1] = e
			npcs.by_key[sec] = e
		end
	end)
	-- the simulation's own squads first in their faction, the story's after them
	table.sort(npcs.entries, function(a, b)
		if a.cat ~= b.cat then return a.cat < b.cat end
		if a.sim ~= b.sim then return a.sim < b.sim end
		return a.sec < b.sec
	end)
	return npcs
end

-- A squad at the point: its members come online beside the actor (the switch distance takes them in at once).
local function spawn_squad(section, pos, lvid, gvid)
	local sim = alife()
	local squad = sim:create(section, pos, lvid, gvid)
	if not squad then return 0 end
	squad:create_npc(nil, pos, lvid, gvid)
	local n = 0
	for k in squad:squad_members() do
		local se_obj = k.object or (k.id and sim:object(k.id))
		if se_obj then
			SIMBOARD:setup_squad_and_group(se_obj)
			n = n + 1
		end
	end
	return n
end

add_tab("npc", "st_dbg_tab_npc", {
	build = function()
		local t = build_npcs()
		return { categories = t.cats, entries = t.entries }
	end,
	describe = function(key)
		local e = build_npcs().by_key[key]
		local body = {}
		if e then
			body[#body + 1] = tr("st_dbg_param_faction") .. " " .. faction_name(e.faction)
			body[#body + 1] = tr("st_dbg_param_members") .. " " .. (r_string(key, "npc_random") ~= "" and r_string(key, "npc_random") or r_string(key, "npc"))
		end
		return { title = e and e.name or key, sub = key, body = table.concat(body, "\\n"),
			count = { min = 1, max = 10, default = 1 }, primary = "st_dbg_spawn_in_front", second = "st_dbg_spawn_here" }
	end,
	act = function(key, button, count, choice)
		local made = 0
		for i = 1, count do
			local pos, lvid, gvid
			if button == "second" then
				pos, lvid, gvid = db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id()
			else
				pos, lvid, gvid = in_front(6 + 2 * (i - 1))
			end
			made = made + spawn_squad(key, pos, lvid, gvid)
		end
		return fmt("st_dbg_spawned_npc_fmt", made)
	end,
})

-- ---- teleport --------------------------------------------------------------------------------------------------------
local points
local function smart_title(se)
	local ok, name = pcall(function() return smart_names.get_smart_terrain_name(se) end)
	if ok and name and name ~= "" then return name end
	local id = "st_" .. se:name() .. "_name"
	local text = game.translate_string(id)
	if text ~= id and text ~= "" then return text end
	return se:name()
end

local function build_points()
	if points then return points end
	points = { entries = {}, by_key = {}, cats = {}, cat_of = {} }
	local gg = game_graph()
	local function level_of(gvid)
		if not gvid or not gg:valid_vertex_id(gvid) then return nil end
		return alife():level_name(gg:vertex(gvid):level_id())
	end
	local function cat_of(lname)
		if not points.cat_of[lname] then
			points.cats[#points.cats + 1] = tr(lname)
			points.cat_of[lname] = #points.cats
		end
		return points.cat_of[lname]
	end
	-- the levels in the order of the map list, the current one first
	cat_of(level.name())
	local maps = "level_maps_single"
	local gini = game_ini()
	if gini:section_exist(maps) then
		for i = 0, gini:line_count(maps) - 1 do
			local _, lname = gini:r_line(maps, i, "", "")
			if lname ~= "fake_start" then cat_of(lname) end
		end
	end
	local function add(key, name, sec, lname, pos, lvid, gvid, note)
		local e = { key = key, name = name, sec = sec, cat = cat_of(lname), pos = pos, lvid = lvid, gvid = gvid, level = lname,
			note = note or "" }
		points.entries[#points.entries + 1] = e
		points.by_key[key] = e
	end
	for id, smart in pairs(SIMBOARD and SIMBOARD.smarts or {}) do
		local se = smart.smrt
		if se then
			local lname = level_of(se.m_game_vertex_id)
			if lname then
				add("smart:" .. se:name(), smart_title(se), se:name(), lname, vector():set(se.position), se.m_level_vertex_id,
					se.m_game_vertex_id, tr("st_dbg_note_smart"))
			end
		end
	end
	alife():iterate_objects(function(se)
		if se:clsid() == clsid.level_changer_s then
			local lname = level_of(se.m_game_vertex_id)
			if lname then
				add("lc:" .. se.id, fmt("st_dbg_transition_fmt", tr(se:name())), se:name(), lname, vector():set(se.position),
					se.m_level_vertex_id, se.m_game_vertex_id, tr("st_dbg_note_transition"))
			end
		end
		return false
	end)
	table.sort(points.entries, function(a, b)
		if a.cat ~= b.cat then return a.cat < b.cat end
		return a.name < b.name
	end)
	return points
end

add_tab("teleport", "st_dbg_tab_teleport", {
	build = function()
		local t = build_points()
		return { all = false, categories = t.cats, entries = t.entries }
	end,
	describe = function(key)
		local e = build_points().by_key[key]
		if not e then return {} end
		local here = e.level == level.name()
		return { title = e.name, sub = e.sec, primary = "st_dbg_teleport",
			body = tr(e.level) .. "\\n" .. string.format("%.1f, %.1f, %.1f", e.pos.x, e.pos.y, e.pos.z) .. "\\n \\n" ..
				tr(here and "st_dbg_teleport_here_level" or "st_dbg_teleport_other_level") }
	end,
	act = function(key)
		local e = build_points().by_key[key]
		if not e then return "" end
		if db.actor:get_current_holder() then
			db.actor:detach_vehicle()
		end
		if e.level == level.name() then
			db.actor:set_actor_position(e.pos)
			return { msg = "st_dbg_teleported", close = true }
		end
		ChangeLevel(e.pos, e.lvid, e.gvid, vector():set(0, 0, 0))
		return { msg = "st_dbg_teleported", close = true }
	end,
})

-- ---- the player ------------------------------------------------------------------------------------------------------
local console = get_console()
local function toggle(cmd)
	return { get = function() return console:get_bool(cmd) end,
		set = function(on) console:execute(cmd .. " " .. (on and "1" or "0")) end }
end

local player = {
	{ key = "god", cat = 1, name = "st_dbg_p_god", sec = "g_god", sw = toggle("g_god") },
	{ key = "ammo", cat = 1, name = "st_dbg_p_ammo", sec = "g_unlimitedammo", sw = toggle("g_unlimitedammo") },
	{ key = "ignore", cat = 1, name = "st_dbg_p_ignore", sec = "ai_ignore_actor", sw = toggle("ai_ignore_actor") },
	{ key = "noclip", cat = 1, name = "st_dbg_p_noclip", sec = "g_no_clip", sw = {
		get = function() return console:get_bool("g_no_clip") end,
		set = function(on) console:execute("g_no_clip " .. (on and "1" or "0")) end } },
	{ key = "heal", cat = 2, name = "st_dbg_p_heal", sec = "heal" },
	{ key = "money", cat = 3, name = "st_dbg_p_money", sec = "money", count = { min = 1, max = 1000000, default = 10000 } },
	{ key = "weight", cat = 4, name = "st_dbg_p_weight", sec = "max_weight", count = { min = 10, max = 10000, default = 200 } },
}
local player_by_key = {}
for _, p in ipairs(player) do player_by_key[p.key] = p end

add_tab("player", "st_dbg_tab_player", {
	build = function()
		local entries = {}
		for _, p in ipairs(player) do
			local badge = ""
			if p.sw then
				local ok, on = pcall(p.sw.get)
				badge = (ok and on) and "st_dbg_on" or "st_dbg_off"
			elseif p.key == "money" then
				badge = tostring(db.actor:money())
			end
			entries[#entries + 1] = { key = p.key, name = p.name, sec = p.sec, cat = p.cat, badge = badge }
		end
		return { categories = { "st_dbg_cat_modes", "st_dbg_cat_state", "st_dbg_cat_money", "st_dbg_cat_body" }, entries = entries }
	end,
	describe = function(key)
		local p = player_by_key[key]
		if not p then return {} end
		local card = { title = p.name, sub = p.sec, body = "st_dbg_p_" .. key .. "_hint" }
		if p.sw then
			local ok, on = pcall(p.sw.get)
			card.primary = (ok and on) and "st_dbg_turn_off" or "st_dbg_turn_on"
		elseif key == "heal" then
			card.primary = "st_dbg_apply"
		elseif key == "money" then
			card.count, card.primary, card.second = p.count, "st_dbg_give", "st_dbg_take"
		elseif key == "weight" then
			card.count, card.primary = p.count, "st_dbg_set"
		end
		return card
	end,
	act = function(key, button, count)
		local p = player_by_key[key]
		if not p then return "" end
		if p.sw then
			local ok, on = pcall(p.sw.get)
			p.sw.set(not (ok and on))
		elseif key == "heal" then
			db.actor:set_health_ex(1)
			db.actor.power = 1
			db.actor.radiation = -1
			db.actor.bleeding = -1
			db.actor.psy_health = 1
			return { msg = "st_dbg_healed", rebuild = true }
		elseif key == "money" then
			if button == "second" then
				db.actor:give_money(-math.min(count, db.actor:money()))
			else
				db.actor:give_money(count)
			end
		elseif key == "weight" then
			db.actor:set_actor_max_weight(count)
			db.actor:set_actor_max_walk_weight(count)
		end
		return { msg = "st_dbg_done", rebuild = true }
	end,
})

-- ---- the world -------------------------------------------------------------------------------------------------------
local world
local months = { "january", "february", "march", "april", "may", "june", "july", "august", "september", "october",
	"november", "december" }

local function build_world()
	if world then return world end
	world = { entries = {}, by_key = {} }
	local function add(e)
		world.entries[#world.entries + 1] = e
		world.by_key[e.key] = e
	end
	for h = 0, 23 do
		add({ key = "time:" .. h, cat = 1, name = string.format("%02d:00", h), sec = "time " .. h, hour = h })
	end
	local files = getFS():file_list_open("$game_weathers$", 1)
	if files then
		local names = {}
		for i = 0, files:Size() - 1 do
			local f = files:GetAt(i)
			names[#names + 1] = string.gsub(f, "%.ltx$", "")
		end
		table.sort(names)
		for _, w in ipairs(names) do
			add({ key = "weather:" .. w, cat = 2, name = w, sec = w, weather = w })
		end
	end
	add({ key = "climate", cat = 2, name = "st_dbg_w_climate", sec = "climate" })
	add({ key = "surge", cat = 3, name = "st_dbg_w_surge", sec = "surge_manager" })
	add({ key = "surge_stop", cat = 3, name = "st_dbg_w_surge_stop", sec = "surge_manager" })
	add({ key = "psi", cat = 3, name = "st_dbg_w_psi", sec = "psi_storm_manager" })
	add({ key = "psi_stop", cat = 3, name = "st_dbg_w_psi_stop", sec = "psi_storm_manager" })
	add({ key = "season:calendar", cat = 4, name = "st_dbg_w_calendar", sec = "r__season calendar", season = "calendar" })
	for i, m in ipairs(months) do
		add({ key = "season:" .. m, cat = 4, name = "st_dbg_month_" .. i, sec = "r__season " .. m, season = m })
	end
	for _, k in ipairs({ 1, 5, 10, 20, 50, 100 }) do
		add({ key = "speed:" .. k, cat = 5, name = "x" .. k, sec = "time_factor " .. k, speed = k })
	end
	return world
end

add_tab("world", "st_dbg_tab_world", {
	build = function()
		local t = build_world()
		local now = level.get_time_hours()
		for _, e in ipairs(t.entries) do
			e.badge = (e.hour == now and "st_dbg_now") or (e.speed and math.abs(level.get_time_factor() - e.speed) < 0.5 and "st_dbg_now")
				or (e.weather and e.weather == level.get_weather() and "st_dbg_now") or ""
		end
		return { categories = { "st_dbg_cat_time", "st_dbg_cat_weather", "st_dbg_cat_events", "st_dbg_cat_season",
			"st_dbg_cat_speed" }, entries = t.entries }
	end,
	describe = function(key)
		local e = build_world().by_key[key]
		if not e then return {} end
		local card = { title = e.name, sub = e.sec, primary = "st_dbg_apply" }
		if e.weather then card.body = "st_dbg_w_weather_hint" end
		if key == "climate" then card.body = "st_dbg_w_climate_hint" end
		if e.hour then card.body = "st_dbg_w_time_hint" end
		return card
	end,
	act = function(key)
		local e = build_world().by_key[key]
		if not e then return "" end
		if e.hour then
			local h, m = level.get_time_hours(), level.get_time_minutes()
			local delta = ((e.hour - h) * 60 - m + 24 * 60) % (24 * 60)
			if delta > 0 then
				level.change_game_time(0, math.floor(delta / 60), delta % 60)
			end
			pcall(function() level_weathers.get_weather_manager():forced_weather_change() end)
		elseif e.weather then
			pcall(function() level.climate_set_sky_driven(false) end)
			level.set_weather(e.weather, true)
		elseif key == "climate" then
			pcall(function() level.climate_set_sky_driven(true) end)
		elseif key == "surge" then
			surge_manager.start_surge()
		elseif key == "surge_stop" then
			surge_manager.stop_surge()
		elseif key == "psi" then
			psi_storm_manager.get_psi_storm_manager():start(true)
		elseif key == "psi_stop" then
			psi_storm_manager.get_psi_storm_manager():finish(true)
		elseif e.season then
			console:execute("r__season " .. e.season)
		elseif e.speed then
			level.set_time_factor(e.speed)
		end
		return { msg = "st_dbg_done", rebuild = true }
	end,
})

-- ---- the story -------------------------------------------------------------------------------------------------------
local infos
local function build_infos()
	if infos then return infos end
	infos = { entries = {}, by_key = {}, cats = {}, cat_of = {} }
	local function add(id, cat)
		if infos.by_key[id] then return end
		local e = { key = id, name = id, sec = id, cat = cat }
		infos.entries[#infos.entries + 1] = e
		infos.by_key[id] = e
	end
	-- the declared ones, a category per file of [info_portions]
	local files = ini:section_exist("info_portions") and r_string("info_portions", "files") or ""
	for file in string.gmatch(files, "[^,%s]+") do
		infos.cats[#infos.cats + 1] = file
		local cat = #infos.cats
		local ok = pcall(function()
			local reader = getFS():r_open("$game_config$", "gameplay\\" .. file .. ".xml")
			if not reader then return end
			local bytes = {}
			while not reader:r_eof() do
				bytes[#bytes + 1] = string.char(reader:r_u8())
			end
			getFS():r_close(reader)
			for id in string.gmatch(table.concat(bytes), "<info_portion%s+id%s*=%s*\"([^\"]+)\"") do
				add(id, cat)
			end
		end)
		if not ok then printf("! [debug menu] %s.xml: the info portions were not read", file) end
	end
	-- and whatever the actor holds that no file declares
	infos.cats[#infos.cats + 1] = "st_dbg_cat_undeclared"
	local undeclared = #infos.cats
	pcall(function()
		alife():iterate_info(db.actor:id(), function(id, info)
			add(info, undeclared)
		end)
	end)
	table.sort(infos.entries, function(a, b) return a.key < b.key end)
	return infos
end

add_tab("story", "st_dbg_tab_story", {
	build = function()
		local t = build_infos()
		for _, e in ipairs(t.entries) do
			e.badge = db.actor:has_info(e.key) and "st_dbg_has" or ""
		end
		return { categories = t.cats, entries = t.entries }
	end,
	describe = function(key)
		local has = db.actor:has_info(key)
		return { title = key, sub = has and tr("st_dbg_has_info") or tr("st_dbg_no_info"), body = "st_dbg_story_hint",
			primary = has and "st_dbg_take_info" or "st_dbg_give_info" }
	end,
	act = function(key)
		if db.actor:has_info(key) then
			db.actor:disable_info_portion(key)
		else
			db.actor:give_info_portion(key)
		end
		return { msg = "st_dbg_done", rebuild = true }
	end,
})

-- ---- what is near ----------------------------------------------------------------------------------------------------
local NEAR_RADIUS = 80
local near = { by_key = {} }

add_tab("near", "st_dbg_tab_near", {
	build = function()
		near.by_key = {}
		local entries = {}
		local apos = db.actor:position()
		level.iterate_online_objects(function(obj)
			if obj:id() ~= db.actor:id() then
				local d = obj:position():distance_to(apos)
				if d <= NEAR_RADIUS then
					local cat
					if IsStalker(obj) then cat = 1
					elseif IsMonster(obj) then cat = 2
					elseif obj:parent() == nil and r_string(obj:section(), "inv_name") ~= "" then cat = 3
					else cat = 4 end
					if cat ~= 4 or ini:line_exist(obj:section(), "visual") then
						local name
						if cat == 1 then name = obj:character_name()
						elseif cat == 3 then name = tr(r_string(obj:section(), "inv_name"))
						else name = obj:name() end
						local e = { key = tostring(obj:id()), name = name, sec = obj:section(), cat = cat,
							note = string.format("%.0f m", d), badge = (cat <= 2 and not obj:alive()) and "st_dbg_dead" or "", d = d }
						entries[#entries + 1] = e
						near.by_key[e.key] = e
					end
				end
			end
		end)
		table.sort(entries, function(a, b) return a.d < b.d end)
		return { categories = { "st_dbg_cat_stalkers", "st_dbg_cat_mutants", "st_dbg_cat_items", "st_dbg_cat_other_objects" },
			entries = entries }
	end,
	describe = function(key)
		local obj = level.object_by_id(tonumber(key))
		if not obj then return { title = key, body = "st_dbg_gone" } end
		local living = (IsStalker(obj) or IsMonster(obj)) and obj:alive()
		local body = obj:name() .. "\\n" .. string.format("id %d", obj:id())
		if IsStalker(obj) then
			body = body .. "\\n" .. tr("st_dbg_param_faction") .. " " .. faction_name(obj:character_community())
		end
		return { title = near.by_key[key] and near.by_key[key].name or obj:name(), sub = obj:section(), body = body,
			icon = r_string(obj:section(), "inv_name") ~= "" and obj:section() or nil,
			primary = "st_dbg_go_to", second = living and "st_dbg_kill" or nil, third = "st_dbg_remove" }
	end,
	act = function(key, button)
		local obj = level.object_by_id(tonumber(key))
		if not obj then return { msg = "st_dbg_gone", rebuild = true } end
		if button == "primary" then
			db.actor:set_actor_position(obj:position())
			return { msg = "st_dbg_teleported", close = true }
		elseif button == "second" then
			obj:kill(db.actor)
		else
			local se = alife():object(obj:id())
			if se then alife():release(se, true) end
		end
		return { msg = "st_dbg_done", rebuild = true }
	end,
})

-- ---- equipment sets --------------------------------------------------------------------------------------------------
-- The sets of configs\dead_air_x64_loadouts.ltx and the player's own in <appdata>\dead_air_x64_loadouts.ltx (a set of
-- the same id there replaces the shipped one, [hidden] lists the shipped ones deleted). Giving a set spawns it into the
-- inventory and puts on what it can wear, taking off what was worn; replacing first takes everything away but the base
-- equipment.
local LOADOUTS_FILE = "dead_air_x64_loadouts.ltx"
-- The base equipment a replace keeps: the power bank, the PDA, the torch the lamps shine through, the bolt.
local keep_sections = { wpn_upd = true, device_pda = true, device_torch = true, bolt = true }
-- The slots a set dresses (the knife, both rifles, the pistol, the outfit, the detector, the helmet, the binoculars, the
-- backpack); an item's own slot is its config's plus one.
local wear_slots = { [1] = true, [2] = true, [3] = true, [5] = true, [7] = true, [9] = true, [12] = true, [14] = true,
	[15] = true }
local RIFLE_SLOT, RIFLE_SLOT_2 = 3, 2
local loadout_choice = 1
local equip_pending = {}
local equip_deadline = 0

-- Saved by hand: a file the engine wrote at its own end would race the next open. A section is never removed (the
-- script ini has no call for it): a deleted set keeps "deleted = 1", the next "Create" takes another id.
local function user_loadouts()
	local f = ini_file("$app_data_root$", LOADOUTS_FILE)
	f:set_readonly(false)
	f:save_at_end(false)
	f:set_override_names(true)
	return f
end

local function user_has_set(f, id)
	return f:section_exist(id) and f:line_exist(id, "items") and not f:line_exist(id, "deleted")
end

local function save_user(f)
	f:save_as(getFS():update_path("$app_data_root$", LOADOUTS_FILE))
end

local function read_set(f, id)
	local function r(key)
		return f:line_exist(id, key) and (f:r_string_ex(id, key) or "") or ""
	end
	local set = { id = id, name = r("name"), items = {}, ammo_boxes = tonumber(r("ammo_boxes")) or 0 }
	for part in string.gmatch(r("items"), "[^,]+") do
		local sec, n = string.match(part, "^%s*([^:%s]+)%s*:?%s*(%d*)%s*$")
		if sec then
			set.items[#set.items + 1] = { sec = sec, count = math.max(tonumber(n) or 1, 1) }
		end
	end
	return set
end

local function write_set(f, set)
	local parts = {}
	for _, it in ipairs(set.items) do
		parts[#parts + 1] = it.count > 1 and (it.sec .. ":" .. it.count) or it.sec
	end
	f:w_string(set.id, "name", set.name, "")
	f:w_string(set.id, "items", table.concat(parts, ", "), "")
	f:w_string(set.id, "ammo_boxes", tostring(set.ammo_boxes or 0), "")
end

-- Every set, the shipped ones first in their order, then the player's own.
local function all_loadouts()
	local list, by_id = {}, {}
	local base = ini_file(LOADOUTS_FILE)
	local user = user_loadouts()
	local hidden = {}
	if user:section_exist("hidden") then
		for i = 0, user:line_count("hidden") - 1 do
			local _, id = user:r_line("hidden", i, "", "")
			hidden[id] = true
		end
	end
	local order = base:section_exist("loadouts") and base:line_exist("loadouts", "order") and base:r_string_ex("loadouts", "order") or ""
	for id in string.gmatch(order, "[^,%s]+") do
		if base:section_exist(id) and not hidden[id] then
			local edited = user_has_set(user, id)
			local set = edited and read_set(user, id) or read_set(base, id)
			set.shipped, set.edited = true, edited
			list[#list + 1] = set
			by_id[id] = set
		end
	end
	user:section_for_each(function(id)
		if id ~= "hidden" and not by_id[id] and not base:section_exist(id) and user_has_set(user, id) then
			local set = read_set(user, id)
			list[#list + 1] = set
			by_id[id] = set
		end
	end)
	return list, by_id, hidden
end

local function section_name(sec)
	local inv = r_string(sec, "inv_name")
	return inv ~= "" and tr(inv) or sec
end

local function is_ammo(sec)
	local class = r_string(sec, "class")
	return string.find(class, "^AMMO") or string.find(class, "^S_AMMO") or false
end

-- A knife's "ammo" is its swing: never a box of its own.
local function knife_ammo(sec)
	return string.find(sec, "^ammo_knife") ~= nil
end

local function base_slot(sec)
	local slot = tonumber(r_string(sec, "slot"))
	return slot and slot >= 0 and slot + 1 or 0
end

-- The base equipment and the quest items stay through a replace and out of a captured set.
local function kept(item)
	local sec = item:section()
	return keep_sections[sec] or (ini:line_exist(sec, "quest_item") and ini:r_bool(sec, "quest_item"))
		or string.find(sec, "^anm_") or string.find(sec, "^animation_")
end

-- What the actor carries now as a set: the worn and slotted things first, ammo in whole boxes.
local function capture()
	local counts, order, rounds = {}, {}, {}
	local function add(sec, n)
		if not counts[sec] then
			order[#order + 1] = sec
			counts[sec] = 0
		end
		counts[sec] = counts[sec] + n
	end
	for _, slot in ipairs({ 7, 12, 15, 3, 2, 5, 1, 9, 14 }) do
		local it = db.actor:item_in_slot(slot)
		if it and not kept(it) then add(it:section(), 1) end
	end
	local slotted = {}
	for _, slot in ipairs({ 7, 12, 15, 3, 2, 5, 1, 9, 14 }) do
		local it = db.actor:item_in_slot(slot)
		if it then slotted[it:id()] = true end
	end
	db.actor:iterate_inventory(function(_, it)
		if slotted[it:id()] or kept(it) then return end
		if knife_ammo(it:section()) then
			return
		elseif is_ammo(it:section()) then
			if not rounds[it:section()] then order[#order + 1] = it:section() end
			rounds[it:section()] = (rounds[it:section()] or 0) + it:ammo_get_count()
		else
			add(it:section(), 1)
		end
	end, nil)
	local items = {}
	for _, sec in ipairs(order) do
		if rounds[sec] then
			local box = math.max(math.floor(r_float(sec, "box_size", 1)), 1)
			items[#items + 1] = { sec = sec, count = math.max(math.ceil(rounds[sec] / box), 1) }
		else
			items[#items + 1] = { sec = sec, count = counts[sec] }
		end
	end
	return items
end

-- A new set's name: the outfit and the main weapon worn now.
local function capture_name()
	local parts = {}
	for _, slot in ipairs({ 7, 3, 2, 5 }) do
		local it = db.actor:item_in_slot(slot)
		if it and #parts < 2 then parts[#parts + 1] = section_name(it:section()) end
	end
	return #parts > 0 and table.concat(parts, " + ") or tr("st_dbg_lo_new_name")
end

-- The spawned things that are to be worn are put on once they are in the inventory (a spawn lands a few frames later).
local function equip_tick()
	if #equip_pending == 0 then return end
	if time_global() > equip_deadline then
		equip_pending = {}
		return
	end
	local rest = {}
	for _, e in ipairs(equip_pending) do
		local obj = level.object_by_id(e.id)
		local parent = obj and obj:parent()
		if parent and parent:id() == db.actor:id() then
			db.actor:move_to_slot(obj, e.slot)
		else
			rest[#rest + 1] = e
		end
	end
	equip_pending = rest
end

local function apply_loadout(set, replace)
	local actor = db.actor
	if replace then
		local doomed = {}
		actor:iterate_inventory(function(_, it)
			if not kept(it) then doomed[#doomed + 1] = it:id() end
		end, nil)
		for _, id in ipairs(doomed) do
			local se = alife():object(id)
			if se then alife():release(se, true) end
		end
	end
	local pos, lvid, gvid, pid = actor:position(), actor:level_vertex_id(), actor:game_vertex_id(), actor:id()
	local taken, made, missing = {}, 0, {}
	local has_ammo = {}
	for _, it in ipairs(set.items) do
		if is_ammo(it.sec) then has_ammo[it.sec] = true end
	end
	local items = {}
	for _, it in ipairs(set.items) do items[#items + 1] = it end
	-- the weapons' ammo the set does not give itself
	if (set.ammo_boxes or 0) > 0 then
		for _, it in ipairs(set.items) do
			local classes = r_string(it.sec, "ammo_class")
			local first = string.match(classes, "^%s*([^,%s]+)")
			local covered = false
			for a in string.gmatch(classes, "[^,%s]+") do
				if has_ammo[a] then covered = true end
			end
			if first and not covered and not knife_ammo(first) and ini:section_exist(first) then
				has_ammo[first] = true
				items[#items + 1] = { sec = first, count = set.ammo_boxes }
			end
		end
	end
	equip_deadline = time_global() + 5000
	for _, it in ipairs(items) do
		if not ini:section_exist(it.sec) or knife_ammo(it.sec) then
			missing[#missing + 1] = it.sec
		else
			for _ = 1, it.count do
				local ok, se = pcall(function() return alife():create(it.sec, pos, lvid, gvid, pid) end)
				if ok and se then
					made = made + 1
					local slot = base_slot(it.sec)
					if slot == RIFLE_SLOT and taken[RIFLE_SLOT] then slot = RIFLE_SLOT_2 end
					local grenade = string.find(r_string(it.sec, "class"), "^G_")
					if wear_slots[slot] and not taken[slot] and not grenade then
						taken[slot] = true
						equip_pending[#equip_pending + 1] = { id = se.id, slot = slot }
					end
				end
			end
		end
	end
	if #missing > 0 then
		printf("! [debug menu] set %s: no such items %s", set.id, table.concat(missing, ", "))
	end
	return made, missing
end

local LO_NEW, LO_EMPTY, LO_RESTORE, LO_DONE, LO_AMMO = "#new", "#empty", "#restore", "#done", "#ammo"
-- The set whose contents the tab shows for editing (nil: the list of sets).
local lo_editing

-- The edited set, written to the player's file as it changes: a shipped one is copied there first.
local function edit_set(f, fn)
	local _, by_id = all_loadouts()
	local set = by_id[lo_editing]
	if not set then
		lo_editing = nil
		return false
	end
	fn(set)
	if f:line_exist(set.id, "deleted") then f:remove_line(set.id, "deleted") end
	write_set(f, set)
	save_user(f)
	return true
end

local function set_count(set, sec)
	for i, it in ipairs(set.items) do
		if it.sec == sec then return it.count, i end
	end
	return 0
end

local function new_own_id(f)
	local n = 1
	while f:section_exist("own_" .. n) do n = n + 1 end
	return "own_" .. n
end

local function item_card(sec, extra)
	local desc = r_string(sec, "description")
	return { title = section_name(sec), sub = sec, icon = sec,
		body = (desc ~= "" and (tr(desc) .. "\\n \\n") or "") .. extra }
end

local function in_set_text(sec, n)
	return fmt(is_ammo(sec) and "st_dbg_lo_in_set_boxes_fmt" or "st_dbg_lo_in_set_fmt", n)
end

add_tab("loadouts", "st_dbg_tab_loadouts", {
	build = function()
		if lo_editing then
			local _, by_id = all_loadouts()
			local set = by_id[lo_editing]
			if set then
				local entries = { { key = LO_DONE, name = "st_dbg_lo_done", sec = set.id, cat = 1 },
					{ key = LO_AMMO, name = "st_dbg_lo_ammo_entry", sec = "ammo_boxes", cat = 1,
						badge = tostring(set.ammo_boxes or 0) } }
				for _, it in ipairs(set.items) do
					entries[#entries + 1] = { key = "has:" .. it.sec, name = section_name(it.sec), sec = it.sec, cat = 1,
						badge = "x" .. it.count }
				end
				-- the whole catalogue of the items tab, its categories after the set's own
				for _, e in ipairs(build_items().entries) do
					entries[#entries + 1] = { key = "add:" .. e.sec, name = e.name, sec = e.sec, cat = e.cat + 1, note = e.note }
				end
				local cats = { fmt("st_dbg_cat_lo_contents_fmt", set.name ~= "" and tr(set.name) or set.id) }
				for _, c in ipairs(item_cats) do cats[#cats + 1] = c end
				return { all = false, categories = cats, entries = entries }
			end
			lo_editing = nil
		end
		local list, _, hidden = all_loadouts()
		local entries = {}
		for _, set in ipairs(list) do
			entries[#entries + 1] = { key = set.id, name = set.name ~= "" and tr(set.name) or set.id, sec = set.id,
				cat = set.shipped and 1 or 2, badge = set.edited and "st_dbg_lo_edited" or "",
				note = fmt("st_dbg_lo_count_fmt", #set.items) }
		end
		entries[#entries + 1] = { key = LO_EMPTY, name = "st_dbg_lo_empty", sec = LOADOUTS_FILE, cat = 3 }
		entries[#entries + 1] = { key = LO_NEW, name = "st_dbg_lo_new", sec = LOADOUTS_FILE, cat = 3 }
		if next(hidden) then
			entries[#entries + 1] = { key = LO_RESTORE, name = "st_dbg_lo_restore", sec = LOADOUTS_FILE, cat = 3 }
		end
		return { categories = { "st_dbg_cat_lo_shipped", "st_dbg_cat_lo_own", "st_dbg_cat_lo_actions" }, entries = entries }
	end,
	describe = function(key)
		if key == LO_NEW then
			return { title = "st_dbg_lo_new", sub = LOADOUTS_FILE, body = "st_dbg_lo_new_hint", primary = "st_dbg_lo_create" }
		elseif key == LO_EMPTY then
			return { title = "st_dbg_lo_empty", sub = LOADOUTS_FILE, body = "st_dbg_lo_empty_hint", primary = "st_dbg_lo_create" }
		elseif key == LO_RESTORE then
			return { title = "st_dbg_lo_restore", sub = LOADOUTS_FILE, body = "st_dbg_lo_restore_hint", primary = "st_dbg_apply" }
		end
		local _, by_id = all_loadouts()
		if lo_editing then
			local set = by_id[lo_editing]
			if not set then return { title = key, body = "st_dbg_gone" } end
			if key == LO_DONE then
				return { title = "st_dbg_lo_done", sub = set.id, body = "st_dbg_lo_edit_hint", primary = "st_dbg_lo_done_button" }
			elseif key == LO_AMMO then
				return { title = "st_dbg_lo_ammo_entry", sub = "ammo_boxes", body = "st_dbg_lo_ammo_hint",
					count = { min = 0, max = 50, default = set.ammo_boxes or 0, reset = 1 }, primary = "st_dbg_lo_set_count" }
			end
			local sec = string.match(key, "^has:(.+)$")
			if sec then
				local n = set_count(set, sec)
				local card = item_card(sec, in_set_text(sec, n))
				card.count = { min = 1, max = 500, default = math.max(n, 1), reset = 1 }
				card.primary, card.second = "st_dbg_lo_set_count", "st_dbg_lo_remove"
				return card
			end
			sec = string.match(key, "^add:(.+)$")
			if sec then
				local n = set_count(set, sec)
				local card = item_card(sec, n > 0 and in_set_text(sec, n) or tr("st_dbg_lo_not_in_set"))
				card.count = { min = 1, max = 500, default = 1, reset = 1 }
				card.primary = "st_dbg_lo_add"
				if n > 0 then card.second = "st_dbg_lo_remove" end
				return card
			end
			return { title = key, body = "st_dbg_gone" }
		end
		local set = by_id[key]
		if not set then return { title = key, body = "st_dbg_gone" } end
		local lines = {}
		for _, it in ipairs(set.items) do
			local name = section_name(it.sec)
			if not ini:section_exist(it.sec) then name = name .. " (" .. tr("st_dbg_lo_missing") .. ")" end
			lines[#lines + 1] = it.count > 1 and (name .. " x" .. it.count) or name
		end
		if (set.ammo_boxes or 0) > 0 then
			lines[#lines + 1] = fmt("st_dbg_lo_ammo_fmt", set.ammo_boxes)
		end
		-- the set's face: its outfit, else its first thing the game has
		local icon
		for _, it in ipairs(set.items) do
			if ini:section_exist(it.sec) and (not icon or string.find(r_string(it.sec, "class"), "STLK")) then
				icon = icon and string.find(r_string(icon, "class"), "STLK") and icon or it.sec
			end
		end
		return { title = set.name ~= "" and tr(set.name) or set.id, sub = set.id, icon = icon,
			body = table.concat(lines, "\\n") .. "\\n \\n" .. tr("st_dbg_lo_hint"),
			choice = { "st_dbg_lo_give", "st_dbg_lo_replace" }, choice_default = loadout_choice,
			primary = "st_dbg_lo_equip", second = "st_dbg_lo_edit", third = "st_dbg_lo_delete" }
	end,
	act = function(key, button, count, choice)
		local user = user_loadouts()
		if lo_editing then
			if key == LO_DONE then
				lo_editing = nil
				return { msg = "st_dbg_done", rebuild = true }
			elseif key == LO_AMMO then
				edit_set(user, function(set) set.ammo_boxes = count end)
				return { msg = "st_dbg_lo_changed", rebuild = true }
			end
			local sec = string.match(key, "^has:(.+)$") or string.match(key, "^add:(.+)$")
			if not sec then return { msg = "st_dbg_gone", rebuild = true } end
			edit_set(user, function(set)
				local n, i = set_count(set, sec)
				if button == "second" then
					if i then table.remove(set.items, i) end
				elseif string.find(key, "^add:") then
					if i then set.items[i].count = n + count else set.items[#set.items + 1] = { sec = sec, count = count } end
				elseif i then
					set.items[i].count = count
				end
			end)
			return { msg = button == "second" and "st_dbg_lo_removed" or "st_dbg_lo_changed", rebuild = true }
		end
		loadout_choice = choice or loadout_choice
		if key == LO_NEW or key == LO_EMPTY then
			local id = new_own_id(user)
			if key == LO_NEW then
				write_set(user, { id = id, name = capture_name(), items = capture(), ammo_boxes = 0 })
			else
				write_set(user, { id = id, name = fmt("st_dbg_lo_own_name_fmt", tonumber(string.match(id, "%d+")) or 1),
					items = {}, ammo_boxes = 4 })
				lo_editing = id
			end
			save_user(user)
			return { msg = "st_dbg_lo_created", rebuild = true }
		elseif key == LO_RESTORE then
			if user:section_exist("hidden") then
				for i = user:line_count("hidden") - 1, 0, -1 do
					local _, id = user:r_line("hidden", i, "", "")
					user:remove_line("hidden", id)
				end
				save_user(user)
			end
			return { msg = "st_dbg_done", rebuild = true }
		end
		local _, by_id = all_loadouts()
		local set = by_id[key]
		if not set then return { msg = "st_dbg_gone", rebuild = true } end
		if button == "primary" then
			local made, missing = apply_loadout(set, choice == 2)
			if #missing > 0 then return fmt("st_dbg_lo_given_missing_fmt", made, #missing) end
			return fmt(choice == 2 and "st_dbg_lo_replaced_fmt" or "st_dbg_lo_given_fmt", made)
		elseif button == "second" then
			lo_editing = key
			return { msg = "st_dbg_lo_editing", rebuild = true }
		end
		-- delete: the player's own set goes, a shipped one is hidden (and its edit dropped)
		if user:section_exist(key) then
			for _, line in ipairs({ "name", "items", "ammo_boxes" }) do
				if user:line_exist(key, line) then user:remove_line(key, line) end
			end
			user:w_string(key, "deleted", "1", "")
		end
		if set.shipped then
			user:w_string("hidden", key, "1", "")
		end
		save_user(user)
		return { msg = "st_dbg_lo_deleted", rebuild = true }
	end,
})

function on_game_start()
	RegisterScriptCallback("actor_on_update", equip_tick)
end

-- ---- the window's calls ----------------------------------------------------------------------------------------------
function tabs()
	local out = {}
	for _, id in ipairs(order) do
		out[#out + 1] = { id = id, caption = providers[id].caption }
	end
	return out
end

-- Captions the window shows as they are (it translates string ids), entries' names too: a name that is a string id of
-- this file (st_dbg_*) is translated here, the rest is already the game's text.
local function shown(text)
	if type(text) == "string" and string.find(text, "^st_dbg_") then
		return tr(text)
	end
	return text
end

function build(tab)
	local p = providers[tab]
	if not p then return {} end
	local ok, t = pcall(p.build)
	if not ok then
		printf("! [debug menu] build(%s): %s", tab, tostring(t))
		return {}
	end
	for _, e in ipairs(t.entries or {}) do
		e.name = shown(e.name)
	end
	return t
end

function describe(tab, key)
	local p = providers[tab]
	if not p then return {} end
	local ok, card = pcall(p.describe, key)
	if not ok then
		printf("! [debug menu] describe(%s, %s): %s", tab, key, tostring(card))
		return {}
	end
	card.title = shown(card.title)
	card.body = shown(card.body)
	return card
end

function act(tab, key, button, count, choice)
	local p = providers[tab]
	if not p then return "" end
	local ok, r = pcall(p.act, key, button, count, choice)
	if not ok then
		printf("! [debug menu] act(%s, %s, %s): %s", tab, key, button, tostring(r))
		return "st_dbg_failed"
	end
	return r
end
