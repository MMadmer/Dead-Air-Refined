-- Glue between the animation module (FDDA item scenes, body search, backpack, wear, ledge
-- climb) and the stock Dead Air scripts. Everything the module needs from the base game is
-- patched from here, so no stock script file is replaced.
-- Compat scripts live in their own namespace table: globals ONLY through _G.

-- ---- the intent to use an item ----------------------------------------------------------------
-- The engine asks _G.da_before_item_use(npc, item) in CInventory::Eat BEFORE the item is used.
-- CInventory__eat runs after the fact and its refusal cancels nothing; the item scenes need to
-- catch the intent, play and consume the item themselves at the right frame. The flag travels
-- as a table because a Lua boolean is passed by value.
_G.da_before_item_use_handlers = {}

function _G.da_register_before_item_use(func)
	if (type(func) ~= "function") then return end
	for i = 1, #_G.da_before_item_use_handlers do
		if (_G.da_before_item_use_handlers[i] == func) then return end
	end
	table.insert(_G.da_before_item_use_handlers, func)
end

function _G.da_before_item_use(npc, item)
	local flags = { ret_value = true }
	for i = 1, #_G.da_before_item_use_handlers do
		local ok, err = pcall(_G.da_before_item_use_handlers[i], npc, item, flags)
		if (not ok) then
			printf("![da_anims] before_item_use handler failed: %s", tostring(err))
		end
	end
	return flags.ret_value
end

-- ---- stock item effects vs the module ------------------------------------------------------------
-- Both sets hang on the same use event. Without this the stock set (camera shake, weapon hide)
-- played over the module's hands. The stock set is muted for what the module covers and plays
-- as always for everything else (repair kits, weapon cleaning, ...).
local function install_actor_effects_patch()
	if not (actor_effects and actor_effects.use_item) then return end
	if (actor_effects.da_use_item_original) then return end

	local original = actor_effects.use_item
	actor_effects.da_use_item_original = original

	actor_effects.use_item = function(name)
		local wear = (name == "outfit") or (name == "helm")
		if (wear) then
			-- Judged by the item now in the slot: a helmet the module has no scene for keeps
			-- the stock effect.
			local wear_slot = (name == "helm") and 12 or 7
			local worn = db.actor and db.actor:item_in_slot(wear_slot)
			if (not worn) or (da_wear_anims and da_wear_anims.covers(worn, wear_slot)) then return end
		end

		if enhanced_animations and enhanced_animations.da_has_anim(name) then return end

		return original(name)
	end
end

-- ---- other scripts' copies of the module's scenes ------------------------------------------------
-- An add-on may carry its own animations for the moments this module animates and hang them on the
-- same events, so both run - one scene inside the other. That is how the hands used to be lost. One
-- such copy has its two halves the wrong way round: its scene ENDS with hide_weapon (a comment next
-- to it reads "the ability to change weapon", the author took hide for restore), and its
-- restore_weapon sits at the START, where the counter is already zero and the call is swallowed.
-- A blocked slot is a refcount: one unmatched hide is permanent, only a fresh actor clears it, and
-- the player is left with empty hands and no way to draw anything, the PDA included.
--
-- The copy reached the player through OUR scene, not instead of it: the module consumes the item
-- mid-scene through the ordinary use, which fires the use event the copy listens on; the harvest
-- copy is started by the loot window once the items are taken, after our harvest has played.
--
-- One feature, one owner: while the module has a scene for the case, the copy is skipped; when it
-- has none, the copy runs as it always did. Which functions are such copies is knowledge about
-- other mods, so it is data: dead_air_x64_scene_copies.ltx, [duplicate_scenes].
local covers = {
	-- A use of an item, which comes among the arguments as a game object or a section name.
	item = function(...)
		if not (enhanced_animations and enhanced_animations.enable_item_anims) then return false end
		-- Ours is already running one: never a second scene inside it.
		if (enhanced_animations.used_item or enhanced_animations.used_monster) then return true end
		for i = 1, select("#", ...) do
			local arg = select(i, ...)
			local section = (type(arg) == "string") and arg or nil
			if (type(arg) == "userdata") then
				local ok, name = pcall(function() return arg:section() end)
				section = ok and name or nil
			end
			if (section and enhanced_animations.da_has_anim(section)) then return true end
		end
		return false
	end,
	-- The mutant harvest: the module plays it before the loot window opens, whenever it is on.
	harvest = function()
		return (enhanced_animations and enhanced_animations.enable_animations and enhanced_animations.mutant_loot_mod) == true
	end,
}

-- What was wrapped, by "script.function". A function that no longer is our wrapper was replaced by
-- its script (reloaded, or reassigned on activation) and is wrapped again.
local duplicate_wrappers = {}

local function install_duplicate_scene_patches()
	local ini = ini_file("dead_air_x64_scene_copies.ltx")
	if not (ini and ini:section_exist("duplicate_scenes")) then return end

	for i = 0, ini:line_count("duplicate_scenes") - 1 do
		local _, name, kind = ini:r_line("duplicate_scenes", i, "", "")
		local script, func = string.match(name or "", "^([%w_]+)%.([%w_]+)$")
		local covered = covers[kind]
		local owner = script and _G[script]
		if (not covered) then
			printf("![da_anims] duplicate_scenes: %s has an unknown kind '%s'", tostring(name), tostring(kind))
		elseif (type(owner) == "table" and type(owner[func]) == "function" and owner[func] ~= duplicate_wrappers[name]) then
			local original = owner[func]
			local wrapper = function(...)
				if covered(...) then return end
				return original(...)
			end
			duplicate_wrappers[name] = wrapper
			owner[func] = wrapper
		end
	end
end

-- ---- knife check with empty hands ----------------------------------------------------------------
-- can_loot is reached from the harvest scene with nothing in the hands; the stock code indexes
-- the active item without a check.
local function install_knife_manager_patch()
	if not (knife_manager and knife_manager.can_loot) then return end
	if (knife_manager.da_can_loot_original) then return end

	local original = knife_manager.can_loot
	knife_manager.da_can_loot_original = original

	knife_manager.can_loot = function(monster)
		if (db.actor and not db.actor:active_item()) then return true end
		return original(monster)
	end
end

function on_game_start()
	install_actor_effects_patch()
	install_knife_manager_patch()
	install_duplicate_scene_patches()
	-- Add-ons register their own handlers from actor_on_first_update, and the order two scripts
	-- get that callback in is the order a hash table lists them. So the patches are put on again
	-- once the game is running, when everything is certainly loaded.
	RegisterScriptCallback("actor_on_first_update", install_duplicate_scene_patches)
end

install_actor_effects_patch()
install_knife_manager_patch()
install_duplicate_scene_patches()
