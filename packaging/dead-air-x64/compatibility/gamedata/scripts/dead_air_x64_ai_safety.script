local original_send_to_nearest_accessible_vertex = utils.send_to_nearest_accessible_vertex
local original_load_var = utils.load_var
local original_process_npc_usability

local function load_var(obj, varname, defval)
	if not db.actor then
		return defval
	end
	return original_load_var(obj, varname, defval)
end

local function send_to_nearest_accessible_vertex(npc, vertex_id, caller)
	if not npc then
		return vertex_id
	end

	if vertex_id and level.valid_vertex_id(vertex_id) then
		return original_send_to_nearest_accessible_vertex(npc, vertex_id, caller)
	end

	-- accessible_nearest refuses an already accessible position and logs an engine error,
	-- so ask for it only when the npc really stands outside its restrictions
	local position = npc:position()
	if not npc:accessible(position) then
		local nearest_position = vector()
		local nearest_vertex_id = npc:accessible_nearest(position, nearest_position)
		if nearest_vertex_id and level.valid_vertex_id(nearest_vertex_id) then
			npc:set_dest_level_vertex_id(nearest_vertex_id)
			return nearest_vertex_id
		end
	end

	local current_vertex_id = npc:level_vertex_id()
	if current_vertex_id and level.valid_vertex_id(current_vertex_id) then
		npc:set_dest_level_vertex_id(current_vertex_id)
	end
	return current_vertex_id
end

-- Condition functions in xr_conditions take the object they ask about as the first argument
-- and almost all of them index it straight away. Smart terrain job setup runs from an npc's
-- net_spawn, which happens while the level is still loading its objects and db.actor does not
-- exist yet, so any logic whose condlist uses one of them killed the session on entering the
-- level. Answering "not met" is the honest result - the object really is absent - and the
-- condlist is re-evaluated on every update, so the section resolves normally once it appears.
--
-- Guard ONLY while db.actor is absent: that is exactly the crashing window, and it is the
-- only case where a condlist hands nil down as the first argument. Several stock callers
-- (xr_statistic faction checks, task_status_functor, dialogs) legitimately pass nil first
-- and only read p; suppressing those mid-game broke kill reputation, task statuses and
-- quest dialogs in 1.3.2.
local conditions_guarded = false

local function guard_object_conditions()
	if conditions_guarded then
		return
	end
	conditions_guarded = true

	for name, original in pairs(xr_conditions) do
		if type(original) == "function" then
			xr_conditions[name] = function(object, npc, p, ...)
				if object == nil and db.actor == nil then
					return false
				end
				return original(object, npc, p, ...)
			end
		end
	end
end

-- xr_meet.process_npc_usability indexes db.storage[id].wounded as soon as IsWounded() says
-- so, but IsWounded answers from the persistent "wounded_state" variable, while the storage
-- entry only appears once the npc's logic is configured (xr_logic.configure_schemes). A
-- stalker saved wounded whose smart terrain found no job for it on spawn is updated before
-- that happens - smart_terrain.setup_gulag_and_logic_on_spawn returns without setting any
-- logic up - and the stock code faults on the nil. Nothing can be evaluated for such an npc
-- yet; the next update after the logic setup runs the stock code unchanged.
local function process_npc_usability(npc)
	local storage = db.storage[npc:id()]
	if storage and storage.wounded == nil and IsWounded(npc) then
		return
	end
	return original_process_npc_usability(npc)
end

local function guard_npc_usability()
	if original_process_npc_usability or not (xr_meet and xr_meet.process_npc_usability) then
		return
	end
	original_process_npc_usability = xr_meet.process_npc_usability
	xr_meet.process_npc_usability = process_npc_usability
end

function on_game_start()
	utils.load_var = load_var
	utils.send_to_nearest_accessible_vertex = send_to_nearest_accessible_vertex
	guard_object_conditions()
	guard_npc_usability()
end
