-- NQ runtime: behaviour graphs - the assets that drive NPCs (NQ_ARCHITECTURE par. 19).
--   caller side:    behaviour.run, behaviour.stop, behaviour_running, behaviour_done
--   behaviour side: npc.goto, npc.hold, npc.anim, npc.follow, npc.attack,
--                   npc.stance, npc.release, npc_at_place, npc_in_combat, role_alive
--
-- A running behaviour is an instance of the ordinary NQ interpreter (core.instance_*),
-- so nodes, pins, conditions, vars, tokens and saves are the ones quests already use.
-- What is new is two things only:
--
--   ROLES. The asset declares them; the calling quest binds them to NPCs, squads,
--   refs or communities. Members are resolved ONCE, on entry, and kept in the
--   instance state - the cast cannot change under the graph's feet.
--
--   STEPS. None of them moves, aims or shoots anything. A step writes a small
--   logic section and hands it to the stock scheme through create_ini_file +
--   xr_logic.configure_schemes - exactly what a smart terrain does in
--   xr_gulag/smart_terrain. Combat, cover, danger, wounded and death therefore
--   keep working, because the same schemes keep running them.
--
-- An NPC that is offline cannot be given a scheme (there is no game object to
-- give it to), so the step is parked and applied the moment it spawns in. The
-- same queue carries a step whose DESTINATION is not there yet: a place naming
-- a ref the caller has not spawned is parked, not failed.
--
-- behaviour.run has three pins and no flag: started fires at once (as a side
-- branch - the node keeps waiting), then exactly one of finished / aborted.

local core = xms_nq
local util = xms_nq_util

local K = {}

local tick_on = false
local UID_MARK = "#"		-- "<module>.<behaviour>#<n>": no asset id can contain it

-- ============================================================================ helpers
local function actor()
	return db and db.actor
end

local function go_by_id(id)
	return id and util.go_by_id(id) or nil
end

local function se_by_id(id)
	return id and util.se_by_id(id) or nil
end

local function alive_id(id)
	local se = se_by_id(id)
	return se ~= nil and util.se_alive(se)
end

local function is_instance(uid)
	return type(uid) == "string" and string.find(uid, UID_MARK, 1, true) ~= nil
end

local function any_instance()
	local st = core.get_state()
	for uid in pairs((st and st.quests) or {}) do
		if (is_instance(uid)) then return true end
	end
	return false
end

-- The engine calls only xms_nq back, so this module asks for the tick itself -
-- and gives it up again the moment nothing is running, the way the world module
-- does with squad registration. A callback that outlives its reason is a
-- callback that fires in a game with no quests at all.
local function ensure_tick()
	if (tick_on or not RegisterScriptCallback) then return end
	RegisterScriptCallback("actor_on_update", tick)
	tick_on = true
end

local function drop_tick()
	if not (tick_on) then return end
	if (UnregisterScriptCallback) then pcall(UnregisterScriptCallback, "actor_on_update", tick) end
	tick_on = false
end

-- every id of a role, living or not, in binding order
local function role_ids(qs, name)
	if not (qs and qs.roles) then return {} end
	local r = qs.roles[name]
	return (type(r) == "table" and r.ids) or {}
end

local function role_names_of(p)
	local who = p and p.who
	if (type(who) == "string") then return { who } end
	if (type(who) == "table") then
		local out = {}
		for _, n in ipairs(who) do if (type(n) == "string") then out[#out + 1] = n end end
		return out
	end
	return {}
end

-- every LIVING member of every role a step addresses
local function targets(ctx, p)
	local qs = ctx.qs
	local out = {}
	for _, name in ipairs(role_names_of(p)) do
		for _, id in ipairs(role_ids(qs, name)) do
			if (alive_id(id)) then out[#out + 1] = id end
		end
	end
	return out
end

local function patrol_exists(path)
	if (type(path) ~= "string" or path == "") then return false end
	local ok, r = pcall(level.patrol_path_exists, path)
	return ok and r == true
end

-- the last point of a path: where "has arrived" is measured against
local function path_end(path)
	if not (patrol_exists(path)) then return nil end
	local ok, p = pcall(patrol, path)
	if not (ok and p) then return nil end
	local n = p:count()
	if (not n or n < 1) then return nil end
	local ok2, pos = pcall(p.point, p, n - 1)
	return ok2 and pos or nil
end

local function near(id, pos, radius)
	if not (pos) then return false end
	local go = go_by_id(id)
	if (go) then
		local ok, d = pcall(function() return go:position():distance_to(pos) end)
		if (ok) then return d <= radius end
		return false
	end
	local se = se_by_id(id)
	if not (se) then return false end
	local ok, d = pcall(function() return se.position:distance_to(pos) end)
	return ok and d <= radius
end

-- ============================================================================ destinations
-- A destination is always WALKED as a patrol path, because that is what the stock
-- schemes walk. When the author drew one, that is it. For anything else - a ref,
-- an object, a role, a smart, a restrictor, a position, the player - the engine
-- registers a one-point runtime path at the place (xms.patrol_point, XFined-Ray)
-- and the same walker/camper walks to it: no movement code lives here.
--
-- Runtime paths are POOLED. A name is a slot ("xms_rt_<n>"); a step keeps the slot
-- it took in the instance state, which survives a save, and the slot goes back to
-- the pool when the instance ends. The engine never frees a runtime path - it
-- moves its point - so an NPC still holding a stale one holds nothing dangling.
local RT_PREFIX = "xms_rt_"
local rt_used = {}			-- slot name -> true; rebuilt from the state on load

local function rt_alloc()
	local n = 1
	while (rt_used[RT_PREFIX .. n]) do n = n + 1 end
	local name = RT_PREFIX .. n
	rt_used[name] = true
	return name
end

local function first_living(qs, role)
	for _, id in ipairs(role_ids(qs, role)) do
		if (alive_id(id)) then return id end
	end
	return nil
end

local function object_pos(id)
	local go = go_by_id(id)
	if (go) then
		local ok, pos = pcall(go.position, go)
		if (ok and pos) then return pos end
	end
	local se = se_by_id(id)
	return se and se.position or nil
end

-- Where a destination is RIGHT NOW, or nil when it cannot be said at the moment:
-- the ref is not in the world (yet, or any more), the role is empty, or the place
-- is on another level - a walker walks within a level.
local function destination_pos(ctx, dest)
	if (type(dest) ~= "table") then return nil end
	if (dest.role) then
		local id = first_living(ctx.qs, dest.role)
		return id and object_pos(id) or nil
	end
	if (dest.story) then
		local id = util.id_by_story(dest.story)
		local se = id and se_by_id(id)
		if not (se) then return nil end
		local lvl, here = util.level_name_of_gvid and util.level_name_of_gvid(se.m_game_vertex_id), util.current_level()
		if (lvl and here and lvl ~= here) then return nil end
		return object_pos(id)
	end
	local lvl, pos = util.place_position(dest, ctx)
	if not (pos) then return nil end
	local here = util.current_level()
	if (lvl and here and lvl ~= here) then return nil end
	return pos
end

local function dist3(a, b)
	local dx, dy, dz = a[1] - b.x, a[2] - b.y, a[3] - b.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- Puts a step's runtime path where its destination is now. True when the step
-- may be applied: it has a path of the author's, or its point has just been set.
local function step_ready(ctx, step)
	if not (step.dest) then return true end
	local pos = destination_pos(ctx, step.dest)
	if not (pos) then return false end
	if not (xms and xms.patrol_point) then return false end
	if not (xms.patrol_point(step.path, pos.x, pos.y, pos.z)) then return false end
	step.at = { pos.x, pos.y, pos.z }
	step.lvl = util.current_level()
	return true
end

-- ============================================================================ applying a step
-- What an instance remembers about a step, all of it in the state so a save keeps it:
--   qs.steps[tag]  = { text = <logic>, dest = <destination|nil>, path = <slot|nil>,
--                      at = {x,y,z}, lvl = <level> }
--   qs.applied[id] = tag		what the NPC is running
--   qs.pending[id] = tag		what it will run once it - or its destination - is there
--
-- The one place a behaviour touches an NPC. Everything above builds text; this
-- hands it to the schemes and lets them do what they have always done.
local function apply_now(id, tag, text)
	local go = go_by_id(id)
	if not (go) then return false end
	if not (create_ini_file and xr_logic and modules) then return false end

	local ok, err = pcall(function()
		local ini = create_ini_file(text)
		-- The game restores a "*name" logic file from db.dynamic_ltx when an NPC
		-- comes back from a save (xr_logic.get_customdata_or_ini_file) - the same
		-- table its smart terrains keep their generated job files in. Ours goes
		-- there too, or an NPC saved in the middle of a step loads into a nil ini.
		if (db and db.dynamic_ltx) then db.dynamic_ltx[tag] = ini end
		local section = "logic@" .. tag
		-- gulag_name "" on purpose: paths in a behaviour are the names the author
		-- gave them in the editor, not names to be prefixed with a smart's
		xr_logic.configure_schemes(go, ini, "*" .. tag, modules.stype_stalker, section, "")
		local sect = xr_logic.determine_section_to_activate(go, ini, section, actor())
		xr_logic.activate_by_section(go, ini, sect, "", false)
	end)
	if not (ok) then
		util.err("behaviour: cannot apply '%s' to %s: %s", tag, tostring(id), tostring(err))
		return false
	end
	return true
end

-- Remembers a step. `dest` is a destination nobody drew a path for; its slot is
-- kept across re-entries of the same node so the pool does not grow with them.
local function remember_step(qs, tag, text, dest)
	qs.steps = qs.steps or {}
	local had = qs.steps[tag]
	local step = { text = text }
	if (dest) then
		step.dest = dest
		step.path = (had and had.path) or rt_alloc()
	elseif (had and had.path) then
		rt_used[had.path] = nil
	end
	qs.steps[tag] = step
	return step
end

-- An offline NPC has no game object to take a scheme, and a destination that is
-- not in the world has no point to walk to. Either way the step waits in the
-- instance state (which survives a save) and the tick applies it the moment both
-- are there.
local function apply(ctx, id, tag, text, dest)
	local qs = ctx.qs
	local key = tostring(id)
	-- a node entered again may say something else this time (who to follow, say)
	local step = qs.steps and qs.steps[tag]
	if not (step and step.text == text) then step = remember_step(qs, tag, text, dest) end
	qs.held = qs.held or {}
	qs.held[key] = true
	qs.applied = qs.applied or {}
	qs.pending = qs.pending or {}
	if (step_ready(ctx, step) and apply_now(id, tag, step.text)) then
		qs.applied[key] = tag
		qs.pending[key] = nil
		core.mark_dirty()
		return true
	end
	qs.applied[key] = nil
	qs.pending[key] = tag
	core.mark_dirty()
	return false
end

local function instance_ctx(uid, qs)
	return { uid = uid, qs = qs, refs = qs.refs }
end

local function drain_pending(uid)
	local qs = core.quest_state(uid)
	if not (qs and qs.pending) then return end
	local ctx = instance_ctx(uid, qs)
	for key, tag in pairs(util.copy(qs.pending)) do
		local id = tonumber(key)
		local step = qs.steps and qs.steps[tag]
		if not (id and step) or not (alive_id(id)) then
			qs.pending[key] = nil
			core.mark_dirty()
		elseif (step_ready(ctx, step) and apply_now(id, tag, step.text)) then
			qs.pending[key] = nil
			qs.applied = qs.applied or {}
			qs.applied[key] = tag
			core.mark_dirty()
		end
	end
end

-- Whoever this instance drives still runs what it was given. A smart terrain
-- handing out jobs, a script resetting logic, a load that could not restore the
-- file - anything may take an NPC back; the instance takes it again, quietly.
local function heal_applied(uid)
	local qs = core.quest_state(uid)
	if not (qs and qs.applied and db and db.storage) then return end
	for key, tag in pairs(qs.applied) do
		local id = tonumber(key)
		local st = id and db.storage[id]
		if (st and st.object and st.ini_filename ~= "*" .. tag) then
			local step = qs.steps and qs.steps[tag]
			if (step and alive_id(id) and step_ready(instance_ctx(uid, qs), step)) then
				apply_now(id, tag, step.text)
			end
		end
	end
end

-- Gives an NPC back to whatever owned it. A member of a smart terrain gets its
-- job again; anyone else simply stops being driven, which returns them to the
-- game's own behaviour. Never left in a scheme nothing updates.
local function release(id)
	local go = go_by_id(id)
	if not (go) then return end
	local se = se_by_id(id)
	local smart_id = se and se.m_smart_terrain_id
	if (smart_id and smart_id ~= 65535 and alife()) then
		local smart = alife():object(smart_id)
		if (smart and smart.setup_logic) then
			if (pcall(smart.setup_logic, smart, go)) then return end
		end
	end
	local st = db and db.storage and db.storage[id]
	if (st and st.ini and xr_logic) then
		pcall(xr_logic.switch_to_section, go, st.ini, "nil")
	end
end

local function release_all(uid)
	local qs = core.quest_state(uid)
	if not (qs) then return 0 end
	local n = 0
	for key in pairs(qs.held or {}) do
		local id = tonumber(key)
		if (id) then release(id) n = n + 1 end
	end
	-- the slots go back to the pool and the logic files are forgotten: nobody
	-- runs them any more (release switched every NPC away first)
	for tag, step in pairs(qs.steps or {}) do
		if (step.path) then rt_used[step.path] = nil end
		if (db and db.dynamic_ltx) then db.dynamic_ltx[tag] = nil end
	end
	qs.held = {}
	qs.pending = {}
	qs.applied = {}
	qs.steps = {}
	return n
end

-- ============================================================================ roles
-- A binding is one of the object reference forms of par. 8, or a list of them.
-- Resolution runs against the OWNER's refs, because that is where a ref a quest
-- saved with spawn.squad actually lives.
local function squad_member_ids(se)
	local out = {}
	if not (se) then return out end
	local ok = pcall(function()
		for member in se:squad_members() do
			out[#out + 1] = member.id
		end
	end)
	if not (ok) then out = {} end
	return out
end

local function ids_from_binding(owner_ctx, binding)
	local out = {}
	if (type(binding) ~= "table") then return out end

	-- a list of bindings
	if (#binding > 0 and binding.story == nil and binding.ref == nil and
		binding.squad == nil and binding.community == nil and binding.profile == nil) then
		for _, one in ipairs(binding) do
			for _, id in ipairs(ids_from_binding(owner_ctx, one)) do out[#out + 1] = id end
		end
		return out
	end

	if (binding.squad ~= nil) then
		local sid = util.resolve_target_id(owner_ctx, type(binding.squad) == "table"
			and binding.squad or { ref = binding.squad })
		local se = sid and se_by_id(sid) or nil
		for _, id in ipairs(squad_member_ids(se)) do out[#out + 1] = id end
		return out
	end

	local se = util.resolve_npc_se(owner_ctx, binding)
	if (se) then
		-- a ref may name a squad even without the squad= form
		local members = squad_member_ids(se)
		if (#members > 0) then
			for _, id in ipairs(members) do out[#out + 1] = id end
		else
			out[#out + 1] = se.id
		end
		return out
	end

	-- a whole community, on this level
	if (binding.community and db and db.storage) then
		for id, st in pairs(db.storage) do
			local go = st and st.object
			if (go and util.go_community(go) == binding.community) then out[#out + 1] = id end
		end
	end
	return out
end

local function bind_roles(owner_ctx, scen, bindings, qs, problems)
	qs.roles = {}
	for _, name in ipairs(scen.role_names or {}) do
		local spec = scen.roles[name]
		local binding = (type(bindings) == "table") and bindings[name] or nil
		if (binding == nil) then binding = spec.default end

		local ids = {}
		if (binding ~= nil) then ids = ids_from_binding(owner_ctx, binding) end

		-- dead members are of no use to anyone, and one NPC is a role of one
		local live = {}
		for _, id in ipairs(ids) do
			if (alive_id(id)) then live[#live + 1] = id end
		end
		if (not spec.many and #live > 1) then
			problems[#problems + 1] = string.format("role '%s' takes one NPC, the binding gives %d", name, #live)
			live = { live[1] }
		end
		if (#live == 0 and not spec.optional) then
			problems[#problems + 1] = string.format("role '%s' is bound to nobody", name)
		end
		qs.roles[name] = { ids = live }
	end
end

-- ============================================================================ the instance
local function instance_uid(scen_uid, qs_owner)
	qs_owner.scen_n = (qs_owner.scen_n or 0) + 1
	return scen_uid .. UID_MARK .. tostring(qs_owner.scen_n)
end

local function find_start(q)
	for _, node in ipairs(q.nodes) do
		if (node.kind == "trigger.start") then return node.id end
	end
	return nil
end

-- `ok` is the whole difference between the two exits of behaviour.run: true
-- when the graph reached flow.end by itself, false when it was cut short - the
-- cast died, behaviour.stop said so, or the asset went away with an update.
local function stop_instance(uid, reason, ok)
	if not (is_instance(uid)) then return end
	local qs = core.quest_state(uid)
	if not (qs) then return end
	local owner = qs.owner
	local n = release_all(uid)
	util.info("behaviour %s ended (%s), %d NPC(s) released", uid, tostring(reason), n)
	core.instance_forget(uid)
	if not (any_instance()) then drop_tick() end
	-- the caller hears about it: its ref becomes "done" and the node that has
	-- been waiting leaves by finished or by aborted
	if (type(owner) == "table" and owner.uid and owner.node) then
		local oqs = core.quest_state(owner.uid)
		if (oqs and owner.ref) then
			local rec = oqs.refs[owner.ref]
			if (type(rec) == "table") then
				rec.ended = true
				rec.ok = (ok == true)
				core.mark_dirty()
			end
		end
		core.complete_external(owner.uid, owner.node, (ok == true) and "finished" or "aborted")
	end
end

-- An instance whose asset is gone cannot be restored, so it cannot be stopped
-- the ordinary way either: release what it holds and give the caller its
-- `aborted` exit by hand.
local function stop_instance_gone(uid)
	local qs = core.quest_state(uid)
	local owner = qs and qs.owner
	release_all(uid)
	core.instance_forget(uid)
	if (type(owner) == "table" and owner.uid and owner.node) then
		local oqs = core.quest_state(owner.uid)
		if (oqs and owner.ref and type(oqs.refs[owner.ref]) == "table") then
			oqs.refs[owner.ref].ended = true
			oqs.refs[owner.ref].ok = false
			core.mark_dirty()
		end
		core.complete_external(owner.uid, owner.node, "aborted")
	end
end

-- Walks one pin of a node WITHOUT completing it: the node goes on waiting for
-- its later exit. This is how `started` runs the rest of the quest while the
-- behaviour plays out - the same enqueue the interpreter uses for its own pins.
local function fork(ctx, pin)
	local node = ctx.node
	if not (node and node.out and node.out[pin]) then return end
	for _, tid in ipairs(node.out[pin]) do
		core.enqueue_enter(ctx.uid, tid, tostring(ctx.node_id) .. "/" .. pin)
	end
end

local function instance_of_ref(ctx, ref_name)
	local qs = ctx.qs
	local rec = qs and qs.refs and qs.refs[ref_name]
	if (type(rec) ~= "table") then return nil, nil end
	return rec.instance, rec
end

-- ============================================================================ quest side
K["behaviour.run"] = {
	begin = function(ctx)
		local p = ctx.params
		local scen_uid = tostring(p.asset)
		if not (string.find(scen_uid, ".", 1, true)) then
			scen_uid = tostring(ctx.uid):match("^(.-)%.") .. "." .. scen_uid
		end
		local scen = core.behaviour_def(scen_uid)
		if not (scen) then
			error("behaviour.run: no behaviour graph '" .. scen_uid .. "' in this module")
		end
		local start = find_start(scen)
		if not (start) then
			error("behaviour.run: behaviour graph '" .. scen_uid .. "' has no start node")
		end
		-- A graph may run another one, never itself - directly or through a chain
		-- (the editor's E113). Checked here too: a module is not always built by
		-- the editor, and the alternative is instances spawning instances forever.
		do
			local up, hops = ctx.qs, 0
			while (up and hops < 16) do
				if (up.behaviour == scen_uid) then
					error("behaviour.run: '" .. scen_uid .. "' would run itself")
				end
				local owner = up.owner
				up = (type(owner) == "table" and owner.uid) and core.quest_state(owner.uid) or nil
				hops = hops + 1
			end
		end

		local uid = instance_uid(scen_uid, ctx.qs)
		local qs = core.instance_start(uid, scen)
		qs.behaviour = scen_uid
		qs.owner = { uid = ctx.uid, node = ctx.node_id, ref = p.ref }

		local problems = {}
		bind_roles(ctx, scen, p.roles, qs, problems)
		for _, text in ipairs(problems) do
			util.warn("%s/%s: %s: %s", ctx.uid, ctx.node_id, scen_uid, text)
		end

		if (p.ref) then
			core.ref_set(ctx.qs, p.ref, { kind = "behaviour", instance = uid, behaviour = scen_uid, ended = false })
		end

		local cast = 0
		for _, r in pairs(qs.roles) do cast = cast + #r.ids end
		util.info("behaviour %s started by %s/%s, %d NPC(s)", uid, ctx.uid, ctx.node_id, cast)

		ensure_tick()
		core.instance_arm(uid)

		-- the rest of the caller runs NOW, alongside the behaviour; this node
		-- stays waiting for finished or aborted. Wire whichever you want.
		fork(ctx, "started")
		return "wait"
	end,
	-- the instance tells the node when it is over (stop_instance); the poll is
	-- the safety net for an instance that went away with a save it was not in
	poll = function(ctx)
		local rec = ctx.qs.refs and ctx.params.ref and ctx.qs.refs[ctx.params.ref]
		if (type(rec) == "table" and rec.instance and not core.quest_state(rec.instance)) then
			return "aborted"
		end
		return nil
	end,
}

K["behaviour.stop"] = {
	run = function(ctx, p)
		local uid = instance_of_ref(ctx, p.target)
		if not (uid) then
			util.warn("%s/%s: behaviour.stop: nothing running under ref '%s'", ctx.uid, ctx.node_id, tostring(p.target))
			return
		end
		stop_instance(uid, "behaviour.stop", false)
	end,
}

K["behaviour_running"] = {
	test = function(ctx, p)
		local uid = instance_of_ref(ctx, p.target)
		return uid ~= nil and core.quest_state(uid) ~= nil
	end,
}

K["behaviour_done"] = {
	test = function(ctx, p)
		local uid, rec = instance_of_ref(ctx, p.target)
		if (rec == nil) then return false end
		return uid == nil or core.quest_state(uid) == nil
	end,
}

-- ============================================================================ steps
local function tag_of(ctx, suffix)
	local base = string.gsub(tostring(ctx.uid) .. "_" .. tostring(ctx.node_id), "[^%w_]", "_")
	return base .. (suffix or "")
end

local function switch_tail(p)
	-- nothing switches a behaviour section by itself: the graph decides when the
	-- next step replaces this one, so the section carries no on_* conditions
	return ""
end

-- The path a step walks: the author's own, or the slot of a runtime one. The
-- second value is the destination when there is no drawn path to walk.
local function step_path(ctx, p, kind, tag)
	local dest = p.place
	if (type(dest) ~= "table") then error(kind .. ": no destination") end
	if (dest.path) then
		if not (patrol_exists(dest.path)) then
			error(kind .. ": there is no waypoint path '" .. tostring(dest.path) .. "'")
		end
		return dest.path, nil
	end
	local had = ctx.qs.steps and ctx.qs.steps[tag]
	local slot = (had and had.path) or rt_alloc()
	if (had) then had.path = slot else ctx.qs.steps = ctx.qs.steps or {} ctx.qs.steps[tag] = { path = slot } end
	return slot, dest
end

K["npc.goto"] = {
	begin = function(ctx)
		local p = ctx.params
		if (p.look and p.look ~= "" and not patrol_exists(p.look)) then
			error("npc.goto: there is no waypoint path '" .. tostring(p.look) .. "'")
		end
		local tag = tag_of(ctx)
		local path, dest = step_path(ctx, p, "npc.goto", tag)
		local moving = (p.move == "run") and "rush" or "patrol"
		local text = "[logic@" .. tag .. "]\n" ..
					 "active = walker@" .. tag .. "\n\n" ..
					 "[walker@" .. tag .. "]\n" ..
					 "path_walk = " .. path .. "\n" ..
					 "def_state_moving = " .. moving .. "\n" ..
					 "def_state_standing = guard\n" ..
					 switch_tail(p)
		if (p.look and p.look ~= "" and p.look ~= path) then
			text = text .. "path_look = " .. p.look .. "\n"
		end
		local step = remember_step(ctx.qs, tag, text, dest)
		step.path = dest and path or nil
		for _, id in ipairs(targets(ctx, p)) do
			apply(ctx, id, tag, text, dest)
		end
		if (p.arrive == false) then return { pin = "done" } end
		return "wait"
	end,
	poll = function(ctx)
		local p = ctx.params
		local tag = tag_of(ctx)
		local step = ctx.qs.steps and ctx.qs.steps[tag]
		local radius = p.radius or 3
		local pos
		if (step and step.dest) then
			local now = destination_pos(ctx, step.dest)
			if not (now) then
				-- it was there and it is gone: the graph moves on. It has never
				-- been there: the step is parked, and so is the node.
				if (step.at) then return "done" end
				return nil
			end
			-- a destination that moved takes its path with it, and the people
			-- on their way are sent again - at most once every two seconds
			if (step.at and dist3(step.at, now) > math.max(2, radius)) then
				local w = ctx.w or {}
				if ((w.moved or 0) + 2000 <= (ctx.now and ctx.now.r or 0)) then
					w.moved = ctx.now and ctx.now.r or 0
					if (step_ready(ctx, step)) then
						for key, t in pairs(ctx.qs.applied or {}) do
							if (t == tag) then apply_now(tonumber(key), tag, step.text) end
						end
						core.mark_dirty()
					end
				end
			end
			-- arrival is measured against where the engine put the point: a
			-- case on a table is reached at the foot of the table
			pos = path_end(step.path) or now
		else
			pos = path_end(p.place and p.place.path)
			if not (pos) then return "done" end
		end
		for _, id in ipairs(targets(ctx, p)) do
			if not (near(id, pos, radius)) then return nil end
		end
		-- nobody left alive is also an answer: the graph moves on instead of
		-- waiting for the dead
		return "done"
	end,
}

K["npc.hold"] = {
	run = function(ctx, p)
		local tag = tag_of(ctx)
		local path, dest = step_path(ctx, p, "npc.hold", tag)
		local look = (p.look and p.look ~= "" and p.look ~= path and patrol_exists(p.look)) and p.look or nil
		do
			local text
			if (look) then
				-- camper: digs in and watches the look path
				text = "[logic@" .. tag .. "]\n" ..
					   "active = camper@" .. tag .. "\n\n" ..
					   "[camper@" .. tag .. "]\n" ..
					   "path_walk = " .. path .. "\n" ..
					   "path_look = " .. look .. "\n" ..
					   "radius = " .. tostring(p.radius or 20) .. "\n" ..
					   "shoot = " .. tostring(p.shoot or "always") .. "\n" ..
					   "no_retreat = " .. tostring(p.no_retreat == true) .. "\n"
			else
				-- no direction to watch: stand on the path and fight normally
				text = "[logic@" .. tag .. "]\n" ..
					   "active = walker@" .. tag .. "\n\n" ..
					   "[walker@" .. tag .. "]\n" ..
					   "path_walk = " .. path .. "\n" ..
					   "def_state_standing = guard\n" ..
					   "def_state_moving = patrol\n"
			end
			local step = remember_step(ctx.qs, tag, text, dest)
			step.path = dest and path or nil
			for _, id in ipairs(targets(ctx, p)) do
				apply(ctx, id, tag, text, dest)
			end
		end
	end,
}

K["npc.anim"] = {
	run = function(ctx, p)
		local tag = tag_of(ctx)
		local state = (type(p.state) == "string" and p.state ~= "") and p.state or "wait"
		for _, id in ipairs(targets(ctx, p)) do
			local text = "[logic@" .. tag .. "]\n" ..
						 "active = remark@" .. tag .. "\n\n" ..
						 "[remark@" .. tag .. "]\n" ..
						 "anim = " .. state .. "\n"
			if (p.sound and p.sound ~= "") then text = text .. "snd = " .. p.sound .. "\n" end
			if (type(p.look) == "table") then
				if (p.look.actor) then
					text = text .. "target = story | actor\n"
				elseif (p.look.story) then
					text = text .. "target = story | " .. tostring(p.look.story) .. "\n"
				end
			end
			apply(ctx, id, tag, text)
		end
	end,
}

K["npc.follow"] = {
	run = function(ctx, p)
		local tag = tag_of(ctx)
		-- who to walk after: the player, or one member of another role
		local target_story = nil
		if (type(p.target) == "table" and p.target.actor) then
			target_story = "actor"
		elseif (type(p.target) == "table" and (p.target.ref or p.target.story)) then
			-- something the caller spawned, or an object of the level: a ref has a
			-- story id of its own from the moment it is set (core.ref_set)
			local oid = util.ref_object_id(ctx, p.target)
			local sid = oid and util.story_id_of(oid) or nil
			if (sid) then
				target_story = tostring(sid)
			else
				util.warn("%s/%s: npc.follow: the target is not in the world, following the player instead",
					ctx.uid, ctx.node_id)
			end
		elseif (type(p.target) == "table" and p.target.role) then
			local ids = role_ids(ctx.qs, p.target.role)
			for _, id in ipairs(ids) do
				if (alive_id(id)) then
					local se = se_by_id(id)
					local sid = se and util.story_id_of and util.story_id_of(id) or nil
					if (sid) then target_story = tostring(sid) end
					break
				end
			end
			if not (target_story) then
				util.warn("%s/%s: npc.follow: role '%s' has nobody with a story id to follow",
					ctx.uid, ctx.node_id, tostring(p.target.role))
			end
		end
		if not (target_story) then target_story = "actor" end

		for _, id in ipairs(targets(ctx, p)) do
			local text = "[logic@" .. tag .. "]\n" ..
						 "active = companion@" .. tag .. "\n\n" ..
						 "[companion@" .. tag .. "]\n" ..
						 "behavior = around\n" ..
						 "dist_min = " .. tostring(math.max(1, (p.distance or 3) - 1)) .. "\n" ..
						 "dist_max = " .. tostring(p.distance or 3) .. "\n" ..
						 "sound_idle = state\n"
			if (target_story ~= "actor") then
				text = text .. "target = " .. target_story .. "\n"
			end
			apply(ctx, id, tag, text)
		end
	end,
}

-- Hostility, not a firing solution: the stock combat picks the fight up as soon
-- as the two sides are enemies and nothing tells them to ignore each other.
local function set_enemy(id, other_id)
	local a, b = go_by_id(id), go_by_id(other_id)
	if not (a and b) then return end
	pcall(function() a:force_set_goodwill(-3000, b) end)
	pcall(function() b:force_set_goodwill(-3000, a) end)
end

K["npc.attack"] = {
	run = function(ctx, p)
		local mine = targets(ctx, p)
		local foes = {}

		if (type(p.target) == "table") then
			if (p.target.actor) then
				local a = actor()
				for _, id in ipairs(mine) do
					local go = go_by_id(id)
					if (go and a) then
						pcall(function() go:force_set_goodwill(-3000, a) end)
						pcall(function() go:set_relation(game_object.enemy, a) end)
					end
				end
			elseif (p.target.role) then
				for _, id in ipairs(role_ids(ctx.qs, p.target.role)) do foes[#foes + 1] = id end
			elseif (p.target.community) then
				for _, id in ipairs(mine) do
					local go = go_by_id(id)
					if (go and game_relations and game_relations.set_community_goodwill) then
						pcall(game_relations.set_community_goodwill, util.go_community(go), p.target.community, -3000)
					end
				end
			else
				local se = util.resolve_npc_se(ctx, p.target)
				if (se) then foes[#foes + 1] = se.id end
			end
		end

		for _, id in ipairs(mine) do
			local go = go_by_id(id)
			-- an NPC told to attack must be allowed to start a fight
			if (go and db and db.storage and db.storage[id]) then
				db.storage[id].combat_ignore = nil
			end
			for _, fid in ipairs(foes) do
				if (fid ~= id) then set_enemy(id, fid) end
			end
		end
	end,
}

K["npc.stance"] = {
	run = function(ctx, p)
		local a = actor()
		for _, id in ipairs(targets(ctx, p)) do
			local go = go_by_id(id)
			if (go) then
				if (p.to_actor and a and game_object) then
					local rel = (p.to_actor == "enemy" and game_object.enemy)
							 or (p.to_actor == "friend" and game_object.friend)
							 or game_object.neutral
					pcall(function() go:set_relation(rel, a) end)
				end
				if (type(p.goodwill) == "number" and a) then
					pcall(function() go:force_set_goodwill(p.goodwill, a) end)
				end
				if (p.invulnerable ~= nil) then
					pcall(function() go:invulnerable(p.invulnerable == true) end)
				end
			end
			if (p.combat_ignore ~= nil and db and db.storage and db.storage[id]) then
				db.storage[id].combat_ignore = (p.combat_ignore == true) and {} or nil
			end
		end
	end,
}

K["npc.release"] = {
	run = function(ctx, p)
		local qs = ctx.qs
		for _, id in ipairs(targets(ctx, p)) do
			release(id)
			if (qs.held) then qs.held[tostring(id)] = nil end
			if (qs.pending) then qs.pending[tostring(id)] = nil end
			if (qs.applied) then qs.applied[tostring(id)] = nil end
		end
		core.mark_dirty()
	end,
}

-- ============================================================================ behaviour conditions
K["npc_at_place"] = {
	test = function(ctx, p)
		local dest = p.place
		local pos
		if (type(dest) == "table" and dest.path) then pos = path_end(dest.path)
		else pos = destination_pos(ctx, dest) end
		if not (pos) then return false end
		local any = false
		for _, id in ipairs(targets(ctx, p)) do
			any = true
			if not (near(id, pos, p.radius or 3)) then return false end
		end
		return any
	end,
}

K["npc_in_combat"] = {
	test = function(ctx, p)
		for _, id in ipairs(targets(ctx, p)) do
			local go = go_by_id(id)
			if (go) then
				local ok, e = pcall(go.best_enemy, go)
				if (ok and e) then return true end
			end
		end
		return false
	end,
}

K["role_alive"] = {
	test = function(ctx, p)
		local names = role_names_of(p)
		local seen, living = 0, 0
		for _, name in ipairs(names) do
			for _, id in ipairs(role_ids(ctx.qs, name)) do
				seen = seen + 1
				if (alive_id(id)) then living = living + 1 end
			end
		end
		if (seen == 0) then return false end
		if (p.all == true) then return living == seen end
		return living > 0
	end,
}

-- ============================================================================ module hooks
function register()
	for name, impl in pairs(K) do core.register_kind(name, impl) end
end

-- A save brings the instance state back but not its graph: the definitions come
-- from the scan, so every live instance is put back into the registry here. An
-- instance whose asset is gone after a module update is stopped and released -
-- an NPC is never left standing in a scheme nothing drives any more.
function on_init()
	local state = core.get_state()
	if not (state and state.quests) then return end
	local restored, dropped = 0, 0
	for uid, qs in pairs(util.copy(state.quests)) do
		if (is_instance(uid)) then
			local scen = qs.behaviour and core.behaviour_def(qs.behaviour) or nil
			if (scen) then
				core.instance_restore(uid, scen)
				restored = restored + 1
			else
				-- the asset went away with an update: release, and leave the
				-- caller by `aborted` rather than stranding a node that waits
				util.warn("behaviour %s: the asset is gone, releasing its NPCs", uid)
				stop_instance_gone(uid)
				dropped = dropped + 1
			end
		end
	end
	if (restored > 0 or dropped > 0) then
		util.info("behaviours: %d restored, %d dropped", restored, dropped)
	end
	-- the pool knows what is taken from the state alone, whatever on_game_load saw
	rt_used = {}
	for uid, qs in pairs(state.quests) do
		if (is_instance(uid)) then
			for _, step in pairs(qs.steps or {}) do
				if (step.path) then rt_used[step.path] = true end
			end
		end
	end
	if (any_instance()) then ensure_tick() else drop_tick() end
end

-- BEFORE the first NPC spawns. An NPC saved in the middle of a step comes back
-- naming a logic file ("*<tag>") and perhaps a runtime patrol path, and the game
-- resolves both the moment it spawns - long before init(). So the saved state is
-- read as it is (core.peek_state) and both are put back here: the inis into
-- db.dynamic_ltx, the paths into the engine, on the level they belong to.
function restore_early()
	local st = core.peek_state and core.peek_state() or nil
	if not (st and type(st.quests) == "table") then return end
	local here = util.current_level()
	local inis, paths = 0, 0
	for uid, qs in pairs(st.quests) do
		if (is_instance(uid) and type(qs.steps) == "table") then
			local running = {}
			for _, tag in pairs(qs.applied or {}) do running[tag] = true end
			for tag, step in pairs(qs.steps) do
				if (step.path) then
					rt_used[step.path] = true
					if (step.at and step.lvl == here and xms and xms.patrol_point) then
						if (xms.patrol_point(step.path, step.at[1], step.at[2], step.at[3])) then paths = paths + 1 end
					end
				end
				if (running[tag] and step.text and create_ini_file and db and db.dynamic_ltx) then
					db.dynamic_ltx[tag] = create_ini_file(step.text)
					inis = inis + 1
				end
			end
		end
	end
	if (inis > 0 or paths > 0) then
		util.info("behaviours: %d logic file(s) and %d runtime path(s) put back before the world spawns", inis, paths)
	end
end

function on_game_start()
	RegisterScriptCallback("on_game_load", function()
		local ok, e = pcall(restore_early)
		if not (ok) then util.err("behaviours: early restore failed: %s", tostring(e)) end
	end)
end

-- A reload rebuilds every graph from the assets: whatever was running stops
-- being driven until on_init puts it back.
function on_reload_begin()
	drop_tick()
end

-- The interpreter finished a graph. For an instance that is the end of the
-- behaviour: release everyone and tell the caller that started it.
function on_quest_finish(uid, status)
	if not (is_instance(uid)) then return end
	-- The graph got to flow.end on its own, and that is `finished` - unless it
	-- says it failed (flow.end status = failed is how a graph reports it), or
	-- it ran out over a cast that is dead: steps let a dead role pass so a graph
	-- never waits for the dead, which must not read as "played out as written".
	local qs = core.quest_state(uid)
	local seen, living = 0, 0
	for _, r in pairs((qs and qs.roles) or {}) do
		for _, id in ipairs(r.ids or {}) do
			seen = seen + 1
			if (alive_id(id)) then living = living + 1 end
		end
	end
	local ok = (status ~= "failed") and not (seen > 0 and living == 0)
	stop_instance(uid, status, ok)
end

-- Parked steps are applied here, and an instance whose whole cast is dead ends
-- instead of waiting for people who are not coming back. The engine calls only
-- xms_nq back, so this module asks for the tick itself - once, like the world
-- module does for squad registration.
function tick()
	local state = core.get_state()
	if not (state and state.quests) then return end
	for uid, qs in pairs(util.copy(state.quests)) do
		if (is_instance(uid)) then
			drain_pending(uid)
			heal_applied(uid)
			local seen, living = 0, 0
			for _, r in pairs(qs.roles or {}) do
				for _, id in ipairs(r.ids or {}) do
					seen = seen + 1
					if (alive_id(id)) then living = living + 1 end
				end
			end
			if (seen > 0 and living == 0) then stop_instance(uid, "every role is empty", false) end
		end
	end
end

-- A quest removed this object. Every instance drops it: a role loses the member,
-- a parked step is thrown away, and the held list forgets it - so nothing tries
-- to hand a scheme to something that is being released, and an instance whose
-- whole cast was removed ends instead of waiting for it.
function forget_object(id)
	local st = core.get_state()
	if not (st and st.quests or id == nil) then return end
	local key = tostring(id)
	for uid, qs in pairs(st.quests) do
		if (is_instance(uid)) then
			if (qs.held) then qs.held[key] = nil end
			if (qs.pending) then qs.pending[key] = nil end
			if (qs.applied) then qs.applied[key] = nil end
			for _, r in pairs(qs.roles or {}) do
				for i = #(r.ids or {}), 1, -1 do
					if (r.ids[i] == id) then table.remove(r.ids, i) end
				end
			end
		end
	end
	core.mark_dirty()
end

function kinds() return K end
