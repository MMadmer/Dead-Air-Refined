-- The visor in the rain: what the engine cannot work out for itself.
--
-- The drop field is solved in the renderer (phase_visor_drops) and it needs two things from the
-- game. Neither is a look knob; both are facts only the script layer holds.
--
--   1. HOW HARD THE GLASS IS BEING WETTED, as a rate. The base driver walks r2_lenswater_val by
--      three hundredths once a second toward a level, which is why the old effect arrived in
--      slabs: a level that steps is a picture that steps. The field reads the same console value
--      as a RATE instead, so what it needs is the honest one - level.get_rain_exposure(), the
--      rain density times the real sky cover at the head, pushed every tick rather than
--      a slow ramp pushed once a second. It goes down its own channel, visor_rate: the base
--      driver keeps writing r2_lenswater_val once a second, and in anything but heavy rain what
--      it writes is zero - sharing the float put the rain on and off at one hertz, which the
--      player saw as the drops stopping for a while and starting again.
--
--   2. WHEN A HAND GOES ACROSS IT. The base driver zeroes its accumulator the instant the
--      cleaning animation starts, which is what deleted every drop in one frame. The field
--      cannot be told "you are clean now" - a wipe is a sweep that takes the better part of a
--      second, collects the water ahead of the hand and leaves a smeared film behind it - so it
--      is told when the sweep BEGINS, and it does the rest. Which is not when the player asks:
--      the cleaning item has to become the item in the hands first, and whatever was there has
--      to be put away before that.

local wipe_section = "animation_clean_mask" -- the item the cleaning animation rides on
local wipe_slot = 13
-- When the hand actually reaches the glass, and how long the sweep takes, in seconds. Both belong
-- to the animation and so both live here rather than in the engine. The trigger below is the
-- moment the cleaning item becomes the ACTIVE item, not the moment it is created: the game has to
-- put away whatever was in the hands first, and firing on creation wiped the visor while the
-- player was still watching a rifle being holstered.
local wipe_delay = 0.35
local wipe_len = 0.55

local was_wiping = false
local pushed = -1
local pushed_at = 0

local function mask_worn()
    -- Same test the base driver makes: a mask HUD is up, or the mask HUD is switched off
    -- entirely, in which case the drops are unconditional.
    if not dinamic_hud then
        return true
    end
    local opt = true
    if axr_main and axr_main.config then
        opt = axr_main.config:r_value("mm_options", "enable_mask_hud", 1, false)
    end
    if opt == false then
        return true
    end
    return dinamic_hud.ishud() and true or false
end

local function update()
    if not db.actor then
        return
    end

    -- The wetting rate.
    local rate = 0
    -- get_rain_exposure and NOT get_rain_volume. The volume is a sound level with the old
    -- lighting hemi folded in on purpose - shipped scripts turn it into radiation and campfire
    -- dousing and were tuned against a number that dies at night - so read as a wetting rate it
    -- dried the visor in every night storm and brought the drops back for the length of a
    -- lightning flash. The exposure is density times sky cover and nothing else.
    if mask_worn() and level.rain_factor() ~= 0 then
        rate = level.get_rain_exposure() or 0
        if rate < 0 then rate = 0 elseif rate > 1 then rate = 1 end
    end
    -- Only when it has actually moved, and in any case once a second: the channel is ours, but a
    -- value that is only ever pushed on change is one lost load screen away from being stale.
    local now = time_global()
    if math.abs(rate - pushed) > 0.01 or (now - pushed_at) > 1000 then
        pushed = rate
        pushed_at = now
        get_console():execute(string.format("visor_rate %.3f", rate))
    end

    -- The hand: only once the cleaning item is the ACTIVE one, which is when its own animation
    -- is playing and the hands are free to hold it.
    local wiping = false
    if db.actor:active_slot() == wipe_slot then
        local item = db.actor:item_in_slot(wipe_slot)
        wiping = item and item:section() == wipe_section or false
    end
    if wiping and not was_wiping then
        get_console():execute(string.format("visor_wipe %.2f %.2f", wipe_delay, wipe_len))
    end
    was_wiping = wiping
end

function on_game_start()
    RegisterScriptCallback("actor_on_update", update)
end
