-- One campaign at a time on the new-game screen.
--
-- The РЕЖИМЫ column ships as bare checkboxes: ui_mm_faction_select never
-- registers CHECK_BUTTON_SET for any of them (InitCallBacks only wires the
-- buttons and lists), so every campaign could be ticked at once, every key
-- was written to axr_options, and on_game_load applied all of them - its
-- mode blocks are independent ifs, not elseifs. The three empty stubs the
-- original author left behind - OnCheckSetStory / OnCheckSetAzazel /
-- OnCheckSetSurvival - are where this was meant to live.
--
-- The group is assembled per screen, from three sources:
--   1. the stock campaigns below,
--   2. every mode an XMS module put on the screen (found, not declared),
--   3. anything a mod added through register() at any point before the
--      screen opens.
-- Membership is therefore open: a new campaign joins the rule by existing,
-- not by this file learning about it.

-- ---------------------------------------------------------------------------
-- 1. Stock campaigns. The base game ships no metadata saying which checkbox
-- is a campaign and which is a modifier - the "РЕЖИМЫ / ОПЦИИ" split is two
-- static captions and two x-coordinates - so this list is the one thing that
-- has to be stated outright. It mirrors the modes column as the author laid
-- it out. The options column (easy, hardcore, rerum, good weapons, good loot)
-- stays multi-select on purpose: those are modifiers.
--   registered control name -> how to reach the control on the screen
-- ---------------------------------------------------------------------------
local STOCK = {
	["check_survival"]			= function(s) return s.ck_survival end,
	["check_laststand_mode"]	= function(s) return s.ck_laststand end,
	["check_das_mode"]			= function(s) return s.ck_das end,
	["check_warmon_mode"]		= function(s) return s.ck_warmon end,
	["check_metro_mode"]		= function(s) return s.ck_metro end,
	["check_rev2_mode"]			= function(s) return s.ck_rev2 end,
	["check_rev_mode"]			= function(s) return s.ck_rev end,
}

-- ---------------------------------------------------------------------------
-- 3. Public registry, for a mod that adds a campaign by hand.
--   register("check_my_mode", function(s) return s.ck_my end)
-- unregister() takes one back out - use it when a mode is a modifier that
-- should stack with a campaign rather than replace it.
-- ---------------------------------------------------------------------------
local EXTRA = {}

function register(control_name, accessor)
	if (type(control_name) == "string" and type(accessor) == "function") then
		EXTRA[control_name] = accessor
	end
end

function unregister(control_name)
	EXTRA[control_name] = nil
	STOCK[control_name] = nil
end

-- 2. XMS module modes. The generated registrar keeps its checkboxes in
-- self.xms_checks[<mode id>] and registers each under "main_dialog:check_<id>
-- _mode" - so they can be picked up here without the module declaring
-- anything, and a module built before this rule existed still obeys it.
-- public so it can be inspected/tested without opening the screen
function build_group(screen)
	local group = {}
	for name, get in pairs(STOCK) do
		local box = get(screen)
		if (box) then group[name] = box end
	end
	for name, get in pairs(EXTRA) do
		local ok, box = pcall(get, screen)
		if (ok and box) then group[name] = box end
	end
	if (type(screen.xms_checks) == "table") then
		for id, box in pairs(screen.xms_checks) do
			if (box) then group["main_dialog:check_" .. id .. "_mode"] = box end
		end
	end
	return group
end

-- SetCheck only moves the button state; it does not send CHECK_BUTTON_SET,
-- so clearing the others here cannot re-enter this handler.
local function keep_only(group, chosen)
	for name, box in pairs(group) do
		if (name ~= chosen and box:GetCheck()) then
			box:SetCheck(false)
		end
	end
end

local function install()
	-- _G auto-loads a namespace on first reference; the screen is a plain
	-- class-definition file, so pulling it in at startup has no side effects
	local screen = ui_mm_faction_select
	if not (screen and screen.faction_ui and screen.faction_ui.InitCallBacks) then
		return false
	end

	local base = screen.faction_ui.InitCallBacks
	screen.faction_ui.InitCallBacks = function(self, f)
		base(self, f)
		-- Built here, not at load: InitControls has already run, so module
		-- checkboxes exist, and a late register() has still been seen.
		local group = build_group(self)
		-- Appended after the base pass. Dispatch takes the FIRST callback
		-- matching (control, event), so should the stock screen ever wire
		-- these checkboxes itself, its handler wins and this one goes quiet
		-- instead of fighting it.
		local n = 0
		for name in pairs(group) do
			n = n + 1
			self:AddCallback(name, ui_events.CHECK_BUTTON_SET, function()
				keep_only(group, name)
			end, self)
		end
		-- the count is the answer to "why is my mode still not exclusive"
		printf("* dead_air_x64: %s campaign checkbox(es) made exclusive", n)
	end
	return true
end

-- A build without the DAR2 screen must not take the script engine down at
-- startup: the menu working matters more than this refinement.
local ok, installed = pcall(install)
if not (ok and installed) then
	printf("! dead_air_x64: new-game campaign exclusivity not installed")
end
