-- One campaign at a time on the new-game screen.
--
-- The screen ships its mode checkboxes bare: ui_mm_faction_select registers
-- no CHECK_BUTTON_SET handler for any of them (InitCallBacks wires only the
-- buttons and lists), so every campaign could be ticked at once, every key
-- was written to axr_options, and on_game_load applied all of them - its
-- mode blocks are independent ifs, not elseifs.
--
-- This file is MECHANISM ONLY and knows no checkbox by name. The group is
-- assembled per screen, when it opens, from three sources:
--   1. dead_air_x64_mode_exclusive.ltx - DATA about the installed screen's
--      campaigns (the stock screen is itself a third-party mod; knowledge
--      about somebody else's mod lives in a config, which other mods can
--      patch, never in code);
--   2. every mode an XMS module put on the screen - discovered, not declared:
--      the generated registrar keeps its controls in self.xms_checks[<id>];
--   3. anything registered through the public register() below.
-- Membership is open: a new campaign joins by existing.

local SECTION = "exclusive_campaigns"

-- ---------------------------------------------------------------------------
-- public registry, for a mod that adds a campaign checkbox by hand:
--   dead_air_x64_mode_exclusive.register("check_my_mode")
-- unregister() also vetoes a config entry - use it when something listed
-- should stack (be a modifier) in your setup.
-- ---------------------------------------------------------------------------
local EXTRA, REMOVED = {}, {}

-- fired after a campaign checkbox click settles, with the screen; the module
-- mode dropdown resets itself through this instead of stealing the click -
-- the dispatcher runs only the FIRST callback per (control, event)
on_campaign_picked = nil

function register(control_name)
	if (type(control_name) == "string" and control_name ~= "") then
		EXTRA[control_name] = true
		REMOVED[control_name] = nil
	end
end

function unregister(control_name)
	EXTRA[control_name] = nil
	REMOVED[control_name] = true
end

local function config_names()
	local names = {}
	local ok, err = pcall(function()
		local ini = ini_file("dead_air_x64_mode_exclusive.ltx")
		if not (ini and ini:section_exist(SECTION)) then return end
		for i = 0, ini:line_count(SECTION) - 1 do
			local res, key = ini:r_line(SECTION, i, "", "")
			if (res and key ~= "") then names[key] = true end
		end
	end)
	if not (ok) then
		printf("! dead_air_x64: campaign config unreadable: %s", tostring(err))
	end
	return names
end

-- public so it can be inspected/tested without opening the screen
function build_group(screen)
	local wanted = config_names()
	for name in pairs(EXTRA) do wanted[name] = true end
	for name in pairs(REMOVED) do wanted[name] = nil end

	local group = {}
	-- Register() writes the window name FindChild searches on, so every name
	-- resolves through the screen itself - no field names, no layout guesses.
	-- A control the installed screen does not have simply is not in the group.
	for name in pairs(wanted) do
		local ok, box = pcall(screen.GetCheckButton, screen, name)
		if (ok and box) then group[name] = box end
	end
	-- XMS module modes: the generated registrar keeps its checkboxes right on
	-- the screen instance, so a module joins without declaring anything - and
	-- a module built before this rule existed still obeys it.
	if (type(screen.xms_checks) == "table") then
		for id, box in pairs(screen.xms_checks) do
			local name = "main_dialog:check_" .. tostring(id) .. "_mode"
			if (box and not REMOVED[name]) then group[name] = box end
		end
	end
	return group
end

-- SetCheck only moves the button state; it does not send CHECK_BUTTON_SET,
-- so clearing the others here cannot re-enter this handler.
local function keep_only(group, chosen)
	for name, box in pairs(group) do
		if (name ~= chosen and box:GetCheck()) then
			box:SetCheck(false)
		end
	end
end

local function install()
	-- _G auto-loads a namespace on first reference; the screen is a plain
	-- class-definition file, so pulling it in at startup has no side effects
	local screen = ui_mm_faction_select
	if not (screen and screen.faction_ui and screen.faction_ui.InitCallBacks) then
		return false
	end

	local base = screen.faction_ui.InitCallBacks
	screen.faction_ui.InitCallBacks = function(self, f)
		base(self, f)
		-- Built here, not at load: InitControls has already run, so module
		-- checkboxes exist, and a late register() has still been seen.
		local group = build_group(self)
		-- Appended after the base pass. Dispatch takes the FIRST callback
		-- matching (control, event), so should the screen ever wire these
		-- checkboxes itself, its handler wins and this one goes quiet.
		local n = 0
		for name in pairs(group) do
			n = n + 1
			self:AddCallback(name, ui_events.CHECK_BUTTON_SET, function()
				keep_only(group, name)
				if (on_campaign_picked) then pcall(on_campaign_picked, self) end
			end, self)
		end
		-- the count is the answer to "why is my mode still not exclusive"
		printf("* dead_air_x64: %s campaign checkbox(es) made exclusive", n)
	end
	return true
end

-- A build with a replaced or missing screen must not take the script engine
-- down at startup: the menu working matters more than this refinement.
local ok, installed = pcall(install)
if not (ok and installed) then
	printf("! dead_air_x64: new-game campaign exclusivity not installed")
end
