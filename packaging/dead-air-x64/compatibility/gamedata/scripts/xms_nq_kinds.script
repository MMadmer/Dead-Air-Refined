-- NQ runtime: core kind implementations (triggers, main flow/wait/objective kinds, extra actions,
-- conditions, event conditions). Registered into xms.registry "nq.kinds" by register().
--
-- Kind contract (see NQ_ARCHITECTURE §6.1):
--   main:    begin(ctx) -> {pin=} | {finish={status,restart}} | "wait";  poll(ctx) -> pin|nil;
--            on_event(ctx, evt) -> pin|nil;  finish(ctx, pin, external) (any completion, before
--            on_exit);  cancel(ctx) (token removed without completing);  save(ctx) -> w;
--            load(ctx, w);  events = {"name", ...};  subscribe(ctx) -> {"name", ...};
--            wants_poll(ctx) -> bool
--   trigger: arm(ctx, existed) -> pin|nil (fire at once), poll/on_event as above, plus a second
--            return: `pin, true` routes the pin WITHOUT firing the trigger (no `fired`, no
--            `once`). ctx.trig.owe = pin keeps the node polled while a soft pin is still owed.
--   extra:   run(ctx, params)
--   cond:    test(ctx, params[, evt]) -> bool   (event kinds get the matching evt)
-- Kinds keep only plain data in ctx.w (persisted with the token) and ctx.trig (triggers).

local util = xms_nq_util
local core = xms_nq

local K = {}

-- ============================================================================ shared helpers
local function actor()
	return db and db.actor
end

-- In a dialog the transfer goes through the NPC (UI feedback in the talk window).
local function in_dialog(ctx)
	local a = actor()
	if not (a and ctx and ctx.npc) then return false end
	local ok, talking = pcall(a.is_talking, a)
	return ok and talking and true or false
end

-- `count` and the return value are WHOLE items (ammo: boxes) on both paths. The PDA line is in
-- rounds for ammo, because that is what vanilla dialogs.script prints and both paths must agree.
function give_item(ctx, section, count)
	count = tonumber(count) or 1
	if (in_dialog(ctx) and dialogs and dialogs.relocate_item_section_to_actor) then
		dialogs.relocate_item_section_to_actor(ctx.npc, actor(), section, count)
		return count
	end
	local made = util.give_items(section, count)
	if (made > 0 and news_manager and news_manager.relocate_item) then
		pcall(news_manager.relocate_item, actor(), "in", section, util.news_amount(section, made))
	end
	return made
end

-- Same units as give_item: `count` is whole items ("all" = every one of them), the news is rounds.
function take_item(ctx, section, count)
	if (count == nil) then count = 1 end
	if (in_dialog(ctx) and dialogs and dialogs.relocate_item_section_from_actor) then
		local have = util.count_items(section)
		if (count ~= "all" and have < count) then count = have end
		if (count == "all" or count > 0) then
			dialogs.relocate_item_section_from_actor(ctx.npc, actor(), section, count)
		end
		return count == "all" and have or count
	end
	local removed = util.remove_items(section, count)
	if (removed > 0 and news_manager and news_manager.relocate_item) then
		pcall(news_manager.relocate_item, actor(), "out", section, util.news_amount(section, removed))
	end
	return removed
end

-- PDA tip; text is cp1251 already. sender: npc_ref | game object | icon key string.
function news(ctx, text, sender, duration, icon)
	local a = actor()
	if not (a and news_manager and news_manager.send_tip) then return false end
	local who = nil
	if (type(sender) == "table") then
		who = util.resolve_npc_go(ctx, sender)
	elseif (type(sender) == "userdata") then
		who = sender
	elseif (type(sender) == "string") then
		who = sender
	end
	if (who == nil and type(icon) == "string" and icon ~= "") then who = icon end
	local ms = math.floor((tonumber(duration) or 5) * 1000)
	local ok, e = pcall(news_manager.send_tip, a, util.format_text(ctx, text), nil, who, ms)
	if not (ok) then util.err("news.tip: %s", tostring(e)) end
	return ok
end

local function money_relocate(kind, amount)
	if (news_manager and news_manager.relocate_money) then
		pcall(news_manager.relocate_money, actor(), kind, amount)
	end
end

local function elapsed_since(ctx, since, node_id, duration)
	local secs, is_game = util.duration_secs(duration)
	if not (secs) then return false end
	local qs = ctx.qs
	if not (qs) then return false end
	if (since == "node") then
		-- A named node without a live token reads false: substituting the current node's token
		-- (what `node_id and qs.tokens[node_id] or ctx.tok` used to do) answers a question nobody asked.
		local tok
		if (node_id) then tok = qs.tokens[node_id] else tok = ctx.tok end
		if not (tok) then return false end
		if (is_game) then return (ctx.now.g - (tok.t0 or ctx.now.g)) >= secs end
		return (tok.r or 0) >= secs
	end
	if (is_game) then return (ctx.now.g - (qs.t0 or ctx.now.g)) >= secs end
	return (qs.r or 0) >= secs
end

-- Deadline bookkeeping shared by wait.timer / wait.when timeout: game time in ctx.w, real time
-- as remaining seconds in qs.timers[node] (decremented by ctx.dt while polled).
local function deadline_start(ctx, duration)
	local secs, is_game = util.duration_secs(duration)
	if not (secs) then return false end
	if (is_game) then
		ctx.w.until_g = ctx.now.g + secs
	else
		ctx.qs.timers[ctx.node_id] = { real_left = secs }
	end
	return secs <= 0
end

local function deadline_hit(ctx)
	if (ctx.w.until_g) then return ctx.now.g >= ctx.w.until_g end
	local t = ctx.qs.timers[ctx.node_id]
	if not (t) then return false end
	t.real_left = (t.real_left or 0) - (ctx.dt or 0)
	if (t.real_left <= 0) then return true end
	return false
end

local function first_true_case(ctx, cases, evt, events_only)
	for _, cs in ipairs(cases or {}) do
		local skip = false
		if (events_only == true and not cs.has_event) then skip = true end
		if (events_only == false and cs.all_events) then skip = true end
		if not (skip) then
			if (core.eval_conds(ctx, cs.cond, evt)) then return cs.name end
		end
	end
	return nil
end

-- ============================================================================ triggers
K["trigger.start"] = {
	arm = function(ctx, existed) return "next" end,
}

local function when_cooldown_ok(ctx)
	local trig = ctx.trig
	if not (trig) then return true end
	if (trig.cd_g and ctx.now.g < trig.cd_g) then return false end
	if (trig.cd_r and (ctx.qs.r or 0) < trig.cd_r) then return false end
	return true
end

local function when_set_cooldown(ctx)
	local trig = ctx.trig
	if not (trig) then return end
	local secs, is_game = util.duration_secs(ctx.params.cooldown)
	trig.cd_g, trig.cd_r = nil, nil
	if (secs and secs > 0) then
		if (is_game) then trig.cd_g = ctx.now.g + secs else trig.cd_r = (ctx.qs.r or 0) + secs end
	end
end

-- "repeat" is a Lua keyword, so the asset writes it as ["repeat"] and it can only be read
-- by index. Without it the trigger would re-arm on every falling edge (the core's own
-- trigger_armed() gate happens to stop that today; the kind must not depend on it).
local function when_repeats(ctx)
	return ctx.params ~= nil and ctx.params["repeat"] == true
end

-- The falling edge is only owed when the author wired `off`: an unconnected pin must not keep the
-- trigger polled (nor its quest alive) after it fired.
local function when_off_pin(ctx)
	local edges = ctx.node.out and ctx.node.out.off
	if (edges and #edges > 0) then return "off" end
	return nil
end

K["trigger.when"] = {
	arm = function(ctx, existed)
		-- arming counts as "false": a true condition fires on the first poll (existing state kept).
		-- Nothing is owed yet, so a condition that is never true produces no `off` either.
		if (ctx.trig and not existed) then ctx.trig.last = false end
		return nil
	end,
	-- Only a cond list made entirely of event kinds can skip the poll: anything else (a state cond,
	-- or an `any` mixing the two) may become true with no event to wake it up. A wired `off` needs
	-- the poll in any case - no event reports a condition that stopped holding.
	wants_poll = function(ctx) return (not ctx.node.all_events) or when_off_pin(ctx) ~= nil end,
	poll = function(ctx)
		local trig = ctx.trig
		local v = core.eval_conds(ctx, ctx.node.cond, nil)
		if not (v) then
			if not (trig) then return nil end
			-- falling edge: the `off` owed by the last rising edge goes out exactly once, and
			-- re-arming happens only for repeat triggers (a one-shot one stays latched forever)
			local off = trig.owe
			if (off) then trig.owe = nil core.mark_dirty() end
			if (trig.last and when_repeats(ctx)) then trig.last = false core.mark_dirty() end
			if (off) then return off, true end	-- soft: routes the pin, does not fire the trigger
			return nil
		end
		if (trig and trig.last) then return nil end
		if not (when_cooldown_ok(ctx)) then return nil end
		if (trig) then trig.last = true trig.owe = when_off_pin(ctx) end
		when_set_cooldown(ctx)
		core.mark_dirty()
		return "next"
	end,
	on_event = function(ctx, evt)
		local trig = ctx.trig
		if (trig and trig.last) then return nil end	-- latched: fired once and does not repeat
		if not (core.eval_conds(ctx, ctx.node.cond, evt)) then return nil end
		if not (when_cooldown_ok(ctx)) then return nil end
		-- an event cond is true only for this instant, so the composite falls back to false
		-- right away: repeat triggers re-arm here, one-shot ones latch, and a wired `off`
		-- follows on the next poll for the very same reason.
		if (trig) then trig.last = not when_repeats(ctx) trig.owe = when_off_pin(ctx) end
		when_set_cooldown(ctx)
		core.mark_dirty()
		return "next"
	end,
}

-- ============================================================================ main: wait
K["wait.timer"] = {
	begin = function(ctx)
		if (deadline_start(ctx, ctx.params.duration)) then return { pin = "done" } end
		return "wait"
	end,
	poll = function(ctx)
		if (deadline_hit(ctx)) then return "done" end
		return nil
	end,
}

K["wait.when"] = {
	begin = function(ctx)
		if (core.eval_conds(ctx, ctx.node.cond, nil)) then return { pin = "done" } end
		if (ctx.params.timeout ~= nil) then
			if (deadline_start(ctx, ctx.params.timeout)) then return { pin = "timeout" } end
		end
		return "wait"
	end,
	wants_poll = function(ctx) return (not ctx.node.all_events) or ctx.params.timeout ~= nil end,
	poll = function(ctx)
		if (not ctx.node.all_events and core.eval_conds(ctx, ctx.node.cond, nil)) then return "done" end
		if (ctx.params.timeout ~= nil and deadline_hit(ctx)) then return "timeout" end
		return nil
	end,
	on_event = function(ctx, evt)
		if (core.eval_conds(ctx, ctx.node.cond, evt)) then return "done" end
		return nil
	end,
}

K["wait.any"] = {
	begin = function(ctx)
		local pin = first_true_case(ctx, ctx.params.cases, nil, false)
		if (pin) then return { pin = pin } end
		return "wait"
	end,
	wants_poll = function(ctx)
		for _, cs in ipairs(ctx.params.cases or {}) do
			if not (cs.has_event) then return true end
		end
		return false
	end,
	poll = function(ctx) return first_true_case(ctx, ctx.params.cases, nil, false) end,
	on_event = function(ctx, evt) return first_true_case(ctx, ctx.params.cases, evt, true) end,
}

-- ============================================================================ main: flow
K["flow.branch"] = {
	begin = function(ctx)
		local pin = first_true_case(ctx, ctx.params.cases, nil, nil)
		return { pin = pin or "else" }
	end,
}

K["flow.random"] = {
	begin = function(ctx)
		local cases = ctx.params.cases or {}
		local total = 0
		for _, cs in ipairs(cases) do total = total + (tonumber(cs.weight) or 1) end
		if (total <= 0 or #cases == 0) then return { pin = nil } end
		local roll = math.random() * total
		local acc = 0
		for _, cs in ipairs(cases) do
			acc = acc + (tonumber(cs.weight) or 1)
			if (roll < acc) then return { pin = cs.name } end
		end
		return { pin = cases[#cases].name }
	end,
}

-- The core gates a join by counting arrivals; when it lets the token in, the join is complete.
K["flow.join"] = {
	begin = function(ctx) return { pin = "next" } end,
}

K["flow.step"] = {
	begin = function(ctx) return { pin = "next" } end,
}

K["flow.end"] = {
	begin = function(ctx)
		return { finish = { status = ctx.params.status or "completed", restart = ctx.params.restart == true } }
	end,
}

-- ============================================================================ main: objectives
-- params.count is whole items (ammo: boxes), the unit item.give / item.take hand out.
-- objective.fetch has three forms, kept apart at load time by E022:
--   section (+count)          any items of the section anywhere in the inventory (the original)
--   section (+count) + from   only items that came out of THAT container
--   item                      one concrete object has to end up on the actor

local function actor_id()
	local a = actor()
	if not (a) then return nil end
	local ok, id = pcall(a.id, a)
	if (ok) then return id end
	return nil
end

-- An inventory item names its owner in the server object's parent_id, online and offline alike,
-- so this answers for a stash the player looted on a level nobody is standing on.
local function held_by_actor(id)
	local aid = actor_id()
	if not (id and aid) then return false end
	local se = util.se_by_id(id)
	if not (se) then return false end
	return se.parent_id == aid
end

-- Ids of `section` items sitting inside the container right now, or nil when it cannot be read.
-- get_children works for an offline container too - the usual state of a stash the player has not
-- reached yet; the inventory iterators are the fallback for an engine without that binding.
local function container_item_ids(cid, section)
	local se = util.se_by_id(cid)
	if not (se) then return nil end
	local ids = {}
	local ok = pcall(function()
		for id in alife():get_children(se) do
			local child = util.se_by_id(id)
			if (child and child:section_name() == section) then ids[#ids + 1] = id end
		end
	end)
	if (ok) then return ids end
	local go = util.go_by_id(cid)
	if not (go) then return nil end
	local list, seen = {}, {}
	local collect = function(_, item)
		local iid = item and item:id()
		if (iid and not seen[iid] and item:section() == section) then
			seen[iid] = true
			list[#list + 1] = iid
		end
		return false
	end
	for _, method in ipairs({ "iterate_inventory_box", "iterate_inventory" }) do
		local f = go[method]
		if (f) then pcall(f, go, collect, go) end
	end
	return list
end

-- What to bring, as one list either way: `items` as declared, or the single
-- section+count folded into a one-entry list.
local function fetch_reqs(p)
	if (p.items) then return p.items end
	if (p.section) then return { { section = p.section, count = p.count or 1 } } end
	return nil
end


local function dist_to_actor(se)
	local a = actor()
	if not (a and se and se.position) then return nil end
	local ok, d = pcall(function() return se.position:distance_to(a:position()) end)
	return ok and d or nil
end

-- Candidate hosts for a random pick, all on the actor's level: inventory boxes filtered by
-- how full they are, or corpses. One registry walk per selection, never per frame.
local function loot_candidates(kind, sel)
	local here = util.current_level()
	return util.alife_scan(function(se)
		if (util.level_name_of_gvid(se.m_game_vertex_id) ~= here) then return false end
		if (kind == "corpse") then return util.se_is_corpse(se) end
		if not (util.se_is_invbox(se)) then return false end
		local state = sel.state or "any"
		if (state ~= "any") then
			local n = util.container_count(se.id)
			if (n == nil) then return false end
			if (state == "empty" and n > 0) then return false end
			if (state == "full" and n == 0) then return false end
		end
		return true
	end)
end

-- The radius rules as the author states them: within/beyond bound the candidates (both at
-- once make a ring). Nothing inside the bound falls back to the NEAREST match anywhere for
-- `within`, and to the FARTHEST one for `beyond` - a stash quest must pick something.
local function pick_host(kind, sel)
	local cand = {}
	for _, se in ipairs(loot_candidates(kind, sel)) do
		local d = dist_to_actor(se)
		if (d) then cand[#cand + 1] = { se = se, d = d } end
	end
	if (#cand == 0) then return nil end
	local within, beyond = tonumber(sel.within), tonumber(sel.beyond)
	local pool = {}
	for _, c in ipairs(cand) do
		if ((not within or c.d <= within) and (not beyond or c.d >= beyond)) then pool[#pool + 1] = c end
	end
	local mode = sel.pick or (kind == "corpse" and "nearest" or "random")
	if (#pool == 0) then
		pool = cand
		if (within) then mode = "nearest" elseif (beyond) then mode = "farthest" end
	end
	if (mode == "random") then return pool[math.random(#pool)].se end
	table.sort(pool, function(x, y) return x.d < y.d end)
	return (mode == "farthest") and pool[#pool].se or pool[1].se
end

-- One host id (or a ground position) for one item instance. Errors here happen BEFORE
-- anything is created, and begin retries them - a container another node makes later is
-- simply not there yet, not a broken quest.
local function fetch_host(ctx, sp, cache)
	if (sp.place) then
		if not (cache.ground) then
			local _, pos, lvid, gvid = util.place_position(sp.place, ctx)
			if not (pos and lvid and gvid) then error("fetch spawn: cannot resolve the place") end
			cache.ground = { pos = pos, lvid = lvid, gvid = gvid }
		end
		return nil, cache.ground
	end
	if (sp.into) then
		local id = util.resolve_target_id(ctx, sp.into)
		if not (id) then error("fetch spawn: the 'into' target does not exist (yet)") end
		return id
	end
	if (sp.npc) then
		local id = util.ref_object_id(ctx, sp.npc)
		if not (id) then
			local go = util.resolve_npc_go(ctx, sp.npc)
			id = go and go:id() or nil
		end
		if not (id) then error("fetch spawn: the npc was not found (profile/community need him online)") end
		return id
	end
	if (sp.stash or sp.corpse) then
		local kind = sp.stash and "stash" or "corpse"
		local se = pick_host(kind, sp.stash or sp.corpse)
		if not (se) then error("fetch spawn: nothing on this level matches the " .. kind .. " filters") end
		return se.id
	end
	if (sp.new_corpse) then
		-- one body per plan: the cache remembers it, the owner (a fetch token or a
		-- quest-level job list) is told through on_body so it can put it down later
		if not (cache.body) then
			local _, pos, lvid, gvid = util.place_position(sp.new_corpse.place, ctx)
			if not (pos and lvid and gvid) then error("fetch spawn: cannot resolve the corpse place") end
			local se = alife():create(sp.new_corpse.section, pos, lvid, gvid)
			if not (se) then error("fetch spawn: cannot create " .. tostring(sp.new_corpse.section)) end
			cache.body = se.id
			if (cache.on_body) then cache.on_body(se.id) end
		end
		return cache.body
	end
	error("fetch spawn: empty spawn block")
end

-- Spreads one ground point over the place's radius: N items dropped on one spot pile up
-- into a single unreadable heap, N navmesh points inside the circle read as loot.
local function scatter_ground(ground, radius)
	if not (ground and radius and radius > 0) then return ground end
	local ang, d = math.random() * 2 * math.pi, math.sqrt(math.random()) * radius
	local pos = vector():set(ground.pos.x + math.cos(ang) * d, ground.pos.y, ground.pos.z + math.sin(ang) * d)
	local ok, lvid = pcall(level.vertex_id, pos)
	if (ok and lvid and lvid < 4294967295 and level.valid_vertex_id(lvid)) then
		local ok2, vp = pcall(level.vertex_position, lvid)
		return { pos = (ok2 and vp) or pos, lvid = lvid, gvid = ground.gvid }
	end
	return ground
end

-- ---------------------------------------------------------------------------- item state
local function ini_str(section, key)
	local ok, v = pcall(function()
		local ini = system_ini()
		if not (ini:line_exist(section, key)) then return nil end
		return ini:r_string(section, key)
	end)
	-- a bare `upgrades =` is a live idiom for cancelling an inherited root, and the ini
	-- stores it as nothing at all - an empty value is "absent", not "present but blank"
	if (ok and type(v) == "string" and v ~= "") then return v end
	return nil
end

local function ini_num(section, key)
	local v = ini_str(section, key)
	return v and tonumber(v) or nil
end

local function csv_list(s)
	local out = {}
	if (type(s) ~= "string") then return out end
	for it in string.gmatch(s, "[^,%s]+") do out[#out + 1] = it end
	return out
end

-- The classes the ammo factory actually accepts. box_size alone is NOT the test: the
-- cooking fuels carry it with class = S_EXPLO, and create_ammo smart_casts and THROWs on
-- anything that is not an ammo entity - that is the whole game down, not a caught error.
local AMMO_CLS = { AMMO = true, AMMO_S = true, S_VOG25 = true, S_OG7B = true, S_M209 = true }

local function is_ammo_section(section)
	local cls = ini_str(section, "class")
	return cls ~= nil and AMMO_CLS[cls] == true
end

-- ammo_type is an index into the weapon's OWN ammo_class list, not a section id.
local function ammo_index(section, kind)
	for i, a in ipairs(csv_list(ini_str(section, "ammo_class"))) do
		if (a == kind) then return i - 1 end
	end
	return nil
end

-- What add_upgrade will accept for a section. `upgrades` names GROUPS, a group's `elements`
-- are the ids that install, and an element's `effects` names further groups - so the legal
-- set is a walk. It has to be checked here because add_upgrade validates nothing (an unknown
-- id crashes later, on the client) and FATALs on a duplicate, which no pcall can catch.
local function upgrade_set(section)
	local out, seen, queue = {}, {}, {}
	for _, g in ipairs(csv_list(ini_str(section, "upgrades"))) do queue[#queue + 1] = g end
	local rooted = #queue > 0
	local guard = 0
	while (#queue > 0 and guard < 512) do
		guard = guard + 1
		local g = table.remove(queue)
		if not (seen[g]) then
			seen[g] = true
			for _, el in ipairs(csv_list(ini_str(g, "elements"))) do
				out[el] = true
				for _, nx in ipairs(csv_list(ini_str(el, "effects"))) do
					if not (seen[nx]) then queue[#queue + 1] = nx end
				end
			end
		end
	end
	return out, rooted
end

-- Everything the item's state can carry, written on the SERVER entity before it is
-- registered, so the client twin is built from it. An unset field means FULL: a quest that
-- hands out a rifle means a working rifle, and the engine's own default for a fresh item is
-- a condition of 1 - only the magazine starts empty, so that is the one this fills.
local function apply_item_state(ctx, se, row, section, ammo_is_box)
	if (row.condition ~= nil) then
		-- the engine writes condition through a u8 quantiser that only VERIFYs the range,
		-- and VERIFY is a no-op in release: out of range wraps instead of failing
		local c = tonumber(row.condition) or 1
		if (c < 0) then c = 0 elseif (c > 1) then c = 1 end
		pcall(function() se.condition = c end)
	end
	if not (ammo_is_box) then
		local mag = 0
		pcall(function() mag = se:get_ammo_magsize() or 0 end)
		local rounds = tonumber(row.ammo)
		if (mag > 0) then
			-- said nothing = a full magazine. The server entity starts at zero rounds,
			-- which for a quest reward reads as a broken gift
			if not (rounds) then rounds = mag end
			if (rounds > mag) then rounds = mag end
			if (rounds < 0) then rounds = 0 end
			pcall(function() se:set_ammo_elapsed(rounds) end)
		elseif (rounds) then
			util.warn("%s/%s: item.spawn: '%s' takes no magazine - ammo ignored", ctx.uid, ctx.node_id, tostring(section))
		end
	end
	if (row.ammo_kind ~= nil) then
		local idx = ammo_index(section, row.ammo_kind)
		if (idx) then
			pcall(function() se.ammo_type = idx end)
		else
			util.warn("%s/%s: item.spawn: ammo_kind '%s' is not in the ammo_class of %s - using the first",
				ctx.uid, ctx.node_id, tostring(row.ammo_kind), tostring(section))
		end
	end
	if (row.upgrades ~= nil) then
		-- an id the section cannot install is not "probably fine": add_upgrade validates
		-- nothing and the crash lands later, on the client, in release
		local legal = upgrade_set(section)
		local done = {}
		for _, up in ipairs(csv_list(row.upgrades)) do
			if (done[up]) then
				util.warn("%s/%s: item.spawn: upgrade '%s' is listed twice on %s - dropped",
					ctx.uid, ctx.node_id, up, tostring(section))
			elseif (not legal[up]) then
				util.warn("%s/%s: item.spawn: upgrade '%s' does not belong to %s - skipped",
					ctx.uid, ctx.node_id, up, tostring(section))
			else
				done[up] = true
				local ok = pcall(function() se:add_upgrade(up) end)
				if not (ok) then
					util.warn("%s/%s: item.spawn: upgrade '%s' could not be added to %s",
						ctx.uid, ctx.node_id, up, tostring(section))
				end
			end
		end
	end
end

-- Creates the items of `rows` at a loot_spawn destination. A row is a section, a count and
-- its OWN state - two rifles and a medkit in one list do not share a condition. Returns the
-- flat id list and, alongside it, the ids each row produced (a ref names one row's object).
-- fetch keeps its own plan: it also has to remember hosts and heal losses.
function spawn_items(ctx, where, rows)
	if (type(where) ~= "table") then error("spawn: 'where' is required") end
	for _, r in ipairs(rows) do
		if (r.item) then error("spawn: a concrete-object row cannot be spawned") end
		local ok, exists = pcall(function() return system_ini():section_exist(r.section) end)
		if (ok and exists == false) then error("spawn: item section '" .. tostring(r.section) .. "' does not exist") end
	end
	local qs = ctx.qs
	local cache = { on_body = function(id) core.online_job(qs, id, { kill = true }) end }
	local scatter = where.stash and where.stash.scatter
	local plan, total = {}, 0
	for _, r in ipairs(rows) do total = total + (r.count or 1) end
	local fixed_host, fixed_ground
	if not (scatter) then fixed_host, fixed_ground = fetch_host(ctx, where, cache) end
	local radius = (where.place and total > 1) and util.place_radius(where.place) or 0
	for ri, r in ipairs(rows) do
		for _ = 1, (r.count or 1) do
			local host, ground = fixed_host, fixed_ground
			if (scatter) then host, ground = fetch_host(ctx, where, cache) end
			if (ground and radius > 0) then ground = scatter_ground(ground, radius) end
			plan[#plan + 1] = { ri = ri, row = r, section = r.section, host = host, ground = ground }
		end
	end
	local ids, by_row = {}, {}
	for _, e in ipairs(plan) do
		local hse = e.host and util.se_by_id(e.host)
		if (e.host and not hse) then error("spawn: the host object vanished before the items were made") end
		local pos = (hse and hse.position) or e.ground.pos
		local lvid = (hse and hse.m_level_vertex_id) or e.ground.lvid
		local gvid = (hse and hse.m_game_vertex_id) or e.ground.gvid
		local row, se = e.row, nil
		local host_online = false
		if (hse) then
			local ok, o = pcall(function() return hse.online end)
			host_online = ok and o == true
		end
		if (is_ammo_section(e.section)) then
			-- a box is made with its rounds already in it; create_ammo writes them before
			-- the spawn packet, so it is right even for an online host. 65535 = no parent
			local box = ini_num(e.section, "box_size") or 1
			local n = tonumber(row.ammo) or box
			if (n > box) then n = box end
			if (n < 1) then n = 1 end
			se = alife():create_ammo(e.section, pos, lvid, gvid, e.host or 65535, n)
			if (se) then apply_item_state(ctx, se, row, e.section, true) end
		elseif (e.host and host_online) then
			-- An ONLINE parent makes alife():create build and send the client twin on the
			-- spot, so anything written afterwards reaches the server entity only and the
			-- item in the player's hands has none of it. Build it unregistered, fill it in,
			-- then register - which hands back a NEW entity and destroys this one.
			se = alife():create(e.section, pos, lvid, gvid, e.host, false)
			if (se) then
				apply_item_state(ctx, se, row, e.section, false)
				se = alife():register(se)
			end
		else
			se = e.host and alife():create(e.section, pos, lvid, gvid, e.host)
					   or alife():create(e.section, pos, lvid, gvid)
			if (se) then apply_item_state(ctx, se, row, e.section, false) end
		end
		if (se) then
			local id = se.id
			ids[#ids + 1] = id
			by_row[e.ri] = by_row[e.ri] or {}
			table.insert(by_row[e.ri], id)
		end
	end
	return ids, by_row
end

-- Creates the loot. The plan (a host for every instance) is resolved in full before the
-- first create, so a retried begin never leaves half the items behind.
local function fetch_make_loot(ctx)
	local w, p = ctx.w, ctx.params
	local sp, reqs = p.spawn, fetch_reqs(p)
	for _, r in ipairs(reqs) do
		-- the loader refuses this combination, but a hand-built state must not crash the node
		if (r.item) then error("fetch spawn: a concrete-object row cannot be spawned") end
		local ok, exists = pcall(function() return system_ini():section_exist(r.section) end)
		if (ok and exists == false) then error("fetch spawn: item section '" .. tostring(r.section) .. "' does not exist") end
	end
	local scatter = sp.stash and sp.stash.scatter
	-- the body of a new_corpse lives in the token: it dies the moment it comes online
	-- (see poll) and the items survive into the corpse
	local cache = { body = w.body, on_body = function(id)
		w.body = id
		w.kos = w.kos or {}
		w.kos[id] = true
		core.mark_dirty()
	end }
	local plan = {}
	local fixed_host, fixed_ground
	if not (scatter) then fixed_host, fixed_ground = fetch_host(ctx, sp, cache) end
	for ri, r in ipairs(reqs) do
		for _ = 1, (r.count or 1) do
			local host, ground = fixed_host, fixed_ground
			if (scatter) then host, ground = fetch_host(ctx, sp, cache) end
			plan[#plan + 1] = { ri = ri, section = r.section, host = host, ground = ground }
		end
	end
	w.ids, w.host_of, w.hosts, w.got = {}, {}, {}, w.got or {}
	for _, e in ipairs(plan) do
		local se
		if (e.host) then
			local hse = util.se_by_id(e.host)
			if (hse) then se = alife():create(e.section, hse.position, hse.m_level_vertex_id, hse.m_game_vertex_id, e.host) end
		else
			se = alife():create(e.section, e.ground.pos, e.ground.lvid, e.ground.gvid)
		end
		if (se) then
			w.ids[se.id] = e.ri
			if (e.host) then
				w.host_of[se.id] = e.host
				w.hosts[e.host] = true
			end
		end
	end
	w.spawned = true
	core.mark_dirty()
	ctx.log("fetch: loot spawned (%d instance(s))", #plan)
end

-- A destroyed instance must not dead-end the quest: it is recreated in its host, or at the
-- player's feet when the host itself is gone too.
local function fetch_heal(ctx)
	local w = ctx.w
	local reqs = fetch_reqs(ctx.params)
	local lost = {}
	for id, ri in pairs(w.ids) do
		if (not w.got[id]) and not util.se_by_id(id) then lost[#lost + 1] = { id = id, ri = ri } end
	end
	for _, e in ipairs(lost) do
		w.ids[e.id] = nil
		local section = reqs[e.ri] and reqs[e.ri].section
		local host = w.host_of and w.host_of[e.id]
		local hse = host and util.se_by_id(host)
		local nse
		if (section and hse) then
			nse = alife():create(section, hse.position, hse.m_level_vertex_id, hse.m_game_vertex_id, host)
		elseif (section) then
			local a = actor()
			if (a) then nse = alife():create(section, a:position(), a:level_vertex_id(), a:game_vertex_id()) end
		end
		if (nse) then
			w.ids[nse.id] = e.ri
			if (hse) then w.host_of[nse.id] = host end
			util.warn("%s/%s: quest item %s was destroyed, a replacement was made", ctx.uid, ctx.node_id, tostring(section))
		end
		core.mark_dirty()
	end
end

-- spawn form: exactly the created instances count; once held, an instance stays credited
local function fetch_spawn_done(ctx)
	local w = ctx.w
	local aid = actor_id()
	if (aid) then
		for id in pairs(w.ids) do
			if not (w.got[id]) then
				local se = util.se_by_id(id)
				if (se and se.parent_id == aid) then
					w.got[id] = true
					core.mark_dirty()
				end
			end
		end
	end
	local need = {}
	for ri, r in ipairs(fetch_reqs(ctx.params)) do need[ri] = r.count or 1 end
	for id, ri in pairs(w.ids) do
		if (w.got[id]) then need[ri] = need[ri] - 1 end
	end
	for _, n in ipairs(need) do
		if (n > 0) then return false end
	end
	return true
end

-- `from`: an item is credited only after it has been seen INSIDE the container and then on
-- the actor. w.fs[section] = { seen, got, n }. An identical item picked up anywhere else was
-- never in `seen`, so it cannot move the counter.
local function fetch_from_done(ctx)
	local w, p = ctx.w, ctx.params
	w.fs = w.fs or {}
	local aid = actor_id()
	if not (w.cid) then
		local cid = util.resolve_target_id(ctx, p.from)
		if (cid) then
			w.cid = cid
			core.mark_dirty()
		end
	end
	local done = true
	for _, r in ipairs(fetch_reqs(p)) do
		-- a concrete-object row is already its own proof: it either sits on the actor or not
		if (r.item) then
			if not (held_by_actor(util.resolve_target_id(ctx, r.item))) then done = false end
		else
		local f = w.fs[r.section]
		if not (f) then
			f = { seen = {}, got = {}, n = 0 }
			w.fs[r.section] = f
		end
		if (w.cid and aid) then
			for _, id in ipairs(container_item_ids(w.cid, r.section) or {}) do
				if not (f.seen[id] or f.got[id]) then
					f.seen[id] = true
					core.mark_dirty()
				end
			end
			for id in pairs(f.seen) do
				local se = util.se_by_id(id)
				if not (se) then
					f.seen[id] = nil			-- destroyed out of sight: it can never be credited now
					core.mark_dirty()
				elseif (se.parent_id == aid) then
					f.seen[id] = nil
					f.got[id] = true
					f.n = f.n + 1
					core.mark_dirty()
				end
			end
		end
		if (f.n < (r.count or 1)) then done = false end
		end
	end
	return done
end

local function fetch_done(ctx)
	local p = ctx.params
	if (p.spawn) then return ctx.w.spawned and fetch_spawn_done(ctx) or false end
	if (p.from) then return fetch_from_done(ctx) end
	for _, r in ipairs(fetch_reqs(p) or {}) do
		if (r.item) then
			if not (held_by_actor(util.resolve_target_id(ctx, r.item))) then return false end
		elseif (util.count_items(r.section) < (r.count or 1)) then return false end
	end
	return true
end

-- Where the marker belongs: the hosts of spawned loot (or the loose items themselves),
-- the watched container, or whatever carries the named item right now.
local function fetch_spot_targets(ctx)
	local w, p = ctx.w, ctx.params
	local out = {}
	if (p.spawn) then
		if (w.hosts and next(w.hosts)) then
			for id in pairs(w.hosts) do out[#out + 1] = id end
		elseif (w.ids) then
			for id in pairs(w.ids) do
				if not (w.got[id]) then out[#out + 1] = id end
			end
		end
		return out
	end
	if (p.from and w.cid) then out[#out + 1] = w.cid end
	-- a concrete-object row is findable: mark whatever carries it right now
	for _, r in ipairs(fetch_reqs(p) or {}) do
		if (r.item) then
			local id = util.resolve_target_id(ctx, r.item)
			if (id and not held_by_actor(id)) then out[#out + 1] = util.top_owner(id) end
		end
	end
	return out
end

-- One marker, the task's own: while the node runs, the bound task/step points at the
-- nearest pending target (host, container, carrier or loose item). Collected targets
-- drop out of fetch_spot_targets, so the marker walks the list by itself. Nothing is
-- removed at the end: like a manual retarget, completing the task/step is what takes
-- the marker off the map - and the author wires that on the same pin anyway.
local function fetch_spot_sync(ctx)
	local p = ctx.params
	if not (p.spot_task) then return end
	local ids = fetch_spot_targets(ctx)
	local a, best, bd = actor(), nil, nil
	local ap = a and a:position()
	for _, id in ipairs(ids) do
		local se = util.se_by_id(id)
		if (se) then
			local d2 = ap and ap:distance_to_sqr(se.position) or 0
			if not (best) or (d2 < bd) then best, bd = id, d2 end
		end
	end
	if (best) then xms_nq_task.retarget(ctx, p.spot_task, p.spot_objective, best) end
end

local function fetch_kill_pending(ctx)
	local w = ctx.w
	if not (w.kos) then return end
	for id in pairs(w.kos) do
		local go = util.go_by_id(id)
		if (go) then
			if (go:alive()) then
				pcall(go.kill, go, go)
			else
				w.kos[id] = nil
				core.mark_dirty()
			end
		end
	end
end

K["objective.fetch"] = {
	events = { "item_taken" },
	begin = function(ctx)
		if (ctx.params.spawn and not ctx.w.spawned) then fetch_make_loot(ctx) end
		if (fetch_done(ctx)) then return { pin = "done" } end
		fetch_spot_sync(ctx)
		return "wait"
	end,
	-- the spawn form has work no event covers: healing, pending kills, late spots
	wants_poll = function(ctx) return true end,
	poll = function(ctx)
		fetch_kill_pending(ctx)
		if (ctx.params.spawn and ctx.w.spawned) then fetch_heal(ctx) end
		if (fetch_done(ctx)) then return "done" end
		fetch_spot_sync(ctx)
		return nil
	end,
	on_event = function(ctx, evt)
		-- the single-section form only cares about its own section; every other form has to
		-- look at each pickup, because the event carries no clue where the item came from
		local p = ctx.params
		if (p.from == nil and p.spawn == nil and p.items == nil and evt.section ~= p.section) then return nil end
		if (fetch_done(ctx)) then return "done" end
		return nil
	end,
	load = function(ctx, w)
		-- engine saves keep task markers; re-offer for the task that arrived late
		fetch_spot_sync(ctx)
	end,
	finish = function(ctx, pin, external) xms_nq_task.spot_finish(ctx, pin, external) end,
}

local function reach_anchor_name(ctx) return ctx.node_id .. "_anchor" end

-- Object id used for the map spot: an anchor restrictor for positions, the smart / zone otherwise.
local function reach_spot_target(ctx)
	local place = ctx.params.place
	if (place.smart) then
		local smart = util.smart_by_name(place.smart)
		return smart and smart.id or nil
	end
	if (place.restrictor) then
		-- the spot needs an id whether or not the zone is online, so the server
		-- object answers when db.zone_by_name cannot
		local zone = util.restrictor_zone(ctx, place.restrictor)
		if (zone) then return zone:id() end
		local se = util.restrictor_se(ctx, place.restrictor)
		return se and se.id or nil
	end
	local rec = core.ref_get(ctx.qs, reach_anchor_name(ctx))
	if (rec) then return rec.id end
	local lvl, pos, lvid, gvid = util.place_position(place, ctx)
	if not (pos and lvid and gvid) then return nil end
	local se
	local ok, e = pcall(function() se = alife():create("space_restrictor", pos, lvid, gvid) end)
	if not (ok or se) then
		util.warn("%s/%s: cannot create anchor restrictor: %s", ctx.uid, ctx.node_id, tostring(e))
		return nil
	end
	if not (se) then return nil end
	core.ref_set(ctx.qs, reach_anchor_name(ctx), { id = se.id, kind = "anchor", section = "space_restrictor" })
	return se.id
end

-- Same contract as fetch: spot_task points the bound task's/step's marker at the
-- place (its restrictor, smart, or the anchor a {pos} place spawned).
local function reach_spot_sync(ctx)
	local p = ctx.params
	if not (p.spot_task) then return end
	local id = reach_spot_target(ctx)
	if (id) then
		if (xms_nq_task.retarget(ctx, p.spot_task, p.spot_objective, id)) then ctx.w.sp = id end
	end
end

local function reach_cleanup(ctx)
	local rec = core.ref_get(ctx.qs, reach_anchor_name(ctx))
	-- the marker may point at the anchor this node is about to release: a marker on a
	-- dead id is nonsense, so that one case is cleared. A marker on anything that
	-- outlives the node stays, like after a manual retarget.
	if (rec and ctx.params.spot_task and ctx.w.sp == rec.id) then
		pcall(xms_nq_task.retarget_clear, ctx, ctx.params.spot_task, ctx.params.spot_objective)
		ctx.w.sp = nil
	end
	if (rec) then
		local se = util.se_by_id(rec.id)
		if (se) then pcall(function() alife():release(se, true) end) end
		core.ref_clear(ctx.qs, reach_anchor_name(ctx))
	end
end

K["objective.reach"] = {
	begin = function(ctx)
		if (util.place_contains_actor(ctx.params.place, ctx)) then return { pin = "done" } end
		reach_spot_sync(ctx)
		return "wait"
	end,
	poll = function(ctx)
		if (util.place_contains_actor(ctx.params.place, ctx)) then return "done" end
		-- the bound task may enter the PDA after this node started - keep offering
		reach_spot_sync(ctx)
		return nil
	end,
	load = function(ctx, w)
		-- engine saves keep task markers; this only re-offers when nothing took yet
		reach_spot_sync(ctx)
	end,
	finish = function(ctx, pin, external)
		reach_cleanup(ctx)
		xms_nq_task.spot_finish(ctx, pin, external)
	end,
	cancel = function(ctx) reach_cleanup(ctx) end,
}

-- ============================================================================ extra: items, money
-- What an item action works on: its `items` rows, or the one-line spelling as a single row.
-- The loader has already refused both spellings at once, so `items` simply wins here.
local function item_rows(p)
	if (type(p.items) == "table") then return p.items end
	if (p.section) then return { { section = p.section, count = p.count } } end
	return {}
end

K["item.give"] = {
	run = function(ctx, p)
		for _, r in ipairs(item_rows(p)) do give_item(ctx, r.section, r.count or 1) end
	end,
}

K["item.take"] = {
	run = function(ctx, p)
		for _, r in ipairs(item_rows(p)) do take_item(ctx, r.section, r.count == nil and 1 or r.count) end
	end,
}

-- The rows of an item.spawn. The one-line spelling IS one row, so the state written next to
-- `section` belongs to it - which is why the state keys are legal there and nowhere else
-- beside an `items` list.
local function spawn_rows(p)
	if (p.items) then return p.items end
	if (p.section) then
		return { { section = p.section, count = p.count or 1, condition = p.condition,
				   ammo = p.ammo, ammo_kind = p.ammo_kind,
				   upgrades = p.upgrades, ref = p.ref } }
	end
	return nil
end

-- item.spawn: the destination is a loot_spawn (the forms fetch uses), and every row carries
-- its own state and its own ref.
K["item.spawn"] = {
	run = function(ctx, p)
		if not (p.where) then error("item.spawn: 'where' is required") end
		local rows = spawn_rows(p)
		if not (rows) then error("item.spawn: section or items is required") end
		local _, by_row = spawn_items(ctx, p.where, rows)
		for ri, r in ipairs(rows) do
			local made = r.ref and by_row[ri] or nil
			if (made and made[1]) then
				-- a ref names ONE object; the editor refuses a ref on a row that makes
				-- several, a hand-written asset gets the first and a warning
				if (#made > 1) then
					util.warn("%s/%s: item.spawn: ref '%s' names the first of %d items",
						ctx.uid, ctx.node_id, r.ref, #made)
				end
				core.ref_set(ctx.qs, r.ref, { id = made[1], kind = "item", section = r.section })
			end
		end
	end,
}

K["money.give"] = {
	run = function(ctx, p)
		local a = actor()
		if not (a) then return end
		if (in_dialog(ctx) and dialogs and dialogs.relocate_money_to_actor) then
			dialogs.relocate_money_to_actor(ctx.npc, a, p.amount)
			return
		end
		a:give_money(p.amount)
		money_relocate("in", p.amount)
	end,
}

K["money.take"] = {
	run = function(ctx, p)
		local a = actor()
		if not (a) then return end
		if (in_dialog(ctx) and dialogs and dialogs.relocate_money_from_actor) then
			dialogs.relocate_money_from_actor(ctx.npc, a, p.amount)
			return
		end
		a:give_money(-p.amount)
		money_relocate("out", p.amount)
	end,
}

-- ============================================================================ extra: info, vars, signals, quests
K["info.give"] = {
	run = function(ctx, p) local a = actor() if (a) then a:give_info_portion(p.info) end end,
}

K["info.disable"] = {
	run = function(ctx, p) local a = actor() if (a) then a:disable_info_portion(p.info) end end,
}

K["var.set"] = {
	run = function(ctx, p) core.set_var(ctx.uid, p.name, p.value) end,
}

K["var.add"] = {
	run = function(ctx, p)
		local cur = tonumber(core.get_var(ctx.uid, p.name)) or 0
		core.set_var(ctx.uid, p.name, cur + (tonumber(p.delta) or 0))
	end,
}

K["signal.send"] = {
	run = function(ctx, p)
		core.emit({ name = "signal", signal = p.name, module = ctx.def and ctx.def.module, quest = ctx.uid })
	end,
}

-- "<module>.<quest>" or "<quest>" (own module).
function resolve_quest_uid(ctx, id)
	if (type(id) ~= "string") then return nil end
	if (string.find(id, ".", 1, true)) then return id end
	return (ctx.def and ctx.def.module or "?") .. "." .. id
end

K["quest.activate"] = {
	run = function(ctx, p)
		local uid = resolve_quest_uid(ctx, p.quest)
		if not (core.quest_def(uid)) then error("quest.activate: unknown quest " .. tostring(uid)) end
		core.activate(uid)
	end,
}

-- ============================================================================ extra: ui, actor, sound
K["news.tip"] = {
	run = function(ctx, p) news(ctx, p.text, p.sender, p.duration, p.icon) end,
}

K["map.spot"] = {
	run = function(ctx, p)
		local id = util.resolve_target_id(ctx, p.target)
		if not (id) then error("map.spot: target not found") end
		local spot = p.spot or "secondary_task_location"
		local hint = p.text and util.format_text(ctx, p.text) or ""
		if (level.map_has_object_spot(id, spot) == 0) then level.map_add_object_spot(id, spot, hint) end
	end,
}

K["map.unspot"] = {
	run = function(ctx, p)
		local id = util.resolve_target_id(ctx, p.target)
		if not (id) then return end
		level.map_remove_object_spot(id, p.spot or "secondary_task_location")
	end,
}

K["actor.teleport"] = {
	run = function(ctx, p)
		local a = actor()
		if not (a) then return end
		local lvl = util.place_level(p.place)
		local cur = util.current_level()
		if (lvl and cur and lvl ~= cur) then error("E031: actor.teleport target is on level " .. tostring(lvl) .. ", actor is on " .. tostring(cur)) end
		local _, pos = util.place_position(p.place, ctx)
		if not (pos) then error("actor.teleport: cannot resolve place") end
		a:set_actor_position(pos)
	end,
}

K["sound.play"] = {
	run = function(ctx, p)
		local a = actor()
		if not (a) then return end
		xr_sound.set_sound_play(a:id(), p.theme)
	end,
}

-- Custom Lua is executed by the core (compiled once at load); the entries exist so the kind is
-- known to be implemented.
K["lua"] = {
	run = function(ctx, p) error("lua actions are executed by the core") end,
	test = function(ctx, p) error("lua conditions are executed by the core") end,
}

-- ============================================================================ conds: state
K["has_info"] = {
	test = function(ctx, p) return has_alife_info(p.info) and true or false end,
}

K["has_item"] = {
	-- p.count is whole items (ammo: boxes), same unit as item.give / objective.fetch.
	test = function(ctx, p) return util.count_items(p.section) >= (p.count or 1) end,
}

K["has_money"] = {
	test = function(ctx, p) local a = actor() return a ~= nil and a:money() >= p.amount end,
}

local function compare(op, a, b)
	if (op == "eq") then return a == b end
	if (op == "ne") then return a ~= b end
	local na, nb = tonumber(a), tonumber(b)
	if (na == nil or nb == nil) then return false end
	if (op == "lt") then return na < nb end
	if (op == "le") then return na <= nb end
	if (op == "gt") then return na > nb end
	if (op == "ge") then return na >= nb end
	return false
end

K["var"] = {
	test = function(ctx, p) return compare(p.op or "eq", core.get_var(ctx.uid, p.name), p.value) end,
}

K["node_done"] = {
	test = function(ctx, p) return core.node_done(ctx.uid, p.node) end,
}

K["quest_status"] = {
	test = function(ctx, p) return core.quest_status(resolve_quest_uid(ctx, p.quest)) == p.is end,
}

K["task_status"] = {
	test = function(ctx, p)
		local st = ctx.qs and ctx.qs.tasks and ctx.qs.tasks[p.task] or "none"
		return st == p.is
	end,
}

-- One step of a task, so a graph can branch on "the bread is found but the medkit
-- is not" without splitting the task into two quests.
K["objective_status"] = {
	test = function(ctx, p)
		local per_task = ctx.qs and ctx.qs.objectives and ctx.qs.objectives[p.task]
		local st = per_task and per_task[p.objective] or "none"
		return st == p.is
	end,
}

-- ============================================================================ conds: world
K["actor_on_level"] = {
	test = function(ctx, p) return util.current_level() == p.level end,
}

K["actor_in_place"] = {
	test = function(ctx, p) return util.place_contains_actor(p.place, ctx) end,
}

K["npc_alive"] = {
	test = function(ctx, p)
		local se = util.resolve_npc_se(ctx, p.npc)
		return se ~= nil and util.se_alive(se)
	end,
}

K["npc_dead"] = {
	test = function(ctx, p)
		local se = util.resolve_npc_se(ctx, p.npc)
		return not (se ~= nil and util.se_alive(se))
	end,
}

K["squad_alive"] = {
	test = function(ctx, p)
		local id = util.resolve_target_id(ctx, p.target)
		return id ~= nil and util.se_by_id(id) ~= nil
	end,
}

K["actor_community"] = {
	test = function(ctx, p)
		local a = actor()
		return a ~= nil and util.go_community(a) == p.community
	end,
}

local RELATION_BY_GO = { [0] = "friend", [1] = "neutral", [2] = "enemy" }

local function relation_of(ctx, who)
	local a = actor()
	if not (a) then return nil end
	local go = util.resolve_npc_go(ctx, who)
	if (go and go.relation) then
		local ok, r = pcall(go.relation, go, a)
		if (ok) then return RELATION_BY_GO[r] end
	end
	local comm = who.community
	if not (comm) then
		local se = util.resolve_npc_se(ctx, who)
		comm = se and util.se_community(se) or nil
	end
	if (comm and relation_registry and relation_registry.community_relation) then
		local ok, g = pcall(relation_registry.community_relation, comm, util.go_community(a))
		if (ok and g) then
			local friends = (game_relations and game_relations.FRIENDS) or 1000
			local enemies = (game_relations and game_relations.ENEMIES) or -1000
			if (g >= friends) then return "friend" end
			if (g <= enemies) then return "enemy" end
			return "neutral"
		end
	end
	return nil
end

K["relation"] = {
	test = function(ctx, p) return relation_of(ctx, p.who) == p.is end,
}

K["time_of_day"] = {
	test = function(ctx, p)
		local h = level.get_time_hours()
		if (p.from <= p.to) then return h >= p.from and h <= p.to end
		return h >= p.from or h <= p.to
	end,
}

K["elapsed"] = {
	test = function(ctx, p) return elapsed_since(ctx, p["from"] or p.since or "quest", p.node, p.duration) end,
}

K["chance"] = {
	test = function(ctx, p) return math.random(100) <= (p.percent or 0) end,
}

K["any"] = {
	test = function(ctx, p, evt)
		for _, c in ipairs(p.of or {}) do
			if (core.eval_cond(ctx, c, evt)) then return true end
		end
		return false
	end,
}

-- ============================================================================ conds: events
-- The core calls these only when evt.name matches the kind; tests match the params.
local function item_event(ctx, p, evt)
	return p.section == nil or p.section == evt.section
end

K["event.item_taken"] = { test = item_event }
K["event.item_dropped"] = { test = item_event }
K["event.item_used"] = { test = item_event }

K["event.npc_killed"] = {
	test = function(ctx, p, evt)
		if (p.by_actor and not evt.by_actor) then return false end
		if (p.who == nil) then return true end
		return util.npc_matches(ctx, p.who, { id = evt.id, story = evt.story, profile = evt.profile, community = evt.community })
	end,
}

K["event.squad_dead"] = {
	test = function(ctx, p, evt)
		local t = p.target
		if (type(t) ~= "table") then return false end
		if (t.ref) then
			local rec = core.ref_get(ctx.qs, t.ref)
			return rec ~= nil and rec.id == evt.squad_id
		end
		if (t.story) then return evt.story == t.story end
		return false
	end,
}

K["event.info_given"] = {
	test = function(ctx, p, evt) return evt.info == p.info end,
}

K["event.level_entered"] = {
	test = function(ctx, p, evt) return evt.level == p.level end,
}

local function talk_event(ctx, p, evt)
	if (p.npc == nil) then return true end
	return util.npc_matches(ctx, p.npc, evt.rec or evt.npc)
end

K["event.talk_started"] = { test = talk_event }
K["event.talk_ended"] = { test = talk_event }
K["event.trade_done"] = { test = talk_event }

K["event.signal"] = {
	test = function(ctx, p, evt)
		if (evt.signal == p.name) then return true end
		if (evt.module and (evt.module .. "." .. tostring(evt.signal)) == p.name) then return true end
		return false
	end,
}

-- ============================================================================ registration
function kinds() return K end

function register()
	local n = 0
	for name, impl in pairs(K) do
		if (core.register_kind(name, impl)) then n = n + 1 end
	end
	return n
end
