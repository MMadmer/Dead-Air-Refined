// XMS UI shapes (xrUICore UIShape): boxes, stars, stroke glyphs and solid pictograms computed per
// pixel from signed distances, at the screen's own resolution. Nothing is sampled from a texture,
// so a border stays one sharp pixel and a corner stays round at any size.
//
// Tex0 is the pixel's position relative to the shape's centre, in screen pixels; the vertex
// colour is the fill. The output is premultiplied (xms_ui_shape.s blends ONE, INVSRCALPHA).
#include "common.h"
#include "xms_ui_glyphs.h"

// half width, half height, corner radius, border (a glyph's stroke) width - screen pixels
uniform float4 xms_shape_box;
// the border colour; the empty part of a star
uniform float4 xms_shape_line;
// kind (0 box, 1 star, 2 search, 3 check, 4 cross, 5 chevron, 6 gas mask, 7.. pictograms of
// xms_ui_glyphs.h); y: a star's filled fraction, a gas mask's badge (0 none, 1 done, 2 failed) or a
// box's segment period in pixels (0 = whole); z: the width of the edge's fade in pixels (1 = crisp);
// w: the badge's scale or the empty part of a box's segment, in pixels
uniform float4 xms_shape_mode;

float sd_box(float2 p, float2 b, float r)
{
	float2 q = abs(p) - b + r;
	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

float sd_segment(float2 p, float2 a, float2 b)
{
	float2 pa = p - a;
	float2 ba = b - a;
	float h = saturate(dot(pa, ba) / dot(ba, ba));
	return length(pa - ba * h);
}

// Inigo Quilez's regular five-pointed star: outer radius r, inner radius r * rf; y up
float sd_star5(float2 p, float r, float rf)
{
	const float2 k1 = float2(0.809016994375, -0.587785252292);
	const float2 k2 = float2(-k1.x, k1.y);
	p.x = abs(p.x);
	p -= 2.0 * max(dot(k1, p), 0.0) * k1;
	p -= 2.0 * max(dot(k2, p), 0.0) * k2;
	p.x = abs(p.x);
	p.y -= r;
	float2 ba = rf * float2(-k1.y, k1.x) - float2(0.0, 1.0);
	float h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
	return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y);
}

float sd_ellipse(float2 p, float2 r)
{
	float k0 = length(p / r);
	float k1 = length(p / (r * r));
	return k0 * (k0 - 1.0) / max(k1, 1e-5);
}

float smin(float a, float b, float k)
{
	float h = saturate(0.5 + 0.5 * (b - a) / k);
	return lerp(b, a, h) - k * h * (1.0 - h);
}

// A gas mask seen from the front in units of its half size, y up: a dome over a narrower jaw,
// two lenses cut through, a round filter at the mouth set off by a thin gap, one groove round it.
// A badge on the right cheek, set off the same way, carries a tick (1) or a cross (2) cut through.
float sd_gas_mask(float2 q, float badge, float badge_scale)
{
	float face = smin(sd_ellipse(q - float2(0.0, 0.24), float2(0.62, 0.60)),
		sd_box(q - float2(0.0, -0.20), float2(0.38, 0.34), 0.28), 0.2);
	float can_r = length(q - float2(0.0, -0.58));
	float can = can_r - 0.28;
	float d = min(max(face, 0.06 - can), can);
	d = max(d, 0.03 - abs(can_r - 0.16));
	d = max(d, 0.18 - length(float2(abs(q.x), q.y) - float2(0.27, 0.20)));
	if (badge < 0.5 || badge_scale <= 0.0)
		return d;

	float2 c = q - float2(0.68, -0.30);
	float disc = length(c) - 0.33 * badge_scale;
	d = min(max(d, 0.07 * badge_scale - disc), disc);
	float2 b = c / badge_scale;
	float mark = badge < 1.5 ?
		min(sd_segment(b, float2(-0.15, 0.01), float2(-0.045, -0.10)), sd_segment(b, float2(-0.045, -0.10), float2(0.15, 0.11))) :
		min(sd_segment(b, float2(-0.11, -0.11), float2(0.11, 0.11)), sd_segment(b, float2(-0.11, 0.11), float2(0.11, -0.11)));
	return max(d, (0.06 - mark) * badge_scale);
}

float4 premultiplied(float4 c) { return float4(c.rgb * c.a, c.a); }

// hue (turns), saturation, value to RGB
float3 da_hsv_to_rgb(float3 c)
{
	float3 k = saturate(abs(frac(c.x + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0);
	return c.z * lerp(float3(1.0, 1.0, 1.0), k, c.y);
}

// sRGB to linear and back, exactly
float3 da_to_linear(float3 c) { return lerp(pow((c + 0.055) / 1.055, 2.4), c / 12.92, step(c, 0.04045)); }
float3 da_to_srgb(float3 c) { return lerp(1.055 * pow(max(c, 0.0), 1.0 / 2.4) - 0.055, c * 12.92, step(c, 0.0031308)); }

float4 main(p_TL I) : SV_Target
{
	float2 p = I.Tex0;
	float2 half_size = xms_shape_box.xy;
	float kind = xms_shape_mode.x;
	float soft = max(xms_shape_mode.z, 1.0);
	float4 fill = premultiplied(I.Color);
	float4 edge = premultiplied(xms_shape_line);

	if (kind > 99.5)
	{
		// The colour picker's paints in a box of the corner radius: 100 the hue round a disc and the saturation
		// out from its centre at the value mode.y; 101 the fill blending into the border colour, from the left
		// (from the top when mode.y is 1 or 3; in linear space when it is 2 or 3); 102 every hue along the box
		// (down it when mode.y is 1). The fill's alpha is the paint's opacity.
		float d = sd_box(p, half_size, min(xms_shape_box.z, min(half_size.x, half_size.y)));
		float t = fmod(xms_shape_mode.y, 2.0) > 0.5 ? (p.y + half_size.y) / (2.0 * half_size.y) : (p.x + half_size.x) / (2.0 * half_size.x);
		float4 c;
		if (kind < 100.5)
		{
			float r = min(half_size.x, half_size.y);
			d = length(p) - r;
			float hue = frac(atan2(-p.y, p.x) / 6.2831853 + 1.0);
			c = float4(da_hsv_to_rgb(float3(hue, saturate(length(p) / r), xms_shape_mode.y)), I.Color.a);
		}
		else if (kind < 101.5)
		{
			c = lerp(I.Color, xms_shape_line, saturate(t));
			if (xms_shape_mode.y > 1.5)
				c.rgb = da_to_srgb(lerp(da_to_linear(I.Color.rgb), da_to_linear(xms_shape_line.rgb), saturate(t)));
		}
		else
			c = float4(da_hsv_to_rgb(float3(saturate(t), 1.0, 1.0)), I.Color.a);
		return premultiplied(c) * saturate(0.5 - d / soft);
	}

	if (kind < 0.5)
	{
		// a box: the fill inside the border, the border as a ring of its own width
		float d = sd_box(p, half_size, min(xms_shape_box.z, min(half_size.x, half_size.y)));
		float outer = saturate(0.5 - d / soft);
		float inner = xms_shape_box.w > 0.0 ? saturate(0.5 - (d + xms_shape_box.w) / soft) : outer;
		float4 color = fill * inner + edge * (outer - inner);
		// cut into segments from the left edge, the way Dead Air drew its bars
		float period = xms_shape_mode.y;
		if (period > 0.5)
		{
			float along = g_mod(p.x + half_size.x, period);
			color *= saturate(min(along, period - xms_shape_mode.w - along) + 0.5);
		}
		return color;
	}

	float size = min(half_size.x, half_size.y);
	if (kind < 1.5)
	{
		// a star centred on its own box, filled from the left up to the fraction
		float r = size * 0.98 / 0.951;
		float d = sd_star5(float2(p.x, -p.y + r * 0.0955), r, 0.45);
		float coverage = saturate(0.5 - d);
		float filled = saturate(xms_shape_mode.y * 2.0 * half_size.x - (p.x + half_size.x) + 0.5);
		return lerp(edge, fill, filled) * coverage;
	}

	if (kind > 5.5)
	{
		// a solid pictogram; the border colour glows round it over the border width
		float scale = size * 0.92;
		float2 q = float2(p.x, -p.y) / scale;
		float d = (kind < 6.5 ? sd_gas_mask(q, xms_shape_mode.y, xms_shape_mode.w) : sd_glyph(kind, q)) * scale;
		float coverage = saturate(0.5 - d / soft);
		float glow = xms_shape_box.w > 0.0 ? saturate(1.0 - max(d, 0.0) / xms_shape_box.w) : 0.0;
		return fill * coverage + edge * (glow * glow * (1.0 - coverage));
	}

	// strokes of the border width
	float w = max(xms_shape_box.w, 1.0) * 0.5;
	float d;
	if (kind < 2.5)
	{
		float2 c = float2(-0.18, -0.18) * size;
		float ring = 0.52 * size;
		float2 from = c + normalize(float2(1.0, 1.0)) * ring;
		d = min(abs(length(p - c) - ring), sd_segment(p, from, float2(0.85, 0.85) * size));
	}
	else if (kind < 3.5)
		d = min(sd_segment(p, float2(-0.7, 0.0) * size, float2(-0.2, 0.5) * size),
			sd_segment(p, float2(-0.2, 0.5) * size, float2(0.75, -0.55) * size));
	else if (kind < 4.5)
		d = min(sd_segment(p, float2(-0.6, -0.6) * size, float2(0.6, 0.6) * size),
			sd_segment(p, float2(-0.6, 0.6) * size, float2(0.6, -0.6) * size));
	else
		d = min(sd_segment(p, float2(-0.55, -0.25) * size, float2(0.0, 0.3) * size),
			sd_segment(p, float2(0.0, 0.3) * size, float2(0.55, -0.25) * size));
	return fill * saturate(0.5 - (d - w));
}
