#include "common.h"
#include "sload.h"
#include "da_fade.h"	// the dithered fade across the draw distance
#include "da_puddles.h"	// rain puddles

#define	USE_4_DETAIL

#if defined(USE_TDETAIL) && defined(USE_4_DETAIL)
#	define	USE_4_BUMP
#endif

// Terrain far-field constants (ported from the sibling engine; every zero reproduces the
// stock path bit for bit, so archive shaders against a new DLL and vice versa stay stock).
// da_macro_var:    x = far brightness variation strength, y = 1/coarse uv step,
//                  z = fade start (m), w = fade end (m).
// da_macro_var2:   x = far hue tint to detail mix, y = far macro relief, z = height-based
//                  layer blend, w = mask uv jitter.
uniform float4	da_macro_var;
uniform float4	da_macro_var2;

// Season tint of the ground (docs/dead-air/GRASS.md): the blade grass carries the season only as far as it
// is drawn, and the terrain sets barely change brightness between seasons, so the ground under the grass
// takes the canopy colour of the day - lightly between the near blades, fully where they have faded out.
// The grass cover map is baked per level from the detail slots (da_grass_blades.cpp); da_gtint.y = 0 is off.
uniform float3x4	m_v2w;
uniform float4	da_gcover_xf;		// world xz -> cover map uv: xy scale, zw offset
uniform float4	da_gtint;			// x near strength, y far strength, z fade start (m), w fade end (m)
uniform float4	da_gtint2;			// xy where the blades' basal pairs fade out (m: from d1 to halfway to d2), z where their
									// cover starts to thin (d2), w 1 / the thinning's scale (da_grass_gen.cs grass_taper)
uniform float4	da_gcanopy[16];		// rgb canopy of each blade community at the day (albedo space), w = grass_visible
uniform float4	da_gcanopy_ref[16];	// rgb canopy at the reference day of the latched terrain folder, w = shade under the blades
Texture2D		s_grass_cover;		// r blade grass, g herbs, b shrubs, a dominant blade community / 15
// Row c, the clumps of community c's graminoids (da_grass_blades.cpp fill_clumps): texel 0 its patch size, scattered
// share, species count and mean occlusion of the ground (the rest is da_grass_tufts.cs's).
Texture2D<float4>	s_grass_clumps;
// The tufts' shade on the ground around the camera (da_grass_tufts.cs), a toroidal window: world xz * da_gtuft.x is its
// uv (wrapped); da_gtuft.y = 1 while it is valid, z how far it reaches (m).
Texture2D		s_grass_tufts;
uniform float4	da_gtuft;

#ifdef USE_4_BUMP
f_deffer 	main	( p_bumped I 	)
#else
f_deffer 	main	( p_flat I 		)
#endif
{
	f_deffer	O;

	da_fade_clip( I.hpos_cur );	// a visual crossing its draw distance (da_fade.h)

 	// diffuse
	float4 D		= tbase		(I.tcdh);			// IN:  rgb.a
//	float4 L 	= tex2D		(s_lmap, I.tcdh);
	float4 L 	= s_lmap.Sample( smp_base, I.tcdh);

	float	G	= def_gloss	;

# ifdef	USE_TDETAIL
 # ifdef USE_4_DETAIL
//	float4	mask= tex2D		(s_mask, I.tcdh);
	// Mask uv jitter (r__mask_jitter). What shows at distance is not the layer transition
	// but the MASK itself - a low-res texture whose smooth gradient stretches over tens of
	// metres and reads as a band. Shifting the sample point by coarse-step noise turns the
	// smooth arc into tongues. Coarse scale matters: a fine pattern would mip-average away
	// exactly where the jitter is needed.
	float2	mask_uv = I.tcdh;
	[branch] if (da_macro_var2.w > 0.0001f)
	{
		const float2 n2 = s_dt_r.Sample( smp_base, I.tcdbump * da_macro_var.y).rg - 0.5f;
		mask_uv += n2 * da_macro_var2.w;
	}
	float4	mask= s_mask.Sample ( smp_base, mask_uv);
	float 	mag	= dot 		(mask,1);
			mask= mask/mag	;

	// Pure layer colours first - the weight applies below, after the blend mode is chosen.
	float3	c_R	= s_dt_r.Sample ( smp_base, I.tcdbump);
	float3	c_G	= s_dt_g.Sample ( smp_base, I.tcdbump);
	float3	c_B	= s_dt_b.Sample ( smp_base, I.tcdbump);
	float3	c_A	= s_dt_a.Sample ( smp_base, I.tcdbump);

	// Height-based splatting (r__terrain_blend); zero = the stock linear mix. Linear
	// blending smears a soapy band across every layer seam; here the layer with the HIGHER
	// relief at this point wins and the edge comes out jagged - grass pokes through dirt
	// instead of fading in a stripe. Texture luminance stands in for the missing height
	// maps; the weight MULTIPLIES so an absent layer (weight 0) cannot win by brightness.
	// The 0.2 threshold is the transition width.
	float4	w	= mask;
	[branch] if (da_macro_var2.z > 0.001f)
	{
		const float3 LUM = float3(0.299f, 0.587f, 0.114f);
		float4 wh = mask * (1.0f + float4(dot(c_R,LUM), dot(c_G,LUM), dot(c_B,LUM), dot(c_A,LUM)));
		float  ma = max(max(wh.x, wh.y), max(wh.z, wh.w)) - 0.2f;
		float4 b  = max(wh - ma, 0.0f);
		b /= max(dot(b, 1.0f), 1e-5f);
		w = lerp(mask, b, saturate(da_macro_var2.z));
	}

	float3	d_R	= c_R*w.r;
	float3	d_G	= c_G*w.g;
	float3	d_B	= c_B*w.b;
	float3	d_A	= c_A*w.a;
	float3	dt	= d_R+d_G+d_B+d_A;
		D.rgb	= 2*D.rgb*dt	 ;

  # ifdef USE_4_BUMP

// 	 float4	n_Rt = tex2D	(s_dn_r, I.tcdbump).wzyx;
//	 float4	n_Gt = tex2D	(s_dn_g, I.tcdbump).wzyx;
//	 float4	n_Bt = tex2D	(s_dn_b, I.tcdbump).wzyx;
//	 float4	n_At = tex2D	(s_dn_a, I.tcdbump).wzyx;
 	 float4	n_Rt = s_dn_r.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_Gt = s_dn_g.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_Bt = s_dn_b.Sample ( smp_linear, I.tcdbump).wzyx;
	 float4	n_At = s_dn_a.Sample ( smp_linear, I.tcdbump).wzyx;

	 // The SAME weights as the albedo (w, not mask) - otherwise colour would transition
	 // along one border and relief along another, making the seam visible twice.
 	 float3	n_R = (n_Rt-0.5)*w.r; float g_R=n_Rt.w*w.r;
	 float3	n_G = (n_Gt-0.5)*w.g; float g_G=n_Gt.w*w.g;
	 float3	n_B = (n_Bt-0.5)*w.b; float g_B=n_Bt.w*w.b;
	 float3	n_A = (n_At-0.5)*w.a; float g_A=n_At.w*w.a;

	 float3	mix		= 	n_R+n_G+n_B+n_A;
			mix.z	*=	0.5;		//. make bump twice as contrast (fake, remove me if possible)
	// Far macro relief (r__macro_relief). Colour alone paints a flat plane - a far surface
	// is recognised by light on its bumps, so mix in a coarse detail normal whose period
	// mips do not average away. Only xy, same NaN reasoning as above; same distance ramp as
	// the colour so both grow together instead of drawing two different borders.
	[branch] if (da_macro_var2.y > 0.001f && da_macro_var.x > 0.001f)
	{
		const float d_mr = length(I.position.xyz);
		const float f_mr = saturate((d_mr - da_macro_var.z) / max(da_macro_var.w - da_macro_var.z, 1.0f));
		[branch] if (f_mr > 0.001f)
		{
			const float2 nr = s_dn_r.Sample(smp_linear, I.tcdbump * da_macro_var.y).wz - 0.5f;
			mix.xy += nr * da_macro_var2.y * f_mr;
		}
	}

	 float3	N		= 	mul     	(float3x3(I.M1, I.M2, I.M3), mix.xyz);

	 	 	G 		= 	g_R+g_G+g_B+g_A;
//			G 	= 0			;
//			G 	= mix.w		;		// gloss
  # else
	float3	N 	= I.N.xyz	;
  # endif

 # else
//	D.rgb	= 2*D.rgb*tex2D	(s_detail, I.tcdbump).rgb;
	D.rgb	= 2*D.rgb*s_detail.Sample( smp_base, I.tcdbump).rgb;
 # endif
# else
	float3	N 	= I.N.xyz	;
# endif

	// Only in the detail-layer variant: I.tcdbump exists only there - without the guard the
	// no-detail permutation fails to compile and the engine silently substitutes a stub.
#ifdef USE_4_BUMP
	// Far brightness variation (r__macro_var). Mips average the detail into one colour and
	// distant ground becomes a flat fill; one coarse re-read of the red layer gives large
	// patches whose period survives mipping. Brightness modulation around one, not a colour
	// mix - the ground tone is owned by the base texture and mask, and touching it would
	// drift the hue at the near/far seam.
	[branch] if (da_macro_var.x > 0.001f)
	{
		const float d_mv = length(I.position.xyz);
		const float f_mv = saturate((d_mv - da_macro_var.z) / max(da_macro_var.w - da_macro_var.z, 1.0f));
		[branch] if (f_mv > 0.001f)
		{
			const float3 mv = s_dt_r.Sample(smp_base, I.tcdbump * da_macro_var.y).rgb;
			const float  lum = dot(mv, float3(0.299f, 0.587f, 0.114f));
			D.rgb *= 1.0f + (lum - 0.5f) * 2.0f * da_macro_var.x * f_mv;

			// "Fake grass" (r__macro_tint): pull the far ground HUE towards the detail mix.
			// Real grass ends at r__detail_radius and bare (usually brown) base texture
			// remains - the "grass just stops" cliff. The tint colour comes from dt - the
			// weighted mix of ALL FOUR layers, not the red layer alone: probing at strength
			// one showed the red layer turn distant ground BROWN where it is soil, not
			// grass. Only the hue transfers: the target is scaled to the GROUND's luminance,
			// otherwise a shaded slope would match a lit one and the relief would flatten.
			[branch] if (da_macro_var2.x > 0.001f)
			{
				const float lum_d = dot(D.rgb, float3(0.299f, 0.587f, 0.114f));
				const float lum_t = dot(dt, float3(0.299f, 0.587f, 0.114f));
				const float3 tinted = dt * (lum_d / max(lum_t, 0.001f));
				D.rgb = lerp(D.rgb, tinted, saturate(da_macro_var2.x * f_mv));
			}
		}
	}
#endif
	// The season tint of the ground under and beyond the blade grass, before the puddles so wet darkening
	// still applies on top. Only the hue moves: the canopy colour is scaled to the ground's brightness,
	// times how much brighter the canopy is now than on the day the terrain textures show.
	float sky_open = 1.0f;
	[branch] if (da_gtint.y > 0.001f)
	{
		const float3 Pw = mul(m_v2w, float4(I.position.xyz, 1.0f));
		const float2 cover_uv = Pw.xz * da_gcover_xf.xy + da_gcover_xf.zw;
		const float4 gc = s_grass_cover.SampleLevel(smp_rtlinear, cover_uv, 0);
		// The community is an index: read the nearest texel, never a blend of two.
		uint gw, gh;
		s_grass_cover.GetDimensions(gw, gh);
		const int2 gt = clamp(int2(floor(cover_uv * float2(gw, gh))), int2(0, 0), int2(gw, gh) - 1);
		const uint gp = min(uint(s_grass_cover.Load(int3(gt, 0)).a * 15.0f + 0.5f), 15u);
		const float cover = saturate(gc.r + 0.5f * gc.g) * da_gcanopy[gp].w;
		const float gdist = length(I.position.xyz);
		// As the blades thin past d2 the canopy's colour takes the opening gaps over (fully where they fade out).
		const float gx = max(gdist - da_gtint2.z, 0.0f) * da_gtint2.w;
		const float thin = 1.0f - rsqrt(1.0f + gx * gx);
		const float gk = lerp(da_gtint.x, da_gtint.y, max(saturate((gdist - da_gtint.z) / max(da_gtint.w - da_gtint.z, 1.0f)), thin));
		const float3 LUMW = float3(0.299f, 0.587f, 0.114f);
		const float lum_d = dot(D.rgb, LUMW);
		const float lum_c = max(dot(da_gcanopy[gp].rgb, LUMW), 1e-3f);
		const float ratio = clamp(sqrt(lum_c / max(dot(da_gcanopy_ref[gp].rgb, LUMW), 1e-3f)), 0.75f, 1.33f);
		D.rgb = lerp(D.rgb, da_gcanopy[gp].rgb * (lum_d / lum_c) * ratio, saturate(cover * gk));

		// The tufts' shade on the ground at their foot: inside d2 the very clumps the blades grow in (da_grass_tufts.cs),
		// beyond it their mean. It takes the sky from the ground in any weather (the sun's shade is the blades'
		// casters'), easing out with the blades' thinning, and gathers the litter's shade below under the tufts and
		// out of the gaps between them (a uniform shade lit a lone tuft's foot like bare soil; a darker one turned the
		// gaps black).
		const float4 H0 = s_grass_clumps.Load(int3(0, gp, 0));
		float occ = H0.w * saturate(gc.r), spread = 1.0f, foot = 0.0f;
		const float near_end = min(da_gtint2.z, da_gtuft.z);
		[branch] if (gdist < near_end && da_gtuft.y > 0.5f)
		{
			const float tuft = s_grass_tufts.SampleLevel(smp_base, Pw.xz * da_gtuft.x, 0).r;
			const float far_k = smoothstep(0.7f * near_end, near_end, gdist);
			spread = lerp(min(tuft / max(occ, 0.05f), 2.0f), 1.0f, far_k);
			foot = 0.6f * tuft * (1.0f - far_k) * da_gcanopy[gp].w;
			occ = lerp(tuft, occ, far_k);
		}
		sky_open = 1.0f - 0.75f * occ * da_gcanopy[gp].w * (1.0f - thin);

		// Between the near blades lies the stand's own litter - last year's leaves and straw, matted, in the
		// shade of the live ones - not bare soil: the canopy's colour turned toward a grey-brown thatch at
		// 40-65 % of its value, the ground's own light and dark kept as the litter's grain. A little shade on
		// top (GoT darkens the terrain under its grass with the blades' base occlusion), so the gaps stay below
		// the blades and never glow; both ease out over the far half of the blades' range, where the blades hide
		// the ground anyway.
		// Past the blades' basal pairs (they fade out from d1 to halfway to d2) only the taller layer is drawn, at
		// the pixel rule, and a gap between its blades looks into the stand's lower leaves, not onto its litter:
		// on a slope facing the camera (a hill at 10-40 m) the litter read as dark ground between thin pale
		// strokes. There the ground is the stand's under-layer: the canopy colour with less thatch in it, at
		// 60-75 % of its value - about the mean of the blades with their base occlusion, so the gaps never glow -
		// and less shade on top.
		const float g_near = saturate(gc.r) * (1.0f - smoothstep(0.5f * da_gtint.z, da_gtint.z, gdist));
		const float under = smoothstep(da_gtint2.x, max(da_gtint2.y, da_gtint2.x + 1.0f), gdist);
		const float grain = saturate(lum_d / lum_c);
		const float3 litter = lerp(da_gcanopy[gp].rgb, float3(0.42f, 0.37f, 0.31f), lerp(0.35f, 0.15f, under))
			* lerp(lerp(0.4f, 0.65f, grain), lerp(0.6f, 0.75f, grain), under);
		D.rgb = lerp(D.rgb, litter, lerp(0.65f, 0.85f, under) * g_near * da_gcanopy[gp].w);
		D.rgb *= 1.0f - max(lerp(0.25f, 0.1f, under) * g_near * da_gcanopy_ref[gp].w * spread, foot);
		// The ground's sheen under the grass, as Ghost of Tsushima's (live TerrainGrassSpecNearValue 1, FarValue 0 from
		// FadeStart 0 to FadeEnd 50 m, scaled with its grass quality): the soil keeps its gloss by the camera, where the
		// blades' own casters shade it, and loses it toward d2 (the preset's 25-45 m, where the blades start to thin), so
		// a far meadow has the stand's matte look instead of the bare ground's (a slope against the sun shone like wet
		// earth where no blade is drawn).
		G *= lerp(1.0f, saturate(1.0f - gdist / max(da_gtint2.z, 1.0f)), cover);
	}

	// Puddles and wet ground. Placed here, after everything else: by this point the normal
	// (after detail maps), gloss and colour are all assembled - exactly the three things
	// water changes. The function computes ONLY the mask and normal; colour and gloss are
	// changed right here in the shader body - values returned through inout/struct colour
	// fields did not reach the frame (verified with an absolute-black probe), so the mask
	// is one number applied where D lives.
	// "Rain reaches here" source: where the level is compiled with static sun, the SUN
	// ACCESS from the lightmap (L.w) - zero under a roof by construction; elsewhere the
	// base texture alpha as before (it was how puddles appeared indoors).
#ifdef USE_R2_STATIC_SUN
	const float da_sky_src = L.w;
#else
	const float da_sky_src = D.w;
#endif
	da_puddle_result PDL = da_puddles(I.position.xyz, da_sky_src, N);
	D.w = PDL.hemi * sky_open;

	// G-buffer half switch (r__puddles_gbuf): flat water normal in the G-buffer is what
	// makes deferred lighting treat the surface as level - it gives the water volume and
	// response to lamps and fires, at the price of a thin rim at the mask edge (bumpy
	// ground meets flat water inside one pixel quad). The overlay pass handles only what
	// the G-buffer cannot: reflecting the world.
	[branch] if (da_puddle_look2.w > 0.5f)
	{
		N = PDL.N;

		[branch] if (PDL.dbg_paint)
		{
			D.rgb = PDL.dbg_color;
			G = 0.0f;
		}
		else
		{
			// Damp ground, the soaked rim and the water itself, all three in one call: the
			// Saunderson curve (da_puddles.h / da_wetness.h) instead of three flat multiplies.
			// A single factor darkened wet gravel exactly as hard as wet tar; the curve takes
			// half off a dark albedo and a fifth off a bright one, which IS the difference.
			// Gloss is deliberately left alone - it does not depend on the albedo.
			D.rgb = da_puddle_albedo(D.rgb, PDL);
			G = max(G, PDL.damp * da_puddle_look.z);
			// Gloss by the SOFT mask: it is a scalar, intermediate values are meaningful -
			// a step here drew its OWN line wherever strong light hit (full glint on one
			// side of a pixel, none on the other, visible at campfires).
			G = lerp(G, max(G, saturate(da_puddle_look.x)), PDL.mask);
		}
	}
	else
	{
		// Default half (r__puddles_gbuf 0): the water keeps the ground's own normal. A flat
		// normal under a directional sun lights a whole puddle as ONE highlight - dot(H,N) is
		// the same across a plane - and at noon every puddle was a sheet of white whatever the
		// gloss. On the bumpy normal the sun breaks into the sparkle a rain-rippled puddle
		// shows. Darkening and the rim stay, the gloss only the damp ground's: the reflection
		// pass adds the fresnel-weighted mirror and a tight sun glint. The water's own gloss
		// (half of r__puddles_gloss, 0.2 in the buffer) is the specular model's f0 of 0.16
		// (lmodel.h), eight times water's: under a bright overcast every puddle seen from above
		// mirrored a sixth of the sky and a meadow after a rain read as snow.
		[branch] if (PDL.dbg_paint)
		{
			D.rgb = PDL.dbg_color;
			G = 0.0f;
		}
		else
		{
			// The same one call as the branch above - the two halves have to darken
			// identically or the r__puddles_gbuf switch would also change the colour.
			D.rgb = da_puddle_albedo(D.rgb, PDL);
			G = max(G, PDL.damp * da_puddle_look.z);
		}
	}

	// hemi, sun, material
	float 	ms	= xmaterial	;
# ifdef USE_R2_STATIC_SUN
		 	ms 	= L.w		;
# endif

  // Ground under the puddle mask: flagged in the G-buffer for the reflection pass, which
  // then paints water only here and never on the grass or the leaves above a puddle.
  da_gbuf_ground = (PDL.mask > 0.001f) ? 1u : 0u;

  // 2. Standart output
  float4     Ne = float4	(normalize(N), 									D.w*H_TERR			);
  O				= pack_gbuffer(
								Ne,	// hemi
								float4 	(I.position.xyz + Ne.xyz*def_virtualh/2.h, 	ms			),	//
								sat(float4(D.x,D.y,D.z,G*0.4),0.8));	// OUT: rgb.gloss

	// Motion vector (da_velocity.h)
	O.velocity = da_velocity(I.hpos_cur, I.hpos_prev);
  return O;
}
