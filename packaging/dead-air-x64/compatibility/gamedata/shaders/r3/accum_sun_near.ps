#include "common.h"
#include "lmodel.h"

// How far a foliage receiver moves toward the sun before its shadow test (m, view space).
#define DA_FOLIAGE_SHADOW_PUSH	0.03f

#ifdef USE_MINMAX_SM
#define SM_MINMAX
#endif

// Stock ladder: SUN_QUALITY 3 (ultra) takes the 7x7 Gather kernel, 4 (extreme) the PCSS
// blocker search whose penumbra widens with the occluder distance (shadow.h, shadow_hw_hq).
// The path was once retired for a per-cascade PCF kernel that shadow_hw no longer carries;
// without it the top two tiers silently fell back to the plain 4-tap PCF of "high".
#if SUN_QUALITY>2
#define ULTRA_SHADOWS_ON
#endif //	SUN_QUALITY>2

#ifdef ULTRA_SHADOWS_ON
#define USE_ULTRA_SHADOWS
#endif

#include "shadow.h"
#include "da_sss.h"	// screen-space contact shadows, r__sss (off by default)
#include "da_rt_consumer.h"	// ray traced sun shadow (DirectX 12, RTX)

// The seam between this cascade and the next (r4_rendertarget_accum_direct.cpp da_set_sun_blend): over the outer band of
// this map's square a share of the pixels - growing to all of them at its edge, by interleaved gradient noise that turns
// with the frame under the temporal resolve - is left to the next cascade (it takes the pixels this pass does not mark
// in the stencil). Each map holds its own casters (the vegetation's leaves near, its clusters in the middle, its blobs
// far), so a hard seam showed the shadows round the player sharpening into detail at once as it swept over them.
// x: the band (a share of the map's half-width), y: the frame (0 without the temporal resolve), z: 1 when a next
// cascade takes the pixels; m_shadow_next: the next map's transform (its square, which must hold the pixel).
uniform float4		da_sun_blend;
uniform float4x4	m_shadow_next;

void	da_sun_cascade_seam	(float4 P4, float4 PS, float2 pix)
{
	[branch] if (da_sun_blend.z > 0.5f)
	{
		const float2 uv = PS.xy / PS.w;
		const float edge = max(abs(uv.x - 0.5f), abs(uv.y - 0.5f)) * 2.0f;
		const float w = saturate((edge - (1.0f - da_sun_blend.x)) / max(da_sun_blend.x, 1e-4f));
		[branch] if (w > 0.0f)
		{
			const float4 PN = mul(m_shadow_next, P4);
			const float2 un = PN.xy / PN.w;
			const float2 p = pix + 5.588238f * da_sun_blend.y;
			const float ign = frac(52.9829189f * frac(dot(p, float2(0.06711056f, 0.00583715f))));
			if (max(abs(un.x - 0.5f), abs(un.y - 0.5f)) < 0.49f && ign < w)
				discard;
		}
	}
}

#ifdef USE_SUNFILTER
#ifdef MSAA_OPTIMIZATION
float4 main ( v2p_volume I, uint iSample : SV_SAMPLEINDEX  ) : SV_Target
#else
float4 main ( v2p_volume I  ) : SV_Target
#endif
{
	//float4 _P = tex2D( s_position, tc );

	gbuffer_data gbd = gbuffer_load_data( GLD_P(I.tc, I.hpos, ISAMPLE) );

	// The receiver's offset against shadow acne. Two-sided foliage (the blade grass) moves TOWARD the sun
	// instead: the stock push along N carries a back-lit blade behind its own caster, and the sunlight
	// through it (lmodel.h) would be shadowed by the blade itself.
	[branch] if (da_is_foliage(gbd.mtl))
		gbd.P -= Ldynamic_dir.xyz * DA_FOLIAGE_SHADOW_PUSH;
#ifdef	GBUFFER_OPTIMIZATION
	else
		gbd.P += gbd.N*0.015f;	//	Emulate virtual offset
#endif	//	GBUFFER_OPTIMIZATION

	float4 _P = float4( gbd.P, 1.f);

	float4 PS = mul( m_shadow,  _P );
	da_sun_cascade_seam( _P, PS, I.hpos.xy );

	float s	= shadowtest_sun( PS, I.tcJ ) * sunmask( _P );
	[branch] if ( da_rt.y > 0.5f )
		s *= s_rt_sun.Load( int3( I.hpos.xy, 0 ) );

	return s;
}
#else
#ifdef MSAA_OPTIMIZATION
float4 main ( v2p_volume I,  uint iSample : SV_SAMPLEINDEX ) : SV_Target
#else
float4 main ( v2p_volume I ) : SV_Target
#endif
{
	//float4 	_P	= tex2D( s_position, tc );
	//float4	_N	= tex2D( s_normal, tc );

	gbuffer_data gbd = gbuffer_load_data( GLD_P(I.tc.xy/I.tc.w, I.hpos, ISAMPLE) );

	// The receiver's offset against shadow acne. Two-sided foliage (the blade grass) moves TOWARD the sun
	// instead: the stock push along N carries a back-lit blade behind its own caster, and the sunlight
	// through it (lmodel.h) would be shadowed by the blade itself.
	[branch] if (da_is_foliage(gbd.mtl))
		gbd.P -= Ldynamic_dir.xyz * DA_FOLIAGE_SHADOW_PUSH;
#ifdef	GBUFFER_OPTIMIZATION
	else
		gbd.P += gbd.N*0.015f;	//	Emulate virtual offset
#endif	//	GBUFFER_OPTIMIZATION

	float4 _P = float4( gbd.P, gbd.mtl );
	float4  _N = float4( gbd.N, gbd.hemi );

	// ----- shadow
	float4 	P4 	= float4( _P.x, _P.y, _P.z, 1.f);
	float4 	PS	= mul( m_shadow, P4 );
	da_sun_cascade_seam( P4, PS, I.hpos.xy );
	float 	s 	= sunmask( P4 );
	#if defined	(USE_SJITTER) || SUN_QUALITY==2 // Hight quality
			s 	*= shadow_high(PS); //shadowtest_sun( PS, float4(0,0,0,0) );
	#else
#ifdef SM_MINMAX
		#ifdef USE_SJITTER
			s 	*= shadow_dx10_1( PS, I.tcJ, I.hpos.xy );
		#else
			s *= shadow( PS );
		#endif
#else
			s *= shadow( PS );
#endif
	#endif

	// Ray traced sun shadow of the static world (dxr.md 3.5): while it runs, the near and middle
	// maps no longer hold the static casters (vegetation, characters and moving objects stay in
	// them and keep swaying), so the two multiply.
	[branch] if ( da_rt.y > 0.5f )
		s *= s_rt_sun.Load( int3( I.hpos.xy, 0 ) );

	[branch] if (s <= 0.0f)
		return 0.0f;

	// Contact shadows only where the shadow map still leaves light: pixels the map already
	// shadows took the early-out above, so the ray march is never paid for them.
	// Faded out toward grazing sun: the interpolated vertex normal calls a pixel lit while
	// the flat depth facet under it is already turned past the light, and the ray then dives
	// behind its own surface on the first step - on a low-poly skinned model that is a dark
	// line along every edge near the terminator. Below N.L = 0.3 the sun term is small anyway.
	const float sss = da_screen_space_shadow( _P.xyz, Ldynamic_dir.xyz, I.hpos.xy );
	s *= lerp( 1.0f, sss, saturate( dot( _N.xyz, -Ldynamic_dir.xyz ) / 0.3f ) );
	[branch] if (s <= 0.0f)
		return 0.0f;

	// ----- light-model
	float	m	= xmaterial;
# ifndef USE_R2_STATIC_SUN
			m 	= _P.w;
# endif
	float4	light	= plight_infinity ( m, _P, _N, Ldynamic_dir );

	return 		blend( Ldynamic_color * light * s/*float4( 1.f, 0.2f, 0.2f, 1.f)*/, I.tc );
}
#endif
