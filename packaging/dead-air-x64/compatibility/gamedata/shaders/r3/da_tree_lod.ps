// [DA] The upgraded trees' far billboards (da_trees.cpp render_extra, docs/dead-air/TREES.md "The billboards"): lod.ps
// as it is, its one change the material - the foliage's codes the trees' near tiers write (da_shrub_cluster.ps), where
// the bake found leaves (da_trees_bake.cpp: the foliage atlas, the share of a texel that is leaves and their
// translucency), so the light through a forest's leaves against the sun goes on past the billboards' distance. The
// stock path's billboards keep lod.ps.
#if ( defined(MSAA_ALPHATEST_DX10_1_ATOC) || defined(MSAA_ALPHATEST_DX10_1) )
#define EXTEND_F_DEFFER
#endif

#include "common.h"
#include "sload.h"

// x = hemi share, y = saturation, z = brightness (r__lod_* knobs; 1/1/1 = stock).
uniform float4	da_lod_tune;
// x the frame (0 .. 63) the foliage codes' dither turns with, as the near tiers' (0 without motion vectors).
uniform float4	da_tree_lod;
// The bake's foliage atlas (half the pair's size): r the share of the texel that is leaves, g their translucency over the
// codes' least, of their span (da_material_codes.h).
Texture2D	s_tree_mtl;

struct 	vf
{
	float3	position	: TEXCOORD0;
 	float2	tc0			: TEXCOORD1;	// base0
 	float2	tc1			: TEXCOORD2;	// base1
	float4	af			: COLOR1;		// alpha&factor
	float4	hpos_cur	: TEXCOORD7;	// motion vector (da_velocity.h)
	float4	hpos_prev	: TEXCOORD8;
	float4	hpos		: SV_Position;
};

void sample_Textures( inout float4 D, inout float4 H, float2 tc1, float2 tc0, float4 af, float2 pixeloffset )
{
  float2 ddx_tc0 = ddx( tc0 );
  float2 ddy_tc0 = ddy( tc0 );
  float2 ddx_tc1 = ddx( tc1 );
  float2 ddy_tc1 = ddy( tc1 );

  float4 D1 	= s_base.Sample( smp_base, tc1 + pixeloffset.x * ddx_tc1 + pixeloffset.y * ddy_tc1 );
  float4 D0 	= s_base.Sample( smp_base, tc0 + pixeloffset.x * ddx_tc0 + pixeloffset.y * ddy_tc0 );
  float4 H0 	= s_hemi.Sample( smp_linear, tc0 + pixeloffset.x * ddx_tc0 + pixeloffset.y * ddy_tc0 );	H0.xyz 	=  H0.rgb*2-1;	// expand
  float4 H1 	= s_hemi.Sample( smp_linear, tc1 + pixeloffset.x * ddx_tc1 + pixeloffset.y * ddy_tc1 );	H1.xyz 	=  H1.rgb*2-1;	// expand

  D 	= lerp		(D0,D1,af.w);		D.w	*= af.z;	// multiply alpha
  H 	= lerp		(H0,H1,af.w);		H.w	*= af.x;	// multiply hemi
}

// The pixel's material: a foliage code with the share of the texel that is leaves (each pixel's choice dithered, the
// codes' own dither on top: their expectation the leaves' translucency), the leaves' translucency as the near tiers turn
// it - the least away from the sun, the leaves' own looking into it (da_shrub_common.h shrub_translucency); else lod.ps's.
float	tree_lod_mtl	( float2 tc1, float2 tc0, float4 af, float3 Pe, float2 pix )
{
  const float2 M = lerp( s_tree_mtl.Sample( smp_base, tc0 ).rg, s_tree_mtl.Sample( smp_base, tc1 ).rg, af.w );
  const uint frame = uint( da_tree_lod.x + 0.5f );
  const float ign = frac( 52.9829189f * frac( dot( pix + float2( 29.0f, 11.0f ) + 5.588238f * float( frame & 63u ), float2( 0.06711056f, 0.00583715f ) ) ) );
  [branch] if ( ign >= M.x )
	return 0;
  const float into_sun = smoothstep( -0.15f, 0.55f, dot( normalize( Pe ), -L_sun_dir_e ) );
  return da_pack_foliage_mtl( DA_FOLIAGE_TR_MIN + into_sun * M.y * ( 3.0f * DA_FOLIAGE_TR_STEP ), pix, frame );
}

#ifdef	ATOC

float4 	main	( vf I ) : SV_Target
{
	float4 D;
	float4 H;
	sample_Textures(D, H, I.tc1, I.tc0, I.af, float2(0,0) );
	D.w = (D.w-def_aref*0.5)/(1-def_aref*0.5);
	return D.w;
}

#else	//	ATOC

f_deffer 	main	( vf I )
{
  f_deffer	O;

  // 1. Base texture + kill pixels with low alpha
//  float4 D0 	= tex2D		(s_base, I.tc0);
//  float4 D1 	= tex2D		(s_base, I.tc1);
//  float4 H0 	= tex2D		(s_hemi, I.tc0);	H0.xyz 	=  H0.rgb*2-1;	// expand
//  float4 H1 	= tex2D		(s_hemi, I.tc1);	H1.xyz 	=  H1.rgb*2-1;	// expand
  float4 D;
  float4 H;

#if !defined(MSAA_ALPHATEST_DX10_1)
  sample_Textures(D, H, I.tc1, I.tc0, I.af, float2(0,0));

#if	!( defined(MSAA_ALPHATEST_DX10_1_ATOC) || defined(MSAA_ALPHATEST_DX10_0_ATOC) )
	clip		(D.w-def_aref)  ;
#endif	//	!( defined(MSAA_ALPHATEST_DX10_1_ATOC) || defined(MSAA_ALPHATEST_DX10_1_ATOC) )
#ifdef 	MSAA_ALPHATEST_DX10_1_ATOC
	float alpha = (D.w-def_aref*0.5)/(1-def_aref*0.5);
	uint mask = alpha_to_coverage ( alpha, I.hpos );
#endif	//	MSAA_ALPHATEST_DX10_1_ATOC

#else
  uint mask = 0x0;

  float2 pixeloffset = MSAAOffsets[0]*(1.0/16.0);

  sample_Textures(D, H, I.tc1, I.tc0, I.af, pixeloffset );

  if( D.w-def_aref >= 0 ) mask |= 0x1;

  [unroll] for( int i = 1; i < MSAA_SAMPLES; ++i )
  {
	float4 DI;
	float4 HI;
	pixeloffset = MSAAOffsets[i]*(1.0/16.0);
	sample_Textures(DI, HI, I.tc1, I.tc0, I.af, pixeloffset );
	if( DI.w-def_aref >= 0 ) mask |= ( uint(0x1) << i );
  }

  if( mask == 0x0 )
	discard;

#endif

  float3 N 	= normalize	(H.xyz);

  // Match distant-vegetation billboards to the look of live near trees. H.w is the baked
  // sky-light share captured under an open sky; a real crown shades itself, so untouched
  // billboards read washed-out and pop at the swap line. Saturation/brightness recover what
  // the small bake texture ate - cheaper here than rebuilding levels (xrLC bakes the LODs).
  H.w *= da_lod_tune.x;
  {
    const float lum_l = dot(D.rgb, float3(0.299f, 0.587f, 0.114f));
    D.rgb = lerp(lum_l.xxx, D.rgb, da_lod_tune.y) * da_lod_tune.z;
  }

  // The far tiers take back four fifths of the sun's share their parts' normals gain over their leaves' (a far part's
  // cells at a fifth of their own facing: 0.48 of the share, da_shrub_cluster.ps); the bake leaves it out, a billboard
  // standing for trees turned every way - here it is taken under the frame's sun, on the texel's share of leaves.
  {
    const float leaf = lerp( s_tree_mtl.Sample( smp_base, I.tc0 ).r, s_tree_mtl.Sample( smp_base, I.tc1 ).r, I.af.w );
    const float l_sun = dot( L_sun_color.rgb, float3( 0.2126f, 0.7152f, 0.0722f ) ), l_sky = dot( L_hemi_color.rgb, float3( 0.2126f, 0.7152f, 0.0722f ) );
    const float sunlit = l_sun / max( l_sun + l_sky, 1e-4f ) * saturate( dot( N, -L_sun_dir_e.xyz ) );
    D.rgb *= pow( max( 1.0f - 0.48f * leaf * sunlit, 0.0f ), 1.0f / 2.2f );
  }

  const float mtl = tree_lod_mtl(I.tc1, I.tc0, I.af, I.position, I.hpos.xy);

  // 2. Standart output
#ifndef EXTEND_F_DEFFER
  O				= pack_gbuffer(
								float4	(N					, H.w		),
								float4 	(I.position + N*def_virtualh/2.h	, mtl		),
								float4	(D.x,	D.y,	D.z			, def_gloss	) );		// OUT: rgb.gloss
#else
  O				= pack_gbuffer(
								float4	(N					, H.w		),
								float4 	(I.position + N*def_virtualh/2.h	, mtl		),
								float4	(D.x,	D.y,	D.z			, def_gloss	),
								mask );		// OUT: rgb.gloss
#endif

	// Motion vector (da_velocity.h)
	O.velocity = da_velocity(I.hpos_cur, I.hpos_prev);
  return O;
}

#endif	//	ATOC
