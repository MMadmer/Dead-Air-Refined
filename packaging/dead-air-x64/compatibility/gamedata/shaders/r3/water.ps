// [DA] Water surface.
//
// Rewritten as an interface between two media instead of a tint laid over a finished frame.
// The three things that were structurally wrong before, and what replaced them:
//
//   1. DEPTH was a view-space z difference - depth along the view axis, not through the water.
//      Every depth-driven effect therefore changed with the viewing angle: a 25 cm foam band
//      became metres wide seen edge-on. There are now two explicit quantities: the path the
//      light actually travelled through the water (drives absorption), and how deep the water
//      is at this spot (drives foam, debris, wave calming) - a property of the place, not of
//      where it is looked at from.
//
//   2. COLOUR was a lerp between two authored tints scaled by a weather key that is 0.0 in 180
//      weather sections and 0.1 in 729 more, which is why water went black in a quarter of the
//      shipped weathers. It is now Beer-Lambert absorption down the real path plus the light
//      the water column scatters back, from per-water-body coefficients. Red is half gone at
//      2 m and dead at 8: that single fact is why clear water is blue and peat water is brown,
//      and no pair of authored tints can reproduce it.
//
//   3. WAVES were normal-map samples at fixed amplitudes summed into a TANGENT-space normal, so
//      the wind direction on water depended on the level author's UV layout. They are now a sum
//      of waves seeded on the CPU from the actual wind and the actual fetch of this water body,
//      accumulated as a world-XZ slope, cut down by the local depth so the last metre before a
//      bank goes glassy while the middle of the pond is still ruffled.
//
// COMPOSITING. The surface writes the finished interface OPAQUELY and supplies its own
// background: s_image (rt_SSR) is a copy of the frame as it stood just before the forward pass,
// so the shader can sample what is behind it and bend that sample properly.
//
//     out = B_refracted * T * (1-F)  +  InScatter * (1-F)  +  Reflection * F
//
// The obvious alternative - stay translucent and add only the DIFFERENCE the refraction makes -
// is exact on paper and wrong in practice: the hardware weights the background by (1-alpha),
// so every correction the shader adds comes back divided by alpha, and in clear shallow water
// alpha is the Fresnel term. A 2 cm refraction offset arrives multiplied by thirteen. Writing
// the interface outright is the only form with no amplification in it.
//
// What that costs: wallmarks are the one thing drawn into the forward pass before water
// (priority 1 against water's 2), so a bullet hole on a lake bed is not in the refracted
// background. Everything else in the forward pass - particles, flares, distortion - sorts after
// water and is unaffected.
//
// The screen-warp pass (waterd, l_special) is switched off in the .s scripts along with this:
// it was a second, uncoordinated refraction stacked on the same pixels.

#include "common.h"
#include "ogse_reflections.h"

struct   vf
{
	float2	tbase		: TEXCOORD0;
	float4	position_w	: TEXCOORD1;	// xyz world, w = sun access
	float4	v2point_w	: TEXCOORD2;	// xyz eye->point in world, w = sky openness
	float4	tctexgen	: TEXCOORD3;	// screen texgen, z = view depth of the surface
	float4	c0			: COLOR0;
	float	fog			: FOG;
	float4	hpos		: SV_Position;
};

Texture2D	s_nmap;
Texture2D	s_leaves;

#include "settings_da_water.h"		// the look knobs that are genuinely looks
#include "da_water_common.h"		// the model: sea state, waves, statistics, optics
#include "da_fog_common.h"			// the atmospheric haze, shared with the deferred combine
#include "da_water_rings.h"			// impact rings, shared with the puddles

// x = rain density 0..1.
uniform float4 rain_params;

// Rain on open water. Two more layers of the animated normal map at incommensurate scales:
// layered samples interfere aperiodically, which is how the industry does rain, where a
// sin(x)*cos(y) is separable and draws an axis-aligned grid of little squares.
float2 da_w_rain(float2 wxz, float t)
{
	const float2 uv0 = wxz * WATER_RIPPLE_SCALE         + float2( 0.37f,  0.93f) * t;
	const float2 uv1 = wxz * (WATER_RIPPLE_SCALE * 1.7f) - float2( 0.81f, -0.59f) * t;
	const float2 r0 = s_nmap.Sample( smp_base, uv0 ).xy - 0.5f;
	const float2 r1 = s_nmap.Sample( smp_base, uv1 ).xy - 0.5f;
	return r0 + r1 * 0.7f;
}

#ifdef GBUFFER_OPTIMIZATION
float4 main( vf I, float4 pos2d : SV_Position ) : SV_Target
#else
float4 main( vf I ) : SV_Target
#endif
{
	const float2 PosTc = I.tctexgen.xy / I.tctexgen.z;
#ifdef GBUFFER_OPTIMIZATION
	const gbuffer_data gbd = gbuffer_load_data( PosTc, pos2d );
#else
	const gbuffer_data gbd = gbuffer_load_data( PosTc );
#endif

	// ---- geometry of the sight line ------------------------------------------------------
	const float3 Pw = I.position_w.xyz;
	const float  dist = length( I.v2point_w.xyz );
	const float3 V = I.v2point_w.xyz / max( dist, 0.0001f );	// eye -> surface, world
	// How much of the view ray's length one metre of view-axis depth is worth. Both the surface
	// and the bed sit on this same ray, so the difference of their view depths divided by this
	// IS the distance between them - no matrix, no reconstruction.
	const float  cosv = max( dot( V, eye_direction ), 0.05f );
	const float  dz = max( gbd.P.z - I.tctexgen.z, 0.0f );
	const float  da_w_path = dz / cosv;					// metres of water the light crossed
	// The vertical drop over that path IS the water's depth here - but only while the ray is
	// steep enough to reach the bottom under this pixel rather than the far bank. Looking flat
	// across a pond it reads near zero everywhere, so it hands over to the body's mean depth
	// as the sight line flattens. A true per-point depth needs the top-down water field, which
	// is the next stage's job.
	const float  vconf = saturate( -V.y * 3.0f );
	const float  da_w_depth = lerp( da_water_body.x, -V.y * da_w_path, vconf );

	// ---- the surface ---------------------------------------------------------------------
	const float  t = da_wind_state.w;
	const float3 gustf = da_wind_field_eval( Pw.xz );
	const float  wind_ms = da_wind_state.z;
	const float2 wind_dir = da_wind_local_dir( da_wind_state.xy, gustf.z );

	float mss_explicit = 0.0f;
	float2 slope = da_w_waves( Pw.xz, da_w_depth, t, mss_explicit );

	// Cox and Munk give the slope variance of the WHOLE surface, capillaries included. That is
	// a budget the three layers below divide: the explicit waves took their half on the CPU,
	// the detail map takes a fixed share here, and whatever is left - everything too small to
	// be a normal at all - becomes the width of the specular lobe.
	const float scum = saturate( DA_W_IOP2.w );
	const float mss_total = da_w_mss( wind_ms, scum, gustf.x );

	// Sub-wave detail. Faded out with distance because past a point one texel of it spans more
	// than a wave and it turns into crawling noise - the aliasing the old shader hid by damping
	// ALL waves with distance, which also flattened the sea it was trying to show.
	const float det_near = saturate( 1.0f - dist / WATER_DETAIL_FADE );
	const float mss_detail = WATER_DETAIL_SHARE * mss_total * det_near;
	[branch]
	if ( det_near > 0.01f )
		slope += da_w_detail( s_nmap, smp_base, Pw.xz, wind_dir, t, wind_ms )
		       * ( WATER_DETAIL_GAIN * sqrt( mss_detail ) );

	// Rain, and the rings every impact leaves. Both are shallow-water business: they ride on
	// top of the wind sea and fade out where a ripple would be smaller than a pixel.
	const float rip_near = saturate( 1.0f - dist / WATER_RIPPLE_FADE );
	[branch]
	if ( rip_near > 0.01f )
	{
		const float rain = saturate( rain_params.x );
		[branch]
		if ( rain > 0.004f )
			slope += da_w_rain( Pw.xz, t * WATER_RIPPLE_SPEED ) * ( WATER_RIPPLE_AMP * rain * rip_near );
		[branch]
		if ( da_wh_info.x > 0.5f )
			slope += da_water_rings( Pw ) * ( WATER_RING_AMP * rip_near );
	}

	// Water is a horizontal plane by construction, so the world normal comes straight out of
	// the world slope. No tangent frame, no dependence on how the level was unwrapped.
	const float3 Nw = normalize( float3( -slope.x, 1.0f, -slope.y ) );

	// A quarter of the budget is kept back whatever the layers above claimed, so the glint can
	// never collapse to a mirror line on a surface that is visibly moving.
	const float mss = max( mss_total - mss_explicit - mss_detail, 0.25f * mss_total );

	// ---- fresnel -------------------------------------------------------------------------
	const float ndv = saturate( dot( Nw, -V ) );
	// The flat-surface Fresnel knows nothing about the slopes it is averaging over, so a choppy
	// far shore would go full mirror. Bruneton's rough-surface mean brings it back.
	const float F = lerp( da_w_fresnel_up( ndv ), da_w_fresnel_rough( ndv, mss_total ), saturate( dist / 12.0f ) );

	// ---- reflection ----------------------------------------------------------------------
	const float3 vreflect = reflect( V, Nw );
	// A rough surface does not mirror a razor-sharp sky. The stock shader sampled the sky cubes
	// at mip 0 always, which is why a squall-blown pond reflected crisp cloud edges.
	const float  env_mip = saturate( sqrt( mss_total ) / 0.35f ) * 4.0f;
	float3 env;
	{
		const float3 d = normalize( vreflect );
		const float3 e0 = s_env0.SampleLevel( smp_base, d, env_mip ).xyz;
		const float3 e1 = s_env1.SampleLevel( smp_base, d, env_mip ).xyz;
		env = lerp( e0, e1, L_ambient.w );
	}

	float3 reflection = env;
#ifdef USE_REFLECTIONS
	// A ray that leaves the surface going DOWN is not a reflection - it is refraction, and the
	// march would find the lake bed and mirror it into the sky. That reject is the one the stock
	// march never had.
	[branch]
	if ( vreflect.y > 0.02f && dist < WATER_SSR_END )
	{
		const float4 refl = calc_reflections( float4( Pw, 1.0f ), vreflect );
		// The march's own screen-edge confidence, faded out with distance instead of the hard
		// hand-over that used to fight the distance damping.
		const float w = saturate( refl.w + saturate( ( dist - WATER_SSR_START ) /
			max( WATER_SSR_END - WATER_SSR_START, 0.001f ) ) );
		reflection = lerp( refl.xyz, env, w );
	}
#endif
	// The sun and moon on the water. GGX at the Cox-Munk roughness, not a fixed exponent: the
	// stock pow(dot, 280) is a permanent 0.8 m/s breeze, which is why the glitter never changed
	// with the weather. Scaled by this patch's own sun access, so a pool under a bridge does not
	// sparkle in full sun.
	{
		const float3 L = -L_sun_dir_w;
		const float spec = da_w_specular( Nw, -V, L, mss );
		reflection += L_sun_color * ( spec * WATER_SUN_STRENGTH * saturate( I.position_w.w ) );
	}

	// ---- the water column ----------------------------------------------------------------
	// c0 is the light that actually reaches this patch of water - baked lighting, hemisphere by
	// sky openness, sun by sun access. Using it rather than a global irradiance is what keeps
	// water in shadow dark and water in the open bright.
	const float3 irradiance = I.c0.rgb;
	const float3 T = da_w_transmit( da_w_path );
	float3 body = da_w_inscatter( irradiance, T );

	// Whatever is behind the water, bent. The offset comes from the surface slope in SCREEN
	// space and shrinks with distance and with how little water there is: a boot-deep film
	// cannot displace the ground under it by half a metre.
	float3 Bs = s_image.SampleLevel( smp_rtlinear, PosTc, 0 ).xyz;
	float3 Br = Bs;
#ifdef USE_SOFT_WATER
	{
		const float3 Nv = mul( (float3x3)m_V, Nw );
		const float2 off = Nv.xy * ( WATER_REFRACT_STRENGTH * saturate( da_w_path * 2.0f ) /
			max( dist, 1.0f ) );
		const float2 uv = PosTc + off;
		// A refracted tap that lands on something IN FRONT of the surface is a piece of dry
		// shore being smeared across the water; fall back to the straight tap there.
		Br = ( get_depth_fast( uv ) > I.tctexgen.z ) ? s_image.SampleLevel( smp_rtlinear, uv, 0 ).xyz : Bs;
	}
#endif

	// ---- what floats on it ---------------------------------------------------------------
	// The authored surface texture is a FILM - scum, algae, duckweed - not the colour of the
	// water. It only appears where the water body says there is any, so a clear pond shows none
	// of it and a bog is covered.
	float3 film_rgb = 0.0f;
	float  film_w = 0.0f;
	[branch]
	if ( scum > 0.004f )
	{
		const float4 base = s_base.Sample( smp_base, I.tbase );
		film_rgb = base.rgb * irradiance;
		film_w = saturate( base.a * scum * saturate( da_w_path * 3.0f ) );
	}

	// Shoreline foam. The band is as wide as the waves run up the bank - about twice the
	// significant wave height - so it grows with the wind instead of sitting at a fixed 25 cm,
	// and it is broken up by the surface slope so it never reads as a painted outline.
	float foam = 0.0f;
	{
		const float band_w = clamp( 2.0f * da_water_sea.x + 0.10f, 0.12f, 0.90f );
		float b = 1.0f - saturate( da_w_path / band_w );
		b = b * b;
		const float n = saturate( 0.55f + 2.2f * ( slope.x + slope.y ) );
		foam = saturate( b * n * WATER_FOAM_STRENGTH ) * saturate( da_w_path * 20.0f );
	}

	// Floating debris, in the depth window where a bank actually collects it.
	float3 leaf_rgb = 0.0f;
	float  leaf_w = 0.0f;
	{
		const float4 lv = s_leaves.Sample( smp_base, I.tbase );
		float k = smoothstep( WATER_LEAVES_NEAR, WATER_LEAVES_NEAR * 3.0f, da_w_path );
		k *= smoothstep( WATER_LEAVES_FAR, WATER_LEAVES_FAR * 0.6f, da_w_path );
		leaf_rgb = lv.rgb * irradiance;
		leaf_w = saturate( lv.a * k * WATER_LEAVES_STRENGTH );
	}

	// ---- composite -------------------------------------------------------------------------
	const float thru = 1.0f - F;
	float3 final = Br * T * thru + body * thru + reflection * F;

	// Things that lie ON the surface go over the finished interface: the water column must not
	// dim a leaf that is floating on top of it.
	final = lerp( final, WATER_FOAM_COLOR * irradiance, foam );
	final = lerp( final, film_rgb, film_w );
	final = lerp( final, leaf_rgb, leaf_w );

	// ---- atmosphere ------------------------------------------------------------------------
	// I.fog is visibility off the fog plane; the height layer, the density ceiling and the sky
	// colour come from the shared header, so the surface dissolves at the same distance and into
	// the same colour as the shore around it.
	float  fogd = saturate( 1.0f - I.fog );
	float3 fogrgb = fog_color.rgb;
	[branch]
	if ( da_fog_extras_on() )
	{
		fogd = da_fog_height( fogd, Pw, eye_position, dist );
		[branch]
		if ( da_fog.x > 0.001f )
		{
			const float3 vd = da_fog_sky_dir( Pw, eye_position );
			const float3 e0 = s_env0.SampleLevel( smp_base, vd, da_fog.y ).xyz;
			const float3 e1 = s_env1.SampleLevel( smp_base, vd, da_fog.y ).xyz;
			fogrgb = da_fog_mix_sky( fogrgb, lerp( e0, e1, L_ambient.w ) );
		}
	}
	fogd = da_fog_ceiling( fogd );
	// The surface carries its own background now, so there is nothing behind it to fog separately
	// - fogging the finished radiance is the whole of it, and it lands on the same colour the
	// combine painted the shore with.
	final = lerp( final, fogrgb, fogd );

	return float4( final, 1.0f );
}
