#include "common.h"

// The shader fire's smoke: a puff is a disc eroded by world-space noise (so it never swims
// when it turns), fading in over its first moments and thinning as it ages; lit by the sky
// (the vertex colour), wrap-lit by the sun on its sun side with a forward-scatter rim when the
// sun stands behind it (smoke is a low-albedo forward scatterer), and lit from below by the
// fire while it is still near the flame. Soft against the scene, fogged like any particle.

uniform float4 da_smoke_sun;    // xyz = direction to the sun in the billboard frame (right, up, toward the eye)
uniform float4 da_smoke_suncol; // rgb = sun colour x albedo, w = time, s

Texture3D s_cloud_detail; // RGB = Worley fBm at 2, 4 and 8 cells per tile

struct v2p
{
	float2 tc		: TEXCOORD0;
	float4 c		: COLOR0;
	float4 e		: TEXCOORD1;
	float3 wpos		: TEXCOORD2;
	float4 tctexgen	: TEXCOORD3;
	float4 hpos		: SV_Position;
	float  fog		: FOG;
};

#define DEPTH_EPSILON 0.1h

float4 main (v2p I) : SV_Target
{
	const float2 uv2 = I.tc * 2.0 - 1.0;
	const float  m   = saturate(1.0 - dot(uv2, uv2));
	if (m <= 0.0)
		discard;

	const float seed = I.e.x;
	const float agen = I.e.y;
	const float glow = I.e.z;

	// Two taps of the Worley volume in world space, one coarse and one fine, so a puff is a
	// ragged wisp from its first frame and never a disc; drifting up slowly with time.
	const float3 nq = I.wpos * 0.8 + float3(0.0, -0.1 * da_smoke_suncol.w, 0.0) + seed * 0.173;
	const float3 nt = s_cloud_detail.SampleLevel(smp_linear, nq, 0).rgb;
	const float3 nf = s_cloud_detail.SampleLevel(smp_linear, nq * 2.7 + 0.31, 0).rgb;
	const float  n  = saturate((nt.r * 0.5 + nt.g * 0.3 + nf.r * 0.2) * 1.15 - 0.05);

	// Erosion from birth (a puff is never a full disc), climbing over its life so it frays
	// before it fades; the disc mask is soft toward the rim.
	const float mm = pow(m, 1.4);
	const float e  = lerp(0.3, 0.95, agen);
	float a = smoothstep(e, e + 0.3, mm * (0.35 + 1.0 * n)) * I.c.a;

	// Soft against the scene, 0.4 m.
	const float2 tcProj = I.tctexgen.xy / I.tctexgen.w;
#ifdef GBUFFER_OPTIMIZATION
	gbuffer_data gbd = gbuffer_load_data(tcProj, I.hpos);
#else
	gbuffer_data gbd = gbuffer_load_data(tcProj);
#endif
	float spaceDepth = gbd.P.z - I.tctexgen.z - DEPTH_EPSILON;
	if (spaceDepth < -2.0 * DEPTH_EPSILON)
		spaceDepth = 100000.0;
	a *= saturate(spaceDepth / 0.4);

	// Lighting on a fake sphere normal.
	const float3 N    = normalize(float3(uv2, sqrt(m)));
	const float3 Ls   = da_smoke_sun.xyz;
	const float  wrap = 0.55 + 0.45 * saturate((dot(N, Ls) + 0.5) / 1.5);
	const float  g    = 0.6;
	const float  cosv = -Ls.z; // the light's travel against the way to the eye
	const float  hg   = (1.0 - g * g) / (12.566 * pow(max(1.0 + g * g - 2.0 * g * cosv, 0.05), 1.5));
	float3 col = I.c.rgb + da_smoke_suncol.rgb * (wrap + 0.3 * hg);
	// The fire under the plume base.
	col += float3(1.0, 0.5, 0.18) * glow * saturate(0.4 - 0.8 * N.y) * (0.4 + 0.6 * n);

	a *= I.fog * I.fog;
	return float4(col, a);
}
