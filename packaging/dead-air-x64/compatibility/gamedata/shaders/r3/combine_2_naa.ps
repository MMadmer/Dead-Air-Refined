#ifndef USE_MSAA
	Texture2D 			s_distort;
#else
	Texture2DMS<float4, MSAA_SAMPLES> s_distort;
#endif

uniform float4		screen_res;
uniform float4 		e_barrier;	// x=norm(.8f), y=depth(.1f), z=clr
uniform float4 		e_weights;	// x=norm, y=depth, z=clr
uniform float4 		e_kernel;	// x=norm, y=depth, z=clr
// x = 1/gamma, y = brightness/2, z = contrast/2, w = 1 when the hardware ramp is dead
// (windowed/borderless) and the sliders have to act here instead.
uniform float4		da_gamma;
#define MAXCOF		7.h
#define EPSDEPTH	0.001h

#include "common.h"
// Ahead of the post stack on purpose: lumasharpen.h #defines a bare "px", which poisons
// every declaration of that name in anything included after it - and the wind core under
// the water optics has one.
#include "da_water_under.h"
#include "sweetfx.h"
#include "blur.h"
#include "da_mblur.h"
#include "da_bloom.h"
#include "dof.h"
#include "grain.h"
#include "visor.h"
// visordrops.h is the base game's: a fixed lattice of cells with a hash threshold, no clock and
// no memory. What replaces it keeps a field of the water itself (da_visor_drops.ps) and this
// header is the optics of looking through it.
#include "da_visor.h"
#include "lumasharpen.h"

//////////////////////////////////////////////////////////////////////////////////////////

#define tmp0 tmp.x
#define tmp1 tmp.y
#define tmp2 tmp.z
#define tmp3 tmp.w

uniform sampler		NormalSampler : register(s0);
//////////////////////////////////////////////////////////////////////////////////////////
// Pixel

struct c2_out
{
	float4	Color : SV_Target;
#ifdef USE_MSAA
	float	Depth : SV_Depth;
#endif
};

c2_out main( v2p_aa_AA I )
{
	c2_out	res;
	res.Color = float4(0,0,0,0);
	int iSample = 0;

#ifndef USE_MSAA
#ifdef GBUFFER_OPTIMIZATION
	float depth = gbuffer_load_depth(I.Tex0, I.HPos, iSample);
#else
	float depth = gbuffer_load_depth(I.Tex0, iSample);
#endif
#else
#ifdef GBUFFER_OPTIMIZATION
	gbuffer_data gbd = gbuffer_load_data(I.Tex0, I.HPos, iSample);
#else
	gbuffer_data gbd = gbuffer_load_data(I.Tex0, iSample);
#endif
	float depth = gbd.P.z;
#endif

	float centerDepth = depth;
#ifdef 	USE_DISTORT
#ifndef USE_MSAA
	float4 	distort	= s_distort.Sample(smp_rtlinear, I.Tex0);
#else // USE_MSAA
	float4 	distort	= s_distort.Load( int3( I.Tex0 * pos_decompression_params2.xy, 0 ), iSample );
#endif // USE_MSAA
	float2	offset	= (distort.xy-(127.0h/255.0h))*def_distort;  // fix newtral offset
	float2	center	= I.Tex0 + offset;

#ifdef GBUFFER_OPTIMIZATION
	float depth_x = gbuffer_load_depth_offset(I.Tex0, center, I.HPos, iSample);
#else
	float depth_x = gbuffer_load_depth_offset(center, iSample);
#endif

	if ((depth_x + EPSDEPTH) < depth)
	{
		center = I.Tex0;
		centerDepth = depth;
	}
	else
	{
		centerDepth = depth_x;
	}
#else // USE_DISTORT
	float2	center 	= I.Tex0;
#endif

	// ---- underwater: the frame seen through the medium -----------------------------------
	// The warp goes on the sampling coordinate itself rather than on the finished image, so
	// bloom, dof and the dirt overlay all follow the same displacement instead of sliding
	// against it. Ramped over the first DA_UW_RAMP of submersion - a hard switch here ghosts
	// across the TAA pass downstream.
	const float uw = da_uw_amount();
	const int uw_tier = da_uw_tier();
	[branch] if ( uw > 0.0h && uw_tier >= 3 )
		center += da_uw_warp( center, uw );

	// Distance the sight line actually travelled, not its view-axis depth: those differ by a
	// fifth at the screen edge and the tint would band visibly across the frame. Sky, and
	// anything else with no g-buffer position, reads zero and is left alone - the surface seen
	// from below is water.ps's own branch and must not be tinted twice.
	const float2 uw_ray = I.Tex0 * pos_decompression_params2.xy * pos_decompression_params.zw
		- pos_decompression_params.xy;
	const float uw_dist = depth * length( float3( uw_ray, 1.0h ) );

	float3 sceneColor = s_image.Sample(smp_rtlinear, center).rgb;
#ifndef USE_MSAA
	sceneColor = da_mblur_gather( s_image, center, sceneColor, I.Tex0 * da_mblur_size.xy );
#endif
	float3 img = sceneColor;
	// The light the lens and the eye scatter round what is bright (da_bloom.h).
	float3 glow = da_bloom_glow( center );
#ifdef USE_DISTORT
	// The stock bloom target stays the exposure meter's source; the distortion's blur reads it.
	float4 bloom	= s_bloom.Sample( smp_rtlinear, center);
#endif

	// Beer-Lambert over the scene and over the bloom both. The bloom pyramid was built before
	// this pass, so leaving it alone would let a bright bank shine through ten metres of pond
	// at full strength.
	[branch] if ( uw > 0.0h )
	{
		if ( uw_tier >= 4 )
			img = da_uw_chroma( center, img, uw );
		// The sun's net on the bed, before the column takes its toll of it - what water.ps
		// does to the refracted background while the eye is still above the surface.
		img *= lerp( 1.0f, da_uw_caustics_scene( float3( uw_ray, 1.0f ) * depth ), uw );
		img = da_uw_medium( img, uw_dist, uw, uw_tier );
		glow = da_uw_medium( glow, uw_dist, uw, uw_tier );
#ifdef USE_DISTORT
		bloom.rgb = da_uw_medium( bloom.rgb, uw_dist, uw, uw_tier );
#endif
		sceneColor = img;
	}

	if (aberration.x != 0)
		img = ChromaticAberrationBase( img, center, aberration );

	if (lumasharpen.x != 0)
		img = LumaSharpenPass(img, sceneColor, center, lumasharpen*3);

	img	= dof(img, center, centerDepth);

	// Before the tone curve, which rolls the halo off with the light it surrounds instead of clipping it.
	img += glow;

	img = ACESFilm(img);

	if (vibrance.x != 0)
		img = Vibrance(img, vibrance+1);

	// Dirt on the visor glowing round bright light. It is a mask's, so it exists only while there
	// is glass in front of the eye (lensdirt.y, from the engine). The texture is square and the
	// screen is not: a band of it is read so the discs stay round, as specks a few centimetres
	// from a round pupil are.
	#ifdef USE_LENS_DIRT
	[branch] if (lensdirt.y > 0.0f)
	{
		const float2 dirt_uv = float2(center.x, 0.5f + (center.y - 0.5f) * screen_res.y * screen_res.z);
		float3 dirt = s_dirt.Sample( smp_rtlinear, dirt_uv);

		float3 bloom_img = dirt*(glow*4-img*2);
		bloom_img = max(bloom_img,0);
		bloom_img = lerp(bloom_img, 0, step(depth,EPSDEPTH));
		bloom_img = Vibrance(bloom_img,2);

		img += bloom_img;
	}
	#endif // USE_LENS_DIRT

	#ifdef 	USE_DISTORT
		float3	blurred	= bloom*(0.2h*def_hdr);
		img		= lerp	(img,blurred,distort.z);
	#endif

	#if defined(USE_VIGNETTE) || defined(USE_FILMGRAIN)
		img = GrainPass( img, center );
	#endif


	#ifdef USE_TECHICOLOR
		//img = MoodPass(img);
		img = TechnicolorPass(img);
	#endif // USE_TECHICOLOR

	float4 final = float4( img, 1.0h );

	#ifdef USE_LENS_WATER
		final.rgb = da_visor_water(s_image, center, final.rgb);

		if (lensdirt.x > 0.9)
		{
		#ifndef USE_MSAA
			float visorDepth = s_position.SampleLevel(smp_rtlinear, float3(center, 0), 0).z;
		#else
			float visorDepth = s_position.Load(int2(center * pos_decompression_params2.xy), iSample).z;
		#endif
			final = visor_reflect(center, final, visorDepth);
		}
	#endif

	// The vignette and the edge chroma close the stack at the top tier: a diving mask, not a
	// post-process look, so both ride the same submersion ramp.
	[branch] if ( uw > 0.0h && uw_tier >= 4 )
		final.rgb = da_uw_vignette( final.rgb, I.Tex0, uw );

	// Gamma / brightness / contrast in the shader, same curve the engine builds for the
	// hardware ramp (CGammaControl::GenLUT) - so the sliders match what they produced on the
	// original DX9 build. Applied only when the ramp is not doing the job (da_gamma.w),
	// i.e. windowed/borderless; at 1/1/1 it reduces exactly to the identity.
	[branch] if ( da_gamma.w > 0.5h )
	{
		const float B = da_gamma.y;
		const float C = da_gamma.z;
		float3 v = pow(max(final.rgb, 0.0h), da_gamma.x);
		final.rgb = (C + 0.5h) * v + (B - 0.5h) * 0.5h - C * 0.5h + 0.25h;
	}

	// Output dithering: +-1/2 LSB triangular noise breaks the 8-bit banding on smooth
	// gradients (sunset sky) into invisible grain. Two independent hashes summed give the
	// triangular distribution; screen-position-only, so static frames stay static.
	{
		float2 dseed = I.Tex0 * screen_res.xy;
		float dn0 = frac(sin(dot(dseed, float2(12.9898h, 78.233h))) * 43758.5453h);
		float dn1 = frac(sin(dot(dseed, float2(39.3468h, 11.135h))) * 24634.6345h);
		final.rgb += (dn0 + dn1 - 1.0h) * (1.0h / 255.0h);
	}

	res.Color = final;

	#ifdef USE_MSAA
		float4 ptp = mul(m_P, float4(gbd.P, 1));
		res.Depth = ptp.w==0?1:ptp.z/ptp.w;
	#endif

	return res;
}
