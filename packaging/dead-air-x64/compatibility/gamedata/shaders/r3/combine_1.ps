#include "common.h"

//#define USE_SUPER_SPECULAR
//#define USE_ORIGINAL_SSAO
//#define HBAO_WORLD_JITTER

#include "lmodel.h"
#include "hmodel.h"

uniform	Texture2D					s_half_depth;

// Haze constants (ported from the sibling engine, d56f2a2). Zeros reproduce the stock fog
// line bit for bit - deliberately runtime branches, not defines, so the shader cache does not
// double its permutations. x = sky-colour share (pre-multiplied by the master), y = cubemap
// mip, z = height-fog density (pre-multiplied), w = height falloff.
uniform float4 da_fog;
// x = density ceiling, y = layer reference altitude, z = horizon flattening of the sky sample.
uniform float4 da_fog2;
// Skydome tint (weather sky_color) for the sky-matched haze - see the mip-fog block.
uniform float4 da_sky_tint;

//#include "ssao_blur.ps"

#ifdef HDAO
#define USE_HDAO 1
#endif

#ifdef SM_5
Texture2D<float> s_occ;
#endif // SM_5

//#ifdef SSAO_QUALITY
//#undef SSAO_QUALITY
//#define SSAO_QUALITY 4
//#endif

#if SSAO_QUALITY <=3
#include "ssao.ps"
//#ifdef SM_5
//#undef SM_5
//#endif
#else
#ifndef USE_HDAO
#define USE_HDAO
#endif
#endif

#ifdef USE_HDAO
#if SSAO_QUALITY > 3
#include "ssao_hdao_new.ps"
#endif
#define USE_HDAO_CODE
#if SSAO_QUALITY <=3
#define  g_f2RTSize ( pos_decompression_params2.xy )
//#define  g_f2RTSize float2( 1280.0f, 1024.0f )
#ifdef GBUFFER_OPTIMIZATION
#define g_txDepth s_position
#define g_txNormal s_position
#else
#define g_txDepth s_position
#define g_txNormal s_normal
#endif
#include "ssao_hdao.ps"
#endif
#else // USE_HDAO
#ifdef	USE_HBAO
#include "ssao_hbao.ps"
#endif	//	USE_HBAO
#endif // USE_HDAO

struct	_input
{
	float4	tc0	: TEXCOORD0;	// tc.xy, tc.w = tonemap scale
	float2	tcJ	: TEXCOORD1;	// jitter coords
	float4 pos2d : SV_Position;
};

struct	_out
{
	float4	low		: SV_Target0;
	float4	high	: SV_Target1;
};

//	TODO:	DX10: Replace Sample with Load
#ifndef MSAA_OPTIMIZATION
_out main ( _input I )
#else
_out main ( _input I, uint iSample : SV_SAMPLEINDEX )
#endif
{
	gbuffer_data gbd = gbuffer_load_data( GLD_P(I.tc0, I.pos2d, ISAMPLE) );
	
	// Sample the buffers:
	float4	P = float4( gbd.P, gbd.mtl );	// position.(mtl or sun)
	float4	N = float4( gbd.N, gbd.hemi );		// normal.hemi
	float4	D = float4( gbd.C, gbd.gloss );		// rgb.gloss
#ifndef USE_MSAA
	float4	L = s_accumulator.Sample( smp_nofilter, I.tc0);	// diffuse.specular
#else
#	ifdef GBUFFER_OPTIMIZATION
	float4	L = s_accumulator.Load( int3( I.pos2d.xy, 0 ), ISAMPLE);	// diffuse.specular
#	else
	float4   L = s_accumulator.Load( int3( I.tc0 * pos_decompression_params2.xy, 0 ), ISAMPLE );
#	endif
#endif

#ifdef USE_SUPER_SPECULAR
	{
		float ds = dot( D.rgb, 1.h/3.h );
		D.w = max( D.w, ds*ds/8.h );
	}
#endif

#ifdef FORCE_GLOSS
	D.w = FORCE_GLOSS;
#endif

#ifdef USE_GAMMA_22
	D.rgb = ( D.rgb*D.rgb ); // pow(2.2)
#endif

        // static sun
	float mtl = P.w;

#ifdef USE_R2_STATIC_SUN
	float sun_occ = P.w*2;

	mtl = xmaterial;
	L += Ldynamic_color * sun_occ * plight_infinity	(mtl, P.xyz, N.xyz, Ldynamic_dir);
#endif

	// hemisphere
	float3 hdiffuse, hspecular;

	//  Calculate SSAO

#ifdef USE_MSAA
#	ifdef GBUFFER_OPTIMIZATION
	int2	texCoord = I.pos2d;
#	else
	int2	texCoord = int2( I.tc0 * pos_decompression_params2.xy );
#	endif
#endif
	
/*#ifdef USE_SSAO_BLUR	
#	ifndef USE_MSAA
	float	occ = ssao_blur_ps(I.tc0);
#	else
	float   occ = ssao_blur_ps( texCoord, ISAMPLE );
#	endif*/

#if defined(USE_GTAO) && defined(SM_5)
	// GTAO mode: the occlusion was rendered and guided-filtered into $user$ssao_temp
	// by phase_gtao before combine ran; nothing is computed inline here.
	float occ = s_occ.Sample( smp_nofilter, I.tc0 ).x;
#elif defined(USE_HDAO)
#ifdef SM_5
#if SSAO_QUALITY > 3
    float occ = s_occ.Sample( smp_nofilter, I.tc0);
#else // SSAO_QUALITY > 3
	float occ = calc_hdao( CS_P(P, N, I.tc0, I.tcJ, I.pos2d, ISAMPLE ) );
#endif // SSAO_QUALITY > 3
#else // SM_5
#if SSAO_QUALITY > 3
	float occ = calc_new_hdao( CS_P(P, N, I.tc0, I.tcJ, I.pos2d, ISAMPLE ) );
#else // SSAO_QUALITY > 3
	float occ = calc_hdao( CS_P(P, N, I.tc0, I.tcJ, I.pos2d, ISAMPLE ) );
#endif // SSAO_QUALITY > 3
#endif // SM_5
#else // USE_HDAO
#ifdef USE_HBAO
	float occ = calc_hbao( P.z, N, I.tc0, I.pos2d );
#else // USE_HBAO
	float occ = calc_ssao( CS_P(P, N, I.tc0, I.tcJ, I.pos2d, ISAMPLE ) );
#endif
#endif // USE_HDAO
	
	hmodel	(hdiffuse, hspecular, mtl, N.w, D.w, P.xyz, N.xyz);
//      hmodel		(hdiffuse, hspecular, mtl, 1, D.w, P.xyz, N.xyz);
//	hdiffuse*=hdiffuse;			//. high contrast hemi
//	hdiffuse*=(D.rgb*0.8 + 0.2h);	// rise texture contrast for diffuse lighting
//	hdiffuse = 0.8;
//	hdiffuse *= (occ*(D.rgb + .1h));
	hdiffuse *= occ;
	hspecular *= occ;

        float4         light       = float4         (L.rgb + hdiffuse, L.w)        ;
        float4         C           = D*light       ;                             // rgb.gloss * light(diffuse.specular)
//        float3         spec        = (C.rgb*.5h + .5h)*C.w + hspecular + hspecular + hspecular;			// replicated specular
	float3         spec        = C.www*L.rgb*5         + hspecular;      // replicated specular

#ifdef         USE_SUPER_SPECULAR
                      spec      = (C.rgb*.5h + .5h)*C.w + hspecular        ;
#endif
//		float3       color     = C.rgb + D.rgb*spec     ;
//		float3       color     = C.rgb + (D.rgb*spec+spec)/0.5h;
		float3       color     = C.rgb + spec     ;
//		float3       color     = C.rgb + D.rgb*spec+hspecular+hspecular     ;	//	More realistic and contrast specular - Ugrumiy edition

////////////////////////////////////////////////////////////////////////////////
/// For Test ///////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
#ifdef         DBG_TEST_NMAP
//. hemi + sun + lighting + specular
					color 	= 	hdiffuse + L.rgb + N;
#endif

#ifdef         DBG_TEST_NMAP_SPEC
//. hemi + sun + lighting + specular
					color 	= 	hdiffuse + L.rgb + N + spec;
#endif

#ifdef         DBG_TEST_LIGHT
//. hemi + sun + lighting + specular
					color 	= 	hdiffuse + L.rgb;
#endif

#ifdef         DBG_TEST_LIGHT_SPEC
//. hemi + sun + lighting + specular
					color 	= 	hdiffuse + L.rgb + spec;
#endif

#ifdef         DBG_TEST_SPEC
//. only lighting and specular
					color 		= spec;
#endif
////////////////////////////////////////////////////////////////////////////////

        // here should be distance fog
        float3        	pos        		= P.xyz;
        float         	distance		= length		(pos);
        float         	fog				= saturate		(distance*fog_params.w + fog_params.x); //

	// Haze: height fog + colour from the sky. m_v2w, sky_s0/sky_s1 and env_color all come
	// from hmodel.h, which this shader already includes - no new textures, no new matrices.
	float3 fog_rgb = fog_color;
	[branch] if ( da_fog.x > 0.001h || da_fog.z > 0.001h )
	{
		const float3 wp  = mul( m_v2w, float4(pos, 1.0h) );   // world point
		const float3 cam = mul( m_v2w, float4(0,0,0,1.0h) );  // world camera

		// Height fog. Density falls off exponentially with altitude; the integral along the
		// view ray is taken analytically. The near-horizontal ray is a degenerate case - the
		// division by the vertical component is unstable there - so its limit is a branch.
		[branch] if ( da_fog.z > 0.001h )
		{
			const float b    = max( da_fog.w, 0.0001h );
			const float ry   = (wp.y - cam.y) / max( distance, 0.001h );
			// Height counts from the LAYER's reference altitude, not from world zero: the
			// player usually stands near zero and the factor came out ~1 for any falloff.
			const float base = exp( -clamp( cam.y - da_fog2.y, -500.0h, 500.0h ) * b );
			const float integ= ( abs(ry) > 0.0001h )
				? base * ( 1.0h - exp( -distance * ry * b ) ) / ( ry * b )
				: base * distance;
			// Density is per METRE of path: the 0..4 knob means thousandths, and the scale is
			// applied here rather than in the binder so the raw value survives the branch
			// threshold above. The integral is optical depth; opacity is 1-exp(-tau).
			const float fogH = 1.0h - exp( -da_fog.z * 0.001h * max( integ, 0.0h ) );
			// Combined with the linear weather fog as two independent opacities, not replacing
			// it: fog_near/fog_far keep working.
			fog = saturate( fog + fogH * (1.0h - fog) );
		}

		// Haze colour from the sky along the view direction (mip fog). The blurred level is
		// deliberate: fog wants the general tone of a direction, not the cloud pattern.
		[branch] if ( da_fog.x > 0.001h )
		{
			// The direction is flattened toward the horizon: scattering happens along the ray
			// TO the object, and that ray is nearly horizontal. Without this a tall tree was
			// painted with the sky ABOVE ITSELF and came out brighter than the murk around it
			// at sunset.
			float3 vd = normalize( wp - cam );
			vd.y *= saturate( 1.0h - da_fog2.z );
			vd = normalize( vd );
			const float3 s0 = sky_s0.SampleLevel( smp_rtlinear, vd, da_fog.y );
			const float3 s1 = sky_s1.SampleLevel( smp_rtlinear, vd, da_fog.y );
			// The SKYDOME tint and brightness, not env_color: sky_s0/s1 are the very skybox
			// textures, but the dome on screen is tinted by the weather's sky_color and
			// scaled 2*0.33 (sky2.vs/ps), while env_color is the IBL tint - a different
			// value. Fogged silhouettes converged to a colour the visible sky NEVER had -
			// the bright-ghosts-in-front-of-dark-sky bug, all four rounds of it.
			const float3 sky = da_sky_tint.rgb * lerp( s0, s1, env_color.w ) * 0.66h;
			fog_rgb = lerp( fog_rgb, sky, saturate( da_fog.x ) );
		}
	}

	// Density ceiling: a little contrast at the horizon keeps the hill silhouettes.
	[branch] if ( da_fog2.x > 0.001h && da_fog2.x < 0.999h )
		fog = min( fog, da_fog2.x );

                      	color			= lerp     		(color,fog_rgb,fog);        			//
        float        	skyblend		= saturate		(fog*fog);

#ifdef         DBG_TMAPPING
        color                        	= D.xyz;
#endif
        float          	tm_scale        = I.tc0.w;                // interpolated from VS

#ifdef        USE_SUPER_SPECULAR
        color        	= spec          - hspecular	;
#endif
//		color 		= N; //show normals
//		color                        	= D.xyz;
//		color 

//float3 color = (0.5 * (sign( gbd.N - gbd.N_org ) + 1.0 ) );
//color = float3( abs( gbd.hemi - gbd.hemi_org), 0, abs( gbd.mtl - gbd.mtl_org) );
//color = abs( gbd.N - gbd.N_org );
//		color = occ; // holger test
		//color = gbd.N;
        _out        	o;
        tonemap        	(o.low, o.high, color, tm_scale )	;
                        o.low.a         = skyblend	;
						o.high.a		= skyblend	;
//		o.low	= skyblend;
//		o.hight	= 0;

	//o.low = float4(gbd.P,1);

	//o.low = float4( 1.0f, 0.0f, 0.0f, 1.0f );

		return        	o;
}
