#include "common.h"

// Camera-reprojection temporal AA (Dead Air x64). Not a full jittered TAA: there is no
// per-object velocity and no projection jitter - this pass stabilises what the camera
// motion aliases (grass shimmer, foliage crawl, spec sparkle) by blending the current
// frame with the reprojected previous one under a neighbourhood clamp. Runs on the
// tonemapped LDR frame after SMAA, so the history is LDR too.
//
// m_previous comes from the mblur block of phase_combine: previous-frame view-projection
// composed with the CURRENT inverse view, i.e. it maps current view-space positions into
// previous-frame clip space directly.
//
// Two outputs: the frame the rest of the chain reads (RGBA8 rt_Generic) and the history
// for the next frame (10-bit rt_taa_resolve). The history needs more than 8 bits: with
// the 0.12 update gain an 8-bit target rounds away every correction under ~4/255, so the
// softness picked up while the camera moved never converged back once it stopped.

Texture2D s_taa_history;

uniform float4x4 m_taa_previous;
uniform float4 screen_res;
// Screen-space uv bbox (min.xy, max.xy) of the held 3D PDA. Its screen is a forward pass
// with no G-buffer depth, so reprojection under it follows the BACKGROUND and smears the
// display while moving. Inside the box the current frame passes through untouched. Empty
// (min > max) when no device is up.
uniform float4 pda_taa_bbox;

struct taa_out
{
    float4 frame : SV_Target0;
    float4 history : SV_Target1;
};

taa_out taa_write(float3 c)
{
    taa_out O;
    O.frame = float4(c, 1.0);
    O.history = float4(c, 1.0);
    return O;
}

// Catmull-Rom history fetch, 9 taps folded into 5 bilinear ones (Jimenez, "Filmic SMAA").
// A plain bilinear fetch at the fractional reprojected offset is a 2x2 box filter applied to
// the history EVERY frame, and under the feedback below a slow pan stacks several of them -
// that is the softness on world geometry that reprojects perfectly. The cubic keeps most of
// the detail per resample; at an integer offset (still camera) it degenerates to the exact
// texel, so a converged history is never touched.
float3 taa_history(float2 uv)
{
    float2 pos = uv * screen_res.xy;
    float2 center = floor(pos - 0.5) + 0.5;
    float2 f = pos - center;

    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    float2 w3 = f * f * (-0.5 + 0.5 * f);
    float2 w12 = w1 + w2;

    float2 tc0 = (center - 1.0) * screen_res.zw;
    float2 tc3 = (center + 2.0) * screen_res.zw;
    float2 tc12 = (center + w2 / w12) * screen_res.zw;

    float3 c = s_taa_history.SampleLevel(smp_rtlinear, float2(tc12.x, tc0.y), 0).rgb * (w12.x * w0.y);
    c += s_taa_history.SampleLevel(smp_rtlinear, float2(tc0.x, tc12.y), 0).rgb * (w0.x * w12.y);
    c += s_taa_history.SampleLevel(smp_rtlinear, float2(tc12.x, tc12.y), 0).rgb * (w12.x * w12.y);
    c += s_taa_history.SampleLevel(smp_rtlinear, float2(tc3.x, tc12.y), 0).rgb * (w3.x * w12.y);
    c += s_taa_history.SampleLevel(smp_rtlinear, float2(tc12.x, tc3.y), 0).rgb * (w12.x * w3.y);

    // The dropped corner taps carry a little (negative) weight; renormalise so a flat field
    // stays flat.
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(c / wsum, 0.0);
}

taa_out main(float2 tc : TEXCOORD0, float2 tcJ : TEXCOORD1, float4 pos2d : SV_Position)
{
    gbuffer_data gbd = gbuffer_load_data(tc, pos2d.xy);

    float3 current = s_image.Sample(smp_nofilter, tc).rgb;

    [branch]
    if (tc.x >= pda_taa_bbox.x && tc.y >= pda_taa_bbox.y && tc.x <= pda_taa_bbox.z &&
        tc.y <= pda_taa_bbox.w)
        return taa_write(current);

    // Sky pixels have no meaningful reprojection depth; the clamp would pass anyway, but
    // skipping keeps cloud motion crisp. Same convention as gtao_render: the position
    // target is cleared to zero, so view-z below epsilon means sky.
    // The other end of the same test is the HUD: hands and the weapon live in the first
    // ~0.6 m of view-z and move with the player, not the world - the camera reprojection is
    // simply wrong for them, and running history over the barrel doubles it on every turn
    // and every bob step. World geometry this close to the eye is a wall filling the whole
    // view; losing TAA on it for a moment is invisible.
    [branch]
    if (gbd.P.z < 0.65)
        return taa_write(current);

    // Reproject the view-space position into the previous frame.
    float4 prev_clip = mul(m_taa_previous, float4(gbd.P, 1.0));
    float2 prev_uv = (prev_clip.xy / prev_clip.w) * float2(0.5, -0.5) + 0.5;

    [branch]
    if (prev_uv.x < 0.0 || prev_uv.x > 1.0 || prev_uv.y < 0.0 || prev_uv.y > 1.0 || prev_clip.w <= 0.0)
        return taa_write(current);

    float3 history = taa_history(prev_uv);

    // Variance clipping (Karis / INSIDE): the history may show something no longer visible
    // (disocclusion, a moving NPC, a rain streak - none carry velocity here). A raw 3x3
    // min/max clamp leaves bounds wide wherever the neighbourhood has any contrast, and a
    // ghost inside those bounds survives for many frames; the mu +/- sigma box hugs the
    // actual distribution, so anything the current frame does not corroborate is pulled
    // back within a frame or two. Clipping toward the mean (uniform scale) instead of a
    // per-component clamp keeps the hue - corner-of-the-box clamping tints the ghost.
    // The same box also bounds the cubic's ringing at hard edges.
    float3 m1 = current, m2 = current * current;
    [unroll]
    for (int dy = -1; dy <= 1; ++dy)
    {
        [unroll]
        for (int dx = -1; dx <= 1; ++dx)
        {
            if (dx == 0 && dy == 0)
                continue;
            float3 n = s_image.Sample(smp_nofilter, tc + float2(dx, dy) * screen_res.zw).rgb;
            m1 += n;
            m2 += n * n;
        }
    }
    m1 /= 9.0;
    m2 /= 9.0;
    float3 sigma = sqrt(max(m2 - m1 * m1, 0.0));
    float3 dist = history - m1;
    float3 excess = abs(dist) / max(sigma, 0.001);
    float t = max(excess.x, max(excess.y, excess.z));
    if (t > 1.0)
        history = m1 + dist / t;

    // Blend weight backs off with reprojection distance: fast pans keep the image crisp,
    // a still or slowly turning camera converges to a stable field.
    float motion_px = length((prev_uv - tc) * screen_res.xy);
    float w = 0.88 * saturate(1.0 - motion_px / 24.0);

    return taa_write(lerp(current, history, w));
}
