#include "common.h"

// Temporal AA (Dead Air x64). The scene is rendered through a projection jittered by a
// sub-pixel Halton offset every frame (da_temporal.h), and this pass accumulates those
// samples: the current frame is blended with the reprojected previous result under a
// neighbourhood clamp. Runs on the tonemapped LDR frame after SMAA, so the history is LDR too.
//
// Reprojection: through the motion vectors of the velocity pass when they were made this
// frame (they carry the camera, moving models, the HUD and the wind); otherwise through
// m_previous from the mblur block of phase_combine - previous-frame view-projection composed
// with the CURRENT inverse view, i.e. current view-space positions straight into the previous
// frame's clip space. Both are unjittered; the G-buffer position already has the jitter taken
// out (pos_decompression_params), so the jitter is added back to land on the history's grid.
//
// Two outputs: the frame the rest of the chain reads (RGBA8 rt_Generic) and the history
// for the next frame (10-bit rt_taa_resolve). The history needs more than 8 bits: with
// the 0.12 update gain an 8-bit target rounds away every correction under ~4/255, so the
// softness picked up while the camera moved never converged back once it stopped.

Texture2D s_taa_history;
// NDC(current) - NDC(previous), unjittered, y up (the velocity pass's target).
Texture2D s_da_taa_velocity;

uniform float4x4 m_taa_previous;
uniform float4 screen_res;
// x: 1 when the motion vectors were rendered this frame, y: 1 on a history reset (level load,
// teleport, back from the menu), zw: this frame's jitter in uv, y down.
uniform float4 da_taa_params;
// Screen-space uv bbox (min.xy, max.xy) of the held 3D PDA. Its screen is a forward pass
// with no G-buffer depth, so reprojection under it follows the BACKGROUND and smears the
// display while moving. Inside the box the current frame passes through untouched. Empty
// (min > max) when no device is up.
uniform float4 pda_taa_bbox;

struct taa_out
{
    float4 frame : SV_Target0;
    float4 history : SV_Target1;
};

taa_out taa_write(float3 c)
{
    taa_out O;
    O.frame = float4(c, 1.0);
    O.history = float4(c, 1.0);
    return O;
}

// Catmull-Rom history fetch, 9 taps folded into 5 bilinear ones (Jimenez, "Filmic SMAA").
// A plain bilinear fetch at the fractional reprojected offset is a 2x2 box filter applied to
// the history EVERY frame, and under the feedback below a slow pan stacks several of them -
// that is the softness on world geometry that reprojects perfectly. The cubic keeps most of
// the detail per resample; at an integer offset (still camera) it degenerates to the exact
// texel, so a converged history is never touched.
float3 taa_history(float2 uv)
{
    float2 pos = uv * screen_res.xy;
    float2 center = floor(pos - 0.5) + 0.5;
    float2 f = pos - center;

    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    float2 w3 = f * f * (-0.5 + 0.5 * f);
    float2 w12 = w1 + w2;

    float2 tc0 = (center - 1.0) * screen_res.zw;
    float2 tc3 = (center + 2.0) * screen_res.zw;
    float2 tc12 = (center + w2 / w12) * screen_res.zw;

    float3 c = s_taa_history.SampleLevel(smp_rtlinear, float2(tc12.x, tc0.y), 0).rgb * (w12.x * w0.y);
    c += s_taa_history.SampleLevel(smp_rtlinear, float2(tc0.x, tc12.y), 0).rgb * (w0.x * w12.y);
    c += s_taa_history.SampleLevel(smp_rtlinear, float2(tc12.x, tc12.y), 0).rgb * (w12.x * w12.y);
    c += s_taa_history.SampleLevel(smp_rtlinear, float2(tc3.x, tc12.y), 0).rgb * (w3.x * w12.y);
    c += s_taa_history.SampleLevel(smp_rtlinear, float2(tc12.x, tc3.y), 0).rgb * (w12.x * w3.y);

    // The dropped corner taps carry a little (negative) weight; renormalise so a flat field
    // stays flat.
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(c / wsum, 0.0);
}

#ifdef GRIZZLY_WAVE_LANES
// The 3x3 neighbourhoods of a 2x2 quad cover a 4x4 block: each lane loads the three texels past its
// own on its outer side and takes the other five from the lanes beside it (dxc.md 6.4). Quad-uniform
// control flow only: every lane of the quad must reach this call.
void taa_moments(float2 tc, float2 pos2d, float3 current, out float3 m1, out float3 m2)
{
    const float2 o = float2((uint2(pos2d) & 1u) * 2u) - 1.0;
    const float3 a = s_image.Sample(smp_nofilter, tc + float2(o.x, 0.0) * screen_res.zw).rgb;
    const float3 b = s_image.Sample(smp_nofilter, tc + float2(0.0, o.y) * screen_res.zw).rgb;
    const float3 d = s_image.Sample(smp_nofilter, tc + o * screen_res.zw).rgb;
    const float3 n0 = QuadReadAcrossX(current), n1 = QuadReadAcrossX(b), n2 = QuadReadAcrossY(current),
                 n3 = QuadReadAcrossY(a), n4 = QuadReadAcrossDiagonal(current);
    m1 = current + a + b + d + n0 + n1 + n2 + n3 + n4;
    m2 = current * current + a * a + b * b + d * d + n0 * n0 + n1 * n1 + n2 * n2 + n3 * n3 + n4 * n4;
}
#endif

// Exactly what da_fullscreen.vs outputs, in its order: D3D12 refuses a pipeline whose pixel
// shader asks for an input the vertex shader does not write.
taa_out main(float2 tc : TEXCOORD0, float4 pos2d : SV_Position)
{
    gbuffer_data gbd = gbuffer_load_data(tc, pos2d.xy);

    float3 current = s_image.Sample(smp_nofilter, tc).rgb;

    // What passes through untouched is taken back to the pixel's own centre: a jittered sample
    // left as it is would shake the passed-through pixels by up to half a pixel every frame.
    // Without jitter (zw = 0) this is the texel itself.
    const float3 still = s_image.SampleLevel(smp_rtlinear, tc + da_taa_params.zw, 0).rgb;

#ifdef GRIZZLY_WAVE_LANES
    // The pass-through cases below, decided for the whole quad first: a quad with any pixel that
    // blends takes its neighbourhood here, while all four lanes still run.
    const bool pass = da_taa_params.y > 0.5 || gbd.P.z < 1.10 ||
        (tc.x >= pda_taa_bbox.x && tc.y >= pda_taa_bbox.y && tc.x <= pda_taa_bbox.z && tc.y <= pda_taa_bbox.w);
    const bool quad_blends = !pass || !QuadReadAcrossX(pass) || !QuadReadAcrossY(pass) || !QuadReadAcrossDiagonal(pass);
    float3 m1 = current, m2 = current * current;
    [branch]
    if (quad_blends)
        taa_moments(tc, pos2d.xy, current, m1, m2);
#endif

    [branch]
    if (da_taa_params.y > 0.5)
        return taa_write(still);

    [branch]
    if (tc.x >= pda_taa_bbox.x && tc.y >= pda_taa_bbox.y && tc.x <= pda_taa_bbox.z &&
        tc.y <= pda_taa_bbox.w)
        return taa_write(still);

    // Sky pixels have no meaningful reprojection depth; the clamp would pass anyway, but
    // skipping keeps cloud motion crisp. Same convention as gtao_render: the position
    // target is cleared to zero, so view-z below epsilon means sky.
    // The other end of the same test is the HUD: hands and whatever is in them move with the
    // player, not the world - the camera reprojection is simply wrong for them, and running
    // history over the barrel doubles it on every turn and every bob step, which reads as
    // cracks and a wireframe across the weapon. 0.65 m covered the hands and left a rifle's
    // barrel and a scope outside; a held item reaches past a metre, so the cut is there.
    // World geometry this close to the eye is a surface being leant against; losing TAA on it
    // for a moment is invisible.
    [branch]
    if (gbd.P.z < 1.10)
        return taa_write(still);

    float2 prev_uv;
    bool behind = false;
    [branch]
    if (da_taa_params.x > 0.5)
    {
        // The motion vector of this pixel's surface: where it was, in the history's grid.
        const float2 v = s_da_taa_velocity.SampleLevel(smp_nofilter, tc, 0).xy;
        prev_uv = tc - v * float2(0.5, -0.5);
    }
    else
    {
        // Reproject the view-space position into the previous frame. The position is where
        // the jittered sample landed; the history's grid is the pixel centres, jitter away.
        float4 prev_clip = mul(m_taa_previous, float4(gbd.P, 1.0));
        prev_uv = (prev_clip.xy / prev_clip.w) * float2(0.5, -0.5) + 0.5 + da_taa_params.zw;
        behind = prev_clip.w <= 0.0;
    }

    [branch]
    if (prev_uv.x < 0.0 || prev_uv.x > 1.0 || prev_uv.y < 0.0 || prev_uv.y > 1.0 || behind)
        return taa_write(still);

    float3 history = taa_history(prev_uv);

    // Variance clipping (Karis / INSIDE): the history may show something no longer visible
    // (disocclusion, a moving NPC, a rain streak - none carry velocity here). A raw 3x3
    // min/max clamp leaves bounds wide wherever the neighbourhood has any contrast, and a
    // ghost inside those bounds survives for many frames; the mu +/- sigma box hugs the
    // actual distribution, so anything the current frame does not corroborate is pulled
    // back within a frame or two. Clipping toward the mean (uniform scale) instead of a
    // per-component clamp keeps the hue - corner-of-the-box clamping tints the ghost.
    // The same box also bounds the cubic's ringing at hard edges.
#ifndef GRIZZLY_WAVE_LANES
    float3 m1 = current, m2 = current * current;
    [unroll]
    for (int dy = -1; dy <= 1; ++dy)
    {
        [unroll]
        for (int dx = -1; dx <= 1; ++dx)
        {
            if (dx == 0 && dy == 0)
                continue;
            float3 n = s_image.Sample(smp_nofilter, tc + float2(dx, dy) * screen_res.zw).rgb;
            m1 += n;
            m2 += n * n;
        }
    }
#endif
    m1 /= 9.0;
    m2 /= 9.0;
    float3 sigma = sqrt(max(m2 - m1 * m1, 0.0));
    float3 dist = history - m1;
    float3 excess = abs(dist) / max(sigma, 0.001);
    float t = max(excess.x, max(excess.y, excess.z));
    if (t > 1.0)
        history = m1 + dist / t;

    // Blend weight backs off with reprojection distance: fast pans keep the image crisp,
    // a still or slowly turning camera converges to a stable field.
    float motion_px = length((prev_uv - tc) * screen_res.xy);
    float w = 0.88 * saturate(1.0 - motion_px / 24.0);

    // How far the history had to be pulled to fit the current distribution is also how much
    // it DISAGREES with it, and clipping alone still blends the pulled value in at full
    // weight. Nothing here carries velocity, so a leaf card moving in the wind reprojects as
    // if it had stood still: its history is the leaf one frame ago, the clip drags that to
    // the local mean - which at a leaf edge is half sky - and 88% of that lands on the
    // pixel. Frame after frame the crown turns into a haze with the cloud pattern showing
    // through it, which is what a player sees as the sky coming through the trees. Weighted
    // down by the same number, a moving leaf keeps its own pixel while everything that
    // reprojects honestly (t <= 1, the whole static world) keeps its history untouched.
    w *= saturate(1.0 - (t - 1.0) * 0.5);

    return taa_write(lerp(current, history, w));
}
