// Dead Air: Refined - ground-truth based ambient occlusion (render pass).
//
// Ported from IX-Ray (gamedata\shaders\d3d11\gtao_render.ps.hlsl, author LVutner;
// no-arccos GTAO after TinyTexel/Jimenez et al). Differences from the donor are
// dictated by our G-buffer, not by taste:
//   * the donor reads the hardware depth buffer and reconstructs view-z through
//     depth_unpack; our deferred position target already stores LINEAR VIEW-Z in
//     s_position.z under both G-buffer layouts, so the reconstruction is one MAD;
//   * the donor packs (view-z, AO) into an R32_UINT via f32tof16 - our RT system
//     has no uint formats, so the pair goes to R16G16_FLOAT verbatim (the packing
//     was 16-bit halves anyway, the stored values are bit-identical);
//   * the donor's sky test is "hw depth == 1"; ours is "view-z < 0.01" - the
//     position target is cleared to zero whenever AO is on (phase_scene_prepare),
//     the same convention ssao.ps uses;
//   * blue noise comes from our engine-built $user$blue_noise (R8G8, 128x128,
//     slice 0 of the donor's volume - see gtao_noise.h), not from a texture file.
//
// Drawn with da_fullscreen.vs over g_combine (see r4_rendertarget_phase_gtao.cpp).
// Runs at FULL resolution, like the donor. The body is gtao_render_pixel (gtao.h), shared
// with gtao_render.cs.

#include "gtao.h"

// The full input signature stays: the pass links against da_fullscreen.vs.
float2 main(float2 tc0 : TEXCOORD0, float4 hpos : SV_Position) : SV_Target
{
    DA_STAGE_EXACT float2 r = gtao_render_pixel(uint2(hpos.xy));
    return r;
}
