// Procedural shrubs: clusters and blobs in the sun cascades - the same leaves (da_shrub_mass.h), no output.

#include "common.h"
#include "da_shrub_mass.h"

struct p_shrub_mass_shadow
{
	float4	hpos	: SV_Position;
	float4	part	: TEXCOORD5;
	float4	dens	: TEXCOORD6;
	float4	misc	: TEXCOORD7;
	float4	xy_t	: TEXCOORD8;	// z: the share of the part's leaves on (da_shrub_cluster_vs.h)
};

void	main	(p_shrub_mass_shadow I)
{
	// Where a cell is under three texels its leaf is under one: the leaves gather into clumps three texels across, a
	// dapple (the leaves' cells, their texture and their gradients were most of a cascade's cost for no texel of
	// difference; the mean blot's solid shadow stepped from the near cascade's leaves at its seam round the player); a
	// part under two clumps across its mean blot alone.
	[branch] if (I.misc.w < 3.0f * I.dens.y)
	{
		shrub_mass_clip(I.misc.w >= 6.0f ? shrub_mass_dapple(I.xy_t.xy, I.part, I.dens, I.misc, I.misc.w / 3.0f, I.xy_t.z)
			: shrub_mass_blot(I.xy_t.xy, I.part, I.dens, I.misc, I.xy_t.z), I.hpos.xy, 0.0f, 0.0f);
		return;
	}
	// Where a leaf's cell is three texels and more: a round clump a leaf at the same cover (Beer-Lambert). A part casts
	// from past the near leaves (a crown over 22 m away, its shadow in the near map, or any farther map), high over what it
	// shades: its sunflecks are the sun's pinhole images and its leaves' outlines lie in a penumbra of some nine
	// centimetres a ten metres of height. The leaves' own outlines (their texture, every cell's turn, the twigs) were
	// most of the trees' shadow maps: seven million texels of a near map at a centimetre each.
	// (The clumps' grid turned its own way per part, as the leaves' cells are: square to every quad, a crown's shadow
	// showed its rows.)
	float g_s, g_c;
	sincos(I.dens.w * 6.2832f, g_s, g_c);
	const float2 p = float2(I.xy_t.x * g_c - I.xy_t.y * g_s, I.xy_t.x * g_s + I.xy_t.y * g_c);
	shrub_mass_clip(shrub_mass_dapple(p, I.part, I.dens, I.misc, I.dens.y, I.xy_t.z), I.hpos.xy, 0.0f, 0.0f);
}