#include "da_clouds_march.h"

// The volumetric march as a pixel pass (phase_clouds_march): the body is
// da_clouds_march_pixel (da_clouds_march.h).
struct v2p
{
	float2	tc0		: TEXCOORD0;
};

// The full input signature stays: the pass links against da_fullscreen.vs.
float4 main(v2p I, float4 pos2d : SV_Position) : SV_Target
{
	return da_clouds_march_pixel(uint2(pos2d.xy));
}
