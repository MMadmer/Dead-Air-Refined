#include "common.h"

struct 	v2p
{
	float4	color	: COLOR0;	// rgb. intensity, for SM3 - tonemap prescaled
  	float2	tc0		: TEXCOORD0;
  	float2	tc1		: TEXCOORD1;
};

//uniform sampler2D 	s_clouds0	: register(s0);
//uniform sampler2D 	s_clouds1	: register(s1);
Texture2D	s_clouds0	: register(t0);
Texture2D	s_clouds1	: register(t1);

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	main	( v2p I, float4 pos2d : SV_Position )	: SV_Target
{
	float4 	s0		= s_clouds0.Sample( smp_base, I.tc0 );
	float4 	s1		= s_clouds1.Sample( smp_base, I.tc1 );
	// [DA] Формула строго стоковая. Попытка «смягчить» сумму screen-смешением ОСЛАБИЛА
	// плотную грозовую пелену - и сквозь неё просветился тёмный верх штормовых скай-кубмап,
	// который эта пелена по дизайну и прикрывает («чёрные стенки скайбокса», полевой тест).
	float4 	mix 	= I.color * (s0 + s1)	;

	float4 	rgb		= mix		;

	// [DA] Единственная правка: выходной дизеринг. Облачные градиенты - худший случай
	// 8-битного бандинга (плавный купол на полнеба). Треугольный шум +-1/2 LSB, только от
	// экранной позиции - статичный кадр остаётся статичным.
	{
		const float dn0 = frac(sin(dot(pos2d.xy, float2(12.9898f, 78.233f))) * 43758.5453f);
		const float dn1 = frac(sin(dot(pos2d.xy, float2(39.3468f, 11.135f))) * 24634.6345f);
		rgb.rgb += (dn0 + dn1 - 1.0f) * (1.0f / 255.0f);
	}

	return  rgb;
}
