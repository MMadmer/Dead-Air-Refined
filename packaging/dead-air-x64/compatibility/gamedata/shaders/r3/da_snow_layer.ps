//
// The full-screen snow layer, first pass (da_snow.cpp, docs/dead-air/SNOW.md): every opaque G-buffer
// pixel (stencil 1) gets the snow of its world position, at every distance, on every deferred shader
// without editing any of them. The result goes to two scratch targets; da_snow_apply.ps writes it back
// (a G-buffer target cannot be read while it is written).
//   coverage  snow depth (season + trails, its thin margin ragged), slope, exposure (what lies over the
//             fall line shelters, a bank beside it does not), dark ground losing thin snow first, the
//             class cover keys on onset/melt days, roads covered whole from December to February (D5),
//             a static surface standing over the snow (a roof past the shells' reach, a crate, a sill) its
//             own cover, anything else above the snow surface at most a light up-facing dusting (D8)
//   look      the class albedo of the month, compacted prints and roads (tyre ruts, a little dirt),
//             water-logged hollows, litter, thin snow letting the ground through (two-way diffuse
//             transmission) and breaking into a mottle at its margin, a subtle wet dark ring around
//             melting patches, the snow surface's own
//             smooth normal with subtle wind ripples, and world-anchored glints of single grains for
//             da_snow_light.h (they twinkle as the eye moves)
//   shells    a shell pixel (da_snow_shell.vs: the snow on a roof, a deck, a vehicle) is deep snow
//   ice       a grid pixel over frozen water is the sheet the grid draws there: bare ice or the snow on it
//   material  code 31 where the snow dominates, the puddle flag cleared under snow; skipped: foliage
//             codes (blades carry their own snow), the first-person view, the lake bed

#include "common.h"
#include "da_material_codes.h"
#include "da_snow_common.h"
#include "da_snow_light.h"

#ifdef USE_MSAA
#define DA_SN_LOAD(tex, p) tex.Load(int2(p), iSample)
#else
#define DA_SN_LOAD(tex, p) tex.Load(int3(int2(p), 0))
#endif

uniform float4x4 da_sn_v2w;  // view -> world
uniform float4x4 da_sn_w2v;  // world -> view
uniform float4 da_sn_sun;    // xyz world direction to the sun, w its strength 0..1 (0 while it is down or hidden)
uniform float4 da_sn_wind;   // xy direction the wind blows to (xz), z tan of the flakes' slant, w unused
uniform float4 da_sn_layer;  // x onset/melt dusting weight, y dusting above the surface, z glint strength, w metres per pixel at 1 m
uniform float4 da_sn_layer2; // x snowfall freshness 0..1, y detail normal range (m), z glint range (m), w depth of the first-person slice

uniform float4 da_snow_cover;  // class cover keys (open, under trees, road, drift)
uniform float4 da_snow_state;  // weights fresh, settled, old, wet (slush = 1 - sum)
uniform float4 da_snow_surf;   // age, crust, wetness, drift strength
uniform float4 da_snow_dirt;   // roadside dirt, litter under trees, road compaction, cap
uniform float4 da_snow_albedo_open;  // linear rgb
uniform float4 da_snow_albedo_road;
uniform float4 da_snow_albedo_trees;

// How much of the snow a print compacted (da_snow_composite.cs), toroidal like the fine depth texture.
Texture2D<float> s_da_sn_trod;
// Metres to the edge of the road inside a road (0..12.75 m as unorm, level texels; da_snow.cpp).
Texture2D<float> s_da_sn_road;
// The topmost static surface: the near window's raw raster (da_ground.cpp, R32F, toroidal) and the level's
// at 1 m (R16_UNORM like the base).
Texture2D<float> s_da_ground_top;
Texture2D<float> s_da_sn_top;

#ifndef USE_MSAA
Texture2D s_depth_copy; // the hardware depth the G-buffer left (da_snow.cpp copies it)
#endif

// The material bare ice is lit as: the stock gloss slice (deffer shaders write (m + 0.5) / 4, m = 1).
#define DA_SN_ICE_MTL 0.375
// Gloss of smooth snow. The sun's specular is five times the gloss times the light twice over (combine_1.ps:
// the accumulated specular times the light's colour) and its lobe is broad: under a bright low sun even a gloss
// of 0.07 drew a smooth glossy streak along every swell toward the sun. Snow's own specular is weak and rough;
// what flashes on it is single grains (the glints below).
#define DA_SN_GLOSS 0.012
// The gloss of the meltwater pooled in a hollow and of wet ruts: a real mirror.
#define DA_SN_GLOSS_WATER 0.25

// The first-person view: rasterised into the top slice of the depth range. MSAA has no single-sampled
// copy of the depth: everything nearer than the longest first-person item stays as it is there.
bool da_sn_first_person(float2 pos2d, float view_z)
{
#ifdef USE_MSAA
	return view_z < 1.0;
#else
	return s_depth_copy.Load(int3(int2(pos2d), 0)).x < da_sn_layer2.w;
#endif
}

struct da_sn_layer_out
{
	float4 g0 : SV_Target0; // packed: normal xy, 1 = changed, position w; else normal xyz, material (0 = unchanged)
	float4 g1 : SV_Target1; // albedo (sRGB-encoded as the G-buffer holds it), gloss
};

float3 da_sn_to_linear(float3 c) { return pow(max(c, 0.0), 2.2); }
float3 da_sn_to_encoded(float3 c) { return pow(max(c, 0.0), 1.0 / 2.2); }

uint da_sn_hash_u(uint3 v)
{
	// pcg3d, one round folded to one value
	v = v * 1664525u + 1013904223u;
	v.x += v.y * v.z;
	v.y += v.z * v.x;
	v.z += v.x * v.y;
	v ^= v >> 16u;
	v.x += v.y * v.z;
	return v.x ^ (v.y >> 7u) ^ (v.z << 3u);
}

float da_sn_hash(float3 cell, uint salt)
{
	return float(da_sn_hash_u(asuint(int3(cell)) + salt) & 0xFFFFFFu) * (1.0 / 16777216.0);
}

// Value noise with its gradient (x value, yz d/dx, d/dz), smooth cubic interpolation.
float3 da_sn_noise(float2 p, uint salt)
{
	const float2 i = floor(p);
	const float2 f = p - i;
	const float2 u = f * f * (3.0 - 2.0 * f);
	const float2 du = 6.0 * f * (1.0 - f);
	const float a = da_sn_hash(float3(i, 0.0), salt);
	const float b = da_sn_hash(float3(i + float2(1.0, 0.0), 0.0), salt);
	const float c = da_sn_hash(float3(i + float2(0.0, 1.0), 0.0), salt);
	const float d = da_sn_hash(float3(i + float2(1.0, 1.0), 0.0), salt);
	const float k = a - b - c + d;
	return float3(a + (b - a) * u.x + (c - a) * u.y + k * u.x * u.y, du.x * ((b - a) + k * u.y), du.y * ((c - a) + k * u.x));
}

// Share of the sky's snowfall reaching p. Only what lies above the fall line from p shelters it (a roof,
// an eave, a bridge deck); a bank, a kerb or a wall foot beside it does not. The fall line climbs upwind
// by the flakes' slant; five taps of the snow base: straight over p at 0.3 m (0.4 of the weight) and a
// cross of four at 1.2 m, 0.35 m out (the soft edge of an eave). The base is a conservative raster (each
// texel holds its highest point), so on a slope it stands up to half a texel's rise above the surface:
// not cover.
// The opened topmost surface at xz in the near window (DA_SN_NONE beyond it: past the window the depth itself
// carries the covers' shelter).
float da_sn_cover_top(float2 xz)
{
	const float2 d = abs(xz - da_sn_win.xy);
	[branch] if (max(d.x, d.y) > da_sn_win.z)
		return DA_SN_NONE;
	const int n = int(da_sn_win2.x);
	const float2 p = xz * da_sn_win2.y - 0.5;
	const float2 i = floor(p);
	const float2 f = p - i;
	const int2 t = int2(i);
	const float4 h = float4(s_da_ground_base.Load(int3(da_sn_wrap(t, n), 0)).w, s_da_ground_base.Load(int3(da_sn_wrap(t + int2(1, 0), n), 0)).w,
		s_da_ground_base.Load(int3(da_sn_wrap(t + int2(0, 1), n), 0)).w, s_da_ground_base.Load(int3(da_sn_wrap(t + int2(1, 1), n), 0)).w);
	[branch] if (min(min(h.x, h.y), min(h.z, h.w)) < DA_SN_NONE * 0.5)
		return max(max(h.x, h.y), max(h.z, h.w));
	return lerp(lerp(h.x, h.y, f.x), lerp(h.z, h.w, f.x), f.y);
}

// The topmost static surface at xz (x) and its texel (y, m): the near window's raw raster (each texel its highest
// point), the level's 1 m field beyond it. DA_SN_NONE where nothing is.
float2 da_sn_static_top(float2 xz)
{
	const float2 d = abs(xz - da_sn_win.xy);
	[branch] if (max(d.x, d.y) < da_sn_win.z)
	{
		const int2 t = int2(floor(xz * da_sn_win2.y));
		return float2(s_da_ground_top.Load(int3(da_sn_wrap(t, int(da_sn_win2.x)), 0)), 1.0 / da_sn_win2.y);
	}
	const float v = s_da_sn_top.Load(int3(int2(floor(xz * da_snow_level_xf.xy + da_snow_level_xf.zw)), 0));
	return float2((v > 0.0) ? da_sn_lvl.x + v * da_sn_lvl.y : DA_SN_NONE, 1.0 / da_snow_level_xf.x);
}

float da_sn_exposure(float3 p, float3 n)
{
	const float2 grad = -n.xz / max(n.y, 0.25);
	const float lift = 0.5 * (abs(grad.x) + abs(grad.y)) / max(da_sn_win2.y, 1.0);
	const float2 slant = -da_sn_wind.xy * min(da_sn_wind.z, 0.5);
	float clear = 0.0;
	[unroll] for (int k = 0; k < 5; ++k)
	{
		const float h = (k == 0) ? 0.3 + lift : 1.2;
		const float2 o = (k == 0) ? float2(0.0, 0.0) : float2((k == 1) ? 0.35 : ((k == 2) ? -0.35 : 0.0), (k == 3) ? 0.35 : ((k == 4) ? -0.35 : 0.0));
		const float yT = da_sn_cover_top(p.xz + o + slant * h);
		const float c = (yT < DA_SN_NONE * 0.5) ? 1.0 : saturate((p.y + h - yT) / 0.15 + 0.5);
		clear += c * ((k == 0) ? 0.4 : 0.15);
	}
	return clear;
}

float da_sn_level_now(int2 t)
{
	return float(s_da_snow_level.Load(int3(t, 0)) & 0xFFFFu) * (da_snow_misc.x / 65535.0);
}

float da_sn_fine_now(float2 a)
{
	return float(s_da_snow_fine.Load(int3(int(a.x), int(a.y), 0)) & 0xFFFFu) * (da_snow_misc.x / 65535.0);
}

// The current snow depth (trails included, exactly da_snow_depth) and its gradient (no base) from shared
// texels: in the fine window a forward difference over one fine texel (its season part is a cubic B-spline,
// the trails are 4.7 cm detail), eight loads for both; past it a central difference over one level texel
// either way (a tent across its texels: no crease at their borders), twelve loads; blended where the fine
// window ends, as the depth itself is.
void da_sn_depth_grad(float2 xz, out float D, out float2 g)
{
	D = 0.0;
	g = float2(0.0, 0.0);
	[branch] if (da_snow_misc.z < 0.5)
		return;
	const float2 dd = abs(xz - da_snow_fine_xf.zw);
	const float wf = saturate((da_snow_misc.y - max(dd.x, dd.y)) / max(da_snow_misc.w, 1e-3));
	[branch] if (wf < 1.0)
	{
		const float2 p = xz * da_snow_level_xf.xy + da_snow_level_xf.zw - 0.5;
		const float2 i = floor(p);
		const float2 f = p - i;
		const int2 t = int2(i);
		// rows t.y and t.y + 1 over columns t.x - 1 .. t.x + 2, and columns t.x, t.x + 1 of rows t.y - 1, t.y + 2
		float r0[4], r1[4];
		[unroll] for (int k = 0; k < 4; ++k)
		{
			r0[k] = da_sn_level_now(t + int2(k - 1, 0));
			r1[k] = da_sn_level_now(t + int2(k - 1, 1));
		}
		const float rm = lerp(da_sn_level_now(t + int2(0, -1)), da_sn_level_now(t + int2(1, -1)), f.x);
		const float rp = lerp(da_sn_level_now(t + int2(0, 2)), da_sn_level_now(t + int2(1, 2)), f.x);
		const float c0 = lerp(r0[1], r0[2], f.x), c1 = lerp(r1[1], r1[2], f.x);
		D = lerp(c0, c1, f.y);
		const float xp = lerp(lerp(r0[2], r0[3], f.x), lerp(r1[2], r1[3], f.x), f.y);
		const float xm = lerp(lerp(r0[0], r0[1], f.x), lerp(r1[0], r1[1], f.x), f.y);
		g = 0.5 * float2((xp - xm) * da_snow_level_xf.x, (lerp(c1, rp, f.y) - lerp(rm, c0, f.y)) * da_snow_level_xf.y);
	}
	[branch] if (wf > 0.0)
	{
		// world texel modulo the window size, as da_snow_fine2
		const float n = da_snow_fine_xf.y;
		const float2 p = xz * da_snow_fine_xf.x - 0.5;
		const float2 i = floor(p);
		const float2 f = p - i;
		const float2 a0 = i - n * floor(i / n);
		const float2 a1 = a0 + 1.0 - n * step(n, a0 + 1.0);
		const float2 a2 = a1 + 1.0 - n * step(n, a1 + 1.0);
		const float d00 = da_sn_fine_now(a0), d10 = da_sn_fine_now(float2(a1.x, a0.y)), d20 = da_sn_fine_now(float2(a2.x, a0.y));
		const float d01 = da_sn_fine_now(float2(a0.x, a1.y)), d11 = da_sn_fine_now(a1), d21 = da_sn_fine_now(float2(a2.x, a1.y));
		const float d02 = da_sn_fine_now(float2(a0.x, a2.y)), d12 = da_sn_fine_now(float2(a1.x, a2.y));
		const float c = lerp(lerp(d00, d10, f.x), lerp(d01, d11, f.x), f.y);
		const float cx = lerp(lerp(d10, d20, f.x), lerp(d11, d21, f.x), f.y);
		const float cz = lerp(lerp(d01, d11, f.x), lerp(d02, d12, f.x), f.y);
		D = lerp(D, c, wf);
		g = lerp(g, float2(cx - c, cz - c) * da_snow_fine_xf.x, wf);
	}
}

// How much of the snow prints compacted here (0 outside the fine window), bilinear.
float da_sn_trod(float2 xz)
{
	const float2 dd = abs(xz - da_snow_fine_xf.zw);
	const float wf = saturate((da_snow_misc.y - max(dd.x, dd.y)) / max(da_snow_misc.w, 1e-3));
	[branch] if (wf <= 0.0 || da_snow_misc.z < 0.5)
		return 0.0;
	const float n = da_snow_fine_xf.y;
	const float2 p = xz * da_snow_fine_xf.x - 0.5;
	const float2 i = floor(p);
	const float2 f = p - i;
	const float2 a = i - n * floor(i / n);
	const float2 b = a + 1.0 - n * step(n, a + 1.0);
	const float t00 = s_da_sn_trod.Load(int3(int(a.x), int(a.y), 0));
	const float t10 = s_da_sn_trod.Load(int3(int(b.x), int(a.y), 0));
	const float t01 = s_da_sn_trod.Load(int3(int(a.x), int(b.y), 0));
	const float t11 = s_da_sn_trod.Load(int3(int(b.x), int(b.y), 0));
	return lerp(lerp(t00, t10, f.x), lerp(t01, t11, f.x), f.y) * wf;
}

// Metres to the road's edge (x) and its gradient (yz), bilinear over the level texels.
float3 da_sn_road_edge(float2 xz)
{
	const float2 p = da_sn_level_coord(xz);
	const float2 i = floor(p);
	const float2 f = p - i;
	const int2 t = int2(i);
	const float r00 = s_da_sn_road.Load(int3(t, 0)) * 12.75;
	const float r10 = s_da_sn_road.Load(int3(t + int2(1, 0), 0)) * 12.75;
	const float r01 = s_da_sn_road.Load(int3(t + int2(0, 1), 0)) * 12.75;
	const float r11 = s_da_sn_road.Load(int3(t + int2(1, 1), 0)) * 12.75;
	const float v = lerp(lerp(r00, r10, f.x), lerp(r01, r11, f.x), f.y);
	const float2 g = float2(lerp(r10 - r00, r11 - r01, f.y), lerp(r01 - r00, r11 - r10, f.x)) * da_snow_level_xf.xy;
	return float3(v, g);
}

// Thin snow lets what is under it through: the diffuse transmission of a scattering slab, down and back
// up, T = 1 / (1 + 0.135 d_we / r_e) (optical depth from the water equivalent d_we in mm and the grain
// radius r_e in mm, asymmetry 0.89). One centimetre of old snow is about half see-through, four
// centimetres hide the ground.
float da_sn_opacity(float D, float rho, float re)
{
	const float T = 1.0 / (1.0 + 0.135 * max(D, 0.0) * rho / re);
	return 1.0 - T * T;
}

// The clumps of a thinning margin: value noise of 25 and 8 cm around 0.5, each faded out as it nears the pixel
// footprint (m).
float da_sn_margin_noise(float2 xz, float footprint)
{
	const float wc = saturate(1.0 - footprint / 0.08);
	const float wf = saturate(1.0 - footprint / 0.027);
	return 0.5 + 0.6 * wc * (da_sn_vnoise(xz * (1.0 / 0.25), 0x84u) - 0.5) + 0.4 * wf * (da_sn_vnoise(xz * (1.0 / 0.08), 0x83u) - 0.5);
}

// A detail scale `scale` (m) at this pixel footprint (m): whole while a cell spans nine pixels or more, gone at
// three, so nothing finer than a few pixels is ever drawn (no shimmer under TAA, no glitter).
float da_sn_fade(float footprint, float scale)
{
	return saturate(1.5 - 4.5 * footprint / scale);
}

// Value noise of `scale` metres with its world gradient (x value, yz d/dx, d/dz), its lattice turned by
// rot = (cos, sin), so no octave lines up with the world's axes or with another octave.
float3 da_sn_pack_noise(float2 xz, float scale, float2 rot, uint salt)
{
	const float2 p = float2(dot(xz, rot), dot(xz, float2(-rot.y, rot.x))) / scale;
	const float2 i = floor(p);
	const float2 f = p - i;
	const float2 u = f * f * (3.0 - 2.0 * f);
	const float2 du = 6.0 * f * (1.0 - f);
	const int2 c = int2(i);
	// the cheap integer hash of da_snow_common.h: these octaves run on every snow pixel
	const float a = da_sn_hash2(c, salt), b = da_sn_hash2(c + int2(1, 0), salt);
	const float d = da_sn_hash2(c + int2(0, 1), salt), e = da_sn_hash2(c + int2(1, 1), salt);
	const float k = a - b - d + e;
	const float2 gq = du * float2((b - a) + k * u.y, (d - a) + k * u.x);
	return float3(a + (b - a) * u.x + (d - a) * u.y + k * u.x * u.y, float2(gq.x * rot.x - gq.y * rot.y, gq.x * rot.y + gq.y * rot.x) / scale);
}

struct da_sn_pack
{
	float2 g;      // slope the pack's relief adds to the snow surface (d/dx, d/dz)
	float3 tint;   // factor on the snow's albedo
};

// The snow pack's own texture, world-anchored, without a time term:
//   relief  the settled, wind-pressed undulation of the pack (lobes of 3.4 m and 1.15 m, about 3 degrees; fresh
//           snow drapes it less), the ablation hollows of melting snow (0.45 m) and, close up, the pack's granular
//           surface (2.2 cm and 0.75 cm: fine and smooth on fresh snow, coarse corn snow in the thaw);
//   albedo  a faint mottle of grain size and density following the relief (+-4 %: the hollows see less of the
//           sky and keep the older, coarser snow; wind-packed crests brighter), and on old and wet snow the dust
//           and litter it gathers as it settles and melts out: a thin grey-brown film over all of it, more in the
//           hollows of the relief and in sub-metre blotches, greyer meltwater in the ablation hollows, and its
//           coarse grains dimming it a little close up.
// Every scale fades out before it nears the pixel footprint (da_sn_fade), and every octave is skipped where it
// adds nothing (far away, fresh snow without dirt or melt). `comp` = compacted share (roads, prints: the relief
// flattened).
da_sn_pack da_sn_pack_detail(float2 xz, float footprint, float comp)
{
	const float slush = saturate(1.0 - dot(da_snow_state, float4(1.0, 1.0, 1.0, 1.0)));
	const float settled = saturate(da_snow_state.y + da_snow_state.z);
	const float melt = saturate(da_snow_state.w + slush);
	da_sn_pack r;
	r.g = float2(0.0, 0.0);
	r.tint = float3(1.0, 1.0, 1.0);
	const float f1 = da_sn_fade(footprint, 3.4);
	[branch] if (f1 <= 0.0)
		return r;
	const float amp = (0.7 + 0.3 * settled + 0.3 * saturate(da_snow_surf.w)) * (1.0 - 0.7 * comp);
	const float3 n1 = da_sn_pack_noise(xz, 3.4, float2(0.8, 0.6), 0x3A1u);
	r.g = 0.15 * amp * f1 * n1.yz;
	float h = 0.7 * n1.x + 0.15;
	const float f2 = da_sn_fade(footprint, 1.15);
	[branch] if (f2 > 0.0)
	{
		const float3 n2 = da_sn_pack_noise(xz, 1.15, float2(0.28, 0.96), 0x3A2u);
		r.g += 0.05 * amp * f2 * n2.yz;
		h += 0.3 * f2 * (n2.x - 0.5);
	}
	h = lerp(0.5, h, f1);
	float a = 1.0 + 0.08 * (h - 0.5);
	float3 tint = float3(1.0, 1.0, 1.0);
	const float dirt_amt = saturate(0.5 * da_snow_state.z + 0.8 * da_snow_state.w + slush);
	[branch] if (dirt_amt > 0.15)
	{
		// blotches of irregular outline: a 0.55 m noise over a 1.7 m one, the finer faded out first
		const float fb = da_sn_fade(footprint, 0.55);
		float nb = 0.5;
		[branch] if (fb > 0.0)
			nb = lerp(0.5, da_sn_pack_noise(xz, 0.55, float2(-0.6, 0.8), 0x3A6u).x, fb);
		const float blot = smoothstep(0.5, 0.85, 0.6 * nb + 0.4 * da_sn_pack_noise(xz, 1.7, float2(0.96, 0.28), 0x3A7u).x);
		const float dirt = dirt_amt * saturate(0.4 + 0.6 * saturate((0.47 - h) * 4.0) + 0.6 * blot);
		tint = lerp(tint, float3(0.80, 0.77, 0.72), 0.6 * dirt);
	}
	const float f3 = da_sn_fade(footprint, 0.45) * melt;
	[branch] if (f3 > 0.1)
	{
		const float3 n3 = da_sn_pack_noise(xz, 0.45, float2(0.96, -0.28), 0x3A3u);
		r.g += 0.02 * f3 * (1.0 - comp) * n3.yz;
		a *= 1.0 - 0.07 * f3 * saturate((0.5 - n3.x) * 3.0);
	}
	const float fg1 = da_sn_fade(footprint, 0.022);
	[branch] if (fg1 > 0.0)
	{
		const float coarse = saturate(0.35 + 0.65 * (melt + 0.5 * da_snow_state.z)) * (1.0 - 0.6 * comp);
		const float3 g1 = da_sn_pack_noise(xz, 0.022, float2(0.6, -0.8), 0x3A4u);
		r.g += 0.0024 * coarse * fg1 * g1.yz;
		a *= 1.0 + 0.08 * coarse * fg1 * (g1.x - 0.5);
		const float fg2 = da_sn_fade(footprint, 0.0075);
		[branch] if (fg2 > 0.0)
		{
			const float3 g2 = da_sn_pack_noise(xz, 0.0075, float2(-0.28, 0.96), 0x3A5u);
			r.g += 0.00075 * coarse * fg2 * g2.yz;
			a *= 1.0 + 0.05 * coarse * fg2 * (g2.x - 0.5);
		}
	}
	r.tint = a * tint;
	return r;
}

// The share of the snow's specular left on melting snow. The light model's sun specular is a broad lobe added
// on top of the albedo; coarse wet grains and slush scatter what their surface reflects mostly into grazing
// directions, so on them that lobe only lifted the thaw's grey snow (0.6-0.75) back to a fresh snow's white.
float da_sn_sheen()
{
	const float slush = saturate(1.0 - dot(da_snow_state, float4(1.0, 1.0, 1.0, 1.0)));
	return lerp(1.0, 0.5, saturate(da_snow_state.w + slush));
}

// Glints: the sun mirrored by single grains of the snow's surface. A cell carries the facet of its best placed
// grain, tilted at random about the surface normal (slope spread DA_SN_GLINT_SPREAD); it flashes while the sun's
// half vector falls within the cell's tolerance of it. With M grains in the cell the chance that one of them
// mirrors the sun grows M times and its share of the cell shrinks M times - but never past a few cells in a
// hundred (DA_SN_GLINT_CHANCE): grown on, the far cells flashed nearly all at once, faintly, and TAA smoothed
// them into a glossy streak toward a low sun. So near, few bright sparks; far, as few, each as bright as the
// cell's share of the sun allows. World-anchored, no time term: as the eye moves other grains light up and the
// snow twinkles; standing still nothing changes (TAA keeps them).
#define DA_SN_GLINT_SPREAD 0.35
#define DA_SN_GLINT_TOL 0.012
#define DA_SN_GLINT_K 400.0
#define DA_SN_GLINT_CHANCE 0.02
// ---- yellow snow -------------------------------------------------------------------------------------
// The stains of da_snow.cpp (stains_build): x, z, the core's radius, a seed; by 8 m cells (first << 12 | count).
Texture2D<uint> s_da_sn_stain_cells;
Texture2D<float4> s_da_sn_stains;
uniform float4 da_sn_stain; // xy the grid's origin (m), z its cell (m), w cells per row (0: none)

// x the halo (pale lemon), y the core (amber, melted in), z the melt hole (dark), w the drops, at xz. After the photo
// pack: an irregular core a little longer than wide, its edge ragged, a pale halo fading round it, a scatter of drops
// on one side, and in a share of them a small dark hole where the stream melted down.
float4 da_sn_stain_at(float2 xz)
{
	float4 r = float4(0.0, 0.0, 0.0, 0.0);
	[branch] if (da_sn_stain.w < 0.5)
		return r;
	const float2 gp = (xz - da_sn_stain.xy) / da_sn_stain.z;
	const int2 c0 = int2(floor(gp - 0.5));
	[unroll] for (int j = 0; j < 2; ++j)
	{
		[unroll] for (int i = 0; i < 2; ++i)
		{
			const int2 c = c0 + int2(i, j);
			[branch] if (c.x < 0 || c.y < 0 || c.x >= int(da_sn_stain.w))
				continue;
			const uint e = s_da_sn_stain_cells.Load(int3(c, 0));
			const uint first = e >> 12, count = e & 0xFFFu;
			[loop] for (uint k = 0; k < count; ++k)
			{
				const float4 s = s_da_sn_stains.Load(int3(int(first + k), 0, 0));
				const float2 d = xz - s.xy;
				// (out to the halo's end along the stretch: a 2 r bound cut the long ones short)
				[branch] if (dot(d, d) > 16.0 * s.z * s.z)
					continue;
				// the core's frame: turned by the seed, stretched 1.3..2.6 along it
				const float a = s.w * 6.2832;
				const float2 q = float2(dot(d, float2(cos(a), sin(a))), dot(d, float2(-sin(a), cos(a))));
				const float stretch = 1.3 + 1.3 * frac(s.w * 13.7);
				// a ragged edge: three octaves, the finest a couple of centimetres (soaked into the grains unevenly)
				const float n = da_sn_vnoise(xz * 7.0 + s.w * 37.0, 0xA1u) + 0.6 * da_sn_vnoise(xz * 19.0 + s.w * 11.0, 0xA2u) +
					0.35 * da_sn_vnoise(xz * 45.0 + s.w * 5.0, 0xA3u);
				const float dist = length(float2(q.x / stretch, q.y)) / s.z + 0.55 * (n - 0.98);
				// the core darker toward where the stream struck
				const float core = (1.0 - smoothstep(0.45, 0.85, dist)) * lerp(0.75, 1.0, 1.0 - smoothstep(0.0, 0.5, dist));
				const float halo = 1.0 - smoothstep(0.7, 1.6, dist);
				// the drops: a 2 cm lattice, a drop in some, splashed to one side of it
				const float2 dc = floor(xz / 0.02);
				const float h1 = frac(sin(dot(dc + s.w * 17.0, float2(12.9898, 78.233))) * 43758.5453);
				const float side = saturate(0.3 + 0.7 * dot(normalize(q + 1e-4), float2(1.0, 0.0)));
				const float drops = step(0.9, h1) * side * (1.0 - smoothstep(1.0, 2.2, dist)) * step(0.85, dist);
				const float hole = (frac(s.w * 7.3) < 0.45) ? 1.0 - smoothstep(0.0, 0.2, length(float2(q.x / (0.6 * stretch), q.y)) / s.z + 0.3 * (n - 0.98)) : 0.0;
				r = max(r, float4(halo, core, hole, drops));
			}
		}
	}
	return r;
}


// One cell level: x the flash (its brightness against the snow's diffuse light), 0 off. hs = the half
// vector's slope against the surface normal (tangent space), grain = grain size (m).
float da_sn_glint_cell(float3 pw, float cell, float2 hs, float grain, uint salt)
{
	const uint h = da_sn_hash_u(asuint(int3(floor(pw / cell))) + salt);
	const float u1 = (float(h & 0xFFFu) + 0.5) * (1.0 / 4096.0);
	const float u2 = float((h >> 12) & 0xFFFu) * (1.0 / 4096.0);
	const float u3 = float(h >> 24) * (1.0 / 256.0);
	// the facet's slope, normal with the spread (Box-Muller)
	const float rad = DA_SN_GLINT_SPREAD * sqrt(-2.0 * log(u1));
	const float2 fs = rad * float2(cos(6.2831853 * u2), sin(6.2831853 * u2));
	const float m = max(cell * cell / (grain * grain), 1.0);
	const float tol2 = min(DA_SN_GLINT_TOL * DA_SN_GLINT_TOL * m, DA_SN_GLINT_CHANCE * 2.0 * DA_SN_GLINT_SPREAD * DA_SN_GLINT_SPREAD);
	const float e = dot(hs - fs, hs - fs) / tol2;
	[branch] if (e >= 1.0)
		return 0.0;
	// brightness: the tolerance's share of the grains, spread over a heavy tail (most faint, a few bright)
	const float b = DA_SN_GLINT_K * DA_SN_GLINT_TOL * DA_SN_GLINT_TOL / tol2 * (0.25 + 3.0 * u3 * u3 * u3);
	return b * (1.0 - e) * (1.0 - e) * 3.0;
}

// The packed (or plain) G-buffer words of a changed pixel.
void da_sn_write(inout da_sn_layer_out o, float4 P, float3 N, float mtl_out, bool keep_mtl, float3 albedo, float gloss)
{
	const float3 Nout = normalize(mul((float3x3)da_sn_w2v, N));
#ifdef GBUFFER_OPTIMIZATION
	const float wout = keep_mtl ? asfloat(asuint(P.w) & ~USABLE_BIT_1) : gbuf_pack_hemi_mtl(gbuf_unpack_hemi(P.w), mtl_out);
	o.g0 = float4(gbuf_pack_normal(Nout), 1.0, wout);
#else
	o.g0 = float4(Nout, keep_mtl ? abs(P.w) : mtl_out);
#endif
	o.g1 = float4(da_sn_to_encoded(albedo), gloss);
}

// The snow grid's sheet over frozen water: bare ice (da_snow_ice.h) under the season's snow on it, the
// thin snow letting the ice through as it lets the ground through elsewhere; the snow wears the pack's own
// texture (da_sn_pack_detail), the bare ice stays flat. `bank` 1 = the bank's own snow running on over the
// ice at the waterline, 0 = the ice's own.
void da_sn_sheet(inout da_sn_layer_out o, float4 P, float3 Pw, float2 ice, float footprint, float bank)
{
	const float age = saturate(da_snow_surf.x - 0.5 * da_sn_layer2.x);
	const float wet = saturate(da_snow_surf.z);
	const float re = lerp(0.05, 1.0, age) * lerp(1.0, 1.5, wet);
	const float rho = lerp(lerp(80.0, 350.0, age), 500.0, wet * 0.6);
	const float k = smoothstep(0.002, 0.02, ice.y) * da_sn_opacity(ice.y, rho, re);
	const float4 bare = da_ice_albedo(Pw.xz, footprint);
	// snow on melting ice is soaked, greyer than the bank's; the bank's own snow running on at the waterline
	// (bank 1) keeps the bank's look, so the shore line shows no step
	float3 A = da_snow_albedo_open.rgb * (1.0 - 0.3 * lerp(saturate(wet - 0.3), saturate(0.144 * wet), bank));
	A = lerp(A, float3(0.89, 0.90, 0.92), 0.5 * da_sn_layer2.x);
	float3 N = float3(0.0, 1.0, 0.0);
	[branch] if (k > 0.01)
	{
		const da_sn_pack pack = da_sn_pack_detail(Pw.xz, footprint, 0.0);
		A *= pack.tint;
		N = normalize(float3(-pack.g.x * k, 1.0, -pack.g.y * k));
	}
	A = min(A, 0.9) * DA_SNOW_TINT;
	// Round a hole the water it pushed up soaks the snow grey, and seeps along the cracks as darker lines.
	const da_ice_mark mk = da_ice_marks(Pw.xz, footprint);
	A *= 1.0 - 0.45 * saturate(mk.wet + 0.8 * mk.crack);
	// The chips a bullet threw lie on the snow: clear chunks, greyer and bluer than the snow round them.
	A = lerp(A, A * float3(0.8, 0.85, 0.9), mk.chip);
	const float slush = saturate(1.0 - dot(da_snow_state, float4(1.0, 1.0, 1.0, 1.0)));
	const float rough = dot(da_snow_state, float4(0.80, 0.70, 0.55, 0.45)) + slush * 0.4;
	const float gloss = lerp(bare.a, saturate(1.0 - rough) * DA_SN_GLOSS * da_sn_sheen(), k);
	const bool snow = k > 0.5;
	da_sn_write(o, P, N, snow ? da_mtl_from_code(DA_MTL_SNOW) : DA_SN_ICE_MTL, false, lerp(bare.rgb, A, k), gloss);
}

da_sn_layer_out main(float2 tc : TEXCOORD0, float4 pos2d : SV_Position
#ifdef USE_MSAA
	, uint iSample : SV_SampleIndex
#endif
	)
{
	const float4 P = DA_SN_LOAD(s_position, pos2d.xy);
	const float4 C = DA_SN_LOAD(s_diffuse, pos2d.xy);
	da_sn_layer_out o;
	o.g1 = C;
#ifdef GBUFFER_OPTIMIZATION
	const float3 Pv = float3(P.z * (pos2d.xy * pos_decompression_params.zw - pos_decompression_params.xy), P.z);
	const float3 Nv = gbuf_unpack_normal(P.xy);
	const float mtl = gbuf_unpack_mtl(P.w);
	const float hemi_in = gbuf_unpack_hemi(P.w);
	o.g0 = float4(P.xy, 0.0, P.w);
#else
	const float3 Pv = P.xyz;
	const float4 Ne = DA_SN_LOAD(s_normal, pos2d.xy);
	const float3 Nv = Ne.xyz;
	const float hemi_in = Ne.w;
	const float mtl = abs(P.w);
	o.g0 = float4(0.0, 0.0, 0.0, 0.0);
#endif
	// the first-person view and the foliage codes (blades carry their own snow) stay as they are
	[branch] if (da_is_foliage(mtl) || da_sn_first_person(pos2d.xy, Pv.z))
		return o;

	const int cut = da_sn_cut();
	[branch] if (cut == 1)
		return o;
	const bool grid = da_is_snow(mtl);
	const float3 Pw = mul(da_sn_v2w, float4(Pv, 1.0)).xyz;
	const float3 Nw = normalize(mul((float3x3)da_sn_v2w, Nv));
	const float view_dist = length(Pv);
	const float footprint = view_dist * da_sn_layer.w;
	float3 base = da_sn_base(Pw.xz);
	float D;
	float2 dgrad;
	da_sn_depth_grad(Pw.xz, D, dgrad);
	const int dbg = da_sn_debug();
	[branch] if (cut == 2)
		return o;
	// r__dbg_snow 4: the snow base's height in bands of 5 cm; 5: the snow's depth in bands of 5 cm.
	[branch] if (dbg == 4 || dbg == 5)
	{
		const float v4 = frac(((dbg == 4) ? base.x : D) / 0.05);
		const float3 c4 = float3(v4, v4, v4);
		da_sn_write(o, P, Nw, 0.0, true, c4, 0.0);
		return o;
	}
	// r__dbg_snow 3: the window's texels over everything - red where the snow tapers to a cliff, green a cover (its
	// base dropped under its opened top), blue a texel standing over its lowest neighbour by a cliff's step.
	[branch] if (dbg == 3)
	{
		const int n3 = int(da_sn_win2.x);
		const int2 t3 = int2(floor(Pw.xz * da_sn_win2.y));
		const float4 b3 = s_da_ground_base.Load(int3(da_sn_wrap(t3, n3), 0));
		const float lo3 = min(min(s_da_ground_base.Load(int3(da_sn_wrap(t3 + int2(1, 0), n3), 0)).x,
			s_da_ground_base.Load(int3(da_sn_wrap(t3 - int2(1, 0), n3), 0)).x),
			min(s_da_ground_base.Load(int3(da_sn_wrap(t3 + int2(0, 1), n3), 0)).x,
			s_da_ground_base.Load(int3(da_sn_wrap(t3 - int2(0, 1), n3), 0)).x));
		const float3 c3 = float3(1.0 - saturate(abs(base.y)), (b3.w - b3.x > 0.3) ? 1.0 : 0.0, (b3.x - lo3 > 0.35) ? 1.0 : 0.0);
		da_sn_write(o, P, Nw, 0.0, true, lerp(float3(0.5, 0.5, 0.5), c3, 0.8) * (grid ? float3(0.7, 1.0, 0.7) : float3(1.0, 1.0, 1.0)), 0.0);
		return o;
	}
	// A snow shell (da_snow_shell.ps marks it with a hemi of 1): the snow on a roof or a vehicle. It is deep snow;
	// the ground's depth and trails are not its own. (Told by its height over the ground's snow, a grid pixel of
	// a coarse ring over a hollow or of the snow over a pond's ice lost its ice and its trails.)
	const bool shell = grid && hemi_in > 0.99;
	[branch] if (shell)
	{
		D = 0.3;
		dgrad = float2(0.0, 0.0);
	}

	// A grid pixel over a frozen pond is the sheet of its ice. The pond's share is per pixel and continuous
	// (da_sn_pond: the bilinear ground against the pond's level, the baked field's pond beyond the window's
	// water), so the sheet ends along the ground's own contour - the window's water texels drew it in 0.25 m
	// squares, a stair-stepped line at any distance. Flat, as the ice: a triangle reaching down into a shore
	// hollow from a vertex the grid did not raise to the pond's level took the bank's slope. The bank's own snow
	// runs a little way onto the ice and thins out (to three quarters of the share), so the snow's edge is the
	// line's meander with a thin see-through rim, not a cut.
	bool frozen_pond = false;
	float3 waterline = float3(DA_SN_NONE, 0.0, 0.0);
	[branch] if (grid && !shell && da_snow_ice.x > 0.02)
	{
		waterline = da_sn_pond(Pw.xz, base);
		[branch] if (waterline.x > DA_SN_NONE * 0.5)
		{
			float2 ice = da_sn_ice_at(Pw.xz);
			frozen_pond = ice.x > 0.5;
			[branch] if (frozen_pond && waterline.y > 0.5 && Pw.y > waterline.x - 0.02 && Pw.y < waterline.x + max(ice.y, D) + 0.5)
			{
				const float bank = saturate((0.75 - waterline.y) * 4.0);
				ice.y = max(ice.y, D * bank);
				da_sn_sheet(o, P, Pw, ice, footprint, bank);
				[branch] if (dbg > 0)
					o.g1.rgb = (waterline.z > 0.5) ? float3(0.1, 0.25, 1.0) : float3(0.0, 0.9, 0.9);
				return o;
			}
		}
	}
	// Under the water surface of open water (base.x is that surface there): the lake bed stays as it is, the
	// water pass draws over it; a grid pixel on it is the sheet of a closing ice front.
	[branch] if (base.z > 0.5 && !frozen_pond && !shell)
	{
		[branch] if (grid && Pw.y > base.x - 0.02)
		{
			const float2 ice = da_sn_ice_at(Pw.xz);
			[branch] if (ice.x > 0.5)
			{
				da_sn_sheet(o, P, Pw, ice, footprint, 0.0);
				[branch] if (dbg > 0)
					o.g1.rgb = float3(0.1, 0.25, 1.0);
				return o;
			}
		}
		[branch] if (!grid && Pw.y < base.x - 0.03)
		{
			[branch] if (dbg > 0)
				da_sn_write(o, P, Nw, 0.0, true, float3(0.9, 0.0, 0.9), C.a);
			return o;
		}
	}

	[branch] if (cut == 3)
		return o;
	// No collision under the pixel (the backdrop beyond the playable area): the surface is its own snow base.
	const bool backdrop = base.x < DA_SN_NONE * 0.5;
	if (backdrop)
		base.x = Pw.y - D;
	// Anything standing above the snow surface gets at most a light up-facing dusting (D8) - but a static
	// surface lying open to the sky (a roof past the shells' reach, a crate's or a slab's top, a sill: on the
	// collision's topmost surface) carries the snow a roof keeps, as a cover of its own. The grid is the snow
	// surface itself (at a shore it stands over the bank's thin snow where the snow on the ice runs on). The step
	// from what lies under the snow to what stands in it is a few centimetres: over 15, a rifle lying in its dent
	// took the snow's cover and went out of sight.
	const float above = grid ? 0.0 : saturate((Pw.y - (base.x + D) - 0.005) / 0.04);
	// What stands over the snow facing sideways or down - a wall, a trunk, a fence, a body's flank - takes none of
	// the layer's snow: out before the season's, the slope's and the exposure's lookups (a good share of the screen;
	// before, the ground's slope under a wall's foot gave it a strip of dust).
	[branch] if (above >= 1.0 && Nw.y <= 0.35)
		return o;
	const da_sn_field fl = da_sn_season(Pw.xz);
	// Texels the bake left without a class (its water) give their share to the open class: snow at a pond's edge is
	// open snow, never without a colour (a black notch on a bank over the bake's water texels before).
	const float4 wc4 = fl.w + float4(saturate(1.0 - dot(fl.w, float4(1.0, 1.0, 1.0, 1.0))), 0.0, 0.0, 0.0);
	const float4 w = wc4 / max(dot(wc4, float4(1.0, 1.0, 1.0, 1.0)), 1e-3);
	float3 G = da_sn_to_linear(C.rgb);

	// ---- the surface's own slope: the base over 2 m, so the collision mesh's facets do not show as
	// bands of light; the grid wrote it as its normal (da_snow_grid.vs) ---------------------------
	float surf = backdrop ? 0.0 : 1.0;
	float2 gb = float2(0.0, 0.0);
	[branch] if (grid)
		gb = -Nw.xz / max(Nw.y, 0.2) * surf;
	else if (above >= 1.0)
		surf = 0.0;
	else
	{
		const float eb = 1.0;
		const float bx0 = da_sn_base(Pw.xz + float2(eb, 0.0)).x, bx1 = da_sn_base(Pw.xz - float2(eb, 0.0)).x;
		const float bz0 = da_sn_base(Pw.xz + float2(0.0, eb)).x, bz1 = da_sn_base(Pw.xz - float2(0.0, eb)).x;
		// a tap off the collision (the edge of the backdrop) gives no slope: the pixel keeps its own normal
		surf = (!backdrop && min(min(bx0, bx1), min(bz0, bz1)) > DA_SN_NONE * 0.5) ? 1.0 : 0.0;
		gb = float2(da_sn_edge_slope(bx1, base.x, bx0, eb), da_sn_edge_slope(bz1, base.x, bz0, eb)) * surf;
	}
	// The slope that sheds snow is the ground's, not its normal map's: a pixel lying on the snow base
	// takes the steeper of the two only where the geometry itself is steep.
	const bool on_base = surf > 0.5 && abs(Pw.y - base.x) < 0.2;
	const float ny = on_base ? max(Nw.y, rsqrt(1.0 + dot(gb, gb))) : Nw.y;

	// ---- coverage --------------------------------------------------------------------------
	const float slope = saturate((ny - 0.35) / 0.40);
	// onset and melt days: the class cover keys over the depth's noise, on a ragged sub-metre margin
	float dust = 0.0;
	[branch] if (da_sn_layer.x > 0.0)
	{
		const float n = da_sn_vnoise(Pw.xz * (1.0 / 0.6), 0x61u);
		dust = saturate((dot(w, da_snow_cover) - (1.0 - fl.f.z) - 0.12 * (n - 0.5)) * 8.0) * da_sn_layer.x;
	}
	// thin snow goes first on dark ground (it takes the sun's heat): asphalt first, then soil and litter, drifts
	// last. By class, not by the pixel's albedo: a texture's light and dark texels would keep and lose it in
	// turn and freckle the whole surface.
	const float dark = lerp(dot(w, float4(0.85, 0.9, 0.65, 1.0)), 1.0, saturate(D / 0.04));
	const float lay = max(smoothstep(0.005, 0.03, D) * dark, dust);
	// December to February a road is snow from kerb to kerb (D5)
	const float road = saturate((da_snow_cover.z - 0.95) * 20.0) * step(0.004, w.z);
	// the exposure (five base lookups) only where snow can lie at all, and not on the grid (its cover is 1)
	float expo = 0.0;
	[branch] if (!grid && above < 1.0 && max(lay, road * step(0.2, ny)) > 0.001)
		expo = da_sn_exposure(Pw, Nw);
	float cov = lay * expo * slope;
	cov = lerp(cov, max(cov, expo * saturate((ny - 0.2) / 0.3)), road);
	// The roof's own cover on a static top over the snow (above).
	float coat = 0.0;
	float Dcoat = 0.0;
	float2 coat_g = float2(0.0, 0.0);
	[branch] if (above > 0.0 && ny > 0.5 && Nw.y > 0.45)
	{
		// On a cover only - the pixel itself standing a cover's height over the snow (a roof, a slab, a vehicle, a
		// stump; not the ground a body or a boot lies on), eased in over its lowest 15 cm - and open to the sky: 15 cm
		// over the raster's highest point at most, under it by no more than a rim's or a rail's height (60 cm: a truck's
		// bed lies that far under its collision box, and its coat came out in diagonal teeth) and the slope's run over a
		// texel. (Gated by its texel's top over the texel's base instead, a stump's flaring
		// roots, a crate's slats and a trailer's bed beside its rails turned white in squares of the 0.25 m window:
		// sheets with toothed edges.)
		const float2 st = da_sn_static_top(Pw.xz);
		const float dy = Pw.y - st.x;
		const float run = st.y * sqrt(saturate(1.0 - ny * ny)) / ny;
		const float over = Pw.y - (base.x + D);
		[branch] if (st.x > DA_SN_NONE * 0.5 && over > 0.15 && dy < 0.15 && dy > -(0.6 + run))
		{
			Dcoat = da_sn_roof_depth(Pw.xz, ny).x;
			coat = smoothstep(0.005, 0.03, Dcoat) * smoothstep(0.15, 0.3, over);
			// Pressed by a boot or a bullet (the roof map, as on the shells): the coat thins where it was pressed - the
			// cover under it shows through a print's floor - and its slope shades the print's walls.
			const float dep = da_sn_roof_dep(Pw.xz);
			[branch] if (dep > 0.002 && coat > 0.0)
			{
				const float e = 0.03;
				coat_g = -float2(da_sn_roof_dep(Pw.xz + float2(e, 0.0)) - da_sn_roof_dep(Pw.xz - float2(e, 0.0)),
					da_sn_roof_dep(Pw.xz + float2(0.0, e)) - da_sn_roof_dep(Pw.xz - float2(0.0, e))) * (0.5 / e);
				// (a press most of the way down bares the cover, as a print's or a bullet's floor on the ground)
				coat *= 1.0 - smoothstep(0.2, 0.7, dep / max(Dcoat, 1e-3));
			}
		}
	}
	// the dusting (a corpse, a creature, a loose prop) grows while it snows: a fresh body is not white
	cov = lerp(cov, max(da_sn_layer.y * slope * (0.4 + 0.6 * da_sn_layer2.x), coat), above);
	[branch] if (grid)
		cov = 1.0;

	// the snow surface: the base's slope and the depth's own
	const float2 g = gb + dgrad * surf + coat_g * above;
	const float3 Nm = normalize(float3(-g.x, 1.0, -g.y));

	[branch] if (cut == 4)
		return o;
	// ---- local state -------------------------------------------------------------------------
	const float3 sun_noon = float3(0.0, 0.36, -0.93); // +z north: the winter noon sun stands low in the south
	const float south = saturate(dot(lerp(Nw, Nm, surf), sun_noon) * 0.5 + 0.5);
	const float age = saturate(da_snow_surf.x + 0.2 * south - 0.5 * da_sn_layer2.x);
	const float wet = saturate(da_snow_surf.z * lerp(0.6, 1.4, south));

	float ring = 0.0;
	[branch] if (wet > 0.05 && cov < 0.99 && ny > 0.5)
	{
		const float r = 0.6;
		const float near = max(max(da_snow_depth(Pw.xz + float2(r, 0.0)), da_snow_depth(Pw.xz - float2(r, 0.0))),
			max(da_snow_depth(Pw.xz + float2(0.0, r)), da_snow_depth(Pw.xz - float2(0.0, r))));
		// Only where the snow itself has melted away: a slope or a shelter that keeps the layer off deep
		// snow is not a melting margin.
		const float bare = 1.0 - smoothstep(0.005, 0.03, D);
		ring = min(1.0 - cov, bare) * saturate(near / 0.02) * wet;
	}
	[branch] if (cov <= 0.001 && ring <= 0.001)
		return o;

	const float trod = shell ? 0.0 : da_sn_trod(Pw.xz);
	const float comp = max(w.z * da_snow_dirt.z, trod);
	const float dirt = saturate(w.z * da_snow_dirt.x + w.y * da_snow_dirt.y);

	const float re = lerp(0.05, 1.0, age) * lerp(1.0, 1.5, wet);
	const float rho = lerp(lerp(80.0, 350.0, age), 500.0, max(wet * 0.6, comp));
	// A grid pixel standing above the bank's own snow is the snow on a pond's ice running on over the bank, or the
	// edge of that ice over a flat shore: it is as deep as the snow on the ice (da_ice_snow, a smooth field), not
	// as the bank's thin cover, and beside a frozen pond what its thin snow lets through is that ice - the albedo
	// the G-buffer holds under the grid is whatever lies behind it along the view (the far bank, the sky's fill),
	// which drew lighter and darker slabs along the terrain's edges. Eased in over 3 cm of that rise, so nothing
	// switches along a line.
	float Dr = D;
	const float lift = (grid && !backdrop && !shell) ? saturate((Pw.y - (base.x + D) - 0.02) / 0.03) : 0.0;
	[branch] if (lift > 0.0)
	{
		Dr = lerp(D, max(D, da_sn_ice_at(Pw.xz).y), lift);
		[branch] if (frozen_pond)
			G = lerp(G, da_ice_albedo(Pw.xz, footprint).rgb, lift);
	}
	// The grid's own snow is deep (from its thinnest drawn depth on); thinner snow it keeps - the flat shore of
	// a frozen pond and the bank beside it - breaks up like the layer's thin snow, eased over 3 to 5 cm: switched
	// at 4 cm, the see-through on one side and the opaque clumps on the other drew tone steps along that depth.
	const float thin = grid ? saturate((0.05 - Dr) / 0.02) : 1.0;
	float R = da_sn_opacity(Dr, rho, re);
	// Thin snow is no even film: it lies in the ground's hollows and in the shade of its lumps and leaves
	// the bumps first, so a thinning margin breaks into clumps before the ground shows through whole
	// (noise of 25 and 8 cm, each faded out as it nears the pixel footprint; no finer grain, which reads
	// as a white frost speckle). Not by the pixel's albedo: the light and dark texels of a gravel or asphalt
	// texture would keep and lose it in turn and freckle the margin white.
	const float wc = saturate(1.0 - footprint / 0.08);
	float n = -1.0;
	[branch] if (R > 0.0 && R < 0.999 && thin > 0.0)
	{
		n = da_sn_margin_noise(Pw.xz, footprint);
		R = lerp(R, saturate((R - n) * 6.0 + 0.5), 0.8 * wc * thin);
	}
	R = max(R, road);
	R = max(R, 0.5 * saturate(dust * 4.0));
	R = lerp(R, lerp(0.55, da_sn_opacity(Dcoat, rho, re), coat), above);
	float k = R * cov;
	// Up close (fully within a few metres, gone by about fifteen) the cover itself - the thin snow's opacity
	// times its lay on the ground, which both ramp over the last centimetres - is cut on the same noise with a
	// transition of about a centimetre: a patch's rim reads as a lace of granular snow and bare ground with
	// crisp edges, not as a milky veil fading out over a hand's width. The noise is stretched over the whole
	// range of the cover, so the lace keeps the veil's mean cover (holes where it was thin, clumps where it was
	// dense), and a little of the veil stays as the clumps' see-through fringe. Its course stays the noise's, so
	// no smooth decal contour comes back. Not on roads, the grid's deep snow or a dusted object.
	const float crisp = thin * (1.0 - smoothstep(0.003, 0.012, footprint)) * (1.0 - above) * (1.0 - road) * wc;
	[branch] if (crisp > 0.0 && k > 0.0 && k < 0.999)
	{
		n = (n < 0.0) ? da_sn_margin_noise(Pw.xz, footprint) : n;
		const float ns = saturate(0.5 + (n - 0.5) * 2.2);
		k = lerp(k, saturate((k - ns) * 10.0 + 0.5), 0.85 * crisp);
	}

	// ---- roads: compacted snow with the ruts of the wheels -------------------------------------------
	float rut = 0.0;
	float2 rut_g = float2(0.0, 0.0);
	[branch] if (!shell && w.z > 0.05 && k > 0.05 && view_dist < 150.0)
	{
		const float3 re3 = da_sn_road_edge(Pw.xz);
		// a wheel track 1.0 m and 2.6 m in from either edge (one lane each way on a wide road), broken
		// along the road, on the compacted share of the road
		const float a0 = (re3.x - 1.0) / 0.17;
		const float a1 = (re3.x - 2.6) / 0.17;
		const float t0 = exp(-a0 * a0), t1 = exp(-a1 * a1);
		const float along = 0.55 + 0.45 * da_sn_vnoise(Pw.xz * (1.0 / 6.0), 0x71u);
		const float amt = along * w.z * saturate(da_snow_dirt.z) * step(0.3, re3.x);
		rut = saturate(t0 + t1) * amt;
		// 2 cm grooves: the height's derivative across the road along the edge distance's gradient
		const float dh = 0.02 * amt * (t0 * 2.0 * a0 + t1 * 2.0 * a1) / 0.17;
		rut_g = dh * re3.yz;
	}

	// ---- albedo ------------------------------------------------------------------------------
	float3 A = (w.x + w.w) * da_snow_albedo_open.rgb + w.y * da_snow_albedo_trees.rgb + w.z * da_snow_albedo_road.rgb;
	A *= 1.0 - 0.3 * saturate(wet - da_snow_surf.z);
	// prints: compacted, denser snow at about three quarters of the fresh snow's albedo
	A *= lerp(1.0, 0.8, trod);
	// the pack's own texture: its relief (below) and its albedo - the mottle, and the dirt old and wet snow gathers
	da_sn_pack pack;
	pack.g = float2(0.0, 0.0);
	pack.tint = float3(1.0, 1.0, 1.0);
	[branch] if (k > 0.01)
		pack = da_sn_pack_detail(Pw.xz, footprint, comp);
	A *= pack.tint;
	const float pond = saturate((wet - 0.55) / 0.35) * saturate(fl.f.w * 1.5) * (1.0 - comp);
	A = lerp(A, float3(0.24, 0.25, 0.25), 0.7 * pond);
	A *= lerp(float3(1.0, 1.0, 1.0), float3(0.62, 0.58, 0.53), saturate(dirt + rut * da_snow_dirt.x * 1.5));
	A *= lerp(1.0, 0.92, rut);
	A = lerp(A, float3(0.89, 0.90, 0.92), 0.5 * da_sn_layer2.x * (1.0 - pond) * (1.0 - comp));
	A = min(A, 0.9) * DA_SNOW_TINT;
	// yellow snow, near (a fresh fall covers it over)
	float stain = 0.0;
	[branch] if (!shell && k > 0.3 && view_dist < 80.0)
	{
		const float4 st = da_sn_stain_at(Pw.xz) * (1.0 - 0.75 * da_sn_layer2.x);
		// (the pack: a pale lemon halo, an ochre core, a brown hole; the core's hue saturated, not mustard grey)
		A *= lerp(float3(1.0, 1.0, 1.0), float3(0.98, 0.91, 0.58), max(0.75 * st.x, 0.85 * st.w));
		A *= lerp(float3(1.0, 1.0, 1.0), float3(0.88, 0.66, 0.26), st.y);
		A *= lerp(float3(1.0, 1.0, 1.0), float3(0.40, 0.27, 0.10), st.z);
		stain = max(st.y, st.w);
	}

	G *= lerp(1.0, 0.72, max(ring, wet * (1.0 - R) * cov));
	const float3 albedo = lerp(G, A, k);

	[branch] if (cut == 5)
		return o;
	// ---- gloss (the specular intensity the G-buffer carries) --------------------------------
	// Wet and slushy snow is coarse-grained and matte, never a plastic sheen; only the meltwater in a hollow
	// mirrors.
	const float slush = saturate(1.0 - dot(da_snow_state, float4(1.0, 1.0, 1.0, 1.0)));
	float rough = dot(da_snow_state, float4(0.80, 0.70, 0.55, 0.45)) + slush * 0.4;
	rough = lerp(rough, 0.5, comp);
	rough = lerp(rough, 0.3, rut);
	rough = lerp(rough, 0.42, saturate(wet - da_snow_surf.z));
	rough = lerp(rough, 0.06, pond);
	// the wet ring is a damp, not a mirror: on a bumpy normal map (asphalt, gravel) more gloss lights every
	// ridge and pebble white, so it keeps the ground's own; melting snow keeps a share of its sheen (da_sn_sheen),
	// the meltwater pooled in a hollow all of it
	const float gloss = lerp(C.a, lerp(saturate(1.0 - rough) * DA_SN_GLOSS * da_sn_sheen(), saturate(1.0 - rough) * DA_SN_GLOSS_WATER, max(pond, rut)), k);

	// ---- normal ------------------------------------------------------------------------------
	float2 gd = rut_g + pack.g;
	const float detail = saturate(1.0 - view_dist / max(da_sn_layer2.y, 1.0)) * k;
	[branch] if (detail > 0.0)
	{
		// wind ripples on loose snow, crests across the winter wind from the west: small ones of 12 cm
		// fading out below the pixel footprint, long ones of 1.4 m; both a few degrees at most
		const float loose = (1.0 - age) * (1.0 - wet) * (1.0 - comp) * (0.5 + da_snow_surf.w);
		const float3 warp = da_sn_noise(Pw.xz * 0.7, 0x1F3u);
		const float2 dir = float2(1.0, 0.15);
		const float f0 = 6.2831853 / 0.12, f1 = 6.2831853 / 1.4;
		const float small = 0.0008 * saturate(1.0 - footprint * 10.0);
		gd += small * loose * -sin(dot(Pw.xz, dir) * f0 + 3.0 * warp.x) * (dir * f0 + 3.0 * 0.7 * warp.yz) * detail;
		gd += 0.006 * loose * -sin(dot(Pw.xz, dir) * f1 + 2.0 * warp.x) * (dir * f1 + 2.0 * 0.7 * warp.yz) * detail;
		// crust pits on old snow
		const float3 pit = da_sn_noise(Pw.xz * (1.0 / 0.12), 0x2B7u);
		gd += 0.0015 * age * (1.0 - comp) * pit.yz * (1.0 / 0.12) * detail * saturate(1.0 - footprint * 10.0);
	}
	const float3 Ns = normalize(float3(-(g.x + gd.x), 1.0, -(g.y + gd.y)));
	// Even a thin film fills the ground's millimetre relief: the ground's normal map is gone once a quarter of
	// the cover lies, so its ridges do not catch the snow's white as a crinkled web over asphalt or gravel; the
	// meltwater of the wet ring softens it by half. A dusted object above the snow keeps its own.
	float3 N = normalize(lerp(Nw, Ns, max(smoothstep(0.0, 0.25, k), 0.5 * ring) * surf * (1.0 - above)));

	[branch] if (cut == 6)
		return o;
	// ---- glints ------------------------------------------------------------------------------
	// Single grains mirroring the sun (da_sn_glint_cell): on clean dry snow the sun shines on (the light pass
	// shadows them), cells of about one and a half pixels at any distance on discrete 1.3x steps (Bowles &
	// Wang; across a step one level's cells drop out as the next one's come in). A flashing pixel's normal turns
	// to the sun's half vector, so the narrow lobe of da_snow_light.h lights it alone, its gloss the flash.
	float gloss_out = gloss;
	bool glint = false;
	[branch] if (da_sn_sun.w > 0.05 && k > 0.6 && stain < 0.3 && view_dist < da_sn_layer2.z && dot(N, da_sn_sun.xyz) > 0.05)
	{
		const float amount = dot(da_snow_state, float4(1.0, 0.85, 0.6, 0.0)) * (1.0 - wet) * (1.0 - wet) * (1.0 - comp) * (1.0 - dirt);
		[branch] if (amount > 0.02)
		{
			const float3 V = normalize(eye_position - Pw);
			const float3 H = normalize(da_sn_sun.xyz + V);
			// the half vector's slope in the surface's frame
			const float3 Tn = normalize(abs(N.y) < 0.99 ? cross(float3(0.0, 1.0, 0.0), N) : float3(1.0, 0.0, 0.0));
			const float3 Bn = cross(N, Tn);
			const float hn = max(dot(H, N), 0.05);
			const float2 hs = float2(dot(H, Tn), dot(H, Bn)) / hn;
			// fresh powder: fine grains, many small sparks; old and corn snow: coarse grains, fewer, bigger ones
			const float grain = lerp(0.0004, 0.0013, age);
			// two pixels and more: a spark keeps its cell under the jitter, so TAA keeps it bright
			const float cell = max(2.2 * footprint, grain);
			const float lv = log2(cell / 0.0006) * (1.0 / log2(1.3));
			const float l0 = floor(lv);
			const float fl0 = lv - l0;
			const float c0 = 0.0006 * exp2(l0 * log2(1.3));
			const float g0 = da_sn_glint_cell(Pw, c0, hs, grain, 0x5A17u) * (1.0 - fl0);
			const float g1 = da_sn_glint_cell(Pw, c0 * 1.3, hs, grain, 0x7B23u) * fl0;
			const float flash = max(g0, g1) * amount * da_sn_sun.w * da_sn_layer.z;
			[branch] if (flash > 0.02)
			{
				N = H;
				gloss_out = saturate(flash * (1.0 / DA_SNOW_GLINT_SCALE));
				glint = true;
			}
		}
	}

	// ---- material and write-out -----------------------------------------------------------------
	const bool snow_code = grid || k > 0.5;
	// r__dbg_snow: the grid green (yellow-green where it runs on as the ice's snow over the bank), the shells
	// violet, the layer's snow yellow, its thin snow and wet rings orange
	float3 alb_out = albedo;
	[branch] if (dbg > 0)
		alb_out = grid ? ((Dr > D + 0.005) ? float3(0.6, 0.9, 0.1) : float3(0.1, 0.9, 0.1)) : ((k > 0.5) ? float3(1.0, 0.9, 0.0) : float3(1.0, 0.45, 0.0));
	// (and the prints the roof map holds red, on a shell or not)
	[branch] if (dbg > 0)
	{
		const float n0 = da_snow_fine_xf.y;
		const float2 a0 = floor(Pw.xz * da_snow_fine_xf.x);
		[branch] if (s_da_sn_roof.Load(int3(int2(a0 - n0 * floor(a0 / n0)), 0)) > 0u)
			alb_out = float3(1.0, 0.1, 0.1);
	}
	[branch] if (dbg > 0 && shell && alb_out.g > 0.2)
		alb_out = float3(0.65, 0.35, 1.0);
	da_sn_write(o, P, N, da_mtl_from_code(glint ? DA_MTL_GLINT : DA_MTL_SNOW), !snow_code, alb_out, gloss_out);
	// a stock material under little snow keeps its word bit for bit (the ground flag goes under snow)
	[branch] if (!snow_code && k <= 0.1)
		o.g0.w = P.w;
	return o;
}
