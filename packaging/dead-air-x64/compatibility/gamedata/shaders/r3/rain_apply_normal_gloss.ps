#include "common.h"

#ifndef ISAMPLE
#define ISAMPLE 0
#endif

#ifndef USE_MSAA
Texture2D s_patched_normal;
#else
Texture2DMS<float4, MSAA_SAMPLES> s_patched_normal;
#endif

struct rain_apply_output
{
    float4 normal : SV_Target0;
    float4 gloss : SV_Target1;
};

#ifdef MSAA_OPTIMIZATION
rain_apply_output main(float2 tc : TEXCOORD0, float2 tcJ : TEXCOORD1, float4 pos2d : SV_Position, uint iSample : SV_SAMPLEINDEX)
#else
rain_apply_output main(float2 tc : TEXCOORD0, float2 tcJ : TEXCOORD1, float4 pos2d : SV_Position)
#endif
{
#ifndef USE_MSAA
    const float4 patched = s_patched_normal.Sample(smp_nofilter, tc);
#elif !defined(MSAA_OPTIMIZATION)
    const float4 patched = s_patched_normal.Load(int2(tc * pos_decompression_params2.xy), ISAMPLE);
#else
    const float4 patched = s_patched_normal.Load(int2(tc * pos_decompression_params2.xy), iSample);
#endif

    // Two finished numbers arrive from the patch pass, and neither is recovered by inverting
    // the other. The normal's length carries the additive gloss (0.5 = none, 1 = full); alpha
    // carries the multiplicative albedo darkening.
    //
    // This pass used to reconstruct wetness from the darkening term as (1-a)^2, which only
    // works while the darkening is one fixed curve for the whole world. It is not any more:
    // the Saunderson darkening depends on the pixel's own albedo and its own porosity, so the
    // inverse has no single solution. The patch pass therefore applies the continuity gate and
    // the viewmodel gate itself and hands the answer over finished - which also means this
    // pass no longer loads the G-buffer at all, and stops reading an s_diffuse its blender
    // never bound.
    const float len = length(patched.xyz);
    const float gloss_add = saturate(len * 2.0 - 1.0);
    const float3 n = patched.xyz / max(len, 1e-4);

    rain_apply_output output;
#ifndef GBUFFER_OPTIMIZATION
    output.normal = float4(n, 1.0);
#else
    output.normal = float4(gbuf_pack_normal(n), 0.0, 0.0);
#endif

    // MRT1 blends rgb multiplicatively into albedo (the wet darkening) and ALPHA additively
    // into the G-buffer gloss - which used to receive a hard 0 - so wet concrete, asphalt and
    // metal actually shine. The hemi gate upstream keeps interiors dry.
    output.gloss = float4(patched.aaa, gloss_add);
    return output;
}
