#include "common.h"

#ifndef ISAMPLE
#define ISAMPLE 0
#endif

#ifndef USE_MSAA
Texture2D s_patched_normal;
#else
Texture2DMS<float4, MSAA_SAMPLES> s_patched_normal;
#endif

struct rain_apply_output
{
    float4 normal : SV_Target0;
    float4 gloss : SV_Target1;
};

#ifdef MSAA_OPTIMIZATION
rain_apply_output main(float2 tc : TEXCOORD0, float2 tcJ : TEXCOORD1, float4 pos2d : SV_Position, uint iSample : SV_SAMPLEINDEX)
#else
rain_apply_output main(float2 tc : TEXCOORD0, float2 tcJ : TEXCOORD1, float4 pos2d : SV_Position)
#endif
{
#ifndef USE_MSAA
    const float4 patched = s_patched_normal.Sample(smp_nofilter, tc);
#elif !defined(MSAA_OPTIMIZATION)
    const float4 patched = s_patched_normal.Load(int2(tc * pos_decompression_params2.xy), ISAMPLE);
#else
    const float4 patched = s_patched_normal.Load(int2(tc * pos_decompression_params2.xy), iSample);
#endif

    // The patch pass encodes the surface continuity in the normal's length (0.5 broken edge,
    // 1 continuous plane): the wet gloss boost belongs to continuous surfaces only - on leaf
    // cards, grass blades and crown silhouettes it drew a white outline. The darkening stays.
    const float len = length(patched.xyz);
    const float cont = saturate(len * 2.0 - 1.0);
    const float3 n = patched.xyz / max(len, 1e-4);

    rain_apply_output output;
#ifndef GBUFFER_OPTIMIZATION
    output.normal = float4(n, 1.0);
#else
    output.normal = float4(gbuf_pack_normal(n), 0.0, 0.0);
#endif

    // MRT1 blends rgb multiplicatively into albedo (the wet darkening) and ALPHA additively into
    // the G-buffer gloss - which used to receive a hard 0. Recover wetness from the stored
    // darkening term (c = max(1-sqrt(w), 0.5) => w = (1-c)^2) and boost the gloss with it, so wet
    // concrete/asphalt/metal actually shine. The hemi gate upstream keeps interiors dry.
    const float wet_back = (1.0 - patched.a) * (1.0 - patched.a);

    // The viewmodel keeps its rain normals and darkening (streaks on the barrel are a feature)
    // but NOT the gloss boost: the 256px rain smap cannot resolve hands, and a mirror-bright
    // rifle centimetres from the camera reads as a smeared screen. HUD geometry lives closer
    // than ~35 cm of view depth.
#ifdef GBUFFER_OPTIMIZATION
#ifdef MSAA_OPTIMIZATION
    const gbuffer_data gbd = gbuffer_load_data(tc, pos2d.xy, iSample);
#else
    const gbuffer_data gbd = gbuffer_load_data(tc, pos2d.xy, ISAMPLE);
#endif
#else
#ifdef MSAA_OPTIMIZATION
    const gbuffer_data gbd = gbuffer_load_data(tc, iSample);
#else
    const gbuffer_data gbd = gbuffer_load_data(tc, ISAMPLE);
#endif
#endif
    const float not_viewmodel = step(0.35, gbd.P.z);

    output.gloss = float4(patched.aaa, saturate(wet_back * 1.2) * not_viewmodel * cont);
    return output;
}
