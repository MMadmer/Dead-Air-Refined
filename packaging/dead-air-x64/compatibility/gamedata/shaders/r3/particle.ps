#include "common.h"

struct v2p
{
	float2 tc0	: TEXCOORD0;
	float4 c	: COLOR0;

//	Igor: for additional depth dest
// [DA_PORT] particle_hard.ps turns the depth test off but keeps the input the vertex shaders
// write with soft particles on, or its position lands a register early and DirectX 12 refuses
// the pipeline.
#if defined(USE_SOFT_PARTICLES) || defined(DA_PARTICLE_TEXGEN_INPUT)
	float4 tctexgen	: TEXCOORD1;
#endif	//	USE_SOFT_PARTICLES

	float4 hpos	: SV_Position;
    float fog: FOG;		// fog
	// The model distortion's vertex shaders (particle_hard.ps) write neither.
#ifndef DA_PARTICLE_HARD
	float3 light : TEXCOORD2;	// the light the particle receives (da_particle_light.h)
	float3 tc2 : TEXCOORD3;	// the flipbook's next frame and the blend toward it (ParticleEffect.cpp)
#endif
};

uniform float4 da_particle_light;
// x: r__particle_light, for the QA views every particle takes (da_particle_light is the lit ones' alone).
uniform float4 da_particle_qa;


//	Must be less than view near
#define	DEPTH_EPSILON	0.1h
//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main( v2p I ) : SV_Target
{
//	float4 result = I.c*tex2D	(s_base,I.tc0);
#ifdef DA_PARTICLE_HARD
	const float3 light = 1.0f, tc2 = 0.0f;
#else
	const float3 light = I.light, tc2 = I.tc2;
#endif
	float4 tex = s_base.Sample( smp_base, I.tc0);
	// An animated flipbook blends into its next frame (DOOM Eternal): the sequence plays smoothly instead of stepping.
	// The gradients are the frame's own, taken outside the branch.
	const float2 dx = ddx( I.tc0 ), dy = ddy( I.tc0 );
	[branch] if ( tc2.z > 0.004f )
		tex = lerp( tex, s_base.SampleGrad( smp_base, tc2.xy, dx, dy ), tc2.z );
	float4 result = I.c * tex;

	//	Igor: additional depth test
#ifdef	USE_SOFT_PARTICLES
//	float4 _P		= tex2Dproj         (s_position,         I.tctexgen);
	float2 tcProj	= I.tctexgen.xy / I.tctexgen.w;
#ifdef GBUFFER_OPTIMIZATION
	gbuffer_data gbd = gbuffer_load_data( tcProj, I.hpos );
#else
	gbuffer_data gbd = gbuffer_load_data( tcProj );
#endif
	float4 _P		= float4( gbd.P, gbd.mtl );
	float spaceDepth = _P.z-I.tctexgen.z-DEPTH_EPSILON;
	if (spaceDepth < -2*DEPTH_EPSILON ) spaceDepth = 100000.0h; //  Skybox doesn't draw into position buffer
	// Soft against the scene, and against the eye (DOOM Eternal's camera fade): a puff the camera walks through
	// dissolves over the last 40 cm before the near plane instead of being cut by it (z is the clip depth, the view
	// depth less the near plane's; a muzzle's smoke past 0.6 m stays whole).
	const float soft = Contrast( saturate(spaceDepth*1.3h), 2) * smoothstep( 0.0f, 0.4f, I.tctexgen.z );
	// Faded toward what leaves the frame as it is, once: an additive particle by its light, a blended one by its
	// coverage (the stock faded both, which darkened a puff's soft edge toward black), a multiplying one toward white or
	// grey (fading those toward black darkened what they crossed).
#if defined(DA_PARTICLE_MUL)
	result.rgb = lerp( 1.0f, result.rgb, soft );
#elif defined(DA_PARTICLE_MUL2)
	result.rgb = lerp( 0.5f, result.rgb, soft );
#elif defined(DA_PARTICLE_ADD)
	result.rgb *= soft;
#else
	result.a *= soft;
#endif
#endif	//	USE_SOFT_PARTICLES

	clip(result.a-(0.01f/255.0f));

	// A blended particle is lit like the scene (da_particle_light.h); additive and multiplying ones are light themselves.
#if !defined(DA_PARTICLE_ADD) && !defined(DA_PARTICLE_MUL) && !defined(DA_PARTICLE_MUL2)
	result.rgb *= light;
	// QA (r__particle_light 2): the light itself, half strength, over the particle's coverage.
	[branch] if (da_particle_qa.x > 1.5f && da_particle_qa.x < 2.5f)
		result.rgb = light * 0.5f;
#endif
	
	//result.rgb /= 2;
	//result.rgb = Vibrance(result.rgb,2.0);

	// The scene's fog, in-scattered by how the particle blends (DOOM Eternal's way) instead of fading it
	// out: a blended particle takes the fog's colour with distance and stays a shape in the murk, an additive
	// one loses its light (nothing glows through fog), a multiplying one turns neutral.
	const float fog = 1.0f - saturate( I.fog );
#if defined(DA_PARTICLE_ADD)
	result.rgb *= 1.0f - fog;
#elif defined(DA_PARTICLE_MUL)
	result.rgb = lerp( result.rgb, 1.0f, fog );
#elif defined(DA_PARTICLE_MUL2)
	result.rgb = lerp( result.rgb, 0.5f, fog );
#else
	result.rgb = lerp( result.rgb, fog_color.rgb, fog );
#endif
	
	// QA (r__particle_light 3): the flipbook's blend toward its next frame, red (none: blue).
	[branch] if ( da_particle_qa.x > 2.5f )
		result.rgb = float3( tc2.z, 0.2f, 1.0f - tc2.z ) * max( result.a, 0.3f );

	return	result;
}
