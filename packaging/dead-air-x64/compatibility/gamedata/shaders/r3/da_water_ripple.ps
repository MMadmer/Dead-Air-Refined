#include "da_water_ripple.h"

//	One fixed step of the ripple field's real-space half as a pixel pass (phase_water_ripple): the
//	body is da_water_ripple_pixel (da_water_ripple.h), shared with da_water_ripple.cs.
struct v2p
{
	float2	tc0		: TEXCOORD0;
};

//	The full input signature stays: the pass links against da_fullscreen.vs.
float4 main(v2p I, float4 hpos : SV_Position) : SV_Target
{
	return float4(da_water_ripple_pixel(uint2(hpos.xy)), 0.0f, 1.0f);
}
