+  gcb.spent = 0;
+  gcb.frame = now;
+  if (budget_usec > 0 && gcb.ticks_us) {
+    gcb.budget = (uint64_t)(budget_usec * gcb.ticks_us);
+    gcb.stale = (uint64_t)(250000 * gcb.ticks_us);
+  } else {
+    gcb.budget = 0;
+  }
+}
