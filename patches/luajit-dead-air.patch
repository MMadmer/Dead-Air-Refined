+#include <intrin.h>
+#define gcb_clock()	__rdtsc()
+#elif LJ_TARGET_X86ORX64 && defined(__GNUC__)
+#include <x86intrin.h>
+#define gcb_clock()	__rdtsc()
+#else
+#define gcb_clock()	((uint64_t)0)
+#endif
+#if LJ_TARGET_POSIX
+#include <time.h>
+#endif
