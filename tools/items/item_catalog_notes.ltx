help = Psy health the item restores (Dead Air).

[item.eat_sleepiness]
title = Sleepiness
help = Sleepiness the item adds, a negative value takes it away (Dead Air).

[item.wounds_heal_perc]
title = Wounds Healed
common = true
help = The share of the bleeding wounds the item closes, from 0 to 1.

[item.apply_time_sec]
