help = Strike protection added while the boost lasts.

[item.boost_fire_wound_immunity]
title = Boost Bullet Immunity
help = Bullet protection added while the boost lasts.

[item.boost_wound_immunity]
title = Boost Wound Immunity
help = Rupture protection added while the boost lasts.

[item.boost_radiation_protection]
title = Boost Radiation Protection
help = Protection against the radiation of the zone added while the boost lasts.

[item.boost_telepat_protection]
title = Boost Psy Protection
help = Protection against psy fields added while the boost lasts.

[item.boost_chemburn_protection]
title = Boost Chemical Protection
help = Protection against chemical fields added while the boost lasts.

[item.use_n_functor]
title = Context Action
help = A Lua function, as script.function, the inventory's context menu calls for a use of the item: use1_functor up to use4_functor, it returns the caption or nothing to hide the row.

[item.use_n_action_functor]
