common = true
help = Health regained per second while the boost lasts.

[item.boost_power_restore]
title = Boost Stamina Regeneration
help = Stamina regained per second while the boost lasts.

[item.boost_radiation_restore]
title = Boost Radiation Removal
common = true
help = Radiation taken away per second while the boost lasts.

[item.boost_bleeding_restore]
title = Boost Bleeding Stop
common = true
