; What no extraction knows about the item keys: the families, the groups, the titles, the help,
; the units and which keys are common. Input of make_item_catalog.py, beside item_keys.tsv.
;
; [<scope>.<name>] notes one key of item_keys.tsv (a series like use<N>_functor is use_n_functor):
;   title, group, unit, common = true, help - and, where the extraction got it wrong, type, values,
;   families, default or required. A key without notes gets a title made from its name and the first
;   group whose `match` fits it. Plain ASCII, no `;` and no double quote inside a value.

[catalog]
version = 1

[scopes]
order = item, hud, upgrade, immunities, absorbation, bones, sound_layers, model, global

[scope.item]
title = Item
help = The item's own section: what spawns, what the inventory shows, what the hands hold.

[scope.hud]
title = HUD Section
help = The section the item's hud key names: the first-person model, where the hands hold it and its motions.

[scope.upgrade]
title = Upgrade
help = An upgrade's settings section (the section key of an upgrade): what installing it changes in the item.

[scope.immunities]
title = Immunities
help = The section an item's immunities_sect names: how much of each kind of hit the item itself takes.

[scope.absorbation]
title = Hit Absorption
help = The section an artefact's hit_absorbation_sect names: how much of each kind of hit it takes off its wearer.

[scope.bones]
title = Bone Protection
help = The section an outfit's or helmet's bones_koeff_protection names: protection per bone of the wearer.

[scope.sound_layers]
title = Sound Layers
help = A section a sound key names instead of a file: every snd_N_layer of it plays at once.

[scope.model]
title = Model Data
help = The torch_definition section in the user data of a torch's model: its lamp.

[scope.global]
title = Game-Wide
help = A section of the system config every item of a kind reads: the defaults an item may override.

[families]
order = item, eatable, medicine, weapon, shotgun, launcher, knife, grenade, ammo, scope, silencer, grenade_launcher, outfit, helmet, backpack, artefact, detector, torch, pda, device, other

[family.item]
title = Plain Item
like = jar, rope, document
help = Parts, junk, documents and props: an inventory item with no use of its own.

[family.eatable]
title = Food and Medicine
like = bread, vodka, medkit
help = Everything eaten, drunk or used on the body. Dead Air's medkits, bandages and drugs are of this family.

[family.medicine]
title = Medkit Class
help = The engine's medkit and antirad classes. Dead Air uses the antirad class for rucksack items such as containers and sleeping bags, its real medicine is of the food family.

[family.weapon]
title = Firearm
like = wpn_ak74, wpn_pm, wpn_svd

[family.shotgun]
title = Shotgun
like = wpn_bm16, wpn_mp133

[family.launcher]
title = Rocket and Grenade Launcher
like = wpn_rpg7, wpn_rg-6

[family.knife]
title = Knife
like = wpn_knife

[family.grenade]
title = Grenade
like = grenade_f1, grenade_rgd5

[family.ammo]
title = Ammunition
like = ammo_5.45x39_fmj, ammo_12x70_buck, ammo_vog-25

[family.scope]
title = Scope
like = wpn_addon_scope

[family.silencer]
title = Silencer
like = wpn_addon_silencer, wpn_sil_9mm

[family.grenade_launcher]
title = Underbarrel Grenade Launcher
like = wpn_addon_grenade_launcher

[family.outfit]
title = Outfit
like = stalker_outfit, novice_outfit, exo_outfit

[family.helmet]
title = Helmet
like = helm_respirator, helm_cloth_mask

[family.backpack]
title = Backpack Class
help = The engine's backpack class. Dead Air's backpacks are artefact-class items in their own slot.

[family.artefact]
title = Artefact
like = af_medusa
help = Artefacts, and Dead Air's belt gear built on the artefact class: backpacks, plates, pouches.

[family.detector]
title = Detector
like = detector_simple, detector_advanced
help = Detectors, and Dead Air's hand lights built on the detector class (the flashlight, glowsticks, lighters).

[family.torch]
title = Head Torch
like = device_torch

[family.pda]
title = PDA
like = device_pda

[family.device]
title = Binoculars and Flare
like = wpn_binoc, device_flare

[family.other]
title = Other
like = bolt
help = The bolt, rockets and the projectiles of grenade launchers, and the multiplayer bag.

[groups]
order = general, icon, inventory, economy, use, protection, weapon, recoil, aim, addons, ammo, condition, explosive, throw, artefact, detector, light, sound, effects, hud, motion, upgrades, tools, ai, other

[group.general]
title = General
match = class, inv_name, inv_name_short, description, visual, kind, story_id, quest_item, ghost, script_binding, custom_data, cform, npc, weapon_class, shadow_visual, npc_visual, actor_visual, character_portrait, parent_section

[group.icon]
title = Icon
match = inv_grid_x, inv_grid_y, inv_grid_width, inv_grid_height, icons_texture, *icon_layer*, upgr_icon_*, kill_msg_*, icon_name, select_mode, full_icon_name

[group.inventory]
title = Inventory
match = inv_weight, slot, belt, can_take, dont_stack, default_to_ruck, system_item, ignore_slots_blocked, highlight_equipped, sprint_allowed, control_inertion_factor, animation_slot, single_handed, hand_dependence, empty_weight

[group.economy]
title = Economy
match = cost, can_trade, box_cost

[group.use]
title = Use
match = eat_*, boost_*, max_uses, remove_after_use, use_sound, use<N>_*, default_use_text, apply_time_sec, wounds_heal_perc, next_use_item, placeable_section, antirad, health_value, food_value, play_function

[group.protection]
title = Protection and Effects
match = *_protection, *_restore_speed, additional_inventory_weight*, power_loss, hit_fraction*, artefact_count, helmet_avaliable, backpack_avaliable, nightvision_sect, immunities_sect*, bones_koeff_protection*, jump_speed, walk_accel, overweight_walk_accel, use_filters, nearest_enemies_show_dist, *_immunity, <bone>, skin_path

[group.weapon]
title = Firing
match = rpm*, hit_power*, hit_impulse*, hit_type, hit_type_2, fire_distance, bullet_speed*, fire_modes, preffered_fire_mode, ammo_class, ammo_mag_size, ammo_elapsed, ammo_limit, fire_dispersion_base*, use_aim_bullet, time_to_aim, air_resistance_factor, base_dispersioned_*, bullet_hit_*, magazined, bolt_action, always_load, tri_state_reload, tracers*, first_bullet_*, use_first_bullet, launch_speed, grenade_class, rocket_class, max_zoom_factor, material, splash*, spash*, auto_spawn_ammo, use_ammo_belt, cycle_down, weapon_remove_time

[group.recoil]
title = Recoil and Spread
match = cam_*, zoom_cam_*, PDM_*, crosshair_inertion

[group.aim]
title = Aiming
match = zoom_enabled, zoom_rotate_time, zoom_hide_crosshair, ironsight_zoom_factor, scope_zoom_factor, scope_texture, scope_dynamic_zoom, scope_nightvision, scope_alive_detector, holder_*, ezi_*, *_dof, nearwall_*, vision_present, vis_frame_*, camera_move_epsilon, disp_min, speed_min, zoom_aim_*, delta_time

[group.addons]
title = Addons
match = scope_status, silencer_status, grenade_launcher_status, scopes, scopes_sect, silencer_name, silencer_x, silencer_y, grenade_launcher_name, grenade_launcher_x, grenade_launcher_y, scope_name, scope_x, scope_y, scope_hide_bones, scope_show_bones, scopes_hide_bone, inv_grid_addon_*, grenade_vel

[group.ammo]
title = Ammunition
match = box_*, k_*, tracer, tracer_color_ID, buck_shot, impair, explosive, allow_ricochet, magnetic_beam_shot, 4to1_tracer, can_be_unlimited, keep_empty_box, misfire_chance, fake_grenade_name, air_resistance_k

[group.condition]
title = Condition and Faults
match = condition*, misfire_*, fault_*, use_condition, allow_repair, repair_type, degrade_rate

[group.explosive]
title = Explosion
match = blast*, frag*, up_throw_factor, explode_*, fragment_speed, time_to_explode, set_timer_particles, detonation_threshold_hit, dynamic_explosion_particles, hide_in_explosion, effect_sect_name, hit_type_blast, hit_type_frag

[group.throw]
title = Throwing and Flight
match = force_*, destroy_time, throw_*, grenade_remove_time, engine_*, third_person_throw_point_offset, infinite, work_time_sec

[group.artefact]
title = Artefact
match = af_rank, af_actor_properties, can_be_controlled, lights_enabled, idle_light_shadow, det_*, artefact_activation_seq, jump_height, impulse_*, energy_*, strike_impulse, time_to_update, hit_absorbation_sect, particle, radius

[group.detector]
title = Detector
match = af_radius, af_vis_radius, af_class_*, zone_class_*, af_freq_*, zone_freq_*, af_sound_*, zone_sound_*, ui_p, ui_r, ef_detector_type, decay_rate, flash_light_range, onoff_light_range

[group.light]
title = Lights
match = light_*, *light_color, *light_range, *light_time, *light_var_*, trail_light_*, torch_*, omni_*, night_vision, disabled_maps, color*, range*, volumetric_*, spot_*, glow_*, guide_bone

[group.sound]
title = Sounds
match = snd_*, *_snd, snd, *sound*, <snd_key><N>

[group.effects]
title = Visual Effects
match = *particles*, shell_point, wm_size

[group.hud]
title = First-Person View
match = hands_*, item_position, item_orientation, aim_hud_offset_*, gl_hud_offset_*, grenade_*zoom*, fire_bone*, fire_point*, shell_bone, position, orientation, zoom_offset, _16x9*, zoom_rotate_*, inertion_*, pitch_offset_*, hud_ui_*, attach_place_idx, item_visual, hud, player_hud_section, strap_*, attach_*, hud_fov_*

[group.motion]
title = Motions
match = anm_*, anim_*

[group.upgrades]
title = Upgrades
match = upgrades, upgrade_scheme, installed_upgrades, *_add

[group.tools]
title = Repair and Cooking Tools
match = repair_*, cooking_*

[group.ai]
title = NPCs
match = ef_*, hit_probability_*

[group.other]
title = Other

; ============================================================================ the item's own section
; ---- general
[item.class]
title = Class
common = true
help = The engine class the item is made of: what it can do and which other keys it reads. A new item takes it from its base.

[item.inv_name]
title = Name
common = true
help = The string id of the name the inventory, the trader and the tooltip show.

[item.inv_name_short]
title = Short Name
common = true
help = The string id of the short name the slots and the item list show.

[item.description]
title = Description
common = true
help = The string id of the text under the name in the tooltip.

[item.visual]
title = Model
common = true
help = The model of the item lying in the world and held by NPCs, a path under meshes without the extension.

[item.quest_item]
title = Quest Item
help = A quest item: traders do not take it, and stashes never hold it.

[item.ghost]
title = Ghost
help = Anomalies do not react to the object.

[item.story_id]
title = Story Id
help = The story id the object takes when it spawns, so quests and scripts can find it.

[item.script_binding]
title = Script Binding
help = A Lua function that binds a script object to the item when it comes online, as script.function.

[item.custom_data]
title = Custom Data
help = Text the spawned object carries as its custom data (a logic section, for instance).

[item.parent_section]
title = Parent Section
help = The weapon this section is a variant of: a scope variant names the gun without the scope.

[item.npc_visual]
title = NPC Model
help = The model an NPC who wears the outfit takes.

[item.actor_visual]
title = Player Model
help = The model the player takes while wearing the outfit.

[item.shadow_visual]
title = Shadow Model
help = A model drawn for the item's shadow instead of its own.

[item.kind]
title = Kind
help = A free word scripts group items by (the debug spawner, for one).

; ---- icon
[item.inv_grid_x]
title = Icon Column
common = true
help = The first column of the item's icon on its icon sheet, in cells of 50 pixels.

[item.inv_grid_y]
title = Icon Row
common = true
help = The first row of the item's icon on its icon sheet, in cells of 50 pixels.

[item.inv_grid_width]
title = Icon Width
common = true
help = The icon's width in cells, which is also how many cells the item takes in the rucksack.

[item.inv_grid_height]
title = Icon Height
common = true
help = The icon's height in cells, which is also how many cells the item takes in the rucksack.

[item.icons_texture]
title = Icon Sheet
common = true
help = A texture of the item's own to cut the icon from, on the same 50 pixel grid, the game's equipment sheet when left out.

[item.n_icon_layer]
title = Icon Layer
help = A section whose icon is drawn over the item's own (a scope on a rifle): 1icon_layer, 2icon_layer and so on, from 0 when 0icon_layer is there, without gaps.

[item.n_icon_layer_x]
title = Icon Layer X
help = Where the layer of the same number sits on the item's icon, in pixels of the icon from its left edge.

[item.n_icon_layer_y]
title = Icon Layer Y
help = Where the layer of the same number sits on the item's icon, in pixels of the icon from its top edge.

[item.n_icon_layer_scale]
title = Icon Layer Scale
unit = x
help = The size of the layer of the same number against its own icon.

[item.upgr_icon_x]
title = Upgrade Picture X
help = The left edge of the item's picture in the upgrade window, in pixels of the upgrade sheet.

[item.upgr_icon_y]
title = Upgrade Picture Y
help = The top edge of the item's picture in the upgrade window, in pixels of the upgrade sheet.

[item.upgr_icon_width]
title = Upgrade Picture Width
help = The width of the item's picture in the upgrade window, in pixels.

[item.upgr_icon_height]
title = Upgrade Picture Height
help = The height of the item's picture in the upgrade window, in pixels.

[item.full_icon_name]
title = Outfit Picture
help = The texture id of the outfit's full figure in the outfit slot.

[item.select_mode]
title = Icon Select Mode


; ---- inventory
[item.inv_weight]
title = Weight
unit = kg
common = true
help = The weight the item adds to what the player carries.

[item.slot]
title = Slot
help = The slot the item goes into: 0 knife, 1 pistol, 2 rifle, 3 grenade, 4 sidearm, 5 bolt, 6 outfit, 7 PDA, 8 detector, 9 torch, 10 artefact, 11 helmet, 13 binoculars, 14 backpack, none for the rucksack only.

[item.belt]
title = Belt Item
help = The item can be worn on the belt.

[item.can_take]
title = Can Be Picked Up
help = The item can be taken from the world.

[item.dont_stack]
title = Do Not Stack
help = Every piece of it takes a cell of its own in the rucksack.

[item.default_to_ruck]
title = Into the Rucksack
help = A slot item picked up goes into the rucksack instead of its slot.

[item.system_item]
title = System Item
help = The inventory never shows the item.

[item.ignore_slots_blocked]
title = Ignores Blocked Slots
help = The item can be drawn while the slots are blocked (in a dialog, for instance).

[item.highlight_equipped]
title = Highlight When Equipped
help = The inventory marks the item while it is in its slot.

[item.sprint_allowed]
title = Sprint Allowed
help = The player can sprint with the item in hand.

[item.control_inertion_factor]
title = Handling Inertia
unit = x
help = How much slower the view turns with the item in hand, 1 is no slower.

[item.animation_slot]
title = Hands Animation Slot
help = Which set of body motions the item is held with, a number of the motion tables of the hands and the third-person body.

[item.single_handed]
title = Single-Handed
help = The weapon is held in one hand, which changes how NPCs and the player's body carry it.

[item.hand_dependence]
title = Hand Dependence
help = How NPCs hold the weapon: 0 none, 1 one hand, 2 both hands.

; ---- economy
[item.cost]
title = Cost
unit = RU
common = true
help = The base price, which traders scale by their own factors.

[item.can_trade]
title = Tradable
help = Traders may buy and sell the item, NPCs also pick up only tradable items.

[item.box_cost]
title = Box Cost
unit = RU
help = The price of a full box when it is not the cost of the box size in rounds.

