[item.max_uses]
title = Portions
common = true
help = How many times the item can be used before it is gone, 255 is without end.

[item.remove_after_use]
title = Removed After Use
help = The item is gone once its last portion is used.

[item.empty_weight]
title = Empty Weight
unit = kg
help = The weight that stays once every portion is used up.

[item.use_sound]
title = Use Sound
common = true
help = The sound played when the item is used.

[item.eat_health]
