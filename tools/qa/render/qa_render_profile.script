-- Render QA profile: rotates the camera at a fixed rate on an already loaded level and
-- reports frame rate once per second, then runs a fast symmetric pitch sweep and quits.
-- Input, cursor and actor position are never automated; the yaw is driven through ordinary
-- runtime calls, the pitch through the cam_pitch_rotate console command.

local profile_started = false
local measurement_started = false
-- Deliberately short: the save starts facing Yanov station, which is the worst-case view of
-- the route, and the sweep rotates away from it. Changing this changes what is measured.
local stabilization_ms = 2500
local measurement_duration_ms = 15000
local yaw_speed_deg_per_sec = 12
local loaded_at = 0
local started_at = 0
local started_epoch = 0
local last_sample_at = 0
local sample_frames = 0
local total_frames = 0
local start_direction = 0

-- Deep symmetric pitch sweep after the yaw pass: full-blackout regressions of local light
-- trigger at steep up/down angles held for a moment, which a yaw-only sweep never visits.
local pitch_started = false
local pitch_index = 0
local pitch_step_end = 0
local pitch_plan = {
    { cmd = "cam_pitch_rotate -80 0.75", wait = 850 },
    { cmd = nil,                         wait = 700 },
    { cmd = "cam_pitch_rotate 80 0.75",  wait = 850 },
    { cmd = nil,                         wait = 700 },
    { cmd = "cam_pitch_rotate 80 0.75",  wait = 850 },
    { cmd = nil,                         wait = 700 },
    { cmd = "cam_pitch_rotate -80 0.75", wait = 850 },
    { cmd = nil,                         wait = 500 },
}

local function start_profile()
    if profile_started then
        return
    end

    profile_started = true
    measurement_started = false
    get_console():execute("g_pause_in_background 0")
    get_console():execute("main_menu off")
    device():pause(false)
    loaded_at = time_global_async()
    printf("[RENDER_QA] stabilizing level=%s", level.name())

    level.add_call(function()
        -- Every frame: the level must not sit paused while the sweep runs.
        device():pause(false)
        local now = time_global_async()

        if not measurement_started then
            if now - loaded_at < stabilization_ms then
                return false
            end

            measurement_started = true
            started_at = now
            started_epoch = os.time()
            last_sample_at = now
            sample_frames = 0
            total_frames = 0
            -- Keep the saved pitch: only the horizontal angle is driven from here.
            start_direction = -device().cam_dir:getH()
            printf("[RENDER_QA] begin level=%s heading_deg=%s",
                level.name(), tostring(start_direction * 180 / math.pi))
        end

        local elapsed = now - started_at
        if not pitch_started then
            local direction = start_direction + elapsed * yaw_speed_deg_per_sec * math.pi / 180000
            db.actor:set_actor_direction(direction)
        end
        sample_frames = sample_frames + 1
        total_frames = total_frames + 1

        if now - last_sample_at >= 1000 then
            local sample_ms = now - last_sample_at
            local fps = sample_frames * 1000 / sample_ms
            printf("[RENDER_QA] sample elapsed_ms=%s heading_deg=%s fps=%s",
                tostring(elapsed), tostring(-device().cam_dir:getH() * 180 / math.pi), tostring(fps))
            last_sample_at = now
            sample_frames = 0
        end

        if not pitch_started then
            if elapsed >= measurement_duration_ms then
                pitch_started = true
                pitch_index = 0
                pitch_step_end = now
                printf("[RENDER_QA] pitch_phase_begin elapsed_ms=%s", tostring(elapsed))
            end
        elseif now >= pitch_step_end then
            pitch_index = pitch_index + 1
            local step = pitch_plan[pitch_index]
            if step then
                if step.cmd then
                    get_console():execute(step.cmd)
                end
                pitch_step_end = now + step.wait
            end
        end

        -- Wall-clock guard as well: a stalled frame loop must not keep the run alive.
        if (pitch_started and pitch_index > #pitch_plan) or os.time() - started_epoch >= 45 then
            local average = 0
            if elapsed > 0 then
                average = total_frames * 1000 / elapsed
            end
            printf("[RENDER_QA] complete elapsed_ms=%s frames=%s average_fps=%s",
                tostring(elapsed), tostring(total_frames), tostring(average))
            get_console():execute("quit")
            return true
        end
        return false
    end, function() end)
end

function on_game_start()
    profile_started = false
    printf("[RENDER_QA] waiting_for_first_update")
    RegisterScriptCallback("actor_on_first_update", start_profile)
end
