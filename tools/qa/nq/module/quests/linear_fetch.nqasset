-- nq: linear_fetch "Хлеб для новичков"
-- A linear quest with no dialogs: start -> task -> fetch bread -> reward -> end.
-- Test-plan reference (sec. 16, game item 1): trigger.start, flow.step, objective.fetch,
-- task.give/complete, item.give, money.give, news.tip, flow.end and a mid-quest save/load.
return {
  nq = 1,
  id = "linear_fetch",
  title = "Хлеб для новичков",
  activation = "auto",
  vars = { bread_needed = 2 },
  tasks = {
    -- two objectives: one visible at once, the other declared hidden and revealed later.
    -- The engine carries task objectives in CGameTask but does NOT save them - after a load
    -- the runtime rebuilds them, which is what the Reload scenario verifies
    bring_bread = { title = "Хлеб для новичков",
                    descr = "Раздобудь две буханки хлеба для лагеря новичков на Кордоне.",
                    type = "additional",
                    objectives = {
                      { id = "find", title = "Найти две буханки" },
                      { id = "deliver", title = "Отнести их новичкам", visible = false },
                    } },
  },
  nodes = {
    { id = "start", kind = "trigger.start", out = { next = "intro" } },

    { id = "intro", kind = "flow.step",
      on_enter = {
        { kind = "news.tip", params = { text = "Новичкам на Кордоне нужен хлеб. Две буханки хватит." } },
        { kind = "task.give", params = { task = "bring_bread" } },
      },
      out = { next = "fetch" } },

    { id = "fetch", kind = "objective.fetch",
      -- the objective is bound to the node: spot_done (default on) closes it, not a manual task.objective_complete
      params = { section = "bread", count = 2, spot_task = "bring_bread", spot_objective = "find" },
      out = { done = "reward" } },

    { id = "reward", kind = "flow.step",
      on_enter = {
        { kind = "task.set_objective_visible", params = { task = "bring_bread", objective = "deliver", visible = true } },
        { kind = "item.take", params = { section = "bread", count = 2 } },
        -- the list spelling: one row per section, the same as item.take's one-line form above
        { kind = "item.give", params = { items = { { section = "medkit", count = 1 } } } },
        { kind = "money.give", params = { amount = 500 } },
        -- the second objective closes here; the task itself is closed by auto_complete
        { kind = "task.objective_complete", params = { task = "bring_bread", objective = "deliver" } },
        { kind = "news.tip", params = { text = "Спасибо, сталкер. Держи аптечку и немного денег." } },
      },
      out = { next = "finish" } },

    { id = "finish", kind = "flow.end", params = { status = "completed" } },
  },
}
