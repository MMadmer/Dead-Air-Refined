; World rules QA: where the new game starts, a patrol path of the module's own, and a
; stalker placed with a standing order to walk it.

[obj:qa_start]
op        = start
level     = l01_escape
position  = -220.9,-19.6,-145.0
direction = 0,1.57,0

[path:qa_world_walk]
level  = l01_escape
points = 3
p0 = -216.0,-19.6,-145.0
p0_name = wp00
p1 = -211.0,-19.6,-149.0
p1_name = wp01
p2 = -216.0,-19.6,-153.0
