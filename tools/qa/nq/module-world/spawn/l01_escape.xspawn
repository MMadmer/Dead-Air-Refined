links  = 0-1:1, 1-2:1, 2-0:1

[obj:qa_world_guard]
op          = add
section     = sim_default_stalker_1
level       = l01_escape
position    = -214.0,-19.6,-147.0
direction   = 0,0,0
custom_data = @spawn/custom_data/qa_world_guard.ltx
