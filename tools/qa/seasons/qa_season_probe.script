-- QA probe: pins the season day to the 15th of each month on a loaded save (qa_season_pin, which also
-- latches that day's texture folders) and takes one scene shot per month with the engine's capture.
-- The weather clock and the wind are held, so a month differs from the next by the season alone.
-- Put into <rig>\gamedata\scripts, remove after the run.

local months = { "january", "february", "march", "april", "may", "june", "july", "august", "september",
	"october", "november", "december" }
local step, t_next, shooting = 0, 0, false

local function con(cmd)
	get_console():execute(cmd)
end

local function on_update()
	device():pause(false)
	local now = time_global()
	if now < t_next then
		return
	end
	if shooting then
		con("r__screenshot_every 0")
		printf(string.format("[qa] SHOT season_%s", months[step]))
		shooting = false
		t_next = now + 500
		return
	end
	step = step + 1
	if step > #months then
		con("qa_season_pin off")
		con("qa_season_state")
		con("env_time_pin -1")
		con("wind_freeze 0")
		printf("[qa] qa_season_done")
		con("flush")
		con("quit")
		t_next = now + 100000
		return
	end
	con("qa_season_pin " .. months[step])
	printf(string.format("[qa] season %s day %.1f", months[step], level.season_day()))
	-- The pin reloads the textures whose folder moved: give the upload a few seconds, then shoot for one
	shooting = true
	CreateTimeEvent("qa_season", "shot", 4, function()
		con("r__screenshot_every 1")
		return true
	end)
	t_next = now + 5200
end

local function on_first_update()
	con("g_pause_in_background 0")
	con("main_menu off")
	con("env_time_pin 12:00")
	con("wind_freeze 1")
	device():pause(false)
	t_next = time_global() + 6000
	RegisterScriptCallback("actor_on_update", on_update)
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", on_first_update)
end
