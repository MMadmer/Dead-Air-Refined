-- QA probe: opens the weather dialog (main menu / pause menu "Weather options") on a loaded save, shows its
-- Seasons page, picks winter, accepts, and checks that r__season followed. The window itself is captured by
-- Watch-QaShots.ps1 at the [qa] SHOT lines. Put into <rig>\gamedata\scripts, remove after the run.

local dlg, step, t_next = nil, 0, 0
local owner = { ShowDialog = function() end, Show = function() end, HideDialog = function() end }

local function con(cmd)
	get_console():execute(cmd)
end

local steps = {
	function()
		dlg = atmosfear_options.af_options_dialog()
		dlg.owner = owner
		dlg:ShowDialog(true)
		printf("[qa] weather dialog open, seasons page %s", tostring(dlg.dlg_season ~= nil))
		printf("[qa] SHOT weather_periods")
		return 2500
	end,
	function()
		dlg:OnBtnSeasonOptions()
		printf("[qa] season list shows '%s' (row %s), r__season %s", dlg.list_season:GetText(),
			tostring(dlg.list_season:GetCurrentIdx()), get_console():get_string("r__season"))
		return 1500
	end,
	function()
		printf("[qa] SHOT weather_seasons")
		return 2500
	end,
	function()
		dlg.list_season:SetCurrentID(1)
		dlg:OnBtnAccept()
		return 1500
	end,
	function()
		printf("[qa] after accept r__season %s", get_console():get_string("r__season"))
		if dlg:IsShown() then
			dlg:HideDialog()
		end
		return 4000
	end,
	function()
		printf("[qa] SHOT weather_winter_world")
		return 2500
	end,
	function()
		printf("[qa] qa_weather_season_done")
		con("flush")
		con("quit")
		return 100000
	end,
}

local function on_update()
	device():pause(false)
	local now = time_global()
	if now < t_next or step >= #steps then
		return
	end
	step = step + 1
	local ok, wait = pcall(steps[step])
	if not ok then
		printf("[qa] step " .. tostring(step) .. " failed: " .. tostring(wait))
		printf("[qa] qa_weather_season_done")
		con("quit")
		return
	end
	t_next = now + (wait or 1000)
end

local function on_first_update()
	con("g_pause_in_background 0")
	con("main_menu off")
	device():pause(false)
	t_next = time_global() + 6000
	RegisterScriptCallback("actor_on_update", on_update)
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", on_first_update)
end
