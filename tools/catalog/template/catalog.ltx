; The catalog's settings (MOD_CATALOG 5.2, 11, 12.3). catalog.py publish copies them into the
; signed public/index.ltx; nothing here reaches the game until it is published.

[catalog]
; tried after the mirrors built into the game; each ends with a slash
mirrors = https://mmadmer.github.io/darf-mods/, https://cdn.jsdelivr.net/gh/MMadmer/darf-mods@main/public/

[virustotal]
; engines whose word counts; the rest count only in numbers
trusted       = Microsoft, Kaspersky, ESET-NOD32, BitDefender, Avast, AVG, Sophos, Symantec, Malwarebytes, TrendMicro, McAfee, F-Secure, DrWeb, Emsisoft, GData, Panda, Avira, Fortinet, CrowdStrike, SentinelOne, Paloalto
block_trusted = 1
warn_trusted  = 1
block_others  = 5
warn_others   = 2

[reviews]
; the form the game posts reviews to, and the CSV its answers are published as; without
; inbox_url reviews are shown but cannot be written
inbox_url     =
inbox_field   =
csv           =
; any random text; changing it resets every hardware hash
salt          =
identity_bits = 24
review_bits   = 20

[accept]
; how the catalog lists modules by itself (MOD_CATALOG 7, 10.2); these stay in this repository and
; are not signed into the index
; a submission from a younger GitHub account is refused, with the day it may come again
min_account_days   = 14
; modules one GitHub account may list
max_mods_per_owner = 20
; new module ids listed in one day; the rest wait for the next
max_new_per_day    = 10
; how long a submission waits when the catalog cannot ask VirusTotal before it is judged without it
vt_wait_days       = 3
; every listed package is analysed again with the day's engines this often (0 = never): the one
; recurring cost of the catalog's own VirusTotal key
vt_rescan_days     = 30
; a listed module whose release has failed the checks this long leaves the browser (it stays listed)
dormant_days       = 30
