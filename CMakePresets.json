{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Ninja Multi-Config)",
      "description": "Canonical Dead Air: Refined Windows build",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ninja-x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Mixed;Release;ReleaseMasterGold",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-master-gold",
      "inherits": "windows-x64",
      "displayName": "Windows x64 Master Gold (Ninja Multi-Config)",
      "description": "Static ReleaseMasterGold build",
      "binaryDir": "${sourceDir}/build/ninja-x64-master-gold",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "targets": [
        "xr_3da",
        "xrRenderPC_R4"
      ]
    },
    {
      "name": "windows-x64-mixed",
      "configurePreset": "windows-x64",
      "configuration": "Mixed",
      "targets": [
        "xr_3da",
        "xrRenderPC_R4"
      ]
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "targets": [
        "xr_3da",
        "xrRenderPC_R4"
      ]
    },
    {
      "name": "windows-x64-release-master-gold",
      "configurePreset": "windows-x64-master-gold",
      "configuration": "ReleaseMasterGold",
      "targets": [
        "xr_3da",
        "xrRenderPC_R4"
      ]
    }
  ]
}
